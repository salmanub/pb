---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
    {# ── URLs reales ya generadas (para no duplicarlas en el loop i18n) ── #}
    {%- set realUrls = [] -%}
    {%- for page in collections.all -%}{%- set _ = realUrls.push(page.url) -%}{%- endfor -%}
    {# ── Pages from collections ── #}
    {# `noindex` añadido el 08/09/2026: una página con <meta name="robots"
       content="noindex"> dentro del sitemap es una señal contradictoria —se le
       pide a Google que rastree lo que se le acaba de decir que no indexe— y
       ensucia el informe de cobertura de Search Console con «Excluida por
       noindex». Afectaba a /colaboracion-peritos/ desde su publicación y ahora
       también a las tres de /colaboracion-expertos/. Filtrar por el mismo
       campo que pinta la meta hace que esto se corrija solo el día que se
       decida indexarlas: se quita `noindex: true` del frontmatter y entran. #}
    {% for page in collections.all %}
       {% if not page.data.draft and not page.data.notshow and not page.data.noindex %}
        <url>
            <loc>{{ metadata.site.url }}{{ page.url | url }}</loc>

            {# hreflang from i18n.json map #}
            {% set alternates = page.url | hreflangAlternates(i18n.pages) %}
            {% for alt in alternates %}
              <xhtml:link rel="alternate" hreflang="{{ alt.lang }}" href="{{ metadata.site.url }}{{ alt.url }}" />
            {% endfor %}
            {% if alternates | length %}
              <xhtml:link rel="alternate" hreflang="x-default" href="{{ metadata.site.url }}{{ (alternates | selectattr('lang', 'equalto', 'es') | first).url | default(page.url) }}" />
            {% endif %}

            <lastmod>{{ page.date.toISOString() }}</lastmod>
            <changefreq>{{ page.data.changeFreq if page.data.changeFreq else "monthly" }}</changefreq>
        </url>
       {% endif %}
    {% endfor %}

    {# ── i18n alternate URLs not yet as pages ── #}
    {% for key, langs in i18n.pages %}
    {% for altLang, altUrl in langs %}
    {% if altLang != "es" and not (altUrl in realUrls) %}
        <url>
            <loc>{{ metadata.site.url }}{{ altUrl }}</loc>
            {% for l2, u2 in langs %}
              <xhtml:link rel="alternate" hreflang="{{ l2 }}" href="{{ metadata.site.url }}{{ u2 }}" />
            {% endfor %}
            <xhtml:link rel="alternate" hreflang="x-default" href="{{ metadata.site.url }}{{ langs.es }}" />
            <changefreq>monthly</changefreq>
        </url>
    {% endif %}
    {% endfor %}
    {% endfor %}
</urlset>