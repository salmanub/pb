---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
    {# ── Pages from collections ── #}
    {% for page in collections.all %}
       {% if not page.data.draft and not page.data.notshow %}
        <url>
            <loc>{{ metadata.site.url }}{{ page.url | url }}</loc>

            {# hreflang from i18n.json map #}
            {% set alternates = page.url | hreflangAlternates(i18n.pages) %}
            {% for alt in alternates %}
              <xhtml:link rel="alternate" hreflang="{{ alt.lang }}" href="{{ metadata.site.url }}{{ alt.url }}" />
            {% endfor %}
            {% if alternates | length %}
              <xhtml:link rel="alternate" hreflang="x-default" href="{{ metadata.site.url }}{{ (alternates | selectattr('lang', 'equalto', 'es') | first).url | default(page.url) }}" />
            {% endif %}

            <lastmod>{{ page.date.toISOString() }}</lastmod>
            <changefreq>{{ page.data.changeFreq if page.data.changeFreq else "monthly" }}</changefreq>
        </url>
       {% endif %}
    {% endfor %}

    {# ── i18n alternate URLs not yet as pages ── #}
    {% for key, langs in i18n.pages %}
    {% for altLang, altUrl in langs %}
    {% if altLang != "es" %}
        <url>
            <loc>{{ metadata.site.url }}{{ altUrl }}</loc>
            {% for l2, u2 in langs %}
              <xhtml:link rel="alternate" hreflang="{{ l2 }}" href="{{ metadata.site.url }}{{ u2 }}" />
            {% endfor %}
            <xhtml:link rel="alternate" hreflang="x-default" href="{{ metadata.site.url }}{{ langs.es }}" />
            <changefreq>monthly</changefreq>
        </url>
    {% endif %}
    {% endfor %}
    {% endfor %}
</urlset>