[
  {
    "title": "Contradictory appraisal and third expert: what to do if you reject the insurer's assessment (art. 38 LCS)",
    "slug": "contradictory-appraisal-insurance-third-expert-art-38-lcs",
    "translations": [
      {
        "lang": "es",
        "permalink": "/blog/peritacion-contradictoria-seguro-tercer-perito-art-38-lcs/"
      },
      {
