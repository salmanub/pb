---
layout: layouts/base.njk
title: "Tell us about your case — Enquiry for individuals"
description: "Guided form for property owners and homeowners' associations. Free initial consultation. We'll advise whether you need an expert report."
lang: en
eleventyNavigation:
  key: ContactParticular
  notshow: true
translations:
  - lang: es
    permalink: /contacto/particular/
  - lang: ca
    permalink: /ca/contacte/particular/
permalink: "/en/contact/particular/"
breadcrumb_parent:
  label: "Contact"
  url: "/en/contact/"
---
{# contact/particular — Typeform-style form #}
<div itemscope itemtype="https://schema.org/Article" style="display: none;" aria-hidden="true"><meta itemprop="headline" content="{{ title }}"><meta itemprop="description" content="{{ description }}"><meta itemprop="url" content="{{ metadata.site.url }}{{ page.url }}"><div itemprop="author" itemscope itemtype="https://schema.org/Person"><meta itemprop="name" content="{{ metadata.author.name }}"></div><div itemprop="publisher" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="{{ metadata.company.name }}"></div></div>
{% set ui = en %}
{% set heroTitle = "Tell us about<br>your case" %}
{% include "partials/page-hero.njk" %}

<div style="max-width: var(--container-wide); margin: 0 auto; padding: 12px var(--gutter) 0; border-top: 1px solid var(--border-subtle);"><span style="font-size: var(--fs-small, 0.8rem); color: var(--text-muted);">Are you a law firm or insurer? </span><a href="/en/contact/professional/" style="font-size: var(--fs-small, 0.8rem); color: var(--text-accent); text-decoration: none; border-bottom: 1px solid transparent;" onmouseenter="this.style.borderBottomColor='var(--accent)'" onmouseleave="this.style.borderBottomColor='transparent'">Request technical collaboration →</a></div>

<section style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
<div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(28px,4vw,64px); align-items: start;" class="site-two">

{# ── Typeform (individual) ── #}
<div>
<div style="border-radius: var(--radius-md); border: 1px solid var(--border-hairline); background: var(--surface-card); overflow: hidden;">

{# Header #}
<div style="padding: 18px 24px; border-bottom: 1px solid var(--border-subtle);">
<span style="font-family: var(--font-mono); font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-muted);">Tell us about your case</span>
</div>

{# Body typeform #}
<div id="intake-p-body" style="padding: 26px 24px 28px; min-height: 420px; position: relative;">

{# Progress bar #}
<div style="margin-bottom: 20px;">
<div style="height: 3px; background: var(--border-subtle); border-radius: 3px; overflow: hidden;">
<div id="tf-progress" style="height: 100%; width: 0%; background: var(--accent); transition: width 0.4s ease;"></div>
</div>
<div id="tf-step-label" style="margin-top: 8px; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint);"></div>
</div>

{# Step 1: Who are you? #}
<div class="tf-step active" data-step="tipo">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">Who are you?</h3>
<div style="display: flex; flex-direction: column; gap: 10px;">
<button type="button" data-value="particular" class="tf-choice" style="width:100%;text-align:left;padding:16px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:1rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)';this.style.background='var(--surface-hover,#f8f8f6)'" onmouseleave="if(!this.classList.contains('selected')){this.style.borderColor='var(--border-hairline)';this.style.background='var(--surface-raised,#fff)'}">
<span style="font-weight: 500; display: inline-flex; align-items: center; gap: 10px;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg> Individual</span>
<span style="display:block;font-size:0.82rem;color:var(--text-muted);margin-top:3px;">Property or premises owner</span>
</button>
<button type="button" data-value="comunidad" class="tf-choice" style="width:100%;text-align:left;padding:16px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:1rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)';this.style.background='var(--surface-hover,#f8f8f6)'" onmouseleave="if(!this.classList.contains('selected')){this.style.borderColor='var(--border-hairline)';this.style.background='var(--surface-raised,#fff)'}">
<span style="font-weight: 500; display: inline-flex; align-items: center; gap: 10px;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg> Homeowners' association</span>
<span style="display:block;font-size:0.82rem;color:var(--text-muted);margin-top:3px;">President or property manager</span>
</button>
<button type="button" data-value="empresa" class="tf-choice" style="width:100%;text-align:left;padding:16px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:1rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)';this.style.background='var(--surface-hover,#f8f8f6)'" onmouseleave="if(!this.classList.contains('selected')){this.style.borderColor='var(--border-hairline)';this.style.background='var(--surface-raised,#fff)'}">
<span style="font-weight: 500; display: inline-flex; align-items: center; gap: 10px;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><rect x="2" y="6" width="20" height="8" rx="1"/><path d="M17 14v7"/><path d="M7 14v7"/><path d="M17 3v3"/><path d="M7 3v3"/><path d="M10 14 5 21"/><path d="M14 14l5 7"/><path d="M2 6l20 0"/></svg> Company</span>
<span style="display:block;font-size:0.82rem;color:var(--text-muted);margin-top:3px;">Builder, developer or insurer</span>
</button>
</div>
</div>

{# Step 2: Type of problem #}
<div class="tf-step" data-step="problema" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">What is your enquiry about?</h3>
<div style="display: flex; flex-direction: column; gap: 10px;">
<button type="button" data-value="humedades" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Damp or water leaks</button>
<button type="button" data-value="grietas_fisuras" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Structural cracks or fissures</button>
<button type="button" data-value="vicios_ocultos" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Hidden defects (property purchase)</button>
<button type="button" data-value="refuerzo" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Structural reinforcement or repair</button>
<button type="button" data-value="otros" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Other enquiry</button>
</div>
<button type="button" class="tf-back" style="margin-top:16px;background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Back</button>
</div>

{# Step 3: Address #}
<div class="tf-step" data-step="direccion" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">Where is the property?</h3>
<div style="display:flex;flex-direction:column;gap:14px;">
<input id="tf-direccion" type="text" required placeholder="Street and number" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<div style="display:flex;gap:14px;">
<input id="tf-cp" type="text" inputmode="numeric" placeholder="Postcode" style="flex:0 0 40%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<input id="tf-ciudad" type="text" required placeholder="City" style="flex:1;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
</div>
</div>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Back</button>
<button type="button" class="tf-next" style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:opacity 0.2s;">Next →</button>
</div>
</div>

{# Step 4: Description (optional) #}
<div class="tf-step" data-step="descripcion" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 6px; line-height: 1.3;">Tell us what's happening</h3>
<p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:18px;">Optional — but it helps us prepare your quote</p>
<textarea id="tf-descripcion" rows="4" placeholder="Describe the issue with your property…" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);resize:vertical;outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'"></textarea>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Back</button>
<button type="button" class="tf-next" style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:opacity 0.2s;">Next →</button>
</div>
</div>

{# Step 5: Name #}
<div class="tf-step" data-step="nombre" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">What is your name?</h3>
<input id="tf-nombre" type="text" required placeholder="Full name" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Back</button>
<button type="button" class="tf-next" style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:opacity 0.2s;">Next →</button>
</div>
</div>

{# Step 6: Email #}
<div class="tf-step" data-step="email" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">What is your email?</h3>
<input id="tf-email" type="email" required placeholder="name@email.com" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<p style="font-size:0.82rem;color:var(--text-muted);margin-top:8px;">We'll reply within 24 business hours</p>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Back</button>
<button type="button" class="tf-next" style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:opacity 0.2s;">Next →</button>
</div>
</div>

{# Step 7: Phone + Submit #}
<div class="tf-step" data-step="telefono" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">And your phone number?</h3>
<input id="tf-telefono" type="tel" required placeholder="+34 ___ ___ ___" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<div style="display:flex;align-items:flex-start;gap:10px;margin-top:16px;padding:12px 14px;background:var(--surface-hover,#f8f8f6);border-radius:var(--radius-sm);border:1px solid var(--border-subtle);">
<input type="checkbox" id="tf-privacidad" style="margin-top:3px;accent-color:var(--accent);width:18px;height:18px;cursor:pointer;">
<label for="tf-privacidad" style="font-size:0.82rem;color:var(--text-muted);line-height:1.45;cursor:pointer;">I have read and accept the <a href="/en/privacy/" style="color:var(--text-accent);text-decoration:underline;">Privacy Policy</a>.</label>
</div>
<p id="tf-error" role="alert" style="display:none;margin:10px 0 0;color:#dc3545;font-family:var(--font-sans);font-size:0.85rem;"></p>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Back</button>
<button type="button" id="tf-submit" disabled style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:all 0.2s;opacity:0.5;">Send enquiry</button>
</div>
</div>

</div>
</div>
</div>

{# ── Sidebar info ── #}
<div>
<div style="position: sticky; top: 92px;">
<div style="border-radius: var(--radius-md); border: 1px solid var(--border-hairline); background: var(--surface-card); overflow: hidden;">
<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; border-bottom: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-muted);">Enquiry for individuals</div>
<div style="padding: 22px 22px 24px;">
<div style="font-family: var(--font-serif); font-style: italic; font-size: 1.6rem; color: var(--text-accent); margin-bottom: 4px;">Free consultation</div>
<div style="margin-top: 14px;">
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">01</span><span>We advise whether you need an expert report</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">02</span><span>Fixed-fee quote in writing</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">03</span><span>Response within 24 business hours</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">04</span><span>Court testimony included</span></div>
</div>

<div style="display: flex; gap: 14px; margin-top: 18px;">
<a href="tel:{{ metadata.contact.phoneNumber | replace(' ', '') }}" style="flex: 1; display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-hairline); background: var(--surface-raised); text-decoration: none; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: var(--text-strong); transition: border-color 0.3s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="this.style.borderColor='var(--border-hairline)'"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ metadata.contact.phoneNumber | replace('+34 ', '') }}</a>
<a href="mailto:{{ metadata.company.email }}" style="flex: 1; display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-hairline); background: var(--surface-raised); text-decoration: none; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; color: var(--text-strong); transition: border-color 0.3s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="this.style.borderColor='var(--border-hairline)'"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>Email</a>
</div>

<div style="margin-top: 12px; text-align: center; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint);">Confidential · No obligation</div>
