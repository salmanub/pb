---
layout: layouts/base.njk
title: "Blog · Forensic Engineering & Expert Reports"
description: "Technical articles on building pathologies, hidden defects, moisture damage and expert witness reports. Resources for property owners, lawyers and insurers."
lang: en
translations:
  - lang: es
    permalink: /blog/
  - lang: ca
    permalink: /ca/blog/
permalink: "/en/blog/"
---
{% set ui = en %}
{% set heroTitle = "Blog · Forensic<br>Engineering" %}
{% include "partials/page-hero.njk" %}

<section itemscope itemtype="https://schema.org/CollectionPage" style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
<meta itemprop="name" content="{{ title }}">
<div style="display:inline-flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;font-weight:var(--fw-medium);color:var(--text-accent);margin-bottom:clamp(28px,4vw,48px);"><span style="width:24px;height:1.5px;background:var(--accent);display:inline-block;"></span>— § 08 · Technical resources</div>
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;" class="three-col">
{% set sortedPosts = posts_en | sort(attribute="datePublished") | reverse %}
{% for post in sortedPosts %}{% if post | isPublished %}
<a href="/en/blog/{{ post.slug }}/" style="text-decoration:none;display:flex;flex-direction:column;" itemprop="hasPart" itemscope itemtype="https://schema.org/BlogPosting">
<article style="border-radius:var(--radius-md);border:1px solid {{ 'var(--ink-700)' if loop.index % 3 == 2 else 'var(--border-hairline)' }};background:{{ 'var(--surface-ink)' if loop.index % 3 == 2 else 'var(--surface-card)' }};padding:24px;flex-grow:1;display:flex;flex-direction:column;">
<div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:16px;">
<span style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;font-weight:600;color:{{ 'var(--text-on-dark-muted)' if loop.index % 3 == 2 else 'var(--text-accent)' }};">{{ post.category }}</span>
<time datetime="{{ post.datePublished }}" style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);color:{{ 'var(--text-on-dark-muted)' if loop.index % 3 == 2 else 'var(--text-faint)' }};">{{ post.datePublished | replace("-", "/") | truncate(7, true, "") }}</time>
</div>
<div itemprop="headline" style="font-family:var(--font-serif);font-size:var(--fs-h2);font-weight:400;line-height:1.25;color:{{ 'var(--bone-100)' if loop.index % 3 == 2 else 'var(--text-strong)' }};margin-bottom:12px;">{{ post.title }}</div>
<p itemprop="description" style="font-size:var(--fs-body-sm);line-height:1.55;color:{{ 'rgba(241,241,234,0.72)' if loop.index % 3 == 2 else 'var(--text-muted)' }};flex-grow:1;">{{ post.excerpt | default(post.description) | truncate(120) }}</p>
{% if post.tags %}<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:16px;">{% for tag in post.tags | slice(0,3) %}<span style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;padding:3px 8px;border-radius:var(--radius-xs);border:1px solid {{ 'var(--ink-600)' if loop.parent.loop.index % 3 == 2 else 'var(--border-hairline)' }};color:{{ 'var(--text-on-dark-muted)' if loop.parent.loop.index % 3 == 2 else 'var(--text-muted)' }};">{{ tag }}</span>{% endfor %}</div>{% endif %}
<div style="margin-top:18px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-accent);display:flex;align-items:center;gap:6px;">Read article <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
</article>
</a>
{% endif %}{% endfor %}
</div>
</section>

<section style="background:var(--surface-tint);border-top:1px solid var(--oxide-200);">
<div style="max-width:var(--container-wide);margin:0 auto;padding:var(--section-y) var(--gutter);text-align:center;">
<div style="display:inline-flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;font-weight:var(--fw-medium);color:var(--text-accent);margin-bottom:18px;"><span style="width:24px;height:1.5px;background:var(--accent);display:inline-block;"></span> No commitment</div>
<h2 style="font-family:var(--font-serif);font-size:var(--fs-h1);font-weight:400;line-height:var(--lh-display);letter-spacing:var(--tracking-tight);color:var(--text-strong);margin:0;">Need an expert report?</h2>
<p style="margin-top:14px;font-size:var(--fs-lede);line-height:var(--lh-lede);color:var(--text-muted);max-width:60ch;margin-left:auto;margin-right:auto;">Free initial consultation to assess your case. Reply within 24 business hours.</p>
<div style="margin-top:28px;"><a href="/en/contact/particular/" style="display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:16px 28px;font-family:var(--font-sans);font-size:var(--fs-body);font-weight:var(--fw-semibold);line-height:1;letter-spacing:0.005em;border-radius:var(--radius-sm);border:1.5px solid transparent;background:var(--accent);color:var(--accent-on);text-decoration:none;">Discuss my case <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></div>
</div>
</section>
