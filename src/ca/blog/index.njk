---
layout: layouts/base.njk
title: "Blog · Enginyeria Forense i Peritatge"
description: "Articles tècnics sobre patologies de l'edificació, vicis ocults, humitats i peritatge judicial. Recursos per a propietaris, advocats i asseguradores."
lang: ca
eleventyNavigation:
  key: Blog
  order: 4
translations:
  - lang: es
    permalink: /blog/
  - lang: en
    permalink: /en/blog/
permalink: "/ca/blog/"
---
{% set ui = ca %}
{% set langPrefix = "/ca" %}
{% set sortedPosts = posts_ca | sort(attribute="datePublished") | reverse %}
{% set publishedPosts = [] %}
{% for post in sortedPosts %}{% if post | isPublished %}{% set publishedPosts = publishedPosts.concat([post]) %}{% endif %}{% endfor %}

{# ── Breadcrumb inline (DS mono) via partial ── #}
{% set breadcrumb_inline = true %}
{% set breadcrumb_items = [
  { label: "Inici", url: "/ca/" },
  { label: "Blog" }
] %}
{% include "partials/breadcrumb.njk" %}
{% set breadcrumb_inline = false %}

{# ── HERO — DS Bitàcola (text, sense imatge) ── #}
<section class="page-hero">
  <div class="page-hero__eyebrow" aria-hidden="true">
    <span class="page-hero__eyebrow-line"></span>
    § Bitàcola
  </div>
  <h1 class="page-hero__h1">Criteri tècnic,<br>en obert</h1>
  <p class="page-hero__lede">Notes pericials sobre patologia de l'edificació i obra civil. Per al particular que vol entendre el seu problema abans d'actuar, i per al professional que busca rigor metodològic.</p>
</section>

{# ── FILTRES (DS: pills mono, actiu = surface-ink / bone-100) ── #}
<section class="ds-wrap" style="padding-bottom: var(--space-4);">
  <div class="bit-filters" id="blog-filter-wrap">
    <button class="bit-cat-btn active" data-cat="Tots" onclick="blogFilter(this,'Tots')">Tots</button>
    {% set seenCats = [] %}
    {% for post in publishedPosts %}{% if post.category and post.category not in seenCats %}{% set seenCats = seenCats.concat([post.category]) %}
    <button class="bit-cat-btn" data-cat="{{ post.category }}" onclick="blogFilter(this,'{{ post.category }}')">{{ post.category }}</button>
    {% endif %}{% endfor %}
  </div>
</section>

{# ── ARTICLE DESTACAT (DS: bit-feat 1.05fr / 1fr) ── #}
{% set featPost = publishedPosts | first %}
{% if featPost %}
<section class="ds-wrap" id="blog-featured" data-cat="{{ featPost.category }}" style="padding-top: var(--space-10); padding-bottom: var(--space-16);">
  <a href="/ca/blog/{{ featPost.slug }}/" class="bit-feat site-two">
    <div class="bit-feat__img">
      {% if featPost.image and featPost.image.url and "placeholder" not in featPost.image.url %}
      <img src="{{ featPost.image.url }}" alt="{{ featPost.image.alt | default(featPost.title) }}" loading="lazy" decoding="async">
      {% else %}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,var(--surface-tint) 0%,var(--paper-50,#eef1ee) 100%);display:flex;align-items:center;justify-content:center;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-faint)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </div>
      {% endif %}
    </div>
    <div>
      <div class="bit-feat__eyebrow">
        <span class="bit-feat__eyebrow-destacado">Destacat</span>
        <span class="bit-feat__eyebrow-sep">·</span>
        <span class="bit-feat__eyebrow-cat">{{ featPost.category }}</span>
      </div>
      <h2 class="bit-feat__h2">{{ featPost.title }}</h2>
      <p class="bit-feat__lede">{{ featPost.excerpt | default(featPost.description) | truncate(200) }}</p>
      <div class="bit-feat__meta">
        <span>{{ featPost.datePublished | replace("-", "/") | truncate(7, true, "") }}</span>
        {% if featPost.readTime %}<span>·</span><span>{{ featPost.readTime }} de lectura</span>{% endif %}
      </div>
      <div class="bit-feat__link">
        Llegir l'article
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
    </div>
  </a>
</section>
{% endif %}

{# ── GRID 3 COLUMNES (posts 2..N) — DS: ArtCard ── #}
{% if publishedPosts.length > 1 %}
<section class="ds-wrap" style="padding-bottom: var(--section-y);" itemscope itemtype="https://schema.org/CollectionPage">
  <meta itemprop="name" content="{{ title }}">
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(28px,3vw,44px);" class="three-col" id="blog-cards">
    {% for post in publishedPosts %}{% if not loop.first %}
    <a href="/ca/blog/{{ post.slug }}/" class="art-card blog-card" data-cat="{{ post.category }}" itemprop="hasPart" itemscope itemtype="https://schema.org/BlogPosting">
      <div class="art-card__img-wrap">
        {% if post.image and post.image.url and "placeholder" not in post.image.url %}
        <img src="{{ post.image.url }}" alt="{{ post.image.alt | default(post.title) }}" loading="lazy" decoding="async">
        {% else %}
        <div style="width:100%;height:100%;background:linear-gradient(135deg,var(--surface-tint) 0%,var(--paper-50,#eef1ee) 100%);display:flex;align-items:center;justify-content:center;">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--text-faint)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        {% endif %}
      </div>
      <div class="art-card__meta">
        <span class="art-card__cat" itemprop="about">{{ post.category }}</span>
        {% if post.readTime %}<span class="art-card__sep">·</span><span class="art-card__time">{{ post.readTime }}</span>{% endif %}
      </div>
      <h3 class="art-card__h3" itemprop="headline">{{ post.title }}</h3>
      <p class="art-card__lede" itemprop="description">{{ post.excerpt | default(post.description) | truncate(200) }}</p>
      <time datetime="{{ post.datePublished }}" itemprop="datePublished" class="art-card__date">{{ post.datePublished | replace("-", "/") | truncate(7, true, "") }}</time>
    </a>
    {% endif %}{% endfor %}
  </div>
</section>
{% endif %}

{# ── BANDA CTA (DS: band-cta--tint) ── #}
<section class="band-cta band-cta--tint">
  <div style="max-width:var(--container-wide);margin:0 auto;">
    <div class="band-cta__eyebrow"><span class="page-hero__eyebrow-line"></span>§ Consulta</div>
    <h2 class="band-cta__h2">El seu cas s'assembla a algun d'aquests?</h2>
    <p class="band-cta__lede">Primera valoració tècnica sense cost i sense compromís. Responem en 24 hores laborables.</p>
    <div class="band-cta__btn-wrap">
      <a href="/ca/contacte/particular/" class="band-cta__btn">
        Plantejar el meu cas
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
function blogFilter(btn, cat) {
  document.querySelectorAll('.bit-cat-btn').forEach(function(b) {
    b.classList.toggle('active', b === btn);
  });
  var feat = document.getElementById('blog-featured');
  if (feat) { feat.style.display = (cat === 'Tots' || feat.getAttribute('data-cat') === cat) ? '' : 'none'; }
  document.querySelectorAll('.blog-card').forEach(function(c) {
    c.style.display = (cat === 'Tots' || c.getAttribute('data-cat') === cat) ? '' : 'none';
  });
}
</script>
