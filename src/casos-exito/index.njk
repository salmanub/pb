{# casos-exito/index.njk — Listado de Casos de Éxito con casosExito.json #}
{% set ui = es %}
{% set heroTitle = "Casos de Éxito<br>en Peritaje" %}
{% include "partials/page-hero.njk" %}

<section itemscope itemtype="https://schema.org/CollectionPage" style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
<meta itemprop="name" content="{{ title }}">
<meta itemprop="description" content="{{ description }}">
{# Eyebrow #}
<div style="display:inline-flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;font-weight:var(--fw-medium);color:var(--text-accent);margin-bottom:clamp(28px,4vw,48px);"><span style="width:24px;height:1.5px;background:var(--accent);display:inline-block;"></span>— § 04 · Expedientes ratificados</div>
{# Grid 3 columnas #}
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;" class="three-col">
{% for caso in casosExito %}
{% if caso.estado == "publicado" %}
<a href="/casos-exito/{{ caso.slug }}/" style="text-decoration:none;display:block;" itemprop="hasPart" itemscope itemtype="https://schema.org/Article">
<article style="border-radius: var(--radius-md); border: 1px solid {{ 'var(--ink-700)' if loop.index % 3 == 2 else 'var(--border-hairline)' }}; background: {{ 'var(--surface-ink)' if loop.index % 3 == 2 else 'var(--surface-card)' }}; padding: 24px; height: 100%; box-sizing: border-box; display:flex; flex-direction:column; transition: box-shadow 0.2s ease;" onmouseenter="this.style.boxShadow='0 4px 24px rgba(0,0,0,0.08)'" onmouseleave="this.style.boxShadow='none'">
{# Fila superior: categoría verde + fecha #}
<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:14px;">
<span style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:{{ 'var(--accent-light, #6fcf97)' if loop.index % 3 == 2 else 'var(--text-accent)' }};font-weight:600;">{{ caso.category | default(caso.tags[0]) }}</span>
<time datetime="{{ caso.datePublished }}" style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);color:{{ 'var(--text-on-dark-muted)' if loop.index % 3 == 2 else 'var(--text-faint)' }};white-space:nowrap;">{{ caso.datePublished | replace("-", "/") | truncate(7, true, "") }}</time>
</div>
{# Importe en grande #}
{% if caso.amount and caso.amount != "—" %}
<div style="font-family:var(--font-mono);font-size:clamp(1.6rem,3vw,2.2rem);font-weight:700;letter-spacing:-0.01em;font-variant-numeric:tabular-nums;color:{{ 'var(--bone-100)' if loop.index % 3 == 2 else 'var(--text-strong)' }};margin-bottom:10px;line-height:1;">{{ caso.amount }}</div>
{% endif %}
{# Título #}
<div itemprop="name" style="font-family:var(--font-serif);font-size:var(--fs-h2);font-weight:400;line-height:1.25;color:{{ 'var(--bone-100)' if loop.index % 3 == 2 else 'var(--text-strong)' }};margin-bottom:10px;">{{ caso.title }}</div>
{# Descripción corta #}
<p itemprop="description" style="font-size:var(--fs-body-sm);line-height:1.55;color:{{ 'rgba(241,241,234,0.72)' if loop.index % 3 == 2 else 'var(--text-muted)' }};flex-grow:1;">{{ caso.description | truncate(120) }}</p>
{# Tags/pills #}
{% if caso.tags %}
<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:16px;">
{% for tag in caso.tags | slice(0,3) %}<span style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;padding:3px 8px;border-radius:var(--radius-xs);border:1px solid {{ 'var(--ink-600)' if loop.parent.loop.index % 3 == 2 else 'var(--border-hairline)' }};color:{{ 'var(--text-on-dark-muted)' if loop.parent.loop.index % 3 == 2 else 'var(--text-muted)' }};">{{ tag }}</span>{% endfor %}
</div>
{% endif %}
{# CTA row #}
<div style="margin-top:18px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-accent);display:flex;align-items:center;gap:6px;">Leer caso <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
</article>
</a>
{% endif %}
{% endfor %}
</div>
</section>

{# BandCTA #}
<section style="background: var(--surface-tint); border-top: 1px solid var(--oxide-200);">
<div style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter); text-align: center;">
<div style="display:inline-flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;font-weight:var(--fw-medium);color:var(--text-accent);margin-bottom:18px;"><span style="width:24px;height:1.5px;background:var(--accent);display:inline-block;"></span> Sin compromiso</div>
<h2 style="font-family:var(--font-serif);font-size:var(--fs-h1);font-weight:400;line-height:var(--lh-display);letter-spacing:var(--tracking-tight);color:var(--text-strong);margin:0;">¿Tiene un caso similar?</h2>
<p style="margin-top:14px;font-size:var(--fs-lede);line-height:var(--lh-lede);color:var(--text-muted);max-width:60ch;margin-left:auto;margin-right:auto;">Primera consulta sin coste para valorar si su caso tiene recorrido pericial. Respuesta en 24 horas.</p>
<div style="margin-top:28px;"><a href="/contacto/profesional/" style="display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:16px 28px;font-family:var(--font-sans);font-size:var(--fs-body);font-weight:var(--fw-semibold);line-height:1;letter-spacing:0.005em;border-radius:var(--radius-sm);border:1.5px solid transparent;background:var(--accent);color:var(--accent-on);text-decoration:none;">Consultar mi caso <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></div>
</div>
</section>
