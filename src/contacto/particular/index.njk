---
layout: layouts/base.njk
title: "Cuéntanos tu caso — Consulta para particulares"
description: "Formulario guiado para particulares y comunidades. Primera consulta sin coste. Te orientamos sobre si necesitas un dictamen pericial."
lang: es
eleventyNavigation:
  key: ContactoParticular
  notshow: true
translations:
  - lang: ca
    permalink: /ca/contacte/particular/
  - lang: en
    permalink: /en/contact/particular/
permalink: "/contacto/particular/"
breadcrumb_parent:
  label: "Contacto"
  url: "/contacto/"
---
{# contacto/particular — Formulario para particulares #}
<div itemscope itemtype="https://schema.org/Article" style="display: none;" aria-hidden="true"><meta itemprop="headline" content="{{ title }}"><meta itemprop="description" content="{{ description }}"><meta itemprop="url" content="{{ metadata.site.url }}{{ page.url }}"><div itemprop="author" itemscope itemtype="https://schema.org/Person"><meta itemprop="name" content="{{ metadata.author.name }}"></div><div itemprop="publisher" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="{{ metadata.company.name }}"></div></div>
{% set ui = es %}
{% set heroTitle = "Cuéntanos<br>tu caso" %}
{% include "partials/page-hero.njk" %}

<div style="max-width: var(--container-wide); margin: 0 auto; padding: 12px var(--gutter) 0; border-top: 1px solid var(--border-subtle);"><span style="font-size: var(--fs-small, 0.8rem); color: var(--text-muted);">¿Es despacho o aseguradora? </span><a href="/contacto/profesional/" style="font-size: var(--fs-small, 0.8rem); color: var(--text-accent); text-decoration: none; border-bottom: 1px solid transparent;" onmouseenter="this.style.borderBottomColor='var(--accent)'" onmouseleave="this.style.borderBottomColor='transparent'">Solicitar colaboración técnica →</a></div>

<section style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
<div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(28px,4vw,64px); align-items: start;" class="site-two">

{# ── Formulario (particular) ── #}
<div>
<div style="border-radius: var(--radius-md); border: 1px solid var(--border-hairline); background: var(--surface-card); overflow: hidden;">

{# Header #}
<div style="padding: 18px 24px; border-bottom: 1px solid var(--border-subtle);">
<span style="font-family: var(--font-mono); font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-muted);">Cuéntanos tu caso</span>
</div>

{# Form #}
<div id="intake-p-body" style="padding: 26px 24px 28px;">
<form id="intake-p-form" novalidate style="display:flex;flex-direction:column;gap:16px;">

<div>
<span style="display:block;font-family:var(--font-sans);font-size:0.85rem;font-weight:500;color:var(--text-strong);margin-bottom:8px;">¿Quién eres?</span>
<div style="display:flex;gap:10px;">
<label style="flex:1;display:flex;align-items:center;gap:10px;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);"><input type="radio" name="tipo_cliente" value="particular" checked style="accent-color:var(--accent);">Particular</label>
<label style="flex:1;display:flex;align-items:center;gap:10px;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);"><input type="radio" name="tipo_cliente" value="empresa" style="accent-color:var(--accent);">Empresa</label>
</div>
</div>

<div>
<label for="ip-nombre" style="display:block;font-family:var(--font-sans);font-size:0.85rem;font-weight:500;color:var(--text-strong);margin-bottom:6px;">Nombre y apellidos</label>
<input id="ip-nombre" name="nombre" type="text" required placeholder="Tu nombre" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:0.95rem;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;">
</div>

<div style="display:flex;gap:14px;flex-wrap:wrap;">
<div style="flex:1;min-width:180px;">
<label for="ip-email" style="display:block;font-family:var(--font-sans);font-size:0.85rem;font-weight:500;color:var(--text-strong);margin-bottom:6px;">Correo electrónico</label>
<input id="ip-email" name="email" type="email" required placeholder="nombre@correo.com" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:0.95rem;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;">
</div>
<div style="flex:1;min-width:180px;">
<label for="ip-telefono" style="display:block;font-family:var(--font-sans);font-size:0.85rem;font-weight:500;color:var(--text-strong);margin-bottom:6px;">Teléfono</label>
<input id="ip-telefono" name="telefono" type="tel" required placeholder="+34 ___ ___ ___" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:0.95rem;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;">
</div>
</div>

<div>
<label for="ip-tipo" style="display:block;font-family:var(--font-sans);font-size:0.85rem;font-weight:500;color:var(--text-strong);margin-bottom:6px;">Tipo de problema</label>
<select id="ip-tipo" name="tipo" required style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:0.95rem;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;cursor:pointer;">
<option value="" disabled selected>Selecciona…</option>
<option value="vicios_ocultos">Vicios ocultos</option>
<option value="humedades">Humedades o filtraciones</option>
<option value="grietas_fisuras">Grietas o fisuras</option>
<option value="otros">Otros</option>
</select>
</div>

<div>
<label for="ip-direccion" style="display:block;font-family:var(--font-sans);font-size:0.85rem;font-weight:500;color:var(--text-strong);margin-bottom:6px;">Dirección del inmueble</label>
<input id="ip-direccion" name="direccion" type="text" required placeholder="Calle y número" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:0.95rem;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;">
</div>

<div style="display:flex;gap:14px;flex-wrap:wrap;">
<div style="flex:0 0 34%;min-width:120px;">
<label for="ip-cp" style="display:block;font-family:var(--font-sans);font-size:0.85rem;font-weight:500;color:var(--text-strong);margin-bottom:6px;">Código postal</label>
<input id="ip-cp" name="cp" type="text" required inputmode="numeric" placeholder="08029" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:0.95rem;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;">
</div>
<div style="flex:1;min-width:150px;">
<label for="ip-ciudad" style="display:block;font-family:var(--font-sans);font-size:0.85rem;font-weight:500;color:var(--text-strong);margin-bottom:6px;">Ciudad</label>
<input id="ip-ciudad" name="ciudad" type="text" required placeholder="Barcelona" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:0.95rem;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;">
</div>
</div>

<div>
<label for="ip-descripcion" style="display:block;font-family:var(--font-sans);font-size:0.85rem;font-weight:500;color:var(--text-strong);margin-bottom:6px;">Explícanos qué ocurre <span style="color:var(--text-faint);font-weight:400;margin-left:6px;">(opcional)</span></label>
<textarea id="ip-descripcion" name="descripcion" rows="4" placeholder="Cuéntanos qué está pasando en tu inmueble…" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:0.95rem;padding:12px 14px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);resize:vertical;outline:none;"></textarea>
</div>

<input type="hidden" name="origen" value="perito.barcelona">
<input type="hidden" name="presupuesto_estimado" value="">

<p id="ip-error" role="alert" style="display:none;margin:0;color:#dc3545;font-family:var(--font-sans);font-size:0.85rem;line-height:1.45;"></p>

<button type="submit" id="ip-submit" style="align-self:flex-start;font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:1.5px solid transparent;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;line-height:1;letter-spacing:0.005em;transition:opacity 0.2s;">Enviar</button>

</form>
</div>

</div>
</div>

{# ── Sidebar info ── #}
<div>
<div style="position: sticky; top: 92px;">
<div style="border-radius: var(--radius-md); border: 1px solid var(--border-hairline); background: var(--surface-card); overflow: hidden;">
<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; border-bottom: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-muted);">Consulta para particulares</div>
<div style="padding: 22px 22px 24px;">
<div style="font-family: var(--font-serif); font-style: italic; font-size: 1.6rem; color: var(--text-accent); margin-bottom: 4px;">Consulta sin coste</div>
<div style="margin-top: 14px;">
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">01</span><span>Te orientamos sobre si necesitas un dictamen</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">02</span><span>Presupuesto cerrado por escrito</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">03</span><span>Respuesta en 24 h laborables</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">04</span><span>Ratificación en sala incluida</span></div>
</div>

<div style="display: flex; gap: 14px; margin-top: 18px;">
<a href="tel:{{ metadata.contact.phoneNumber | replace(' ', '') }}" style="flex: 1; display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-hairline); background: var(--surface-raised); text-decoration: none; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: var(--text-strong); transition: border-color 0.3s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="this.style.borderColor='var(--border-hairline)'"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ metadata.contact.phoneNumber | replace('+34 ', '') }}</a>
<a href="mailto:{{ metadata.company.email }}" style="flex: 1; display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-hairline); background: var(--surface-raised); text-decoration: none; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; color: var(--text-strong); transition: border-color 0.3s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="this.style.borderColor='var(--border-hairline)'"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>Email</a>
</div>

<div style="margin-top: 12px; text-align: center; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint);">Confidencial · Sin compromiso</div>
</div>
</div>
</div>
</div>

</div>
</section>

<script>
(function(){
  'use strict';
  var form = document.getElementById('intake-p-form');
  if(!form) return;
  var submitBtn = document.getElementById('ip-submit');
  var errorEl = document.getElementById('ip-error');
  var WEBHOOK = '/api/contacto';

  form.querySelectorAll('input,select,textarea').forEach(function(inp){
    if(inp.type==='radio') return;
    inp.addEventListener('focus', function(){ inp.style.borderColor='var(--accent)'; });
    inp.addEventListener('blur', function(){ inp.style.borderColor='var(--border-hairline)'; });
  });

  function showError(msg){ errorEl.textContent = msg; errorEl.style.display='block'; }
  function clearError(){ errorEl.style.display='none'; errorEl.textContent=''; }
  function validEmail(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    clearError();
    var checked = form.querySelector('input[name="tipo_cliente"]:checked');
    var data = {
      nombre: form.nombre.value.trim(),
      email: form.email.value.trim(),
      telefono: form.telefono.value.trim(),
      tipo: form.tipo.value,
      tipo_cliente: checked ? checked.value : 'particular',
      direccion: form.direccion.value.trim(),
      cp: form.cp.value.trim(),
      ciudad: form.ciudad.value.trim(),
      descripcion: form.descripcion.value.trim(),
      perfil: 'particular',
      origen: 'perito.barcelona',
      presupuesto_estimado: ''
    };

    if(!data.nombre){ return showError('Indica tu nombre y apellidos.'); }
    if(!validEmail(data.email)){ return showError('Introduce un correo electrónico válido.'); }
    if(!data.telefono){ return showError('Indica un teléfono de contacto.'); }
    if(!data.tipo){ return showError('Selecciona el tipo de problema.'); }
    if(!data.direccion){ return showError('Indica la dirección del inmueble.'); }
    if(!data.cp){ return showError('Indica el código postal.'); }
    if(!data.ciudad){ return showError('Indica la ciudad.'); }

    var originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';
    submitBtn.style.opacity = '0.7';
    submitBtn.style.cursor = 'default';

    fetch(WEBHOOK, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) })
      .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); showSuccess(); })
      .catch(function(){
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
        showError('No se ha podido enviar. Revisa tu conexión e inténtalo de nuevo.');
      });
  });

  function showSuccess(){
    var body = document.getElementById('intake-p-body');
    if(!body) return;
    body.innerHTML = '<div style="text-align:center;padding:28px 8px 32px;">'+
      '<div style="width:52px;height:52px;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center;background:rgba(30,100,60,0.09);">'+
      '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>'+
      '<h3 style="font-family:var(--font-serif);font-size:var(--fs-h2,1.75rem);font-weight:400;margin:20px 0 0;color:var(--text-strong);">Recibido</h3>'+
      '<p style="margin:12px auto 0;max-width:42ch;color:var(--text-muted);line-height:1.6;">En unos minutos tendrás un email con tu propuesta y las opciones de pago.</p>'+
      '</div>';
  }
})();
</script>
