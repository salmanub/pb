---
layout: layouts/base.njk
title: "Cuéntanos tu caso — Consulta para particulares"
description: "Formulario guiado para particulares y comunidades. Primera consulta sin coste. Te orientamos sobre si necesitas un dictamen pericial."
lang: es
eleventyNavigation:
  key: ContactoParticular
  notshow: true
translations:
  - lang: ca
    permalink: /ca/contacte/particular/
  - lang: en
    permalink: /en/contact/particular/
permalink: "/contacto/particular/"
breadcrumb_parent:
  label: "Contacto"
  url: "/contacto/"
---
{# contacto/particular — Formulario estilo typeform #}
<div itemscope itemtype="https://schema.org/Article" style="display: none;" aria-hidden="true"><meta itemprop="headline" content="{{ title }}"><meta itemprop="description" content="{{ description }}"><meta itemprop="url" content="{{ metadata.site.url }}{{ page.url }}"><div itemprop="author" itemscope itemtype="https://schema.org/Person"><meta itemprop="name" content="{{ metadata.author.name }}"></div><div itemprop="publisher" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="{{ metadata.company.name }}"></div></div>
{% set ui = es %}
{% set heroTitle = "Cuéntanos<br>tu caso" %}
{% include "partials/page-hero.njk" %}

<div style="max-width: var(--container-wide); margin: 0 auto; padding: 12px var(--gutter) 0; border-top: 1px solid var(--border-subtle);"><span style="font-size: var(--fs-small, 0.8rem); color: var(--text-muted);">¿Es despacho o aseguradora? </span><a href="/contacto/profesional/" style="font-size: var(--fs-small, 0.8rem); color: var(--text-accent); text-decoration: none; border-bottom: 1px solid transparent;" onmouseenter="this.style.borderBottomColor='var(--accent)'" onmouseleave="this.style.borderBottomColor='transparent'">Solicitar colaboración técnica →</a></div>

<section style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
<div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(28px,4vw,64px); align-items: start;" class="site-two">

{# ── Formulario typeform (particular) ── #}
<div>
<div style="border-radius: var(--radius-md); border: 1px solid var(--border-hairline); background: var(--surface-card); overflow: hidden;">

{# Header #}
<div style="padding: 18px 24px; border-bottom: 1px solid var(--border-subtle);">
<span style="font-family: var(--font-mono); font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-muted);">Cuéntanos tu caso</span>
</div>

{# Body typeform #}
<div id="intake-p-body" style="padding: 26px 24px 28px; min-height: 420px; position: relative;">

{# Progress bar #}
<div style="margin-bottom: 20px;">
<div style="height: 3px; background: var(--border-subtle); border-radius: 3px; overflow: hidden;">
<div id="tf-progress" style="height: 100%; width: 0%; background: var(--accent); transition: width 0.4s ease;"></div>
</div>
<div id="tf-step-label" style="margin-top: 8px; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint);"></div>
</div>

{# Step 1: ¿Quién eres? #}
<div class="tf-step active" data-step="tipo">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">¿Quién eres?</h3>
<div style="display: flex; flex-direction: column; gap: 10px;">
<button type="button" data-value="particular" class="tf-choice" style="width:100%;text-align:left;padding:16px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:1rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)';this.style.background='var(--surface-hover,#f8f8f6)'" onmouseleave="if(!this.classList.contains('selected')){this.style.borderColor='var(--border-hairline)';this.style.background='var(--surface-raised,#fff)'}">
<span style="font-weight: 500;">🏠 Particular</span>
<span style="display:block;font-size:0.82rem;color:var(--text-muted);margin-top:3px;">Propietario/a de vivienda o local</span>
</button>
<button type="button" data-value="comunidad" class="tf-choice" style="width:100%;text-align:left;padding:16px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:1rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)';this.style.background='var(--surface-hover,#f8f8f6)'" onmouseleave="if(!this.classList.contains('selected')){this.style.borderColor='var(--border-hairline)';this.style.background='var(--surface-raised,#fff)'}">
<span style="font-weight: 500;">🏢 Comunidad de propietarios</span>
<span style="display:block;font-size:0.82rem;color:var(--text-muted);margin-top:3px;">Presidente/a o administrador/a de fincas</span>
</button>
<button type="button" data-value="empresa" class="tf-choice" style="width:100%;text-align:left;padding:16px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:1rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)';this.style.background='var(--surface-hover,#f8f8f6)'" onmouseleave="if(!this.classList.contains('selected')){this.style.borderColor='var(--border-hairline)';this.style.background='var(--surface-raised,#fff)'}">
<span style="font-weight: 500;">🏗️ Empresa</span>
<span style="display:block;font-size:0.82rem;color:var(--text-muted);margin-top:3px;">Constructora, promotora o aseguradora</span>
</button>
</div>
</div>

{# Step 2: Tipo de problema #}
<div class="tf-step" data-step="problema" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">¿Sobre qué es tu consulta?</h3>
<div style="display: flex; flex-direction: column; gap: 10px;">
<button type="button" data-value="humedades" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Humedades o filtraciones</button>
<button type="button" data-value="grietas_fisuras" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Grietas o fisuras estructurales</button>
<button type="button" data-value="vicios_ocultos" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Vicios ocultos (compra de inmueble)</button>
<button type="button" data-value="refuerzo" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Refuerzo o reparación estructural</button>
<button type="button" data-value="otros" class="tf-choice" style="width:100%;text-align:left;padding:14px 20px;background:var(--surface-raised,#fff);border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-sans);font-size:0.95rem;color:var(--text-strong);transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="if(!this.classList.contains('selected'))this.style.borderColor='var(--border-hairline)'">Otra consulta</button>
</div>
<button type="button" class="tf-back" style="margin-top:16px;background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Atrás</button>
</div>

{# Step 3: Dirección #}
<div class="tf-step" data-step="direccion" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">¿Dónde está el inmueble?</h3>
<div style="display:flex;flex-direction:column;gap:14px;">
<input id="tf-direccion" type="text" required placeholder="Calle y número" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<div style="display:flex;gap:14px;">
<input id="tf-cp" type="text" inputmode="numeric" placeholder="Código postal" style="flex:0 0 40%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<input id="tf-ciudad" type="text" required placeholder="Ciudad" style="flex:1;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
</div>
</div>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Atrás</button>
<button type="button" class="tf-next" style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:opacity 0.2s;">Siguiente →</button>
</div>
</div>

{# Step 4: Descripción (opcional) #}
<div class="tf-step" data-step="descripcion" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 6px; line-height: 1.3;">Explícanos qué ocurre</h3>
<p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:18px;">Opcional — pero nos ayuda a preparar tu presupuesto</p>
<textarea id="tf-descripcion" rows="4" placeholder="Cuéntanos qué está pasando en tu inmueble…" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);resize:vertical;outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'"></textarea>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Atrás</button>
<button type="button" class="tf-next" style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:opacity 0.2s;">Siguiente →</button>
</div>
</div>

{# Step 5: Nombre #}
<div class="tf-step" data-step="nombre" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">¿Cuál es tu nombre?</h3>
<input id="tf-nombre" type="text" required placeholder="Nombre y apellidos" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Atrás</button>
<button type="button" class="tf-next" style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:opacity 0.2s;">Siguiente →</button>
</div>
</div>

{# Step 6: Email #}
<div class="tf-step" data-step="email" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">¿Cuál es tu email?</h3>
<input id="tf-email" type="email" required placeholder="nombre@correo.com" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<p style="font-size:0.82rem;color:var(--text-muted);margin-top:8px;">Le responderemos en menos de 24h laborables</p>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Atrás</button>
<button type="button" class="tf-next" style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:opacity 0.2s;">Siguiente →</button>
</div>
</div>

{# Step 7: Teléfono + Enviar #}
<div class="tf-step" data-step="telefono" style="display:none;">
<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 300; color: var(--text-strong); margin-bottom: 20px; line-height: 1.3;">¿Y tu teléfono?</h3>
<input id="tf-telefono" type="tel" required placeholder="+34 ___ ___ ___" style="width:100%;box-sizing:border-box;font-family:var(--font-sans);font-size:1.05rem;padding:14px 16px;border:1.5px solid var(--border-hairline);border-radius:var(--radius-sm);background:var(--surface-raised,#fff);color:var(--text-strong);outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-hairline)'">
<div style="display:flex;align-items:flex-start;gap:10px;margin-top:16px;padding:12px 14px;background:var(--surface-hover,#f8f8f6);border-radius:var(--radius-sm);border:1px solid var(--border-subtle);">
<input type="checkbox" id="tf-privacidad" style="margin-top:3px;accent-color:var(--accent);width:18px;height:18px;cursor:pointer;">
<label for="tf-privacidad" style="font-size:0.82rem;color:var(--text-muted);line-height:1.45;cursor:pointer;">He leído y acepto la <a href="/privacidad/" style="color:var(--text-accent);text-decoration:underline;">Política de Privacidad</a>.</label>
</div>
<p id="tf-error" role="alert" style="display:none;margin:10px 0 0;color:#dc3545;font-family:var(--font-sans);font-size:0.85rem;"></p>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
<button type="button" class="tf-back" style="background:none;border:none;cursor:pointer;font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">← Atrás</button>
<button type="button" id="tf-submit" disabled style="font-family:var(--font-sans);font-size:0.95rem;font-weight:600;color:var(--accent-on,#fff);background:var(--accent);border:none;border-radius:var(--radius-sm);padding:13px 28px;cursor:pointer;transition:all 0.2s;opacity:0.5;">Enviar consulta</button>
</div>
</div>

</div>
</div>
</div>

{# ── Sidebar info ── #}
<div>
<div style="position: sticky; top: 92px;">
<div style="border-radius: var(--radius-md); border: 1px solid var(--border-hairline); background: var(--surface-card); overflow: hidden;">
<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; border-bottom: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-muted);">Consulta para particulares</div>
<div style="padding: 22px 22px 24px;">
<div style="font-family: var(--font-serif); font-style: italic; font-size: 1.6rem; color: var(--text-accent); margin-bottom: 4px;">Consulta sin coste</div>
<div style="margin-top: 14px;">
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">01</span><span>Te orientamos sobre si necesitas un dictamen</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">02</span><span>Presupuesto cerrado por escrito</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">03</span><span>Respuesta en 24 h laborables</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-body); line-height: 1.5;"><span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-accent); font-weight: 600; flex-shrink: 0; padding-top: 2px;">04</span><span>Ratificación en sala incluida</span></div>
</div>

<div style="display: flex; gap: 14px; margin-top: 18px;">
<a href="tel:{{ metadata.contact.phoneNumber | replace(' ', '') }}" style="flex: 1; display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-hairline); background: var(--surface-raised); text-decoration: none; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: var(--text-strong); transition: border-color 0.3s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="this.style.borderColor='var(--border-hairline)'"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ metadata.contact.phoneNumber | replace('+34 ', '') }}</a>
<a href="mailto:{{ metadata.company.email }}" style="flex: 1; display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-hairline); background: var(--surface-raised); text-decoration: none; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; color: var(--text-strong); transition: border-color 0.3s;" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="this.style.borderColor='var(--border-hairline)'"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>Email</a>
</div>

<div style="margin-top: 12px; text-align: center; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint);">Confidencial · Sin compromiso</div>
</div>
</div>
</div>
</div>

</div>
</section>

<script>
(function(){
  'use strict';
  var body = document.getElementById('intake-p-body');
  if(!body) return;

  var steps = Array.from(body.querySelectorAll('.tf-step'));
  var progress = document.getElementById('tf-progress');
  var stepLabel = document.getElementById('tf-step-label');
  var errorEl = document.getElementById('tf-error');
  var submitBtn = document.getElementById('tf-submit');
  var privCheckbox = document.getElementById('tf-privacidad');
  var current = 0;
  var TOTAL = steps.length;
  var WEBHOOK = '/api/contacto';

  var formData = { tipo_cliente: '', tipo: '', direccion: '', cp: '', ciudad: '', descripcion: '', nombre: '', email: '', telefono: '' };

  function showStep(i) {
    current = i;
    steps.forEach(function(s, idx) {
      s.style.display = idx === i ? 'block' : 'none';
      if (idx === i) s.classList.add('active'); else s.classList.remove('active');
    });
    var pct = Math.round(((i + 1) / TOTAL) * 100);
    if (progress) progress.style.width = pct + '%';
    if (stepLabel) stepLabel.textContent = 'Pregunta ' + (i + 1) + ' de ' + TOTAL;
    var inp = steps[i].querySelector('input:not([type=checkbox]),textarea');
    if (inp) setTimeout(function(){ inp.focus(); }, 200);
  }

  // Choice buttons (tipo & problema)
  body.addEventListener('click', function(e) {
    var choice = e.target.closest('.tf-choice');
    if (choice) {
      var step = choice.closest('.tf-step');
      var stepName = step.dataset.step;
      var val = choice.dataset.value;

      // Highlight
      step.querySelectorAll('.tf-choice').forEach(function(b) {
        b.classList.remove('selected');
        b.style.borderColor = 'var(--border-hairline)';
        b.style.background = 'var(--surface-raised,#fff)';
      });
      choice.classList.add('selected');
      choice.style.borderColor = 'var(--accent)';
      choice.style.background = 'var(--surface-hover,#f8f8f6)';

      if (stepName === 'tipo') formData.tipo_cliente = val;
      if (stepName === 'problema') formData.tipo = val;

      setTimeout(function(){ showStep(current + 1); }, 250);
      return;
    }

    // Back
    var back = e.target.closest('.tf-back');
    if (back && current > 0) { showStep(current - 1); return; }

    // Next
    var next = e.target.closest('.tf-next');
    if (next) {
      if (validateCurrent()) showStep(current + 1);
      return;
    }

    // Submit
    if (e.target.closest('#tf-submit')) {
      if (!privCheckbox.checked) {
        if (errorEl) { errorEl.textContent = 'Acepta la política de privacidad para continuar.'; errorEl.style.display = 'block'; }
        return;
      }
      submitForm();
    }
  });

  // Enable/disable submit on checkbox
  if (privCheckbox) {
    privCheckbox.addEventListener('change', function() {
      submitBtn.disabled = !privCheckbox.checked;
      submitBtn.style.opacity = privCheckbox.checked ? '1' : '0.5';
      if (errorEl) errorEl.style.display = 'none';
    });
  }

  // Enter to advance
  body.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey && document.activeElement.tagName !== 'TEXTAREA') {
      e.preventDefault();
      var nextBtn = steps[current].querySelector('.tf-next');
      var subBtn = steps[current].querySelector('#tf-submit');
      if (nextBtn && validateCurrent()) showStep(current + 1);
      else if (subBtn && privCheckbox && privCheckbox.checked) submitForm();
    }
  });

  function validateCurrent() {
    var step = steps[current];
    var name = step.dataset.step;
    if (name === 'direccion') {
      var dir = document.getElementById('tf-direccion').value.trim();
      var ciu = document.getElementById('tf-ciudad').value.trim();
      if (!dir || !ciu) { shake(step); return false; }
      formData.direccion = dir;
      formData.cp = document.getElementById('tf-cp').value.trim();
      formData.ciudad = ciu;
    } else if (name === 'descripcion') {
      formData.descripcion = document.getElementById('tf-descripcion').value.trim();
    } else if (name === 'nombre') {
      var n = document.getElementById('tf-nombre').value.trim();
      if (!n) { shake(step); return false; }
      formData.nombre = n;
    } else if (name === 'email') {
      var em = document.getElementById('tf-email').value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)) { shake(step); return false; }
      formData.email = em;
    }
    return true;
  }

  function shake(el) {
    el.style.animation = 'none';
    el.offsetHeight;
    el.style.animation = 'tf-shake 0.4s ease';
  }

  function submitForm() {
    formData.telefono = document.getElementById('tf-telefono').value.trim();
    if (!formData.telefono) {
      if (errorEl) { errorEl.textContent = 'Indica un teléfono de contacto.'; errorEl.style.display = 'block'; }
      return;
    }
    if (errorEl) errorEl.style.display = 'none';

    var originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';
    submitBtn.style.opacity = '0.7';

    var payload = {
      nombre: formData.nombre,
      email: formData.email,
      telefono: formData.telefono,
      tipo_cliente: formData.tipo_cliente,
      tipo: formData.tipo,
      direccion: formData.direccion,
      cp: formData.cp,
      ciudad: formData.ciudad,
      descripcion: formData.descripcion,
      perfil: formData.tipo_cliente === 'empresa' ? 'profesional' : 'particular',
      origen: 'perito.barcelona',
      timestamp: new Date().toISOString()
    };

    fetch(WEBHOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
      .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); showSuccess(); })
      .catch(function() {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        submitBtn.style.opacity = '1';
        if (errorEl) { errorEl.textContent = 'No se ha podido enviar. Revisa tu conexión e inténtalo de nuevo.'; errorEl.style.display = 'block'; }
      });
  }

  function showSuccess() {
    body.innerHTML =
      '<div style="text-align:center;padding:40px 8px 48px;">' +
      '<div style="width:56px;height:56px;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center;background:rgba(30,100,60,0.09);">' +
      '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>' +
      '<h3 style="font-family:var(--font-serif);font-size:1.75rem;font-weight:400;margin:22px 0 0;color:var(--text-strong);">Recibido</h3>' +
      '<p style="margin:14px auto 0;max-width:42ch;color:var(--text-muted);line-height:1.6;">En unos minutos tendrás un email con tu propuesta y las opciones de pago.</p>' +
      '</div>';
  }

  // Add shake animation
  var style = document.createElement('style');
  style.textContent = '@keyframes tf-shake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-6px)}40%,80%{transform:translateX(6px)}}';
  document.head.appendChild(style);

  showStep(0);
})();
</script>
