<script>
/**
 * Instant Navigation / Smart Prefetching
 * Optimized to prevent 503 errors and server overload.
 * Strategy: Low priority 'prefetch' on idle + High priority on hover/interaction.
 */
(function() {
    const config = {
        // Limit concurrent prefetches to avoid network congestion
        maxConcurrent: 2,
        // Delay before prefetching on hover (ms) to avoid accidental triggers
        hoverDelay: 100,
        // Exclude patterns
        exclude: /\.(pdf|zip|jpg|png|gif|webp|mp4)$|^tel:|^mailto:|^#|^javascript:/i
    };

    let queue = [];
    let active = 0;
    let seen = new Set();

    // Check if network is slow/data-saver enabled
    const isSlowConnection = navigator.connection && 
        (navigator.connection.saveData || (navigator.connection.effectiveType && navigator.connection.effectiveType.includes('2g')));

    if (isSlowConnection) {
        console.log('Skipping prefetch due to slow connection');
        return;
    }

    // Helper: Add link tag
    function addPrefetch(url) {
        if (seen.has(url)) return;
        seen.add(url);
        
        const link = document.createElement('link');
        link.rel = 'prefetch'; // Low priority hint to browser
        link.href = url;
        document.head.appendChild(link);
    }

    // Interaction Observers
    function setupInteraction() {
        let hoverTimer;
        
        document.addEventListener('mouseover', (e) => {
            const link = e.target.closest('a');
            if (!link || !link.href) return;
            
            // Only internal links
            if (link.hostname !== window.location.hostname) return;
            if (config.exclude.test(link.href)) return;
            if (link.href === window.location.href) return;

            // Clear previous timer
            if (hoverTimer) clearTimeout(hoverTimer);

            // Fetch on hover intent
            hoverTimer = setTimeout(() => {
                addPrefetch(link.href);
            }, config.hoverDelay);
        }, { passive: true });

        document.addEventListener('mouseout', () => {
            if (hoverTimer) clearTimeout(hoverTimer);
        }, { passive: true });

        // Touch start for mobile instant load
        document.addEventListener('touchstart', (e) => {
            const link = e.target.closest('a');
            if (link && link.href && link.hostname === window.location.hostname) {
                if (!config.exclude.test(link.href)) {
                     addPrefetch(link.href);
                }
            }
        }, { passive: true });
    }

    // Idle Preloader (Optional: preload key nav items when idle)
    function setupIdlePreload() {
        if ('requestIdleCallback' in window) {
            requestIdleCallback(() => {
                // Preload high priority nav links (e.g. in header)
                const navLinks = document.querySelectorAll('header nav a, .nav-link');
                navLinks.forEach(link => {
                    if (link.hostname === window.location.hostname && !config.exclude.test(link.href)) {
                        addPrefetch(link.href);
                    }
                });
            });
        }
    }

    // Init
    if (document.readyState === 'complete') {
        setupInteraction();
        setTimeout(setupIdlePreload, 2000); // Delay idle load
    } else {
        window.addEventListener('load', () => {
            setupInteraction();
            setTimeout(setupIdlePreload, 2000);
        });
    }
})();
</script>
