{# =========================================================
   Mobile Bottom Bar — Dos acciones fijas en el pie
   Visible solo en móvil (< 768px)
   Estilo: Premium, acorde con floating-notice.njk desktop
   ========================================================= #}

<div class="fixed bottom-0 left-0 right-0 z-50 md:hidden flex items-stretch h-[64px] shadow-[0_-8px_32px_rgba(0,0,0,0.35)]">

  {# ── BOTÓN IZQUIERDO: Llamada directa ── #}
  <a href="tel:{{ metadata.contact.phoneNumber | replace(' ', '') }}"
     aria-label="Llamar al perito"
     class="group relative flex-1 flex flex-col items-center justify-center gap-0.5
            active:opacity-80 transition-opacity overflow-hidden"
     style="background: linear-gradient(135deg, #0891b2 0%, #06b6d4 60%, #22d3ee 100%);">

    {# Brillo superior #}
    <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/50 to-transparent pointer-events-none"></span>

    {# Icono + ping #}
    <span class="relative flex items-center justify-center">
      <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span class="absolute -top-0.5 -right-1.5 flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-80"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400 border-[1.5px] border-white"></span>
      </span>
    </span>

    {# Texto #}
    <span class="flex flex-col items-center leading-none mt-0.5">
      <span class="text-[9px] font-black uppercase tracking-[0.18em] text-cyan-100/80">Perito disponible</span>
      <span class="text-[12px] font-bold text-white leading-tight">{{ metadata.contact.floating_cta_text[lang] }}</span>
    </span>
  </a>

  {# Divisor central #}
  <span class="w-px bg-white/10 flex-shrink-0"></span>

  {# ── BOTÓN DERECHO: Abrir chatbot ── #}
  <button id="mobile-chat-trigger"
          type="button"
          aria-label="Abrir asistente técnico"
          class="group relative flex-1 flex flex-col items-center justify-center gap-0.5
                 bg-slate-900 active:bg-slate-800 transition-colors overflow-hidden cursor-pointer border-0">

    {# Brillo superior #}
    <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent pointer-events-none"></span>

    {# Icono + badge AI #}
    <span class="relative flex items-center justify-center">
      <svg class="w-5 h-5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
      </svg>
      <span class="absolute -top-1 -right-2 flex items-center justify-center h-3.5 w-3.5 rounded-full bg-cyan-500 border border-slate-900">
        <span class="text-[6px] font-black text-white leading-none">AI</span>
      </span>
    </span>

    {# Texto #}
    <span class="flex flex-col items-center leading-none mt-0.5">
      <span class="text-[9px] font-black uppercase tracking-[0.18em] text-cyan-400/80">Asistente técnico</span>
      <span class="text-[12px] font-bold text-slate-100 leading-tight">Consulta por chat</span>
    </span>
  </button>

</div>

{# Ocultar el bubble nativo del chatbot también en móvil:
   el mobile-bar ya gestiona la acción de chat #}
<style>
  @media (max-width: 767px) {
    #chat-button { display: none !important; }
  }
</style>

<script>
  (function () {
    const mobileChat = document.getElementById('mobile-chat-trigger');
    if (!mobileChat) return;
    mobileChat.addEventListener('touchstart', function () {
      const nativeBtn = document.getElementById('chat-button');
      if (nativeBtn) nativeBtn.dispatchEvent(new MouseEvent('mouseover', { bubbles: true }));
    }, { passive: true });
    mobileChat.addEventListener('click', function () {
      const nativeBtn = document.getElementById('chat-button');
      if (nativeBtn) {
        nativeBtn.dispatchEvent(new MouseEvent('mouseover', { bubbles: true }));
        setTimeout(function () { nativeBtn.click(); }, 80);
      }
    });
  })();
</script>
