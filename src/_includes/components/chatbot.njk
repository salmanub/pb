{# 
  Componente Chatbot Perito.barcelona
  Sistema de triaje técnico y captura de leads
  Estilos: Solo Tailwind CSS
  
  Uso:
  {% include "components/chatbot.njk" %}
#}

{# Widget flotante del chatbot - Posicionado a la derecha, encima del botón de llamar #}
<div id="perito-chat-widget" class="fixed bottom-24 right-5 z-[9999] font-sans">
  {# Botón flotante #}
  <button 
    id="chat-button" 
    aria-label="Abrir chat de asistencia técnica"
    class="w-14 h-14 rounded-full bg-gradient-to-br from-cyan-600 to-cyan-700 border-0 cursor-pointer shadow-lg flex items-center justify-center transition-all duration-300 ease-out hover:scale-110 hover:shadow-xl hover:from-cyan-500 hover:to-cyan-600 active:scale-95 group"
  >
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 fill-white transition-transform duration-300 ease-out group-hover:scale-110 group-hover:rotate-12">
      <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/>
    </svg>
  </button>

  {# Ventana de chat #}
  <div 
    id="chat-window"
    class="hidden fixed bottom-[180px] right-5 w-[380px] h-[550px] max-h-[calc(100vh-200px)] bg-white rounded-xl shadow-2xl flex-col overflow-hidden opacity-0 translate-y-5 scale-95 transition-all duration-300"
  >
    {# Header del chat #}
    <div id="chat-resize-handle" class="hidden md:hidden w-full h-6 bg-gray-50 cursor-ns-resize flex items-center justify-center border-b border-gray-200 touch-none">
      <div class="w-10 h-1 bg-gray-300 rounded-full"></div>
    </div>
    <div class="bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-5 py-4 flex justify-between items-center flex-shrink-0">
      <div>
        <h3 class="m-0 text-base font-semibold leading-tight">Perito Barcelona</h3>
        <p class="m-0 mt-1 text-xs opacity-85 leading-tight">Asistente técnico</p>
      </div>
      <div class="flex items-center gap-2">
        <button 
          id="download-chat" 
          aria-label="Guardar conversación"
          title="Guardar conversación"
          class="bg-transparent border-0 text-white text-lg cursor-pointer p-0 w-8 h-8 flex items-center justify-center rounded transition-all duration-300 ease-out hover:bg-white/20 hover:scale-110"
        >
          ⬇️
        </button>
        <button 
          id="close-chat" 
          aria-label="Cerrar chat"
          class="bg-transparent border-0 text-white text-3xl cursor-pointer p-0 w-8 h-8 flex items-center justify-center rounded transition-all duration-300 ease-out hover:bg-white/20 hover:rotate-90"
        >
          &times;
        </button>
      </div>
    </div>

    {# Área de mensajes #}
    <div 
      id="chat-messages"
      class="flex-1 overflow-y-auto p-5 bg-gray-50 scroll-smooth scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-transparent"
    >
      {# Los mensajes se añaden dinámicamente via JavaScript #}
    </div>

    {# Input de chat #}
    <div class="p-4 bg-white border-t border-gray-200 flex gap-2 items-center flex-shrink-0">
      <input 
        type="text" 
        id="chat-input" 
        placeholder="Escribe tu mensaje..." 
        autocomplete="off"
        aria-label="Mensaje del chat"
        class="flex-1 border border-gray-300 rounded-full px-4 py-2.5 text-sm outline-none transition-all duration-300 ease-out focus:border-cyan-600 focus:shadow-md focus:shadow-cyan-100 disabled:bg-gray-100 disabled:cursor-not-allowed"
      >
      <button 
        id="send-button" 
        aria-label="Enviar mensaje"
        class="bg-cyan-600 text-white border-0 rounded-full w-10 h-10 min-w-[40px] cursor-pointer flex items-center justify-center flex-shrink-0 transition-all duration-300 ease-out hover:bg-cyan-700 hover:scale-110 hover:shadow-lg active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </button>
    </div>
  </div>
</div>

{# Estilos adicionales para animaciones y clases especiales #}
<style>
  /* ==========================================
     DESKTOP: SIDEBAR (DRAWER)
     ========================================== */
  @media (min-width: 769px) {
    #chat-window {
      position: fixed;
      top: 0;
      right: -450px; /* Oculto inicialmente */
      bottom: 0;
      width: 450px;
      height: 100vh;
      max-height: none;
      border-radius: 0;
      transform: none !important; /* Anular transformaciones previas */
      transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: -5px 0 25px rgba(0,0,0,0.15);
      z-index: 9999;
      display: flex !important; /* Siempre flex, controlado por posición */
      opacity: 1 !important;
    }

    #chat-window.open {
      right: 0;
    }

    /* Empujar el contenido de la web */
    body {
      transition: margin-right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    body.chat-open {
      margin-right: 450px;
      overflow-x: hidden; /* Evitar scroll horizontal durante la transición */
    }
  }

  /* ==========================================
     MOBILE: BOTTOM SHEET (RESIZABLE)
     ========================================== */
  @media (max-width: 768px) {
    #chat-window {
      position: fixed;
      top: auto;
      bottom: -100%; /* Oculto inicialmente */
      left: 0;
      right: 0;
      width: 100%;
      height: 50vh; /* Altura inicial */
      max-height: 90vh;
      min-height: 20vh;
      border-radius: 20px 20px 0 0;
      transform: none !important;
      transition: bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 10000;
      display: flex !important;
      opacity: 1 !important;
      box-shadow: 0 -5px 25px rgba(0,0,0,0.15);
    }

    #chat-window.open {
      bottom: 0;
    }

    #chat-window.resizing {
      transition: none !important; /* Sin transición durante el drag */
    }

    /* Mostrar el handle solo en móvil */
    #chat-resize-handle {
      display: flex !important;
    }

    /* Ajustar botón flotante en móvil */
    #perito-chat-widget {
      bottom: 20px;
      right: 20px;
    }
    
    /* Ocultar botón cuando el chat está abierto en móvil */
    body.chat-open #chat-button {
      display: none;
    }
  }

  /* ==========================================
     ANIMACIONES GENERALES
     ========================================== */
  
  /* Animación del pulso en el botón */
  @keyframes pulse-chat {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  #chat-button::before {
    content: '';
    position: absolute;
    top: -3px;
    right: -3px;
    width: 16px;
    height: 16px;
    background: #f59e0b;
    border-radius: 9999px;
    opacity: 0.5;
    animation: pulse-chat 2.5s ease-in-out infinite;
    transition: all 0.3s ease-out;
  }
  
  #chat-button:hover::before {
    animation-play-state: paused;
    opacity: 0;
  }

  /* Animación de mensajes */
  .message {
    animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Typing indicator */
  @keyframes bounce-dot {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-8px); }
  }

  .typing-indicator span {
    animation: bounce-dot 1.4s infinite ease-in-out;
  }
  .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }

  /* Loading spinner */
  #send-button.loading svg {
    animation: rotate 1.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media print {
    #perito-chat-widget { display: none !important; }
    body.chat-open { margin-right: 0 !important; }
  }
</style>

{# Script del chatbot #}
<script>
  // Configuración global del chatbot
  window.PERITO_CHATBOT_CONFIG = window.PERITO_CHATBOT_CONFIG || {
    apiUrl: '{{ chatbot.apiUrl | default("https://perito-barcelona-chatbot.prueba2.workers.dev/api/chat") }}',
    autoOpen: {{ chatbot.autoOpen | default("false") }},
    theme: '{{ chatbot.theme | default("dark") }}'
  };
  
  // Metadata global (para usar el teléfono en mensajes de error)
  window.PERITO_METADATA = window.PERITO_METADATA || {
    contact: {
      phoneNumber: '{{ metadata.contact.phoneNumber }}',
      email: '{{ metadata.contact.email }}'
    }
  };

  // Cargar el script del chatbot después de que la página haya cargado completamente
  window.addEventListener('load', function() {
    const script = document.createElement('script');
    script.src = '/assets/js/chatbot.js?v=2';
    script.defer = true;
    document.body.appendChild(script);
  });
</script>
