{# 
  Componente Chatbot Perito.barcelona
  Sistema de triaje técnico y captura de leads
  Estilos: Solo Tailwind CSS
  
  Uso:
  {% include "components/chatbot.njk" %}
#}

{# Widget flotante del chatbot - Posicionado a la derecha, encima del botón de llamar #}
<div id="perito-chat-widget" class="fixed bottom-4 right-4 md:bottom-6 md:right-6 z-[9999] font-sans">
  {# Botón flotante #}
  <button 
    id="chat-button" 
    aria-label="Abrir chat de asistencia técnica"
    class="w-14 h-14 md:w-16 md:h-16 lg:w-18 lg:h-18 xl:w-20 xl:h-20 rounded-full bg-gradient-to-br from-cyan-900 via-cyan-800 to-cyan-700 border-2 border-white/10 cursor-pointer shadow-2xl flex items-center justify-center transition-all duration-300 ease-out hover:scale-110 hover:shadow-cyan-900/50 hover:bg-cyan-800 active:scale-95 group relative"
    style="box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255,255,255,0.1) inset;"
  >
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 md:w-8 md:h-8 lg:w-9 lg:h-9 xl:w-10 xl:h-10 fill-white transition-all duration-300 ease-out group-hover:scale-110 group-hover:rotate-12">
      <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/>
    </svg>
    

  </button>

  {# Ventana de chat #}
  <div 
    id="chat-window"
    class="hidden fixed bottom-[180px] right-5 w-[380px] h-[550px] max-h-[calc(100vh-200px)] bg-white rounded-xl shadow-2xl flex-col overflow-hidden opacity-0 translate-y-5 scale-95 transition-all duration-300"
  >
    {# Header del chat #}
    <div id="chat-resize-handle" class="hidden md:hidden w-full h-6 bg-gray-50 cursor-ns-resize flex items-center justify-center border-b border-gray-200 touch-none">
      <div class="w-10 h-1 bg-gray-300 rounded-full"></div>
    </div>
    {# Header — gradiente premium acorde con los botones flotantes #}
    <div class="relative flex-shrink-0 px-5 py-4 flex justify-between items-center"
         style="background: linear-gradient(135deg, #0891b2 0%, #06b6d4 60%, #22d3ee 100%);">
      {# Brillo superior sutil #}
      <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/50 to-transparent pointer-events-none"></span>

      <div class="flex items-center gap-3">
        {# Avatar / icono AI #}
        <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-white/20 border border-white/30 flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </span>
        <div>
          <h3 class="m-0 text-[15px] font-bold text-white leading-tight tracking-tight">Perito Barcelona</h3>
          <p class="m-0 mt-0.5 text-[10px] font-black uppercase tracking-[0.18em] text-cyan-100/80 leading-tight">Asistente técnico · AI</p>
        </div>
      </div>

      <div class="flex items-center gap-1">
        {# Botones Desktop #}
        <div class="hidden md:flex items-center gap-1">
          <button
            id="restart-chat"
            type="button"
            aria-label="Reiniciar conversación"
            class="group relative bg-white/10 border border-white/20 text-white cursor-pointer w-8 h-8 flex items-center justify-center rounded-lg transition-colors duration-200 hover:bg-white/25"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
            <span class="absolute top-full mt-2 left-1/2 -translate-x-1/2 bg-slate-900 text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-50">
              Reiniciar
            </span>
          </button>
          <button
            id="download-chat"
            type="button"
            aria-label="Guardar conversación"
            class="group relative bg-white/10 border border-white/20 text-white cursor-pointer w-8 h-8 flex items-center justify-center rounded-lg transition-colors duration-200 hover:bg-white/25"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="absolute top-full mt-2 left-1/2 -translate-x-1/2 bg-slate-900 text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-50">
              Guardar
            </span>
          </button>
        </div>

        {# Menú móvil #}
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Opciones"
          class="md:hidden bg-white/10 border border-white/20 text-white cursor-pointer w-8 h-8 flex items-center justify-center rounded-lg transition-colors duration-200 hover:bg-white/25"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="1"></circle>
            <circle cx="12" cy="5" r="1"></circle>
            <circle cx="12" cy="19" r="1"></circle>
          </svg>
        </button>

        {# Cerrar #}
        <button
          id="close-chat"
          aria-label="Cerrar chat"
          class="bg-white/10 border border-white/20 text-white cursor-pointer w-8 h-8 flex items-center justify-center rounded-lg transition-colors duration-200 hover:bg-white/25 text-lg font-light leading-none"
        >
          &times;
        </button>
      </div>
    </div>

    {# Menú de opciones móvil (Overlay) #}
    <div id="mobile-options-menu" class="hidden absolute top-[60px] right-0 left-0 bg-white border-b border-gray-200 shadow-lg z-50 flex-col p-2 animate-in slide-in-from-top-2 duration-200 md:hidden">
      <button id="mobile-restart" class="w-full text-left px-4 py-3 text-slate-700 hover:bg-slate-50 rounded-lg flex items-center gap-3 transition-colors">
        <div class="w-8 h-8 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
        </div>
        <span class="font-medium">Reiniciar conversación</span>
      </button>
      <button id="mobile-download" class="w-full text-left px-4 py-3 text-slate-700 hover:bg-slate-50 rounded-lg flex items-center gap-3 transition-colors">
        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        </div>
        <span class="font-medium">Guardar historial</span>
      </button>
    </div>

    {# Área de mensajes #}
    <div
      id="chat-messages"
      class="flex-1 overflow-y-auto p-5 scroll-smooth"
      style="background: #f8fafc;"
    >
      {# Los mensajes se añaden dinámicamente via JavaScript #}
    </div>

    {# Input de chat — estilo oscuro premium #}
    <div class="px-4 py-3 flex gap-2 items-center flex-shrink-0 border-t border-slate-100" style="background:#fff;">
      <input
        type="text"
        id="chat-input"
        placeholder="Escribe tu consulta..."
        autocomplete="off"
        aria-label="Mensaje del chat"
        class="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 outline-none transition-all duration-300 focus:border-cyan-500 focus:bg-white focus:shadow-[0_0_0_3px_rgba(6,182,212,0.15)] placeholder:text-slate-400 disabled:opacity-50 disabled:cursor-not-allowed"
      >
      <button
        id="send-button"
        aria-label="Enviar mensaje"
        class="flex-shrink-0 w-10 h-10 min-w-[40px] rounded-xl border-0 cursor-pointer flex items-center justify-center transition-all duration-300 hover:scale-105 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:scale-100"
        style="background: linear-gradient(135deg, #0891b2, #22d3ee); box-shadow: 0 4px 14px rgba(6,182,212,0.4);"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </button>
    </div>

    {# Créditos de agencia #}
    <div class="chat-powered-by">
      <span>⚡ Tecnología por </span>
      <a href="https://growleads.es" target="_blank" rel="noopener">Grow Leads</a>
    </div>

    {# Modal reinicio #}
    <div id="restart-confirm-modal" class="hidden absolute inset-0 z-50 flex flex-col items-center justify-center p-6 text-center backdrop-blur-sm" style="background:rgba(15,23,42,0.85);">
      <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4" style="background:rgba(6,182,212,0.15); border:1px solid rgba(6,182,212,0.3);">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
      </div>
      <h4 class="text-base font-bold text-white mb-1">¿Reiniciar conversación?</h4>
      <p class="text-sm text-slate-400 mb-5">Se perderá el historial actual.</p>
      <div class="flex gap-2 w-full">
        <button id="cancel-restart" class="flex-1 px-4 py-2.5 bg-slate-700 border border-slate-600 text-slate-200 rounded-xl text-sm font-medium hover:bg-slate-600 transition-colors cursor-pointer">Cancelar</button>
        <button id="confirm-restart" class="flex-1 px-4 py-2.5 text-white rounded-xl text-sm font-bold cursor-pointer transition-all hover:opacity-90" style="background:linear-gradient(135deg,#0891b2,#22d3ee);">Reiniciar</button>
      </div>
    </div>

    {# Modal descarga #}
    <div id="download-confirm-modal" class="hidden absolute inset-0 z-50 flex flex-col items-center justify-center p-6 text-center backdrop-blur-sm" style="background:rgba(15,23,42,0.85);">
      <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4" style="background:rgba(6,182,212,0.15); border:1px solid rgba(6,182,212,0.3);">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      </div>
      <h4 class="text-base font-bold text-white mb-1">¿Guardar conversación?</h4>
      <p class="text-sm text-slate-400 mb-5">Se descarga el historial como archivo de texto.</p>
      <div class="flex gap-2 w-full">
        <button id="cancel-download" class="flex-1 px-4 py-2.5 bg-slate-700 border border-slate-600 text-slate-200 rounded-xl text-sm font-medium hover:bg-slate-600 transition-colors cursor-pointer">Cancelar</button>
        <button id="confirm-download" class="flex-1 px-4 py-2.5 text-white rounded-xl text-sm font-bold cursor-pointer transition-all hover:opacity-90" style="background:linear-gradient(135deg,#0891b2,#22d3ee);">Descargar</button>
      </div>
    </div>
  </div>
</div>

{# Estilos adicionales para animaciones y clases especiales #}
<style>
  .chat-powered-by {
    font-size: 12px;
    text-align: center;
    color: #94a3b8;
    padding-bottom: 4px; /* Pegado al fondo */
    background: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    letter-spacing: 0.5px;
  }

  .chat-powered-by a {
    color: #64748b;
    text-decoration: none;
    font-weight: 700;
  }

  .chat-powered-by a:hover {
    color: #475569;
  }

  /* ==========================================
     DESKTOP: SIDEBAR (DRAWER)
     ========================================== */
  @media (min-width: 769px) {
    #chat-window {
      position: fixed;
      top: 0;
      right: -450px; /* Oculto inicialmente */
      bottom: 0;
      width: 450px;
      height: 100vh;
      max-height: none;
      border-radius: 0;
      transform: none !important; /* Anular transformaciones previas */
      transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: -5px 0 25px rgba(0,0,0,0.15);
      z-index: 9999;
      display: flex !important; /* Siempre flex, controlado por posición */
      opacity: 1 !important;
    }

    #chat-window.open {
      right: 0;
    }

    /* Empujar el contenido al abrir el chat */
    body {
      transition: margin-right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body.chat-open {
      margin-right: 450px;
      overflow-x: hidden;
    }
  }

  /* ==========================================
     MOBILE: BOTTOM SHEET (RESIZABLE)
     ========================================== */
  @media (max-width: 768px) {
    #chat-window {
      position: fixed;
      top: auto;
      bottom: -100%; /* Oculto inicialmente */
      left: 0;
      right: 0;
      width: 100%;
      height: 95vh; /* Altura inicial */
      max-height: 95vh;
      min-height: 20vh;
      border-radius: 20px 20px 0 0;
      transform: none !important;
      transition: bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 10000;
      display: flex !important;
      opacity: 1 !important;
      box-shadow: 0 -5px 25px rgba(0,0,0,0.15);
    }

    #chat-window.open {
      bottom: 0;
    }

    #chat-window.resizing {
      transition: none !important; /* Sin transición durante el drag */
    }

    /* Mostrar el handle solo en móvil */
    #chat-resize-handle {
      display: flex !important;
    }

    /* Ajustar botón flotante en móvil */
    #perito-chat-widget {
      bottom: 20px;
      right: 20px;
    }
    
    /* Ocultar botón cuando el chat está abierto en móvil */
    body.chat-open #chat-button {
      display: none;
    }
  }

  /* ==========================================
     ANIMACIONES GENERALES
     ========================================== */
  
  /* Animación del pulso en el botón */
  @keyframes pulse-chat {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  #chat-button::before {
    content: '';
    position: absolute;
    top: -3px;
    right: -3px;
    width: 16px;
    height: 16px;
    background: #f59e0b;
    border-radius: 9999px;
    opacity: 0.5;
    animation: pulse-chat 2.5s ease-in-out infinite;
    transition: all 0.3s ease-out;
  }
  
  #chat-button:hover::before {
    animation-play-state: paused;
    opacity: 0;
  }

  /* Animación de mensajes */
  .message {
    animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Typing indicator */
  @keyframes bounce-dot {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-8px); }
  }

  .typing-indicator span {
    animation: bounce-dot 1.4s infinite ease-in-out;
  }
  .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }

  /* Loading spinner */
  #send-button.loading svg {
    animation: rotate 1.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media print {
    #perito-chat-widget { display: none !important; }
    body.chat-open { margin-right: 0 !important; }
  }
</style>

{# Script del chatbot #}
<script>
  // Configuración global del chatbot
  window.PERITO_CHATBOT_CONFIG = window.PERITO_CHATBOT_CONFIG || {
    apiUrl: '{{ chatbot.apiUrl | default("https://perito-barcelona-chatbot.prueba2.workers.dev/api/chat") }}',
    autoOpen: {{ chatbot.autoOpen | default("false") }},
    theme: '{{ chatbot.theme | default("dark") }}'
  };
  
  // Metadata global (para usar el teléfono en mensajes de error)
  window.PERITO_METADATA = window.PERITO_METADATA || {
    contact: {
      phoneNumber: '{{ metadata.contact.phoneNumber }}',
      email: '{{ metadata.contact.email }}'
    }
  };

  // Cargador diferido e interactivo del chatbot
  window.addEventListener('DOMContentLoaded', function() {
    const chatButton = document.getElementById('chat-button');
    const talkToExpertBtns = document.querySelectorAll('.talk-to-expert-btn'); // Si existen otros botones disparadores
    let isScriptLoaded = false;
    let isScriptLoading = false;

    // Función para cargar el script
    function loadChatbotScript(callback) {
      if (isScriptLoaded) {
        if (callback) callback();
        return;
      }
      
      if (isScriptLoading) return; // Evitar doble carga
      isScriptLoading = true;

      const script = document.createElement('script');
      script.src = '/assets/js/chatbot.js?v=3';
      script.defer = true;
      script.onload = function() {
        isScriptLoaded = true;
        isScriptLoading = false;
        // console.log('Chatbot script loaded via interaction');
        if (callback) callback();
      };
      
      document.body.appendChild(script);
    }

    // Inicialización
    // 1. Si está configurado autoOpen, cargar inmediatamente (pero esperar idle si es posible)
    if (window.PERITO_CHATBOT_CONFIG.autoOpen) {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => loadChatbotScript());
      } else {
        setTimeout(loadChatbotScript, 2000);
      }
    } else {
      // 2. Si no, cargar al interactuar
      
      // Preload en mouseover para que esté listo al hacer clic
      const preloadOnHover = () => {
        loadChatbotScript();
        chatButton.removeEventListener('mouseover', preloadOnHover);
      };
      
      if (chatButton) {
        chatButton.addEventListener('mouseover', preloadOnHover);
        
        // Cargar y abrir al click
        chatButton.addEventListener('click', (e) => {
          if (!isScriptLoaded) {
            e.preventDefault(); // Evitar comportamiento default si el script no está
            // Mostrar estado de carga visual si fuera necesario
            loadChatbotScript(() => {
              // Una vez cargado, si el script no maneja el click automáticamente, 
              // el usuario tendrá que hacer clic de nuevo o podemos disparar un evento
              // Pero normalmente el script se inicializa y bindeara sus eventos.
              // Simulamos el click de nuevo o dejamos que el usuario lo haga?
              // Mejor: el script del chatbot debería comprobar si el chat-window está oculto y abrirlo al init si se le indica
              // O simplemente esperamos que el usuario haga click. 
              // Dado que el botón ya existe, el script del chatbot probablemente se ata a él.
              // Vamos a despachar un click manual después de cargar?
              // Riesgo de bucle. Mejor dejamos que cargue.
              // Opcional: chatButton.click(); 
            });
          }
        });
      }
      
      // Manejar otros botones (ej. "Hablar con un experto")
      talkToExpertBtns.forEach(btn => {
        btn.addEventListener('mouseover', preloadOnHover);
        btn.addEventListener('click', () => loadChatbotScript());
      });
    }
  });
</script>
