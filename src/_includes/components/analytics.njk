{% if metadata.site.googleAnalyticsId %}
<!-- Google Analytics 4 (Optimized for Performance) -->
<script>
    // Define dataLayer and the gtag function.
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}

    // Function to inject the GA script.
    function loadGA() {
        var script = document.createElement('script');
        script.src = "https://www.googletagmanager.com/gtag/js?id={{ metadata.site.googleAnalyticsId }}";
        script.async = true;
        document.head.appendChild(script);

        gtag('js', new Date());
        gtag('config', '{{ metadata.site.googleAnalyticsId }}');
    }

    // Optimization: Load GA only after user interaction or delay
    const loadEvents = ['mousedown', 'mousemove', 'keydown', 'scroll', 'touchstart'];
    let loaded = false;

    function triggerLoad() {
        if (loaded) return;
        loaded = true;
        
        // Clean up event listeners immediately
        loadEvents.forEach(e => window.removeEventListener(e, triggerLoad));

        // Use requestIdleCallback if available, otherwise run immediately
        if ('requestIdleCallback' in window) {
            requestIdleCallback(() => loadGA());
        } else {
            loadGA();
        }
    }

    // Add event listeners for user interaction
    loadEvents.forEach(e => window.addEventListener(e, triggerLoad, { passive: true }));

    // Fallback: load after 5 seconds if no interaction occurs
    setTimeout(triggerLoad, 5000);
</script>
{% endif %}