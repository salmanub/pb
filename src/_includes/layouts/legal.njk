{% extends "layouts/base.njk" %}

{% block content %}
<main itemscope itemtype="https://schema.org/WebPage">

    {# --- INICIO HERO PARA PÁGINAS LEGALES --- #}
    {# Hero con estilo similar a service-child.njk, pero más sobrio para contenido legal #}
    <header class="relative mt-[70px] md:mt-[90px] lg:mt-[120px] min-h-[320px] bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] text-white overflow-hidden isolate">
        <!-- Efectos decorativos modernos -->
        <div class="absolute inset-0">
            <!-- Patrón de puntos con mejor contraste -->
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <!-- Gradientes suaves -->
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <!-- Efecto de luz moderna - más sutil para contenido legal -->
            <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-cyan-400/15 blur-[100px] rounded-full"></div>
            <!-- Velo sutil para mejorar legibilidad -->
            <div class="absolute inset-0 bg-gradient-to-b from-slate-900/10 to-slate-900/20 mix-blend-overlay"></div>
        </div>
        
        <div class="relative z-10 container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="py-16 lg:py-20 max-w-4xl">
                {% if hero and hero.title %}
                    <h1 class="text-3xl md:text-4xl lg:text-5xl font-light text-white leading-tight" itemprop="headline">{{ hero.title }}</h1>
                {% else %}
                    <h1 class="text-3xl md:text-4xl lg:text-5xl font-light text-white leading-tight" itemprop="headline">{{ title }}</h1>
                {% endif %}
                
                {% if hero and hero.subtitle %}
                    <p class="mt-4 text-lg md:text-xl text-cyan-300">{{ hero.subtitle }}</p>
                {% endif %}
                
                {% if hero and hero.lastUpdated %}
                    <p class="mt-8 text-sm text-white/60 flex items-center">
                        <svg class="w-4 h-4 mr-2 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        {{ hero.lastUpdated }}
                    </p>
                {% endif %}
            </div>
        </div>
    </header>
    {# --- FIN HERO PARA PÁGINAS LEGALES --- #}

    {# --- INICIO CONTENIDO PRINCIPAL DEL TEXTO LEGAL --- #}
    <article class="py-16 lg:py-24 bg-white" itemprop="mainContentOfPage">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            {# Contenedor centrado y con ancho máximo para facilitar la lectura #}
            <div class="prose prose-lg max-w-4xl mx-auto">
                {{ content | safe }}
            </div>
        </div>
    </article>
    {# --- FIN CONTENIDO PRINCIPAL --- #}

</main>
{% endblock %}


{% block pageStyles %}
{# Heredamos los estilos principales y añadimos estilos específicos para el 'prose' de textos legales #}
{% set baseCss %} {% include "dist/assets/styles/index.css" %} {% endset %}
<style>
{{ baseCss | safe }}

.prose {
    @apply text-slate-700 max-w-none text-base leading-relaxed;
}

.prose h3 {
    @apply text-xl font-bold text-slate-800 mt-10 mb-4 border-b border-slate-200 pb-2;
}

.prose h4 {
    @apply text-lg font-semibold text-slate-700 mt-8 mb-3;
}

.prose p {
    @apply mb-4;
}

.prose ul {
    @apply list-disc pl-6 space-y-2 my-6;
}

.prose ol {
    @apply list-decimal pl-6 space-y-2 my-6;
}

.prose a {
    @apply text-cyan-600 hover:text-cyan-700 underline;
}

.prose strong {
    @apply font-semibold text-slate-800;
}

</style>
{% endblock %}