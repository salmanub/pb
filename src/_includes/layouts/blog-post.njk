{% extends "layouts/base.njk" %}

{% block content %}
<article class="pt-[70px] lg:pt-[120px]" itemscope itemtype="https://schema.org/Article">
    
    <!-- Schema microdata oculto -->
    <div hidden>
        <meta itemprop="headline" content="{{ title | truncate(110) }}">
        <meta itemprop="description" content="{{ description }}">
        <meta itemprop="mainEntityOfPage" content="{{ metadata.site.url }}{{ page.url }}">
        <meta itemprop="datePublished" content="{{ datePublished }}T00:00:00+01:00">
        <meta itemprop="dateModified" content="{{ dateModified }}T00:00:00+01:00">
        {% if tags and tags.length > 0 %}<meta itemprop="keywords" content="{{ tags | join(', ') }}">{% endif %}
        <meta itemprop="inLanguage" content="{{ lang }}">
        <meta itemprop="isAccessibleForFree" content="True">
        
        <!-- Author -->
        <span itemprop="author" itemscope itemtype="https://schema.org/Person">
            <meta itemprop="name" content="{{ author }}">
            <meta itemprop="url" content="{{ metadata.author.linkedin }}">
        </span>
        
        <!-- Image -->
        {% if image %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ image.url }}">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}{{ image.url }}">
            <meta itemprop="caption" content="{{ image.caption | default('Imagen del artículo: ' + title) }}">
            <meta itemprop="width" content="1200">
            <meta itemprop="height" content="675">
        </span>
        {% else %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="caption" content="Logo de {{ metadata.site.title }}">
            <meta itemprop="width" content="600">
            <meta itemprop="height" content="60">
        </span>
        {% endif %}
    </div>
    
    <!-- Hero Section -->
    <header class="bg-gradient-to-br from-slate-50 to-white py-12 px-4 md:px-[5%] shadow-sm">
        <div class="max-w-[900px] mx-auto">
            <!-- Breadcrumbs -->
            <nav aria-label="Breadcrumb" class="mb-6">
                <ol class="flex items-center gap-2 text-sm text-slate-600" itemscope itemtype="https://schema.org/BreadcrumbList">
                    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <a href="/" class="hover:text-cyan-600 transition-colors" itemprop="item">
                            <span itemprop="name">Inicio</span>
                        </a>
                        <meta itemprop="position" content="1">
                    </li>
                    <li>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </li>
                    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <a href="/blog/" class="hover:text-cyan-600 transition-colors" itemprop="item">
                            <span itemprop="name">Blog</span>
                        </a>
                        <meta itemprop="position" content="2">
                    </li>
                    <li>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </li>
                    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <span class="text-slate-800 font-medium" itemprop="name">{{ title }}</span>
                        <meta itemprop="position" content="3">
                    </li>
                </ol>
            </nav>

            <!-- Category Badge -->
            {% if category %}
            <div class="mb-4">
                <span class="inline-block px-3 py-1 bg-cyan-500 text-white text-sm font-semibold rounded-full">
                    {{ category }}
                </span>
            </div>
            {% endif %}

            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4 leading-tight" itemprop="headline name">
                {{ title }}
            </h1>

            <!-- Meta Info -->
            <div class="flex flex-wrap items-center gap-4 text-slate-600 mb-6">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <time datetime="{{ datePublished }}T00:00:00+01:00">
                        {{ datePublished }}
                    </time>
                </div>
                
                {% if dateModified and dateModified != datePublished %}
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                    <time datetime="{{ dateModified }}T00:00:00+01:00">
                        Actualizado: {{ dateModified }}
                    </time>
                </div>
                {% endif %}

                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <span>{{ author }}</span>
                </div>
            </div>

            <!-- Excerpt -->
            {% if excerpt %}
            <p class="text-lg text-slate-600 italic border-l-4 border-cyan-500 pl-4">
                {{ excerpt }}
            </p>
            {% endif %}

            <!-- Featured Image -->
            {% if image %}
            <div class="mt-8">
                <figure class="relative group overflow-hidden rounded-xl shadow-lg bg-slate-900">
                    <img 
                        src="{{ image.url }}" 
                        alt="{{ image.alt }}" 
                        class="w-full aspect-[16/9] object-cover"
                        loading="lazy"
                        itemprop="url contentUrl">
                    {% if image.caption %}
                    <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-900/90 to-transparent p-4" itemprop="caption">
                        <p class="text-white text-sm">{{ image.caption }}</p>
                    </figcaption>
                    {% endif %}
                </figure>
            </div>
            {% endif %}

            <!-- Tags -->
            {% if tags and tags.length > 0 %}
            <div class="mt-6 flex flex-wrap gap-2">
                {% for tag in tags %}
                <span class="text-xs px-3 py-1 bg-slate-100 text-slate-700 rounded-full" itemprop="keywords">
                    #{{ tag }}
                </span>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </header>

    <!-- Main Content -->
    <article class="py-16 bg-white" itemprop="articleBody">
        <div class="max-w-[900px] mx-auto px-4 sm:px-8 md:px-12">
            <div class="prose prose-lg max-w-none" itemprop="text">
                {% if content %}
                    {{ content | safe }}
                {% else %}
                    <div class="bg-red-50 p-4 rounded-md">
                        <p class="text-red-600">No se encontró contenido para este artículo.</p>
                    </div>
                {% endif %}
            </div>

            <!-- Related Services CTA -->
            {% if relatedServices and relatedServices.length > 0 %}
            <div class="mt-16 p-8 bg-gradient-to-br from-slate-50 to-white rounded-2xl border border-slate-100 shadow-lg text-center">
                <h3 class="text-2xl font-bold text-slate-800 mb-4">¿Necesita ayuda profesional con este tema?</h3>
                <p class="text-lg text-slate-600 mb-6">
                    Ofrecemos servicios especializados en:
                </p>
                <div class="flex flex-wrap gap-3 justify-center mb-8">
                    {% for service in relatedServices %}
                    <a href="{{ service.url }}" class="inline-flex items-center px-4 py-2 bg-cyan-100 text-cyan-700 font-semibold rounded-lg hover:bg-cyan-200 transition-colors">
                        {{ service.title }}
                        <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                    {% endfor %}
                </div>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/contacto/" class="inline-flex items-center justify-center px-8 py-4 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 shadow-md hover:shadow-lg transition-all group">
                        Solicitar Presupuesto
                        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </a>
                    <a href="tel:+34932123456" class="inline-flex items-center justify-center px-8 py-4 border-2 border-cyan-500 text-cyan-600 font-semibold rounded-lg hover:bg-cyan-50 hover:text-cyan-700 transition-all">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        Llamar Ahora
                    </a>
                </div>
            </div>
            {% endif %}

            <!-- Back to Blog -->
            <div class="mt-12 text-center">
                <a href="/blog/" class="inline-flex items-center text-slate-600 hover:text-cyan-600 font-medium transition-colors group">
                    <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
                    </svg>
                    Volver al Blog
                </a>
            </div>
        </div>
    </article>
</article>
{% endblock %}

{% block pageStyles %}
{% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
<style>
    {{ indexCSS | safe }}

    /* Estilos mejorados para el contenido del blog */
    .prose {
        @apply text-slate-600 max-w-none text-lg leading-relaxed;
    }

    .prose h2 {
        @apply text-3xl md:text-4xl font-light text-slate-800 mt-16 mb-10;
        background: linear-gradient(to right, #0891b2, #0e7490);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .prose h3 {
        @apply text-2xl font-semibold text-slate-700 mt-12 mb-6;
        border-bottom: 2px solid #06b6d4;
        display: inline-block;
    }

    .prose p {
        @apply mb-6 text-slate-600;
    }

    .prose strong {
        @apply font-semibold text-cyan-700 bg-cyan-50 px-1 rounded;
    }

    .prose ul {
        @apply my-8 space-y-4;
    }

    .prose li {
        @apply relative py-3 pl-6 pr-4 rounded-lg;
        background: linear-gradient(to right, rgba(8, 145, 178, 0.05) 0%, transparent 100%);
    }

    .prose a {
        @apply text-cyan-600 font-medium hover:text-cyan-700 transition-colors;
    }
</style>
{% endblock %}
