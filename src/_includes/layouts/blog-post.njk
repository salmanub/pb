{% extends "layouts/base.njk" %}

{% block content %}
<article class="pt-[70px] lg:pt-[120px]" itemscope itemtype="https://schema.org/Article">
    
    <!-- Schema microdata oculto -->
    <div hidden>
        <meta itemprop="headline" content="{{ title | truncate(110) }}">
        <meta itemprop="description" content="{{ description }}">
        <meta itemprop="mainEntityOfPage" content="{{ metadata.site.url }}{{ page.url }}">
        <meta itemprop="datePublished" content="{{ datePublished }}T00:00:00+01:00">
        <meta itemprop="dateModified" content="{{ dateModified }}T00:00:00+01:00">
        {% if tags and tags.length > 0 %}<meta itemprop="keywords" content="{{ tags | join(', ') }}">{% endif %}
        <meta itemprop="inLanguage" content="{{ lang }}">
        <meta itemprop="isAccessibleForFree" content="True">
        
        <!-- Author -->
        <span itemprop="author" itemscope itemtype="https://schema.org/Person">
            <meta itemprop="name" content="{{ author }}">
            <meta itemprop="url" content="{{ metadata.author.linkedin }}">
        </span>
        
        <!-- Image -->
        {% if image %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ image.url }}">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}{{ image.url }}">
            <meta itemprop="caption" content="{{ image.caption | default('Imagen del artículo: ' + title) }}">
            <meta itemprop="width" content="1200">
            <meta itemprop="height" content="675">
        </span>
        {% else %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="caption" content="Logo de {{ metadata.site.title }}">
            <meta itemprop="width" content="600">
            <meta itemprop="height" content="60">
        </span>
        {% endif %}
    </div>
    
    <!-- Hero Section -->
    <header class="relative bg-white py-24 md:py-32 px-6 md:px-12 lg:px-16 overflow-hidden">
        <!-- Background Elements -->
         <div class="absolute inset-0 z-0">
             <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-50 skew-x-[-12deg] translate-x-1/4 origin-top"></div>
             <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-white to-transparent"></div>
         </div>

        <div class="w-full relative z-10 max-w-5xl mx-auto text-center md:text-left">
            <!-- Breadcrumbs -->
            <div class="flex justify-center md:justify-start mb-8">
            {% set parentService = {
                "title": "Blog",
                "url": "/blog/"
            } %}
            {% include "partials/breadcrumb.njk" %}
            </div>

            <!-- Category Badge -->
            {% if category %}
            <div class="mb-8 flex justify-center md:justify-start">
                <span class="inline-block px-4 py-1.5 bg-cyan-50 border border-cyan-100 text-cyan-700 text-xs font-bold uppercase tracking-widest rounded-full">
                    {{ category }}
                </span>
            </div>
            {% endif %}

            <!-- Title -->
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 mb-8 leading-[1.1] tracking-tighter" itemprop="headline name">
                {{ title }}
            </h1>

            <!-- Meta Info -->
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-6 text-slate-500 mb-10 text-sm font-medium">
                <div class="flex items-center gap-2 bg-slate-50 px-3 py-1 rounded-full border border-slate-100">
                    <svg class="w-4 h-4 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <time datetime="{{ datePublished }}T00:00:00+01:00" class="uppercase tracking-wide">
                        {{ datePublished }}
                    </time>
                </div>
                
                <div class="flex items-center gap-2">
                    <span class="w-8 h-8 rounded-full bg-cyan-500 flex items-center justify-center text-white text-xs font-bold">
                        {{ author | first }}
                    </span>
                    <span itemprop="author" itemscope itemtype="https://schema.org/Person" class="text-slate-700 font-bold">
                        <span itemprop="name">{{ author }}</span>
                        <meta itemprop="url" content="{{ metadata.author.linkedin }}">
                    </span>
                </div>
            </div>

            <!-- Excerpt -->
            {% if excerpt %}
            <p class="text-xl md:text-2xl text-slate-600 font-light leading-relaxed mb-0 pl-0 md:pl-6 md:border-l-4 border-cyan-500 max-w-3xl">
                {{ excerpt }}
            </p>
            {% endif %}
        </div>
    </header>
    
    <!-- Image Section - Full Width Container -->
    <div class="w-full px-6 md:px-12 lg:px-16 mb-16 md:mb-24">
         <div class="relative w-full max-w-6xl mx-auto aspect-[21/9] rounded-[2rem] overflow-hidden shadow-2xl shadow-slate-200">
             {% set imgSrc = image.url if image else (post.image.url if post.image else metadata.site.placeholderImage) %}
             {% set imgAlt = image.alt if image else (post.image.alt if post.image else 'Imagen del artículo') %}
             {% set imgCaption = image.caption if image else (post.image.caption if post.image else '') %}
             
             {# Extraer el path completo y nombre sin extensión #}
             {% set imgPath = imgSrc | replace(".jpg", "") | replace(".jpeg", "") | replace(".png", "") | replace(".JPG", "") | replace(".JPEG", "") | replace(".PNG", "") %}
             {# Manejar rutas que empiezan con src/ o con / #}
             {% set imgRelativePath = imgPath.split("/assets/images/")[1] if "/assets/images/" in imgPath else imgPath %}
             {% set imgBasePath = "/assets/images/optimized/" + imgRelativePath %}
             
             <picture>
                 {% if "placeholder" in imgRelativePath %}
                 <source 
                     srcset="{{ imgBasePath }}-320w.avif 320w, {{ imgBasePath }}-640w.avif 640w, {{ imgBasePath }}-1024w.avif 1024w"
                     sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1400px"
                     type="image/avif">
                 <source 
                     srcset="{{ imgBasePath }}-320w.webp 320w, {{ imgBasePath }}-640w.webp 640w, {{ imgBasePath }}-1024w.webp 1024w"
                     sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1400px"
                     type="image/webp">
                 <source 
                     srcset="{{ imgBasePath }}-320w.jpeg 320w, {{ imgBasePath }}-640w.jpeg 640w, {{ imgBasePath }}-1024w.jpeg 1024w"
                     sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1400px"
                     type="image/jpeg">
                 <img 
                     src="{{ imgBasePath }}-1024w.jpeg" 
                     alt="{{ imgAlt }}" 
                     class="w-full h-full object-cover"
                     width="1200"
                     height="675"
                     loading="eager"
                     fetchpriority="high"
                     decoding="async"
                     itemprop="url contentUrl">
                 {% else %}
                 <source 
                     srcset="{{ imgBasePath }}-320w.avif 320w, {{ imgBasePath }}-640w.avif 640w, {{ imgBasePath }}-1024w.avif 1024w, {{ imgBasePath }}-1280w.avif 1280w, {{ imgBasePath }}-1920w.avif 1920w"
                     sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1400px"
                     type="image/avif">
                 <source 
                     srcset="{{ imgBasePath }}-320w.webp 320w, {{ imgBasePath }}-640w.webp 640w, {{ imgBasePath }}-1024w.webp 1024w, {{ imgBasePath }}-1280w.webp 1280w, {{ imgBasePath }}-1920w.webp 1920w"
                     sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1400px"
                     type="image/webp">
                 <source 
                     srcset="{{ imgBasePath }}-320w.jpeg 320w, {{ imgBasePath }}-640w.jpeg 640w, {{ imgBasePath }}-1024w.jpeg 1024w, {{ imgBasePath }}-1280w.jpeg 1280w, {{ imgBasePath }}-1920w.jpeg 1920w"
                     sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1400px"
                     type="image/jpeg">
                 <img 
                     src="{{ imgBasePath }}-1024w.jpeg" 
                     alt="{{ imgAlt }}" 
                     class="w-full h-full object-cover"
                     width="1200"
                     height="675"
                     loading="eager"
                     fetchpriority="high"
                     decoding="async"
                     itemprop="url contentUrl">
                 {% endif %}
             </picture>
             <div class="absolute inset-0 bg-gradient-to-t from-slate-900/50 to-transparent"></div>
             {% if imgCaption %}
             <figcaption class="absolute bottom-6 right-6 px-4 py-2 bg-black/50 backdrop-blur-md rounded-lg text-white text-xs font-medium tracking-wide" itemprop="caption">
                 {{ imgCaption }}
             </figcaption>
             {% endif %}
         </div>
    </div>

    <!-- Main Content -->
    <article class="bg-white pb-24" itemprop="articleBody">
        <div class="w-full px-6 md:px-12 lg:px-16">
            <div class="prose prose-lg prose-slate max-w-3xl mx-auto" itemprop="text">
                {% if content %}
                    {{ content | safe }}
                {% else %}
                    <div class="bg-red-50 p-6 rounded-2xl border border-red-100">
                        <p class="text-red-600 font-medium">No se encontró contenido para este artículo.</p>
                    </div>
                {% endif %}
            </div>

            <!-- Related Services CTA -->
            {% if relatedServices and relatedServices.length > 0 %}
            <div class="max-w-4xl mx-auto mt-20 p-10 bg-gradient-to-br from-slate-900 to-slate-800 rounded-[2.5rem] shadow-2xl shadow-slate-200 text-center relative overflow-hidden">
                <!-- Decorative -->
                <div class="absolute top-0 right-0 w-64 h-64 bg-cyan-500/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
                <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

                <div class="relative z-10">
                    <h3 class="text-3xl font-bold text-white mb-6">¿Necesita ayuda profesional con este tema?</h3>
                    <p class="text-lg text-slate-300 mb-8 max-w-2xl mx-auto">
                        Ofrecemos servicios especializados y asesoría técnica personalizada.
                    </p>
                    <div class="flex flex-wrap gap-3 justify-center mb-10">
                        {% for service in relatedServices %}
                        <a href="{{ service.url }}" class="inline-flex items-center px-5 py-2.5 bg-white/10 text-cyan-300 font-semibold rounded-full hover:bg-white/20 transition-colors border border-cyan-500/30 backdrop-blur-sm">
                            {{ service.title }}
                        </a>
                        {% endfor %}
                    </div>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="/contacto/" class="inline-flex items-center justify-center px-8 py-4 bg-cyan-500 text-white font-bold rounded-xl hover:bg-cyan-400 transition-colors shadow-lg shadow-cyan-500/30">
                            Solicitar Presupuesto
                        </a>
                        <a href="tel:+34932123456" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white/20 text-white font-bold rounded-xl hover:bg-white/5 hover:border-white/40 transition-all">
                            Llamar Ahora
                        </a>
                    </div>
                </div>
            </div>
            {% endif %}

            <!-- Back to Blog -->
            <div class="mt-16 text-center">
                <a href="/blog/" class="inline-flex items-center text-slate-500 hover:text-cyan-600 font-bold tracking-wider uppercase text-sm transition-colors group py-4 px-8 rounded-full hover:bg-slate-50">
                    <svg class="w-4 h-4 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
                    </svg>
                    Volver al Blog
                </a>
            </div>
        </div>
    </article>
</article>
{% endblock %}

{% block pageStyles %}
{% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
<style>
    {{ indexCSS | safe }}

    /* Estilos mejorados para el contenido del blog */
    .prose {
        @apply text-slate-600 max-w-none text-lg leading-relaxed;
    }

    .prose h2 {
        @apply text-3xl md:text-4xl font-light text-slate-800 mt-16 mb-10;
        background: linear-gradient(to right, #0891b2, #0e7490);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .prose h3 {
        @apply text-2xl font-semibold text-slate-700 mt-12 mb-6;
        border-bottom: 2px solid #06b6d4;
        display: inline-block;
    }

    .prose p {
        @apply mb-6 text-slate-600;
    }

    .prose strong {
        @apply font-semibold text-cyan-700 bg-cyan-50 px-1 rounded;
    }

    .prose ul {
        @apply my-8 space-y-4;
    }

    .prose li {
        @apply relative py-3 pl-6 pr-4 rounded-lg;
        background: linear-gradient(to right, rgba(8, 145, 178, 0.05) 0%, transparent 100%);
    }

    .prose a {
        @apply text-cyan-600 font-medium hover:text-cyan-700 transition-colors;
    }
</style>
{% endblock %}
