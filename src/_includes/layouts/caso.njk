---
layout: layouts/base.njk
---
{#
  caso.njk — DS-pixel-fiel (SiteBlog.jsx CasoDetalle)
  Clases CSS: .pagehero-grid .caso-tag .caso-resultado .caso-imp
             .method-grid--caso .fact-cell .caso-banner
             .caso-narrative .caso-eyebrow .phase-row
             .caso-norm .caso-related .caso-rel-card
             .band-cta--ink
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}
{% set _casosUrl = "/casos-exito/" if (not lang or lang == "es") else ("/en/success-cases/" if lang == "en" else "/ca/casos-d-exit/") %}
{% set _casosLabel = "Casos" if (not lang or lang == "es") else ("Cases" if lang == "en" else "Casos") %}
{% set _contactPro = "/contacto/profesional/" if (not lang or lang == "es") else ("/en/contact/professional/" if lang == "en" else "/ca/contacte/professional/") %}

{# Schema SEO invisible #}
<div itemscope itemtype="https://schema.org/Article" style="display:none;" aria-hidden="true"><meta itemprop="headline" content="{{ caso.title }}"><meta itemprop="description" content="{{ caso.description }}"><meta itemprop="url" content="{{ metadata.site.url }}{{ page.url }}"><meta itemprop="datePublished" content="{{ caso.datePublished }}"><meta itemprop="dateModified" content="{{ caso.dateModified }}"><div itemprop="author" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="{{ metadata.company.name }}"></div></div>

{# ── 1. HERO SECTION ── #}
<section style="max-width:var(--container-wide);margin:0 auto;padding:clamp(36px,6vw,84px) var(--gutter) var(--space-10);">

  {# Breadcrumb inline vía partial #}
  {% set breadcrumb_inline = true %}
  {% set breadcrumb_items = [
    { label: "Inicio", url: "/" },
    { label: _casosLabel, url: _casosUrl },
    { label: caso.category | default(caso.tags[0]) }
  ] %}
  {% include "partials/breadcrumb.njk" %}
  {% set breadcrumb_inline = false %}

  {# DS: grid 1fr auto — left: tag+resultado+H1+description | right: importe #}
  <div class="pagehero-grid">
    <div>
      {# Tag + resultado en fila #}
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
        <span class="caso-tag">{{ caso.category | default(caso.tags[0]) }}</span>
        {% if caso.summary %}{% set resultItem = null %}{% for s in caso.summary %}{% if s.label in ["Resultado","Result","Resultat"] and not resultItem %}{% set resultItem = s %}{% endif %}{% endfor %}{% if resultItem %}
        <span class="caso-resultado">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>{{ caso.resultado | default(resultItem.value) | truncate(50) }}
        </span>
        {% endif %}{% endif %}
      </div>
      {# H1 #}
      <h1 style="font-family:var(--font-serif);font-size:clamp(2rem,4vw,3.1rem);font-weight:var(--fw-regular);line-height:1.08;letter-spacing:var(--tracking-tight);color:var(--text-strong);margin:0;">{{ caso.title }}</h1>
      {# Lede = encargo #}
      <p style="margin:20px 0 0;font-size:var(--fs-lede);line-height:var(--lh-lede);color:var(--text-muted);max-width:58ch;">{{ caso.encargo | default(caso.description) }}</p>
    </div>
    {# Importe derecha #}
    {% if caso.amount and caso.amount != "—" %}
    <div class="caso-imp">
      <div class="caso-imp__label">Importe peritado</div>
      <div class="caso-imp__value">{{ caso.amount }}</div>
    </div>
    {% endif %}
  </div>
</section>

{# ── 2. FACTS STRIP 4-col (.method-grid--caso + .fact-cell) ── #}
<section style="max-width:var(--container-wide);margin:0 auto;padding:0 var(--gutter);">
  <div class="method-grid--caso">
    <div class="fact-cell">
      <div class="fact-cell__label">Cliente</div>
      <div class="fact-cell__value">{{ caso.cliente | default("—") }}</div>
    </div>
    <div class="fact-cell">
      <div class="fact-cell__label">Plazo de entrega</div>
      <div class="fact-cell__value">{{ caso.plazo | default("—") }}</div>
    </div>
    <div class="fact-cell">
      <div class="fact-cell__label">Jurisdicción</div>
      <div class="fact-cell__value">{{ caso.jurisdiccion | default("—") }}</div>
    </div>
    <div class="fact-cell">
      <div class="fact-cell__label">Resultado</div>
      <div class="fact-cell__value">{{ caso.resultado | default(caso.summary[3].value if caso.summary else "—") }}</div>
    </div>
  </div>
</section>

{# ── 3. IMAGEN 21/9 (.caso-banner max 1040px) ── #}
{% if caso.image and caso.image.url and "placeholder" not in caso.image.url %}
<div class="caso-banner">
  <img src="{{ caso.image.url }}" alt="{{ caso.image.alt | default(caso.title) }}" loading="lazy" decoding="async">
  {% if caso.image.caption %}<p style="margin-top:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:0.04em;color:var(--text-faint);">{{ caso.image.caption }}</p>{% endif %}
</div>
{% endif %}

{# ── 4. NARRATIVA PHASE 01-04 (.caso-narrative + .phase-row) ── #}
<section class="caso-narrative">
  <div class="caso-eyebrow">§ El caso, paso a paso</div>

  <div style="margin-top:var(--space-4);">
    {% if caso.encargo %}
    <div class="phase-row">
      <div class="phase-row__num">01</div>
      <div>
        <h3 class="phase-row__title">El encargo</h3>
        <p class="phase-row__body">{{ caso.encargo }}</p>
      </div>
    </div>
    {% endif %}

    {% if caso.instruccion %}
    <div class="phase-row">
      <div class="phase-row__num">02</div>
      <div>
        <h3 class="phase-row__title">La instrucción técnica</h3>
        <p class="phase-row__body">{{ caso.instruccion }}</p>
      </div>
    </div>
    {% endif %}

    {% if caso.dictamen %}
    <div class="phase-row">
      <div class="phase-row__num">03</div>
      <div>
        <h3 class="phase-row__title">El dictamen</h3>
        <p class="phase-row__body">{{ caso.dictamen }}</p>
      </div>
    </div>
    {% endif %}

    {% if caso.resultadoNarr %}
    <div class="phase-row">
      <div class="phase-row__num">04</div>
      <div>
        <h3 class="phase-row__title">El resultado</h3>
        <p class="phase-row__body">{{ caso.resultadoNarr }}</p>
      </div>
    </div>
    {% endif %}
  </div>

  {# ── 5. NORMATIVA (.caso-norm) ── #}
  {% if caso.tags %}
  <div class="caso-norm">
    <div class="caso-norm__label">Normativa y técnica aplicada</div>
    <div class="caso-norm__tags">
      {% for tag in caso.tags %}<span class="caso-norm__tag">{{ tag }}</span>{% endfor %}
    </div>
  </div>
  {% endif %}
</section>

{# ── 6. CASOS RELACIONADOS (.caso-related + .caso-rel-card × 3) ── #}
{% set allCasos = casosExito | sort(attribute="datePublished") | reverse %}
{% set relCount = 0 %}{% set rel1 = null %}{% set rel2 = null %}{% set rel3 = null %}
{% for c in allCasos %}{% if c.slug != caso.slug and relCount < 3 %}{% if relCount == 0 %}{% set rel1 = c %}{% elif relCount == 1 %}{% set rel2 = c %}{% else %}{% set rel3 = c %}{% endif %}{% set relCount = relCount + 1 %}{% endif %}{% endfor %}

{% if relCount > 0 %}
<section class="caso-related">
  <div class="caso-related__head">
    <div>
      <div class="caso-related__eyebrow"><span class="page-hero__eyebrow-line"></span>§ Otros casos</div>
      <h2 class="caso-related__h2">Casos relacionados</h2>
    </div>
    <a href="{{ langPrefix }}{{ _casosUrl }}" class="caso-related__link">
      Ver todos los casos
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,2.5vw,32px);" class="three-col">
    {% for rc in [rel1, rel2, rel3] %}{% if rc %}
    <a href="{{ langPrefix }}/casos-exito/{{ rc.slug }}/" class="caso-rel-card">
      <div class="caso-rel-card__img">
        {% if rc.image and rc.image.url and "placeholder" not in rc.image.url %}
        <img src="{{ rc.image.url }}" alt="{{ rc.image.alt | default(rc.title) }}" loading="lazy" decoding="async">
        {% else %}
        <div style="width:100%;height:100%;background:linear-gradient(135deg,var(--surface-tint) 0%,var(--paper-50,#f2f5f2) 100%);display:flex;align-items:center;justify-content:center;"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--text-faint)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
        {% endif %}
      </div>
      <div class="caso-rel-card__cat">{{ rc.category | default(rc.tags[0]) }}</div>
      <h3 class="caso-rel-card__title">{{ rc.title }}</h3>
      {% if rc.amount and rc.amount != "—" %}<div class="caso-rel-card__amount">{{ rc.amount }}</div>{% endif %}
    </a>
    {% endif %}{% endfor %}
  </div>
</section>
{% endif %}

{# ── 7. BAND CTA INK (.band-cta--ink) ── #}
<section class="band-cta band-cta--ink">
  <div style="max-width:var(--container-wide);margin:0 auto;">
    <div class="band-cta__eyebrow"><span class="page-hero__eyebrow-line"></span>§ Su caso</div>
    <h2 class="band-cta__h2">¿Tiene un caso de cuantía relevante?</h2>
    <p class="band-cta__lede">Briefing técnico con letrado o director de siniestros. Análisis previo de viabilidad sin coste, honorarios fijos por escrito.</p>
    <div class="band-cta__btn-wrap">
      <a href="{{ _contactPro }}" class="band-cta__btn">
        Plantear el caso
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
    <div style="margin-top:16px;"><a href="{{ langPrefix }}{{ _casosUrl }}" style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-on-dark-muted);text-decoration:none;">← {{ _casosLabel }}</a></div>
  </div>
</section>
