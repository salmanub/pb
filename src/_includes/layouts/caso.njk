---
layout: layouts/base.njk
---
{#
  caso.njk — Layout para fichas individuales de Casos de Exito
  Cadena: pagination → caso.njk → base.njk
  NOTE: All HTML on single lines to prevent Markdown <p> wrapping
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}
{% set _casosUrl = "/casos-exito/" if (not lang or lang == "es") else ("/en/success-cases/" if lang == "en" else "/ca/casos-d-exit/") %}
{% set _casosLabel = "Casos de Exito" if (not lang or lang == "es") else ("Success Cases" if lang == "en" else "Casos d'Exit") %}
{% set _contactPro = "/contacto/profesional/" if (not lang or lang == "es") else ("/en/contact/professional/" if lang == "en" else "/ca/contacte/professional/") %}
{% set breadcrumb_parent = { label: _casosLabel, url: _casosUrl } %}
{% set title = caso.title %}
<div itemscope itemtype="https://schema.org/Article" style="display:none;" aria-hidden="true"><meta itemprop="headline" content="{{ caso.title }}"><meta itemprop="description" content="{{ caso.description }}"><meta itemprop="url" content="{{ metadata.site.url }}{{ page.url }}"><meta itemprop="datePublished" content="{{ caso.datePublished }}"><meta itemprop="dateModified" content="{{ caso.dateModified }}"><div itemprop="author" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="{{ metadata.company.name }}"></div></div>
{% include "partials/breadcrumb.njk" %}
<section style="max-width: var(--container-wide); margin: 0 auto; padding: 0 var(--gutter); padding-top: clamp(32px,5vw,64px); padding-bottom: var(--section-y);">
<div style="display:grid;grid-template-columns:1.35fr 0.65fr;gap:clamp(32px,5vw,72px);align-items:start;" class="hero-grid">
<div>
<div style="display:inline-flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;font-weight:600;color:var(--text-accent);margin-bottom:18px;"><span style="width:24px;height:1.5px;background:var(--accent);display:inline-block;"></span>{{ "Caso de Exito" if (not lang or lang == "es") else ("Success Case" if lang == "en" else "Cas d'Exit") }}</div>
<h1 style="font-family:var(--font-serif);font-size:var(--fs-display-1);line-height:var(--lh-display);letter-spacing:var(--tracking-tight);color:var(--text-strong);margin:0;font-weight:400;">{{ caso.title }}</h1>
<p style="margin-top:20px;font-size:var(--fs-lede);line-height:var(--lh-lede);color:var(--text-muted);max-width:52ch;">{{ caso.description }}</p>
{% if caso.tags %}
<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:22px;">{% for tag in caso.tags %}<span style="display:inline-flex;align-items:center;font-family:var(--font-mono);font-weight:600;letter-spacing:var(--tracking-label);text-transform:uppercase;line-height:1.2;border-radius:var(--radius-xs);font-size:var(--fs-mono-label);padding:4px 10px;color:var(--text-accent);border:1px solid var(--oxide-200);background:var(--surface-tint);">{{ tag }}</span>{% endfor %}</div>
{% endif %}
</div>
<div style="position:sticky;top:100px;">
<div style="border:1px solid var(--border-hairline);border-radius:var(--radius-md);background:var(--surface-card);overflow:hidden;">
<div style="padding:14px 20px;border-bottom:1px solid var(--border-hairline);font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-muted);">{{ "Ficha del caso" if (not lang or lang == "es") else ("Case file" if lang == "en" else "Fitxa del cas") }}</div>
{% for item in caso.summary %}
<div style="padding:14px 20px;{% if not loop.last %}border-bottom:1px solid var(--border-hairline);{% endif %}">
<div style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-faint);margin-bottom:4px;">{{ item.label }}</div>
<div style="font-size:0.9rem;color:var(--text-strong);line-height:1.45;">{{ item.value }}</div>
</div>
{% endfor %}
<div style="padding:12px 20px;border-top:1px solid var(--border-hairline);font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-faint);"><time datetime="{{ caso.datePublished }}">{{ "Publicado" if (not lang or lang == "es") else ("Published" if lang == "en" else "Publicat") }} · {{ caso.datePublished | replace("-", " / ") }}</time></div>
</div>
</div>
</div>
</section>
<div style="max-width:var(--container-wide);margin:0 auto;padding:0 var(--gutter);"><div style="height:1px;background:var(--border-hairline);"></div></div>
<section style="max-width:var(--container-text);margin:0 auto;padding:var(--section-y) var(--gutter);">
<div class="prose">
{{ caso.content | markdown | safe }}
</div>
</section>
{% if caso.images and caso.images | length > 0 %}
<section style="max-width:var(--container-wide);margin:0 auto;padding:0 var(--gutter) var(--section-y);">
<div style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-muted);margin-bottom:18px;">{{ "Documentacion grafica" if (not lang or lang == "es") else ("Visual documentation" if lang == "en" else "Documentacio grafica") }}</div>
<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px;" class="two-col">
{% for img in caso.images %}<figure style="margin:0;"><img src="{{ img.url }}" alt="{{ img.alt }}" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:var(--radius-md);border:1px solid var(--border-hairline);aspect-ratio:16/10;object-fit:cover;">{% if img.caption %}<figcaption style="margin-top:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:0.04em;color:var(--text-faint);">{{ img.caption }}</figcaption>{% endif %}</figure>{% endfor %}
</div>
</section>
{% endif %}
{% if caso.relatedService %}
<section style="background:var(--paper-50);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);">
<div style="max-width:var(--container-wide);margin:0 auto;padding:var(--space-10) var(--gutter);display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;">
<div><div style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;">{{ "Servicio relacionado" if (not lang or lang == "es") else ("Related service" if lang == "en" else "Servei relacionat") }}</div><div style="font-family:var(--font-serif);font-size:var(--fs-h2);font-weight:400;color:var(--text-strong);">{{ caso.relatedService.title }}</div></div>
<a href="{{ caso.relatedService.url }}" style="display:inline-flex;align-items:center;gap:9px;padding:13px 22px;font-family:var(--font-sans);font-size:var(--fs-body);font-weight:var(--fw-semibold);border-radius:var(--radius-sm);border:1.5px solid var(--ink-900);background:transparent;color:var(--ink-900);text-decoration:none;white-space:nowrap;">{{ "Ver servicio" if (not lang or lang == "es") else ("View service" if lang == "en" else "Veure servei") }} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
</div>
</section>
{% endif %}
<section style="background:var(--surface-tint);border-top:1px solid var(--oxide-200);">
<div style="max-width:var(--container-wide);margin:0 auto;padding:var(--section-y) var(--gutter);text-align:center;">
<div style="display:inline-flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;font-weight:600;color:var(--text-accent);margin-bottom:18px;"><span style="width:24px;height:1.5px;background:var(--accent);display:inline-block;"></span>{{ "Tiene un caso similar?" if (not lang or lang == "es") else ("Similar situation?" if lang == "en" else "Te un cas similar?") }}</div>
<h2 style="font-family:var(--font-serif);font-size:var(--fs-h1);font-weight:400;line-height:var(--lh-display);letter-spacing:var(--tracking-tight);color:var(--text-strong);margin:0;">{{ "Cuentenos su problema" if (not lang or lang == "es") else ("Tell us about your case" if lang == "en" else "Expliqui'ns el seu problema") }}</h2>
<p style="margin-top:14px;font-size:var(--fs-lede);line-height:var(--lh-lede);color:var(--text-muted);max-width:58ch;margin-left:auto;margin-right:auto;">{{ "Primera consulta sin coste para valorar si su caso tiene recorrido pericial." if (not lang or lang == "es") else ("Free initial consultation to assess the expert potential of your case." if lang == "en" else "Primera consulta sense cost per valorar si el seu cas te recorregut pericial.") }}</p>
<div style="margin-top:28px;"><a href="{{ _contactPro }}" class="cta-hero" style="display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:16px 28px;font-family:var(--font-sans);font-size:var(--fs-body);font-weight:var(--fw-semibold);line-height:1;letter-spacing:0.005em;border-radius:var(--radius-sm);border:1.5px solid transparent;background:var(--accent);color:var(--accent-on);text-decoration:none;">{{ "Solicitar consulta" if (not lang or lang == "es") else ("Request a consultation" if lang == "en" else "Sol·licitar consulta") }} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></div>
<div style="margin-top:16px;"><a href="{{ _casosUrl }}" style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-muted);text-decoration:none;">← {{ _casosLabel }}</a></div>
</div>
</section>
