{% extends "layouts/base.njk" %}

{% block content %}
<main class="contact-page" itemscope itemtype="https://schema.org/ContactPage">
    {# Hero Section con dos columnas #}
    <header class="relative mt-[70px] lg:mt-[120px] bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] text-white overflow-hidden isolate" itemprop="mainEntity">
        <!-- Efectos decorativos consistentes con heroWithImage -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
        </div>

        <div class="relative z-10 w-full py-12 lg:py-16">
            <div class="w-full px-4 sm:px-8 md:px-12 lg:px-0 md:w-[95%] max-w-[1400px] mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                    <div class="space-y-8">
                        {% include "partials/breadcrumb.njk" %}
                        
                        <h1 class="text-[2.5rem] md:text-[3.5rem] font-light leading-[1.1] text-center md:text-left" itemprop="headline">
                            {{ contact.title | safe}}
                        </h1>
                        
                        <p class="text-lg md:text-xl text-cyan-50 font-light max-w-3xl mx-auto md:mx-0 text-center md:text-left py-2 lg:py-4" itemprop="description">
                        {{ contact.intro }}
                        </p>
                    </div>
                    
                    <div class="space-y-6" itemscope itemtype="https://schema.org/ContactPoint">
                        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
                            <h3 class="text-xl font-medium text-white mb-4 text-center md:text-left">{{contact.direct_contact.title }}</h3>
                            <div class="space-y-4">
                                <a href="tel:{{metadata.contact.phoneNumber}}" class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-xl transition-colors group" itemprop="telephone">
                                    <svg class="w-6 h-6 text-cyan-400 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                    <div>
                                        <div class="text-white font-medium">{{metadata.contact.phoneNumber}}</div>
                                        <p class="text-xs text-white/70">{{contact.direct_contact.phone_hours}}</p>
                                    </div>
                                </a>
                                
                                <a href="mailto:info@perito.barcelona" class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-xl transition-colors group" itemprop="email">
                                    <svg class="w-6 h-6 text-cyan-400 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                    <div>
                                        <div class="text-white font-medium">{{metadata.contact.email}}</div>
                                        <p class="text-xs text-white/70">{{contact.direct_contact.email_response }}</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
    </header>

    {% if content | length > 10 %}
    <section class="py-16 lg:py-24 relative z-10 bg-white">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="prose prose-lg prose-slate max-w-4xl mx-auto">
                {{ content | safe }}
            </div>
        </div>
    </section>
    {% endif %}

    {# Contenido Principal - 2 Columnas con Typeform y Mapas #}
    <section class="py-24 -mt-8 relative z-10 bg-gradient-to-br from-slate-50 via-white to-slate-100">
        <div class="max-w-[1400px] mx-auto px-4 md:px-8">
            {# Grid con gap consistente #}
            <div class="grid lg:grid-cols-2 items-start lg:items-stretch gap-12 lg:gap-16">
                {# Columna Izquierda - Oficinas #}
                <div class="order-2 lg:order-1" itemscope itemtype="https://schema.org/Place">
                    {# Sticky wrapper #}
                    <div class="sticky top-24 space-y-8">
                        {# Encabezado descriptivo para las ubicaciones #}
                        <div class="text-center lg:text-left">
                             <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-3" itemprop="name">Nuestras Oficinas</h2>
                             <p class="text-lg text-slate-600" itemprop="description">Visítanos en Barcelona o Granollers.</p>
                        </div>
                        
                        {# Ubicaciones con tabs para mapas #}
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-slate-100 flex flex-col">
                            {# Tabs de ubicaciones #}
                            <div class="tabs-header flex border-b border-slate-200">
                                <button id="tab-barcelona" class="tab-btn flex-1 px-5 py-4 font-semibold text-slate-800 bg-white border-b-2 border-cyan-500 focus:outline-none group transition-colors duration-200" onclick="switchTab('barcelona')">
                                    <div class="flex items-center justify-center gap-3">
                                        <svg class="w-5 h-5 text-cyan-500 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                        <span>Barcelona</span>
                                    </div>
                                </button>
                                <button id="tab-granollers" class="tab-btn flex-1 px-5 py-4 font-semibold text-slate-500 bg-slate-50 border-b-2 border-transparent hover:bg-slate-100 focus:outline-none group transition-colors duration-200" onclick="switchTab('granollers')">
                                    <div class="flex items-center justify-center gap-3">
                                        <svg class="w-5 h-5 text-cyan-500 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                        <span>Granollers</span>
                                    </div>
                                </button>
                            </div>
                            
                            {# Contenido de las tabs #}
                            <div class="tabs-content flex-grow">
                                <!-- Dirección Barcelona -->
                                <div id="content-barcelona" class="tab-content h-full flex flex-col" itemscope itemtype="https://schema.org/Place">
                                    <meta itemprop="name" content="Oficina de Barcelona">
                                    <div class="p-6 lg:p-8 bg-white">
                                        <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                                            <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                                                <p class="text-lg font-bold text-slate-800 mb-1" itemprop="addressLocality">Barcelona</p>
                                                <p class="text-slate-600" itemprop="streetAddress">C/ Numancia 95, Local 5</p>
                                                <p class="text-sm text-slate-500 mt-1">Metro L5 Entença</p>
                                            </div>
                                            <div class="md:pl-4 md:border-l md:border-slate-200 flex-shrink-0 mt-4 md:mt-0">
                                                <p class="text-sm font-semibold text-slate-700">Horario</p>
                                                <p class="text-sm text-slate-600">L-J: 9-18h | V: 9-14h</p>
                                                <p class="text-xs text-slate-500 mt-1">* Visitas con cita previa</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="h-[300px] flex-grow relative">
                                        <iframe 
                                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2993.6856624264604!2d2.136047!3d41.3850643!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4987ae76a9c89%3A0xd6c91a8d003a5417!2sC.%20de%20Numancia%2C%2095%2C%20L-5%2C%2008029%20Barcelona!5e0!3m2!1ses!2ses!4v1660123456789!5m2!1ses!2ses"
                                            class="w-full h-full border-0"
                                            allowfullscreen=""
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"
                                            title="Oficina de Barcelona - C/ Numancia 95, Local 5">
                                        </iframe>
                                    </div>
                                </div>

                                <!-- Dirección Granollers -->
                                <div id="content-granollers" class="tab-content hidden h-full flex flex-col" itemscope itemtype="https://schema.org/Place">
                                    <meta itemprop="name" content="Oficina de Granollers">
                                    <div class="p-6 lg:p-8 bg-white">
                                        <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                                            <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                                                <p class="text-lg font-bold text-slate-800 mb-1" itemprop="addressLocality">Granollers</p>
                                                <p class="text-slate-600" itemprop="streetAddress">C/ Navarra 14</p>
                                                <p class="text-sm text-slate-500 mt-1">Cerca estación Renfe</p>
                                            </div>
                                            <div class="md:pl-4 md:border-l md:border-slate-200 flex-shrink-0 mt-4 md:mt-0">
                                                <p class="text-sm font-semibold text-slate-700">Horario</p>
                                                <p class="text-sm text-slate-600">L-J: 9-18h | V: 9-14h</p>
                                                <p class="text-xs text-slate-500 mt-1">* Visitas con cita previa</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="h-[300px] flex-grow relative">
                                        <iframe 
                                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2982.9574654721266!2d2.2862264!3d41.6082985!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4c7d5708e4acf%3A0x617a54b79c245caa!2sC.%20Navarra%2C%2014%2C%2008401%20Granollers%2C%20Barcelona!5e0!3m2!1ses!2ses!4v1660123456789!5m2!1ses!2ses"
                                            class="w-full h-full border-0"
                                            allowfullscreen=""
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"
                                            title="Oficina de Granollers - C/ Navarra 14">
                                        </iframe>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                        </div>
                    </div>
                </div>

                {# Columna Derecha - Formulario #}
                <div class="order-1 lg:order-2" itemscope itemtype="https://schema.org/ContactPoint">
                    <div class="bg-white rounded-2xl shadow-lg p-8 lg:p-12 border border-slate-100 hover:shadow-xl transition-shadow duration-300">
                        <div class="mb-10 text-center lg:text-left">
                            <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-3" itemprop="name">Consulta Online Detallada</h2>
                            <p class="text-lg text-slate-600" itemprop="description">Rellena los pasos para darnos más información sobre tu caso.</p>
                        </div>
                        {# Contenedor Typeform #}
                        <div id="typeform-wrapper" class="flex flex-col h-full">
                            <div id="typeform-container" class="space-y-16 flex-grow flex flex-col justify-between">
                                <!-- Aquí va el contenido del formulario -->
                                {{ metadata.ctaForm[lang].content | safe }}
                            </div>
                            <div class="mt-8 w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                                <div id="typeform-progress" class="bg-gradient-to-r from-cyan-400 to-cyan-600 h-full w-0 transition-all duration-300"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden isolate">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.1)_1px,transparent_1px)] [background-size:48px_48px]"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-50/40 via-transparent to-slate-100/30"></div>
            <div class="absolute -bottom-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-200/20 blur-[100px] rounded-full"></div>
        </div>
        
        <div class="max-w-[1400px] mx-auto relative z-10 text-center">
            <div class="max-w-3xl mx-auto">
                <h3 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6" itemprop="headline">¿Prefieres hablar directamente?</h3>
                <p class="text-lg md:text-xl text-slate-600 mb-10" itemprop="description">Llámanos ahora y te atenderemos personalmente para resolver tus dudas.</p>
                <a href="tel:{{metadata.contact.phoneNumber}}" class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:shadow-cyan-500/25 transition-all group text-lg" itemprop="telephone">
                    <svg class="w-5 h-5 mr-3 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    Llamar al {{metadata.contact.phoneNumber}}
                </a>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block scripts %}
<script>
    // Funcionalidad para las tabs de ubicaciones
    function switchTab(location) {
        // Ocultar todos los contenidos
        document.querySelectorAll('.tab-content').forEach(content => {
            content.classList.add('hidden');
        });
        
        // Mostrar el contenido seleccionado
        document.getElementById(`content-${location}`).classList.remove('hidden');
        
        // Actualizar estilos de los botones de tabs
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('border-cyan-500', 'text-slate-800', 'bg-white');
            btn.classList.add('border-transparent', 'text-slate-500', 'bg-slate-50', 'hover:bg-slate-100');
        });
        
        // Resaltar el botón activo
        const activeBtn = document.getElementById(`tab-${location}`);
        activeBtn.classList.remove('border-transparent', 'text-slate-500', 'bg-slate-50', 'hover:bg-slate-100');
        activeBtn.classList.add('border-cyan-500', 'text-slate-800', 'bg-white');
    }
</script>
{% endblock %}

{% block pageStyles %}
    {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
    <style>
        {{ indexCSS | safe }}
    </style>
{% endblock %}
