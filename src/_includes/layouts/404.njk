{% block content %}
<main id="page-404" class="relative mt-[70px] lg:mt-[120px] isolate">
    <div class="py-24 px-4 text-center bg-white">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-6xl md:text-8xl font-bold text-cyan-500 opacity-90">404</h1>
            <h2 class="mt-4 text-3xl md:text-4xl font-light text-slate-800">{{ metadata.error404[lang].title }}</h2>
            <p class="mt-6 text-lg text-slate-600">
                {{ metadata.error404[lang].description }}
            </p>
            <div id="language-suggestion" class="hidden"></div>
            <div class="mt-12">
                <p class="text-slate-700 font-semibold mb-6">{{ metadata.error404[lang].suggestions }}</p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a href="/{% if lang != 'es' %}{{ lang }}/{% endif %}" class="inline-flex items-center justify-center px-6 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-all">
                        {{ metadata.error404[lang].homeButton }}
                    </a>
                    <a href="/{% if lang != 'es' %}{{ lang }}/{% endif %}{{ metadata.error404[lang].servicesPath }}" class="inline-flex items-center justify-center px-6 py-3 border border-cyan-500 text-cyan-600 font-semibold rounded-lg hover:bg-cyan-50 transition-all">
                        {{ metadata.error404[lang].servicesButton }}
                    </a>
                    <a href="/{% if lang != 'es' %}{{ lang }}/{% endif %}{{ metadata.error404[lang].contactPath }}" class="inline-flex items-center justify-center px-6 py-3 border border-slate-300 text-slate-600 font-semibold rounded-lg hover:bg-slate-50 transition-all">
                        {{ metadata.error404[lang].contactButton }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}


    {% block pageStyles %}
    {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
    <style>
        {{ indexCSS | safe }}
    </style>
{% endblock %}



