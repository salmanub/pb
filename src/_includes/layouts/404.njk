{% extends "layouts/base.njk" %}

{% block content %}
<main id="page-404" class="relative mt-[70px] lg:mt-[100px] min-h-[calc(100vh-70px)] flex items-center justify-center isolate overflow-hidden bg-slate-50">
    <!-- Visual Identity Background -->
    <div class="absolute inset-0 z-0">
        <div class="absolute top-0 right-0 w-2/3 h-full bg-white skew-x-[-12deg] translate-x-1/4 origin-top"></div>
        <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-slate-100 to-transparent"></div>
    </div>

    <div class="relative z-10 w-full px-6 md:px-12 lg:px-16 py-12 md:py-24 text-center">
        <div class="max-w-3xl mx-auto">
            <!-- 404 Illustration: Standard Construction Icon -->
            <div class="mb-8 flex justify-center">
                <div class="relative w-40 h-40 md:w-56 md:h-56 flex items-center justify-center animate-float text-slate-300">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-full h-full">
                        <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
                    </svg>
                </div>
            </div>
            
            <h1 class="text-6xl md:text-8xl font-black text-slate-900 mb-4 tracking-tighter">404</h1>
            
            <h2 class="text-2xl md:text-3xl font-light text-slate-600 mb-8">
                {{ metadata.error404[lang].title }}
            </h2>

            <p class="text-lg text-slate-600 mb-12 max-w-2xl mx-auto">
                {{ metadata.error404[lang].description }}
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/{{ ((lang + '/') if lang != 'es' else '') }}" class="inline-flex items-center justify-center px-8 py-3 bg-slate-900 text-white font-medium rounded-none hover:bg-slate-800 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                    {{ metadata.error404[lang].homeButton }}
                </a>
                <a href="/{{ ((lang + '/') if lang != 'es' else '') }}{{ metadata.error404[lang].servicesPath }}" class="inline-flex items-center justify-center px-8 py-3 bg-white text-slate-700 font-medium rounded-none border border-slate-200 hover:bg-slate-50 transition-colors shadow-sm hover:shadow-md">
                    {{ metadata.error404[lang].servicesButton }}
                </a>
            </div>
            
            <!-- Suggestion for other languages -->
            {% if metadata.error404Suggestion[lang] %}
                <div class="mt-12 text-sm text-slate-400">
                    <p>{{ metadata.error404Suggestion[lang].pageAvailableIn }} 
                        {% for l in metadata.languages %}
                            {% if l != lang %}
                                <a href="/{{ l }}/" class="underline hover:text-slate-600 uppercase mx-1">{{ l }}</a>
                            {% endif %}
                        {% endfor %}
                    </p>
                </div>
            {% endif %}
        </div>
    </div>
</main>

<style>
/* Animación suave para la ilustración */
@keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(2deg); }
}
.animate-float {
    animation: float 6s ease-in-out infinite;
}
</style>
{% endblock %}
