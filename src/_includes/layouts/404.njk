{% extends "layouts/base.njk" %}

{% block content %}
<main id="page-404" class="relative mt-[70px] lg:mt-[100px] min-h-[calc(100vh-70px)] flex items-center justify-center isolate overflow-hidden">
    <!-- Visual Identity Background -->
    <div class="absolute inset-0 z-0">
        <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-100 skew-x-[-12deg] translate-x-1/4 origin-top"></div>
        <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-white to-transparent"></div>
    </div>

    <div class="relative z-10 w-full px-6 md:px-12 lg:px-16 py-12 md:py-24 text-center">
        <div class="max-w-3xl mx-auto">
            <!-- 404 Illustration -->
            <div class="mb-8 flex justify-center">
                <svg class="w-64 h-64 md:w-80 md:h-80 text-slate-200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M40 160L80 40L160 160H40Z" fill="currentColor" fill-opacity="0.5"/>
                    <path d="M70 160L90 100" stroke="#94a3b8" stroke-width="4" stroke-linecap="round"/>
                    <path d="M130 160L110 100" stroke="#94a3b8" stroke-width="4" stroke-linecap="round"/>
                    <rect x="60" y="150" width="80" height="10" fill="#94a3b8"/>
                    <circle cx="100" cy="80" r="30" stroke="#0ea5e9" stroke-width="8" fill="white"/>
                    <path d="M125 105L145 125" stroke="#0ea5e9" stroke-width="8" stroke-linecap="round"/>
                    <path d="M85 80C85 88.2843 91.7157 95 100 95" stroke="#0ea5e9" stroke-width="4" stroke-linecap="round"/>
                </svg>
            </div>
            
            <h1 class="text-6xl md:text-8xl font-black text-slate-900 mb-4 tracking-tighter">404</h1>
            
            <h2 class="text-2xl md:text-3xl font-light text-slate-600 mb-8">
                {{ metadata.error404[lang].title }}
            </h2>

            <p class="text-lg text-slate-600 mb-12 max-w-2xl mx-auto">
                {{ metadata.error404[lang].description }}
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/{{ ((lang + '/') if lang != 'es' else '') }}" class="inline-flex items-center justify-center px-8 py-3 bg-slate-900 text-white font-medium rounded-full hover:bg-slate-800 transition-colors">
                    {{ metadata.error404[lang].homeButton }}
                </a>
                <a href="/{{ ((lang + '/') if lang != 'es' else '') }}{{ metadata.error404[lang].servicesPath }}" class="inline-flex items-center justify-center px-8 py-3 bg-white text-slate-700 font-medium rounded-full border border-slate-200 hover:bg-slate-50 transition-colors">
                    {{ metadata.error404[lang].servicesButton }}
                </a>
            </div>
            
            <!-- Suggestion for other languages -->
            {% if metadata.error404Suggestion[lang] %}
                <div class="mt-12 text-sm text-slate-400">
                    <p>{{ metadata.error404Suggestion[lang].pageAvailableIn }} 
                        {% for l in metadata.languages %}
                            {% if l != lang %}
                                <a href="/{{ l }}/" class="underline hover:text-slate-600 uppercase mx-1">{{ l }}</a>
                            {% endif %}
                        {% endfor %}
                    </p>
                </div>
            {% endif %}
        </div>
    </div>
</main>

<style>
/* Animación suave para la ilustración */
@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}
svg {
    animation: float 6s ease-in-out infinite;
}
</style>
{% endblock %}
