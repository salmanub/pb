{% extends "layouts/base.njk" %}

{% block content %}
<main id="page-404" class="relative mt-[70px] lg:mt-[100px] min-h-[calc(100vh-70px)] flex items-center justify-center isolate overflow-hidden bg-slate-50">
    <!-- Snow Animation Background -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="snowflake">❄</div>
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
        <div class="snowflake">❄</div>
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
        <div class="snowflake">❄</div>
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
        <div class="snowflake">❄</div>
    </div>

    <!-- Visual Identity Background -->
    <div class="absolute inset-0 z-0">
        <div class="absolute top-0 right-0 w-2/3 h-full bg-white skew-x-[-12deg] translate-x-1/4 origin-top"></div>
        <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-slate-100 to-transparent"></div>
    </div>

    <div class="relative z-10 w-full px-6 md:px-12 lg:px-16 py-12 md:py-24 text-center">
        <div class="max-w-3xl mx-auto">
            <!-- 404 Illustration: Mouse Construction -->
            <div class="mb-8 flex justify-center">
                <div class="relative w-64 h-64 md:w-80 md:h-80 flex items-center justify-center animate-float">
                    {% image "src/assets/images/mouse-construction-snow.png", "Mouse Engineer in Snow", "w-full h-full object-contain drop-shadow-2xl" %}
                </div>
            </div>
            
            <h1 class="text-6xl md:text-8xl font-black text-slate-900 mb-4 tracking-tighter">404</h1>
            
            <h2 class="text-2xl md:text-3xl font-light text-slate-600 mb-8">
                {{ metadata.error404[lang].title }}
            </h2>

            <p class="text-lg text-slate-600 mb-12 max-w-2xl mx-auto">
                {{ metadata.error404[lang].description }}
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/{{ ((lang + '/') if lang != 'es' else '') }}" class="inline-flex items-center justify-center px-8 py-3 bg-slate-900 text-white font-medium rounded-full hover:bg-slate-800 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                    {{ metadata.error404[lang].homeButton }}
                </a>
                <a href="/{{ ((lang + '/') if lang != 'es' else '') }}{{ metadata.error404[lang].servicesPath }}" class="inline-flex items-center justify-center px-8 py-3 bg-white text-slate-700 font-medium rounded-full border border-slate-200 hover:bg-slate-50 transition-colors shadow-sm hover:shadow-md">
                    {{ metadata.error404[lang].servicesButton }}
                </a>
            </div>
            
            <!-- Suggestion for other languages -->
            {% if metadata.error404Suggestion[lang] %}
                <div class="mt-12 text-sm text-slate-400">
                    <p>{{ metadata.error404Suggestion[lang].pageAvailableIn }} 
                        {% for l in metadata.languages %}
                            {% if l != lang %}
                                <a href="/{{ l }}/" class="underline hover:text-slate-600 uppercase mx-1">{{ l }}</a>
                            {% endif %}
                        {% endfor %}
                    </p>
                </div>
            {% endif %}
        </div>
    </div>
</main>

<style>
/* Animación suave para la ilustración */
@keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(2deg); }
}
.animate-float {
    animation: float 6s ease-in-out infinite;
}

/* Snowfall Animation */
.snowflake {
  color: #cbd5e1;
  font-size: 1.5em;
  font-family: Arial, sans-serif;
  text-shadow: 0 0 5px #000;
  position: fixed;
  top: -10%;
  z-index: 0;
  user-select: none;
  cursor: default;
  animation-name: snowflakes-fall, snowflakes-shake;
  animation-duration: 10s, 3s;
  animation-timing-function: linear, ease-in-out;
  animation-iteration-count: infinite, infinite;
  animation-play-state: running, running;
}
.snowflake:nth-of-type(0) { left: 1%; animation-delay: 0s, 0s; }
.snowflake:nth-of-type(1) { left: 10%; animation-delay: 1s, 1s; }
.snowflake:nth-of-type(2) { left: 20%; animation-delay: 6s, 0.5s; }
.snowflake:nth-of-type(3) { left: 30%; animation-delay: 4s, 2s; }
.snowflake:nth-of-type(4) { left: 40%; animation-delay: 2s, 2s; }
.snowflake:nth-of-type(5) { left: 50%; animation-delay: 8s, 3s; }
.snowflake:nth-of-type(6) { left: 60%; animation-delay: 6s, 2s; }
.snowflake:nth-of-type(7) { left: 70%; animation-delay: 2.5s, 1s; }
.snowflake:nth-of-type(8) { left: 80%; animation-delay: 1s, 0s; }
.snowflake:nth-of-type(9) { left: 90%; animation-delay: 3s, 1.5s; }

@keyframes snowflakes-fall {
  0% { top: -10%; }
  100% { top: 100%; }
}
@keyframes snowflakes-shake {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(80px); }
}
</style>
{% endblock %}
