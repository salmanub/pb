{% extends "layouts/base.njk" %}

{# {% block pageStyles %}
<style>
@keyframes dash {
    from {
        stroke-dasharray: 0, 1000;
        stroke-dashoffset: 0;
    }
    to {
        stroke-dasharray: 1000, 0;
        stroke-dashoffset: 0;
    }
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

.animate-[dash_2s_ease-in-out] {
    animation: dash 2s ease-in-out forwards;
}

.animate-[dash_2s_ease-in-out_0.5s] {
    animation: dash 2s ease-in-out 0.5s forwards;
}

.animate-[dash_2s_ease-in-out_1s] {
    animation: dash 2s ease-in-out 1s forwards;
}

.animate-[fadeIn_3s_ease-in-out] {
    animation: fadeIn 3s ease-in-out forwards;
}
</style>
{% endblock %} #}

{% block content %}
<main class="relative mt-[70px] lg:mt-[120px] isolate">
    <div class="py-24 px-4 text-center bg-white">
        <div class="max-w-4xl mx-auto">
            {# <!-- Ilustración 404 Avant-garde -->
            <div class="relative w-full max-w-2xl mx-auto mb-12 aspect-[4/3]" role="img" aria-label="Ilustración artística de error 404 con elementos de arquitectura e ingeniería">
                <svg viewBox="0 0 800 600" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <title>Error 404 - Página no encontrada</title>
                    <desc>Una ilustración artística que representa el error 404 usando elementos de arquitectura, ingeniería y construcción en un estilo técnico y moderno.</desc>
                    
                    <!-- Definiciones de patrones y gradientes -->
                    <defs>
                        <!-- Grid técnico mejorado -->
                        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#E2E8F0" stroke-width="0.5"/>
                            <circle cx="0" cy="0" r="1" fill="#E2E8F0"/>
                        </pattern>
                        
                        <!-- Gradientes mejorados -->
                        <linearGradient id="fadeGradient" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#0891B2" stop-opacity="0.15"/>
                            <stop offset="50%" stop-color="#0891B2" stop-opacity="0.05"/>
                            <stop offset="100%" stop-color="#0891B2" stop-opacity="0"/>
                        </linearGradient>
                        
                        <!-- Patrón de líneas diagonales -->
                        <pattern id="diagonalLines" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                            <line x1="0" y1="0" x2="0" y2="10" stroke="#E2E8F0" stroke-width="0.5"/>
                        </pattern>
                    </defs>

                    <!-- Fondo con capas -->
                    <rect width="800" height="600" fill="url(#grid)" aria-hidden="true"/>
                    <rect width="800" height="600" fill="url(#fadeGradient)" aria-hidden="true"/>
                    <rect width="800" height="600" fill="url(#diagonalLines)" opacity="0.3" aria-hidden="true"/>

                    <!-- Composición principal -->
                    <g aria-label="Números 404 estilizados">
                        <!-- Primer 4 - Edificio en construcción -->
                        <g transform="translate(100,100)">
                            <path d="M 100 0 L 100 200 L 0 200 L 200 0 L 200 400" 
                                  fill="none" 
                                  stroke="#0891B2" 
                                  stroke-width="8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  class="animate-[dash_2s_ease-in-out]"/>
                            <!-- Detalles arquitectónicos -->
                            <path d="M 50 200 L 150 200" stroke="#0891B2" stroke-width="2" stroke-dasharray="10,5"/>
                            <circle cx="100" cy="100" r="5" fill="#0891B2" class="animate-pulse"/>
                        </g>

                        <!-- 0 - Plano circular complejo -->
                        <g transform="translate(400,300)">
                            <circle r="80" fill="none" stroke="#0891B2" stroke-width="8" class="animate-[dash_2s_ease-in-out_0.5s]"/>
                            <!-- Detalles técnicos -->
                            <circle r="60" fill="none" stroke="#0891B2" stroke-width="1" stroke-dasharray="4,4"/>
                            <circle r="100" fill="none" stroke="#0891B2" stroke-width="1" stroke-dasharray="4,4"/>
                            <!-- Líneas de medición -->
                            <line x1="-90" y1="0" x2="90" y2="0" stroke="#94A3B8" stroke-width="1" stroke-dasharray="5,5"/>
                            <line x1="0" y1="-90" x2="0" y2="90" stroke="#94A3B8" stroke-width="1" stroke-dasharray="5,5"/>
                        </g>

                        <!-- Segundo 4 - Estructura metálica -->
                        <g transform="translate(500,100)">
                            <path d="M 100 0 L 100 200 L 0 200 L 200 0 L 200 400" 
                                  fill="none" 
                                  stroke="#0891B2" 
                                  stroke-width="8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  class="animate-[dash_2s_ease-in-out_1s]"/>
                            <!-- Refuerzos estructurales -->
                            <path d="M 50 100 L 150 100 M 100 50 L 100 150" 
                                  stroke="#0891B2" 
                                  stroke-width="2" 
                                  stroke-dasharray="8,4"/>
                        </g>
                    </g>

                    <!-- Elementos técnicos decorativos -->
                    <g class="animate-pulse" aria-label="Detalles técnicos">
                        <!-- Cuadrícula de medición -->
                        <path d="M 50 450 H 750 M 50 460 V 440 M 750 460 V 440" 
                              stroke="#94A3B8" 
                              stroke-width="1.5" 
                              stroke-dasharray="4,4"/>
                        
                        <!-- Marcadores de referencia -->
                        <g class="animate-[fadeIn_3s_ease-in-out]">
                            <circle cx="100" cy="100" r="4" fill="#0891B2">
                                <animate attributeName="r" values="3;5;3" dur="2s" repeatCount="indefinite"/>
                            </circle>
                            <circle cx="700" cy="100" r="4" fill="#0891B2">
                                <animate attributeName="r" values="3;5;3" dur="2s" repeatCount="indefinite" begin="0.5s"/>
                            </circle>
                        </g>
                    </g>

                    <!-- Textos técnicos y medidas -->
                    <g class="animate-[fadeIn_3s_ease-in-out]" aria-label="Anotaciones técnicas">
                        <text x="60" y="480" fill="#64748B" font-family="monospace" font-size="12">0.00m</text>
                        <text x="730" y="480" fill="#64748B" font-family="monospace" font-size="12">7.50m</text>
                        <text x="370" y="150" fill="#0891B2" font-family="monospace" font-size="14" font-weight="bold" class="animate-pulse">ERROR 404</text>
                        <!-- Notas técnicas -->
                        <text x="100" y="550" fill="#64748B" font-family="monospace" font-size="10" class="animate-[fadeIn_3s_ease-in-out]">REV: A-01</text>
                        <text x="650" y="550" fill="#64748B" font-family="monospace" font-size="10" class="animate-[fadeIn_3s_ease-in-out]">ESC: 1:100</text>
                    </g>
                </svg>
            </div> #}
            <h1 class="text-6xl md:text-8xl font-bold text-cyan-500 opacity-90">404</h1>
            <h2 class="mt-4 text-3xl md:text-4xl font-light text-slate-800">{{ metadata.error404[lang].title }}</h2>
            <p class="mt-6 text-lg text-slate-600">
                {{ metadata.error404[lang].description }}
            </p>
            <div class="mt-12">
                <p class="text-slate-700 font-semibold mb-6">{{ metadata.error404[lang].suggestions }}</p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a href="/{% if lang != 'es' %}{{ lang }}/{% endif %}" class="inline-flex items-center justify-center px-6 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-all">
                        {{ metadata.error404[lang].homeButton }}
                    </a>
                    <a href="/{% if lang != 'es' %}{{ lang }}/{% endif %}{{ metadata.error404[lang].servicesPath }}" class="inline-flex items-center justify-center px-6 py-3 border border-cyan-500 text-cyan-600 font-semibold rounded-lg hover:bg-cyan-50 transition-all">
                        {{ metadata.error404[lang].servicesButton }}
                    </a>
                    <a href="/{% if lang != 'es' %}{{ lang }}/{% endif %}{{ metadata.error404[lang].contactPath }}" class="inline-flex items-center justify-center px-6 py-3 border border-slate-300 text-slate-600 font-semibold rounded-lg hover:bg-slate-50 transition-all">
                        {{ metadata.error404[lang].contactButton }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}


    {% block pageStyles %}
    {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
    <style>
        {{ indexCSS | safe }}
    </style>
{% endblock %}



