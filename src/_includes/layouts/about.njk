{#
  about.njk — Layout para página de El Despacho / About
  Port de SitePages.jsx → Despacho
  AGENTES §6 microdata: Person
  Cadena: content.md → about.njk → base.njk
  Datos: frontmatter + {lang}.json + metadata.json
  NOTE: All HTML on single lines to prevent Markdown <p> wrapping
#}
{% if not ui %}{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}{% endif %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}
{% set _contactPro = "/contacto/profesional/" if (not lang or lang == "es") else ("/en/contact/professional/" if lang == "en" else "/ca/contacte/professional/") %}
{% set _contactPart = "/contacto/particular/" if (not lang or lang == "es") else ("/en/contact/particular/" if lang == "en" else "/ca/contacte/particular/") %}

{# ── Microdata Article ── #}
<div itemscope itemtype="https://schema.org/Article" style="display: none;" aria-hidden="true"><meta itemprop="headline" content="{{ title }}"><meta itemprop="description" content="{{ description }}"><meta itemprop="url" content="{{ metadata.site.url }}{{ page.url }}"><div itemprop="author" itemscope itemtype="https://schema.org/Person"><meta itemprop="name" content="{{ metadata.author.name }}"></div><div itemprop="publisher" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="{{ metadata.company.name }}"></div></div>

{# ===== BREADCRUMB (above hero) ===== #}
<div style="max-width: var(--container-wide); margin: 0 auto; padding: 0 var(--gutter); padding-top: clamp(20px,3vw,32px);">
{% include "partials/breadcrumb.njk" %}
</div>

{# ===== PAGE HERO ===== #}
<section style="max-width: var(--container-wide); margin: 0 auto; padding: 0 var(--gutter); padding-top: clamp(24px,4vw,48px); padding-bottom: var(--space-12);">
<div>
<h1 style="font-family: var(--font-serif); font-size: var(--fs-display-1); line-height: var(--lh-display); letter-spacing: var(--tracking-tight); color: var(--text-strong); margin: 0; font-weight: 400;">{{ title | safe }}</h1>
<p style="margin-top: 22px; font-size: var(--fs-lede); line-height: var(--lh-lede); color: var(--text-muted); max-width: 60ch;">{{ description }}</p>
</div>
</section>

{# ===== BODY + SIDEBAR (Person microdata) ===== #}
<section style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
<div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(28px,4vw,56px); align-items: start;" class="site-two" itemscope itemtype="https://schema.org/Person">
<div>
<meta itemprop="name" content="{{ metadata.author.name }}"><meta itemprop="jobTitle" content="{{ metadata.author.jobTitle[lang | default('es')] }}"><meta itemprop="url" content="{{ metadata.author.linkedin }}"><div itemprop="worksFor" itemscope itemtype="https://schema.org/Organization" style="display: none;"><meta itemprop="name" content="{{ metadata.company.name }}"></div>
{% for block in body_blocks %}
<h3 style="font-family: var(--font-serif); font-size: var(--fs-h3); font-weight: 500; color: var(--text-strong); margin: 26px 0 10px; padding-bottom: 8px; border-bottom: 2px solid var(--accent); display: inline-block;">{{ block.h }}</h3>
<p style="font-size: 1rem; line-height: 1.75; color: var(--text-muted); margin: 0 0 12px; max-width: 62ch;">{{ block.p | safe }}</p>
{% endfor %}

{# ── Enlace al claustro pericial y a la captación de peritos ──────────────────
   /claustro-pericial/ tiene contenido siempre (las cinco disciplinas son fijas
   y las que no tienen persona salen como «Plaza abierta»), así que el enlace no
   necesita condición. Spec 30/08: se enlaza desde el main de /el-despacho/, sin
   tocar el nav principal.
   Texto: frontmatter `claustro_block` {h, p} (AGENTES §5.1). #}
{% if claustro_block %}
<h3 style="font-family: var(--font-serif); font-size: var(--fs-h3); font-weight: 500; color: var(--text-strong); margin: 26px 0 10px; padding-bottom: 8px; border-bottom: 2px solid var(--accent); display: inline-block;">{{ claustro_block.h }}</h3>
<p style="font-size: 1rem; line-height: 1.75; color: var(--text-muted); margin: 0 0 12px; max-width: 62ch;">{{ claustro_block.p | safe }}</p>
{% endif %}

{% set linkedinTitle = "Perfil a LinkedIn" if lang == "ca" else ("LinkedIn profile" if lang == "en" else "Perfil en LinkedIn") %}
<div style="margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border-hairline); display: flex; align-items: center; gap: 14px;">
{% if about_image %}
<img itemprop="image" src="{{ about_image }}" alt="{{ metadata.author.name }}" loading="lazy" style="width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border-subtle); flex-shrink: 0;" onerror="this.style.display='none'">
{% endif %}
<a href="{{ metadata.author.linkedin }}" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--text-muted); font-size: 0.88rem; line-height: 1.4;" title="{{ linkedinTitle }}">
<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink: 0;"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
<span><strong style="color: var(--text-strong); font-weight: var(--fw-medium);">{{ metadata.author.name }}</strong> · {{ metadata.author.jobTitle[lang | default('es')] }}</span>
</a>
</div>
{{ content | safe }}
</div>
{% include "partials/qual.njk" %}
</div>
</section>

{# ===== BAND CTA ===== #}
{% if band_title %}
<section style="background: var(--surface-tint); border-top: 1px solid var(--oxide-200);">
<div style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter); text-align: center;">
<div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label); text-transform: uppercase; font-weight: var(--fw-medium); color: var(--text-accent); margin-bottom: 18px;">{{ band_eyebrow | default("Disponibilidad") }}</div>
<h2 style="font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 400; line-height: var(--lh-display); color: var(--text-strong); margin: 0;">{{ band_title }}</h2>
<div style="margin-top: 28px;"><a href="{{ _contactPro }}" style="display: inline-flex; align-items: center; justify-content: center; padding: 14px 28px; font-family: var(--font-sans); font-size: var(--fs-body); font-weight: var(--fw-semibold); line-height: 1; border-radius: var(--radius-sm); border: 1.5px solid transparent; background: var(--accent); color: var(--accent-on); text-decoration: none;">{{ band_cta | default(ui.qual.consultar_caso) }}</a></div>
</div>
</section>
{% endif %}
