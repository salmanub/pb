{% extends "layouts/base.njk" %}

{% block content %}
<main class="pt-[70px] lg:pt-[120px]" itemscope itemtype="https://schema.org/Blog">
    
    <!-- Hero Section -->
    <header class="bg-gradient-to-br from-slate-50 to-white py-16 px-4 md:px-[5%] shadow-sm">
        <div class="max-w-[1200px] mx-auto">
            <div class="text-center mb-8">
                <h1 class="text-4xl md:text-5xl font-bold text-slate-800 mb-4" itemprop="name">
                    {{ hero.title }}
                    <span class="block text-cyan-500 mt-2">{{ hero.strong }}</span>
                </h1>
                <p class="text-xl text-slate-600 mb-4" itemprop="description">{{ hero.subtitle }}</p>
                <p class="text-lg text-slate-500 max-w-[800px] mx-auto">{{ hero.description }}</p>
            </div>
        </div>
    </header>

    <!-- Blog Posts Grid -->
    <section class="py-16 bg-white">
        <div class="max-w-[1200px] mx-auto px-4 md:px-[5%]">
            
            <!-- Content Description -->
            <div class="prose prose-lg max-w-none mb-12">
                {{ content | safe }}
            </div>

            <!-- Posts Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" itemprop="blogPost">
                {% for post in posts %}
                {% if not post.estado or post.estado == "publicado" %}
                <article class="group/card relative block h-full bg-gradient-to-br from-white to-slate-50/80 rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-500"
                         itemscope itemtype="https://schema.org/BlogPosting">
                    
                    <!-- Featured Image -->
                    {% if post.image %}
                    <div class="relative overflow-hidden aspect-[16/9]">
                        <img src="{{ post.image.url }}" 
                             alt="{{ post.image.alt }}" 
                             class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500"
                             loading="lazy"
                             itemprop="image">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent"></div>
                        
                        <!-- Category Badge -->
                        <div class="absolute top-4 left-4">
                            <span class="px-3 py-1 bg-cyan-500 text-white text-xs font-semibold rounded-full">
                                {{ post.category }}
                            </span>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Content -->
                    <div class="p-6">
                        <!-- Meta Info -->
                        <div class="flex items-center gap-4 text-sm text-slate-500 mb-3">
                            <time datetime="{{ post.datePublished }}T00:00:00+01:00" itemprop="datePublished">
                                {{ post.datePublished }}
                            </time>
                            <span>•</span>
                            <span itemprop="author" itemscope itemtype="https://schema.org/Person">
                                <span itemprop="name">{{ post.author }}</span>
                            </span>
                        </div>

                        <!-- Title -->
                        <h2 class="text-xl font-bold text-slate-800 mb-3 group-hover/card:text-cyan-600 transition-colors" itemprop="headline">
                            <a href="/blog/{{ post.slug }}/" class="no-underline" itemprop="url">
                                {{ post.title }}
                            </a>
                        </h2>

                        <!-- Excerpt -->
                        <p class="text-slate-600 mb-4 line-clamp-3" itemprop="description">
                            {{ post.excerpt }}
                        </p>

                        <!-- Tags -->
                        {% if post.tags and post.tags.length > 0 %}
                        <div class="flex flex-wrap gap-2 mb-4">
                            {% for tag in post.tags %}
                            <span class="text-xs px-2 py-1 bg-slate-100 text-slate-600 rounded" itemprop="keywords">
                                {{ tag }}
                            </span>
                            {% endfor %}
                        </div>
                        {% endif %}

                        <!-- Read More Link -->
                        <a href="/blog/{{ post.slug }}/" 
                           class="inline-flex items-center text-cyan-600 font-semibold hover:text-cyan-700 transition-colors group/link">
                            Leer artículo completo
                            <svg class="w-4 h-4 ml-1 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>

                    <!-- Hidden schema data -->
                    <meta itemprop="mainEntityOfPage" content="{{ metadata.site.url }}/blog/{{ post.slug }}/">
                    <meta itemprop="dateModified" content="{{ post.dateModified }}T00:00:00+01:00">
                </article>
                {% endif %}
                {% endfor %}
            </div>

            <!-- No posts message -->
            {% if not posts or posts.length == 0 %}
            <div class="text-center py-12">
                <p class="text-lg text-slate-600">Próximamente publicaremos nuevos artículos técnicos.</p>
            </div>
            {% endif %}

        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-br from-slate-50 to-white">
        <div class="max-w-[800px] mx-auto px-4 text-center">
            <h2 class="text-3xl font-bold text-slate-800 mb-4">{{ cta.title }}</h2>
            <p class="text-lg text-slate-600 mb-8">{{ cta.description }}</p>
            <a href="{{ cta.button.url }}" 
               class="inline-flex items-center px-8 py-4 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 shadow-md hover:shadow-lg transition-all group">
                {{ cta.button.text }}
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </a>
        </div>
    </section>

</main>
{% endblock %}

{% block pageStyles %}
{% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
<style>
    {{ indexCSS | safe }}

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
{% endblock %}
