{% extends "layouts/base.njk" %}

{% block content %}
{% if not caso.estado or caso.estado == "publicado" %}
<article class="pt-[70px] lg:pt-[120px]" itemscope itemtype="https://schema.org/Article">
    <!-- Schema microdata oculto -->
    <div hidden>
        <meta itemprop="headline" content="{{ title | truncate(110) }}">
        <meta itemprop="description" content="{{ description }}">
        <meta itemprop="mainEntityOfPage" content="{{ metadata.site.url }}{{ page.url }}">
        <meta itemprop="datePublished" content="{{ datePublished }}T00:00:00+01:00">
        <meta itemprop="dateModified" content="{{ dateModified }}T00:00:00+01:00">
        {% if caso.tags and caso.tags.length > 0 %}<meta itemprop="keywords" content="{{ caso.tags | join(', ') }}">{% endif %}
        <meta itemprop="inLanguage" content="{{ lang }}">
        <meta itemprop="isAccessibleForFree" content="True">
        
        <!-- Author -->
        <span itemprop="author" itemscope itemtype="https://schema.org/Person">
            <meta itemprop="name" content="{{ metadata.author.name }}">
            <meta itemprop="jobTitle" content="{{ metadata.author.jobTitle }}">
            <meta itemprop="url" content="{{ metadata.author.linkedin }}">
        </span>
        
        <!-- Images -->
        {% if caso.image %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ caso.image.url }}">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}{{ caso.image.url }}">
            <meta itemprop="caption" content="{{ caso.image.caption | default('Imagen de caso de éxito de ' + metadata.site.title) }}">
            <meta itemprop="width" content="1200">
            <meta itemprop="height" content="675">
        </span>
        {% elif caso.images and caso.images[0] %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ caso.images[0].url }}">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}{{ caso.images[0].url }}">
            <meta itemprop="caption" content="{{ caso.images[0].caption | default('Imagen de caso de éxito de ' + metadata.site.title) }}">
            <meta itemprop="width" content="600">
            <meta itemprop="height" content="450">
        </span>
        {% else %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="caption" content="Logo de {{ metadata.site.title }}">
            <meta itemprop="width" content="600">
            <meta itemprop="height" content="60">
        </span>
        {% endif %}
    </div>
    
    <!-- Hero Section -->
    <header class="bg-gradient-to-br from-slate-50 to-white py-12 px-4 md:px-[5%] shadow-sm">
        <div class="max-w-[1000px] mx-auto">
            <!-- Breadcrumbs -->
            {% set parentService = {
                "title": "Casos de Éxito",
                "url": "/casos-exito/"
            } %}
            {% include "partials/breadcrumb.njk" %}
            
            <!-- Title and Tags -->
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-6 leading-tight" itemprop="headline name">
                    {{ title }}
                </h1>
                <!-- Quitamos las etiquetas duplicadas aquí porque ya se muestran en el recuadro del resumen -->
                <div class="mb-8"></div>

                <!-- Case Summary Box -->
                <div class="bg-gradient-to-br from-cyan-50/30 to-white p-6 rounded-xl shadow-md border border-slate-100 mb-6">
                    <!-- Datos del caso -->
                    {% if caso.summary and caso.summary.length > 0 %}
                    <div>
                        <h2 class="text-xl font-semibold text-slate-800 mb-4 flex items-center">
                            <svg class="w-6 h-6 text-cyan-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            Resumen del Caso:
                        </h2>
                        <dl class="grid sm:grid-cols-2 gap-4">
                            {% for item in caso.summary %}
                            <div class="p-3 bg-white/70 rounded-lg hover:bg-white hover:shadow-sm transition-all">
                                <dt class="font-medium text-cyan-800 mb-1">{{ item.label }}:</dt>
                                <dd class="text-slate-800">{{ item.value }}</dd>
                            </div>
                            {% endfor %}
                        </dl>
                    </div>
                    {% endif %}
                    
                    <!-- Categorías -->
                    {% if caso.tags and caso.tags.length > 0 %}
                    <div class="mt-5 pt-5 border-t border-slate-100">
                        <div class="flex items-start gap-2">
                            <svg class="w-5 h-5 text-cyan-600 mr-1 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                            </svg>
                            <div>
                                <span class="font-medium text-cyan-800 mr-2">Categorías:</span>
                                <div class="flex flex-wrap gap-2 mt-1">
                                    {% for tag in caso.tags %}
                                    <span class="text-xs font-medium px-2 py-1 rounded-full
                                        {% if tag == 'Construcción' %}bg-cyan-100 text-cyan-700
                                        {% elif tag == 'Seguros' %}bg-green-100 text-green-700
                                        {% elif tag == 'Patologías' %}bg-purple-100 text-purple-700
                                        {% elif tag == 'Humedades' %}bg-blue-100 text-blue-700
                                        {% elif tag == 'Estructural' %}bg-amber-100 text-amber-700
                                        {% elif tag == 'Comunidades' %}bg-emerald-100 text-emerald-700
                                        {% else %}bg-slate-100 text-slate-700{% endif %}">
                                        {{ tag }}
                                    </span>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>
                
                <!-- Metadatos del artículo (autor y fechas) -->
                <div class="bg-gradient-to-br from-slate-50 to-white p-4 rounded-lg shadow-sm border border-slate-100 mb-8">
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-5">
                        <!-- Autor -->
                        <div class="flex items-center">
                            <svg class="w-5 h-5 text-cyan-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            <span class="font-medium text-slate-800">{{ metadata.author.name }}</span>
                            <span class="mx-2 text-slate-400">|</span>
                            <span class="text-slate-600">{{ metadata.author.jobTitle }}</span>
                        </div>
                        
                        <!-- Fechas -->
                        <div class="flex flex-wrap items-center gap-4">
                            <div class="flex items-center text-slate-600">
                                <svg class="w-5 h-5 text-cyan-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                <span class="font-medium text-cyan-800">Publicado:</span>
                                <time datetime="{{ datePublished }}" class="ml-1">{{ datePublished }}</time>
                            </div>
                            
                            {% if dateModified and dateModified != datePublished %}
                            <div class="flex items-center text-slate-600">
                                <svg class="w-5 h-5 text-cyan-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                </svg>
                                <span class="font-medium text-cyan-800">Actualizado:</span>
                                <time datetime="{{ dateModified }}" class="ml-1">{{ dateModified }}</time>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Single Image or Gallery -->
                <div class="mt-8">
                    {% if caso.image or (not caso.images or caso.images.length == 0) %}
                    <figure class="relative group overflow-hidden rounded-xl shadow-lg bg-slate-900">
                        {% set imgSrc = caso.image.url if caso.image else metadata.site.placeholderImage %}
                        {# Extraer el path completo y nombre sin extensión #}
                        {% set imgPath = imgSrc | replace(".jpg", "") | replace(".jpeg", "") | replace(".png", "") | replace(".JPG", "") | replace(".JPEG", "") | replace(".PNG", "") %}
                        {# Manejar rutas que empiezan con src/ o con / #}
                        {% if "src/assets/images/" in imgPath %}
                            {% set imgRelativePath = imgPath.split("src/assets/images/")[1] %}
                        {% elif "/assets/images/" in imgPath %}
                            {% set imgRelativePath = imgPath.split("/assets/images/")[1] %}
                        {% else %}
                            {% set imgRelativePath = imgPath %}
                        {% endif %}
                        {% set imgBasePath = "/assets/images/optimized/" + imgRelativePath %}
                        
                        <picture>
                            <source 
                                srcset="{{ imgBasePath }}-320w.avif 320w, {{ imgBasePath }}-640w.avif 640w, {{ imgBasePath }}-1280w.avif 1280w, {{ imgBasePath }}-1920w.avif 1920w"
                                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
                                type="image/avif">
                            <source 
                                srcset="{{ imgBasePath }}-320w.webp 320w, {{ imgBasePath }}-640w.webp 640w, {{ imgBasePath }}-1280w.webp 1280w, {{ imgBasePath }}-1920w.webp 1920w"
                                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
                                type="image/webp">
                            <source 
                                srcset="{{ imgBasePath }}-320w.jpg 320w, {{ imgBasePath }}-640w.jpg 640w, {{ imgBasePath }}-1280w.jpg 1280w, {{ imgBasePath }}-1920w.jpg 1920w"
                                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
                                type="image/jpeg">
                            <img 
                                src="{{ imgBasePath }}-1280w.jpg" 
                                alt="{{ caso.image.alt if caso.image else 'Imagen del caso de éxito' }}" 
                                class="w-full aspect-[16/9] object-cover group-hover:scale-105 group-hover:opacity-90 transition-all duration-500"
                                width="1200"
                                height="675"
                                loading="eager"
                                fetchpriority="high"
                                decoding="async">
                        </picture>
                        {% if caso.image and caso.image.caption %}
                        <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-900/90 to-transparent p-4">
                            <p class="text-white text-sm">{{ caso.image.caption }}</p>
                        </figcaption>
                        {% endif %}
                    </figure>
                    {% elif caso.images and caso.images.length > 0 %}
                <div class="mt-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {% for image in caso.images %}
                        <figure class="relative group overflow-hidden rounded-xl shadow-lg bg-slate-900">
                            <img 
                                src="{{ image.url }}" 
                                alt="{{ image.alt | default('Imagen del caso de éxito') }}" 
                                class="w-full aspect-[4/3] object-cover group-hover:scale-105 group-hover:opacity-90 transition-all duration-500"
                                width="600"
                                height="450"
                                loading="lazy"
                                decoding="async">
                            {% if image.caption %}
                            <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-900/90 to-transparent p-4">
                                <p class="text-white text-sm">{{ image.caption }}</p>
                            </figcaption>
                            {% endif %}
                        </figure>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

            </div>
        </div>
    </header>

    <!-- Main Content -->
    <article class="py-16 bg-white" itemprop="articleBody">
        <div class="max-w-[900px] mx-auto px-4 sm:px-8 md:px-12">
            <!-- Ya no necesitamos esta sección porque la hemos movido al resumen del caso arriba -->
            
            <div class="prose prose-lg max-w-none" itemprop="text">
                {% if content %}
                    {{ content | safe }}
                {% else %}
                    <!-- Mostrar un mensaje de error si no hay contenido -->
                    <div class="bg-red-50 p-4 rounded-md">
                        <p class="text-red-600">No se encontró contenido para este caso.</p>
                    </div>
                {% endif %}
            </div>

            <!-- Related Service(s) CTA -->
            {% if caso.relatedServices and caso.relatedServices.length > 0 %}
            <div class="mt-16 p-8 bg-gradient-to-br from-slate-50 to-white rounded-2xl border border-slate-100 shadow-lg text-center">
                <h3 class="text-2xl font-bold text-slate-800 mb-4">¿Tiene un caso similar?</h3>
                <p class="text-lg text-slate-600 mb-6">
                    Este caso es un ejemplo de nuestra experiencia en:
                </p>
                <div class="flex flex-wrap gap-3 justify-center mb-8">
                    {% for service in caso.relatedServices %}
                    <a href="{{ service.url }}" class="inline-flex items-center px-4 py-2 bg-cyan-100 text-cyan-700 font-semibold rounded-lg hover:bg-cyan-200 transition-colors cursor-pointer">
                        {{ service.title }}
                        <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                    {% endfor %}
                </div>
                <p class="text-slate-600 mb-8">
                    Si necesita un diagnóstico técnico en Barcelona, podemos ayudarle.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/contacto/" class="inline-flex items-center justify-center px-8 py-4 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 shadow-md hover:shadow-lg transition-all group cursor-pointer">
                        Solicitar Presupuesto
                        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </a>
                    <a href="tel:+34932123456" class="inline-flex items-center justify-center px-8 py-4 border-2 border-cyan-500 text-cyan-600 font-semibold rounded-lg hover:bg-cyan-50 hover:text-cyan-700 transition-all cursor-pointer">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        Llamar Ahora
                    </a>
                </div>
            </div>
            {% elif caso.relatedService and caso.relatedService.title and caso.relatedService.url %}
            <div class="mt-16 p-8 bg-gradient-to-br from-slate-50 to-white rounded-2xl border border-slate-100 shadow-lg text-center">
                <h3 class="text-2xl font-bold text-slate-800 mb-4">¿Tiene un caso similar?</h3>
                <p class="text-lg text-slate-600 mb-8">
                    Este caso es un ejemplo de nuestra experiencia en 
                    <a href="{{ caso.relatedService.url }}" class="text-cyan-600 font-semibold cursor-pointer hover:text-cyan-700 transition-colors">
                        {{ caso.relatedService.title }}
                    </a>. 
                    Si necesita un diagnóstico técnico en Barcelona, podemos ayudarle.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/contacto/" class="inline-flex items-center justify-center px-8 py-4 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 shadow-md hover:shadow-lg transition-all group cursor-pointer">
                        Solicitar Presupuesto
                        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </a>
                    <a href="tel:+34932123456" class="inline-flex items-center justify-center px-8 py-4 border-2 border-cyan-500 text-cyan-600 font-semibold rounded-lg hover:bg-cyan-50 hover:text-cyan-700 transition-all cursor-pointer">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        Llamar Ahora
                    </a>
                </div>
            </div>
            {% endif %}
        </div>
    </article>
</article>
{% else %}
<!-- Caso no publicado -->
<div class="pt-[70px] lg:pt-[120px]">
    <div class="max-w-[900px] mx-auto px-4 sm:px-8 md:px-12 py-20 text-center">
        <div class="bg-yellow-50 border border-yellow-100 p-8 rounded-xl shadow-sm">
            <svg class="w-16 h-16 mx-auto text-yellow-500 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <h1 class="text-2xl font-bold text-slate-800 mb-4">Contenido en Preparación</h1>
            <p class="text-lg text-slate-600 mb-8">Lo sentimos, este caso de éxito aún está siendo revisado y no está disponible para consulta.</p>
            <a href="/casos-exito/" class="inline-flex items-center justify-center px-6 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-all">
                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
                </svg>
                Volver a Casos de Éxito
            </a>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block pageStyles %}
 {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}

<style>
    {{ indexCSS | safe }}

/* Estilos para el breadcrumb en fondo claro - específico para success-case.njk */
header nav[aria-label="Breadcrumb"] ol {
    color: #0e7490 !important;
}

header nav[aria-label="Breadcrumb"] a {
    color: #0e7490 !important;
    font-weight: 500;
}

header nav[aria-label="Breadcrumb"] a:hover {
    color: #164e63 !important;
    text-decoration: underline;
}

header nav[aria-label="Breadcrumb"] svg {
    color: #0e7490 !important;
}

header nav[aria-label="Breadcrumb"] span[aria-current="page"] {
    color: #0f172a !important;
    font-weight: 400;
}

/* Estilos mejorados para la página de caso individual */
.prose {
    @apply text-slate-600 max-w-none text-lg leading-relaxed;
}

.prose h2 {
    @apply text-3xl md:text-4xl font-light text-slate-800 mt-16 mb-10;
    background: linear-gradient(to right, #0891b2, #0e7490);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    overflow: visible;
}

.prose h2::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    height: 2px;
    width: 60px;
    background: linear-gradient(to right, #0891b2, #0e7490);
    transition: width 0.3s ease;
}

.prose h3 {
    @apply text-2xl font-semibold text-slate-700 mt-12 mb-6;
    border-bottom: 2px solid #06b6d4;
    display: inline-block;
    transition: border-width 0.3s ease;
}

.prose h3:hover {
    border-bottom-width: 3px;
}

.prose p {
    @apply mb-6 text-slate-600;
}

.prose strong {
    @apply font-semibold text-cyan-700 bg-cyan-50 px-1 rounded;
    transition: background-color 0.3s ease;
}

.prose figure {
    @apply my-12 rounded-xl shadow-lg overflow-hidden;
}

.prose figure img {
    @apply w-full h-auto transition-transform hover:scale-105 duration-500;
}

.prose figure figcaption {
    @apply text-sm text-slate-500 text-center bg-slate-50 p-4;
}

.prose blockquote {
    @apply my-12 pl-8 py-6 bg-gradient-to-r from-cyan-50 to-transparent rounded-r-lg border-l-4 border-cyan-400 text-lg italic text-slate-700;
}

.prose ul {
    @apply my-8 space-y-4;
}

.prose li {
    @apply relative py-3 pl-6 pr-4 rounded-lg transition-all duration-300;
    background: linear-gradient(to right, rgba(8, 145, 178, 0.05) 0%, transparent 100%);
}

.prose li:hover {
    @apply translate-x-2;
    background: linear-gradient(to right, rgba(8, 145, 178, 0.1) 0%, transparent 100%);
}

.prose a {
    @apply text-cyan-600 font-medium relative inline-block cursor-pointer;
    background-image: linear-gradient(transparent 70%, rgba(8, 145, 178, 0.2) 70%);
    background-size: 0 100%;
    background-repeat: no-repeat;
    transition: background-size .4s ease, color .3s ease;
}

.prose a:hover {
    @apply text-cyan-700;
    background-size: 100% 100%;
}
</style>
{% endblock %}
