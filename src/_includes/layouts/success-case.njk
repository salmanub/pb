{% extends "layouts/base.njk" %}

{% block content %}
<main class="pt-[70px] lg:pt-[120px]">
    <!-- Schema JSON-LD mejorado - El formato preferido por Google para rich snippets -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "TechnicalArticle",
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ metadata.site.url }}{{ page.url }}"
        },
        "headline": "{{ title | truncate(110) }}",
        "description": "{{ description }}",
        "image": {% if caso.image %}[{
            "@type": "ImageObject",
            "url": "{{ metadata.site.url }}{{ caso.image.url }}",
            "width": 1200,
            "height": 675,
            "caption": "{{ caso.image.caption | default('Imagen de caso de éxito de ' + metadata.site.title) }}"
        }]{% elif caso.images and caso.images[0] %}[{
            "@type": "ImageObject",
            "url": "{{ metadata.site.url }}{{ caso.images[0].url }}",
            "width": 600,
            "height": 450,
            "caption": "{{ caso.images[0].caption | default('Imagen de caso de éxito de ' + metadata.site.title) }}"
        }{% for image in caso.images %}{% if loop.index > 1 %}, {
            "@type": "ImageObject",
            "url": "{{ metadata.site.url }}{{ image.url }}",
            "width": 600,
            "height": 450,
            "caption": "{{ image.caption | default('Imagen ' + loop.index + ' de caso de éxito') }}"
        }{% endif %}{% endfor %}]
        {% else %}[{
            "@type": "ImageObject",
            "url": "{{ metadata.site.url }}/assets/images/logos/logo.png",
            "width": 600,
            "height": 60,
            "caption": "Logo de {{ metadata.site.title }}"
        }]{% endif %},
        "thumbnailUrl": {% if caso.image %}"{{ metadata.site.url }}{{ caso.image.url }}"{% elif caso.images and caso.images[0] %}"{{ metadata.site.url }}{{ caso.images[0].url }}"{% else %}"{{ metadata.site.url }}/assets/images/logos/logo.png"{% endif %},
        
        "datePublished": "{{ datePublished }}",
        "dateModified": "{{ dateModified }}",
        {% if caso.tags and caso.tags.length > 0 %}"keywords": "{{ caso.tags | join(', ') }}",{% endif %}
        "articleSection": "Casos de Éxito",
        "articleBody": "{{ content | striptags | replace('"', '\\"') }}",
        "author": {
            "@type": "Person",
            "name": "{{ metadata.author.name }}",
            "url": "{{ metadata.author.linkedin }}",
            "jobTitle": "{{ metadata.author.jobTitle }}",
            "sameAs": [
                "{{ metadata.author.linkedin }}"
            ],
            "worksFor": {
                "@type": "Organization",
                "name": "{{ metadata.company.name }}",
                "url": "{{ metadata.site.url }}",
                "sameAs": [
                    "{{ metadata.company.linkedin }}"
                ]
            }
        },
        "creator": "{{ metadata.author.name }}",
        "editor": "{{ metadata.author.name }}",
        
        "publisher": {
            "@type": "Organization",
            "name": "{{ metadata.site.title }}",
            "url": "{{ metadata.site.url }}",
            "logo": {
                "@type": "ImageObject",
                "url": "{{ metadata.site.url }}/assets/images/logos/logo.png",
                "width": "600",
                "height": "60"
            },
            "sameAs": [
                "{{ metadata.company.linkedin }}"
            ]
        },
        {% if caso.summary %}
        "about": {
            "@type": "TechArticle",
            "name": "Informe Pericial Técnico: {{ title }}",
            "description": "Caso de éxito en informe pericial técnico en {{ caso.summary[0].value | default('Barcelona') }}",
            "audience": "Propietarios, Administradores de fincas, Comunidades de vecinos, Aseguradoras",
            "educationalUse": "Informativo",
            "specialty": "{% if caso.tags %}{{ caso.tags | join(', ') }}{% else %}Peritaje Técnico{% endif %}"
        },
        {% endif %}
        "speakable": {
            "@type": "SpeakableSpecification",
            "cssSelector": ["h1", ".prose h2", ".prose h3"]
        },
        "inLanguage": "{{ metadata.default_lang }}",
        "isAccessibleForFree": "True",
        "locationCreated": {
            "@type": "Place",
            "name": "Barcelona, España",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Barcelona",
                "addressRegion": "Cataluña",
                "addressCountry": "ES"
            }
        },
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "EUR",
            "availability": "https://schema.org/InStock"
        }
    }
    </script>
    
    <!-- Breadcrumb Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Inicio",
                "item": "{{ metadata.site.url }}/"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Casos de Éxito",
                "item": "{{ metadata.site.url }}/casos-exito/"
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": "{{ title }}",
                "item": "{{ metadata.site.url }}{{ page.url }}"
            }
        ]
    }
    </script>
    
    <!-- Mantenemos los atributos itemscope/itemtype para compatibilidad con herramientas antiguas -->
    <div itemscope itemtype="https://schema.org/TechnicalArticle">
        <meta itemprop="headline" content="{{ title | truncate(110) }}">
        <meta itemprop="description" content="{{ description }}">
        <meta itemprop="mainEntityOfPage" content="{{ metadata.site.url }}{{ page.url }}">
        <meta itemprop="datePublished" content="{{ datePublished }}">
        <meta itemprop="dateModified" content="{{ dateModified }}">
        {% if caso.tags and caso.tags.length > 0 %}<meta itemprop="keywords" content="{{ caso.tags | join(', ') }}">{% endif %}
        
        <!-- Author -->
        <div itemprop="author" itemscope itemtype="https://schema.org/Person">
            <meta itemprop="name" content="{{ metadata.author.name }}">
            <meta itemprop="jobTitle" content="{{ metadata.author.jobTitle }}">
            <meta itemprop="url" content="{{ metadata.author.linkedin }}">
            <div itemprop="worksFor" itemscope itemtype="https://schema.org/Organization">
                <meta itemprop="name" content="{{ metadata.company.name }}">
                <meta itemprop="url" content="{{ metadata.site.url }}">
            </div>
        </div>
        
        <!-- Publisher -->
        <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
            <meta itemprop="name" content="{{ metadata.company.name }}">
            <meta itemprop="url" content="{{ metadata.site.url }}">
            <meta itemprop="sameAs" content="{{ metadata.company.linkedin }}">
            <div itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
                <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
                <meta itemprop="width" content="600">
                <meta itemprop="height" content="60">
            </div>
        </div>
        
        <!-- Images -->
        {% if caso.image %}
        <div itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ caso.image.url }}">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}{{ caso.image.url }}">
            <meta itemprop="caption" content="{{ caso.image.caption | default('Imagen de caso de éxito de ' + metadata.site.title) }}">
            <meta itemprop="width" content="1200">
            <meta itemprop="height" content="675">
        </div>
        {% elif caso.images and caso.images[0] %}
        <div itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ caso.images[0].url }}">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}{{ caso.images[0].url }}">
            <meta itemprop="caption" content="{{ caso.images[0].caption | default('Imagen de caso de éxito de ' + metadata.site.title) }}">
            <meta itemprop="width" content="600">
            <meta itemprop="height" content="450">
        </div>
        {% else %}
        <div itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="caption" content="Logo de {{ metadata.site.title }}">
            <meta itemprop="width" content="600">
            <meta itemprop="height" content="60">
        </div>
        {% endif %}
    </div>
    <!-- Hero Section -->
    <header class="bg-gradient-to-br from-slate-50 to-white py-12 px-4 md:px-[5%] shadow-sm">
        <div class="max-w-[1000px] mx-auto">
            <!-- Breadcrumbs -->
            <nav class="mb-8 text-sm text-cyan-600/80">
                <div class="flex items-center gap-2">
                    <a href="/" class="hover:text-cyan-600 transition-colors cursor-pointer">Inicio</a>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                    <a href="/casos-exito/" class="hover:text-cyan-600 transition-colors cursor-pointer">Casos de Éxito</a>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                    <span class="text-slate-800">{{ title | truncate(40) }}</span>
                </div>
            </nav>
            
            <!-- Title and Tags -->
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-6 leading-tight" itemprop="headline name">
                    {{ title }}
                </h1>
                <div class="flex flex-wrap gap-2 mb-8">
                    {% for tag in caso.tags %}
                    <span class="tag-categoria text-xs font-semibold px-3 py-1 rounded-full
                        {% if tag == 'Construcción' %}bg-cyan-100 text-cyan-700
                        {% elif tag == 'Seguros' %}bg-green-100 text-green-700
                        {% elif tag == 'Patologías' %}bg-purple-100 text-purple-700
                        {% elif tag == 'Humedades' %}bg-blue-100 text-blue-700
                        {% elif tag == 'Estructural' %}bg-amber-100 text-amber-700
                        {% elif tag == 'Comunidades' %}bg-emerald-100 text-emerald-700
                        {% else %}bg-slate-100 text-slate-700{% endif %}">
                        {{ tag }}
                    </span>
                    {% else %}
                    <!-- Mostrar un mensaje si no hay tags -->
                    <span class="text-xs text-gray-500">Sin categorías</span>
                    {% endfor %}
                </div>

                <!-- Case Summary Box -->
                {% if caso.summary and caso.summary.length > 0 %}
                <div class="bg-gradient-to-br from-white to-slate-50/80 p-6 rounded-xl shadow-md border border-slate-100">
                    <h2 class="text-xl font-semibold text-slate-800 mb-4">Resumen del Caso:</h2>
                    <dl class="grid sm:grid-cols-2 gap-4">
                        {% for item in caso.summary %}
                        <div>
                            <dt class="font-medium text-slate-600">{{ item.label }}:</dt>
                            <dd class="text-slate-800">{{ item.value }}</dd>
                        </div>
                        {% endfor %}
                    </dl>
                </div>
                {% endif %}

                <!-- Single Image or Gallery -->
                {% if caso.image %}
                <div class="mt-8">
                    <figure class="relative group overflow-hidden rounded-xl shadow-lg bg-slate-900" itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
                        <meta itemprop="width" content="1200">
                        <meta itemprop="height" content="675">
                        <img 
                            src="{{ caso.image.url }}" 
                            itemprop="url contentUrl"
                            alt="{{ caso.image.alt }}" 
                            class="w-full aspect-[16/9] object-cover group-hover:scale-105 group-hover:opacity-90 transition-all duration-500"
                            loading="lazy"
                            width="1200"
                            height="675">
                        {% if caso.image.caption %}
                        <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-900/90 to-transparent p-4" itemprop="caption">
                            <p class="text-white text-sm">{{ caso.image.caption }}</p>
                        </figcaption>
                        {% endif %}
                    </figure>
                </div>
                {% elif caso.images and caso.images.length > 0 %}
                <div class="mt-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {% for image in caso.images %}
                        <figure class="relative group overflow-hidden rounded-xl shadow-lg bg-slate-900">
                            <img 
                                src="{{ image.url }}" 
                                alt="{{ image.alt | default('Imagen del caso de éxito') }}" 
                                class="w-full aspect-[4/3] object-cover group-hover:scale-105 group-hover:opacity-90 transition-all duration-500"
                                loading="lazy"
                                width="600"
                                height="450">
                            {% if image.caption %}
                            <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-900/90 to-transparent p-4">
                                <p class="text-white text-sm">{{ image.caption }}</p>
                            </figcaption>
                            {% endif %}
                        </figure>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

            </div>
        </div>
    </header>

    <!-- Main Content -->
    <article class="py-16 bg-white" itemprop="articleBody">
        <div class="max-w-[900px] mx-auto px-4 sm:px-8 md:px-12">
            <!-- Metadatos del autor y fechas de publicación visibles para SEO -->
            <div class="mb-8 text-sm text-slate-500 flex justify-between items-center">
                <div class="flex items-center" itemprop="author" itemscope itemtype="https://schema.org/Person">
                    <span class="font-medium text-cyan-700" itemprop="name">{{ metadata.author.name }}</span>
                    <span class="ml-1 text-slate-400">|</span>
                    <span class="ml-1" itemprop="jobTitle">{{ metadata.author.jobTitle }}</span>
                </div>
                <div>
                    <time datetime="{{ datePublished }}" itemprop="datePublished" class="inline-block mr-3">
                        Publicado: {{ datePublished }}
                    </time>
                    {% if dateModified and dateModified != datePublished %}
                    <time datetime="{{ dateModified }}" itemprop="dateModified" class="inline-block">
                        Actualizado: {{ dateModified }}
                    </time>
                    {% endif %}
                </div>
            </div>
            
            <div class="prose prose-lg max-w-none" itemprop="text">
                {% if content %}
                    {{ content | safe }}
                {% else %}
                    <!-- Mostrar un mensaje de error si no hay contenido -->
                    <div class="bg-red-50 p-4 rounded-md">
                        <p class="text-red-600">No se encontró contenido para este caso.</p>
                    </div>
                {% endif %}
            </div>

            <!-- Related Service CTA -->
            {% if caso.relatedService and caso.relatedService.title and caso.relatedService.url %}
            <div class="mt-16 p-8 bg-gradient-to-br from-slate-50 to-white rounded-2xl border border-slate-100 shadow-lg text-center">
                <h3 class="text-2xl font-bold text-slate-800 mb-4">¿Tiene un caso similar?</h3>
                <p class="text-lg text-slate-600 mb-8">
                    Este caso es un ejemplo de nuestra experiencia en 
                    <a href="{{ caso.relatedService.url }}" class="text-cyan-600 font-semibold cursor-pointer hover:text-cyan-700 transition-colors">
                        {{ caso.relatedService.title }}
                    </a>. 
                    Si necesita un diagnóstico técnico en Barcelona, podemos ayudarle.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/contacto/" class="inline-flex items-center justify-center px-8 py-4 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 shadow-md hover:shadow-lg transition-all group cursor-pointer">
                        Solicitar Presupuesto
                        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </a>
                    <a href="tel:+34932123456" class="inline-flex items-center justify-center px-8 py-4 border-2 border-cyan-500 text-cyan-600 font-semibold rounded-lg hover:bg-cyan-50 hover:text-cyan-700 transition-all cursor-pointer">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        Llamar Ahora
                    </a>
                </div>
            </div>
            {% endif %}
        </div>
    </article>
</main>

{% block pageStyles %}
 {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}

<style>
    {{ indexCSS | safe }}

/* Estilos mejorados para la página de caso individual */
.prose {
    @apply text-slate-600 max-w-none text-lg leading-relaxed;
}

.prose h2 {
    @apply text-3xl md:text-4xl font-light text-slate-800 mt-16 mb-10;
    background: linear-gradient(to right, #0891b2, #0e7490);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    overflow: visible;
}

.prose h2::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    height: 2px;
    width: 60px;
    background: linear-gradient(to right, #0891b2, #0e7490);
    transition: width 0.3s ease;
}

.prose h3 {
    @apply text-2xl font-semibold text-slate-700 mt-12 mb-6;
    border-bottom: 2px solid #06b6d4;
    display: inline-block;
    transition: border-width 0.3s ease;
}

.prose h3:hover {
    border-bottom-width: 3px;
}

.prose p {
    @apply mb-6 text-slate-600;
}

.prose strong {
    @apply font-semibold text-cyan-700 bg-cyan-50 px-1 rounded;
    transition: background-color 0.3s ease;
}

.prose figure {
    @apply my-12 rounded-xl shadow-lg overflow-hidden;
}

.prose figure img {
    @apply w-full h-auto transition-transform hover:scale-105 duration-500;
}

.prose figure figcaption {
    @apply text-sm text-slate-500 text-center bg-slate-50 p-4;
}

.prose blockquote {
    @apply my-12 pl-8 py-6 bg-gradient-to-r from-cyan-50 to-transparent rounded-r-lg border-l-4 border-cyan-400 text-lg italic text-slate-700;
}

.prose ul {
    @apply my-8 space-y-4;
}

.prose li {
    @apply relative py-3 pl-6 pr-4 rounded-lg transition-all duration-300;
    background: linear-gradient(to right, rgba(8, 145, 178, 0.05) 0%, transparent 100%);
}

.prose li:hover {
    @apply translate-x-2;
    background: linear-gradient(to right, rgba(8, 145, 178, 0.1) 0%, transparent 100%);
}

.prose a {
    @apply text-cyan-600 font-medium relative inline-block cursor-pointer;
    background-image: linear-gradient(transparent 70%, rgba(8, 145, 178, 0.2) 70%);
    background-size: 0 100%;
    background-repeat: no-repeat;
    transition: background-size .4s ease, color .3s ease;
}

.prose a:hover {
    @apply text-cyan-700;
    background-size: 100% 100%;
}
</style>
{% endblock %}
{% endblock %}
