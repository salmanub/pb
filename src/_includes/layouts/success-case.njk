{% extends "layouts/base.njk" %}

{% block content %}
{% if not caso.estado or caso.estado == "publicado" %}
<article class="pt-[70px] lg:pt-[100px]" itemscope itemtype="https://schema.org/Article">
    <!-- Schema microdata oculto -->
    <div hidden>
        <meta itemprop="headline" content="{{ title | truncate(110) }}">
        <meta itemprop="description" content="{{ description }}">
        <meta itemprop="mainEntityOfPage" content="{{ metadata.site.url }}{{ page.url }}">
        <meta itemprop="datePublished" content="{{ datePublished }}T00:00:00+01:00">
        <meta itemprop="dateModified" content="{{ dateModified }}T00:00:00+01:00">
        {% if caso.tags and caso.tags.length > 0 %}<meta itemprop="keywords" content="{{ caso.tags | join(', ') }}">{% endif %}
        <meta itemprop="inLanguage" content="{{ lang }}">
        <meta itemprop="isAccessibleForFree" content="True">
        
        <!-- Author -->
        <span itemprop="author" itemscope itemtype="https://schema.org/Person">
            <meta itemprop="name" content="{{ metadata.author.name }}">
            <meta itemprop="jobTitle" content="{{ metadata.author.jobTitle[lang] }}">
            <meta itemprop="url" content="{{ metadata.author.linkedin }}">
        </span>
        
        <!-- Images -->
        {% if caso.image %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ caso.image.url }}">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}{{ caso.image.url }}">
            <meta itemprop="caption" content="{{ caso.image.caption | default('Imagen de caso de éxito de ' + metadata.site.title) }}">
            <meta itemprop="width" content="1200">
            <meta itemprop="height" content="675">
        </span>
        {% elif caso.images and caso.images[0] %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ caso.images[0].url }}">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}{{ caso.images[0].url }}">
            <meta itemprop="caption" content="{{ caso.images[0].caption | default('Imagen de caso de éxito de ' + metadata.site.title) }}">
            <meta itemprop="width" content="600">
            <meta itemprop="height" content="450">
        </span>
        {% else %}
        <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="contentUrl" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
            <meta itemprop="caption" content="Logo de {{ metadata.site.title }}">
            <meta itemprop="width" content="600">
            <meta itemprop="height" content="60">
        </span>
        {% endif %}
    </div>
    
    <!-- Hero Section -->
    <header class="bg-slate-50 py-16 px-6 md:px-12 lg:px-16 border-b border-slate-100 relative overflow-hidden">
        <div class="absolute inset-0 bg-grid-pattern opacity-[0.3]"></div>
        <div class="max-w-5xl mx-auto relative z-10">
            <!-- Breadcrumbs -->
            {% set parentService = {
                "title": "Casos de Éxito",
                "url": "/casos-exito/"
            } %}
            {% include "partials/breadcrumb.njk" %}
            
            <!-- Title and Tags -->
            <div class="mt-8">
                 <span class="badge badge-primary mb-4">Caso de Éxito</span>
                <h1 class="text-3xl md:text-5xl font-black text-slate-900 mb-8 leading-tight tracking-tight uppercase" itemprop="headline name">
                    {{ title }}
                </h1>
                <!-- Quitamos las etiquetas duplicadas aquí porque ya se muestran en el recuadro del resumen -->
                <div class="mb-8"></div>

                <!-- Case Summary Box -->
                <div class="bg-white p-8 rounded-2xl shadow-soft border border-slate-100 mb-8">
                    <!-- Datos del caso -->
                    {% if caso.summary and caso.summary.length > 0 %}
                    <div>
                        <h2 class="text-lg font-bold text-slate-900 mb-6 flex items-center uppercase tracking-wider">
                            <svg class="w-5 h-5 text-cyan-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            {{ metadata.caseLabels[lang].summary }}
                        </h2>
                        <dl class="grid sm:grid-cols-2 gap-4">
                            {% for item in caso.summary %}
                            <div class="p-4 bg-slate-50 rounded-xl hover:bg-slate-100 transition-colors border border-slate-100/50">
                                <dt class="font-bold text-slate-900 text-xs uppercase tracking-wide mb-1">{{ item.label }}</dt>
                                <dd class="text-slate-600">{{ item.value }}</dd>
                            </div>
                            {% endfor %}
                        </dl>
                    </div>
                    {% endif %}
                    
                    <!-- Categorías -->
                    {% if caso.tags and caso.tags.length > 0 %}
                    <div class="mt-6 pt-6 border-t border-slate-100">
                        <div class="flex items-center gap-3">
                            <span class="font-bold text-slate-900 text-sm uppercase tracking-wide">{{ metadata.caseLabels[lang].categories }}:</span>
                            <div class="flex flex-wrap gap-2">
                                {% for tag in caso.tags %}
                                <span class="badge badge-primary bg-slate-100 text-slate-600 border-slate-200">
                                    {{ tag }}
                                </span>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>
                
                <!-- Metadatos del artículo (autor y fechas) -->
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 text-sm text-slate-500 border-t border-slate-200 pt-6">
                    <!-- Autor -->
                    <div class="flex items-center">
                        <svg class="w-4 h-4 text-cyan-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <span class="font-bold text-slate-900">{{ metadata.author.name }}</span>
                        <span class="mx-2">|</span>
                        <span>{{ metadata.author.jobTitle[lang] }}</span>
                    </div>
                    
                    <!-- Fechas -->
                    <div class="flex flex-wrap items-center gap-4">
                        <div class="flex items-center">
                            <span class="font-medium mr-1">Publicado:</span>
                            <time datetime="{{ datePublished }}">{{ datePublished }}</time>
                        </div>
                        
                        {% if dateModified and dateModified != datePublished %}
                        <div class="flex items-center">
                            <span class="font-medium mr-1">Actualizado:</span>
                            <time datetime="{{ dateModified }}">{{ dateModified }}</time>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Single Image or Gallery -->
                <div class="mt-12">
                    {% if caso.image or (not caso.images or caso.images.length == 0) %}
                    <figure class="relative group overflow-hidden rounded-2xl shadow-xl bg-slate-100">
                        {% set imgSrc = caso.image.url if caso.image else metadata.site.placeholderImage %}
                        {# Extraer el path completo y nombre sin extensión #}
                        {% set imgPath = imgSrc | replace(".jpg", "") | replace(".jpeg", "") | replace(".png", "") | replace(".JPG", "") | replace(".JPEG", "") | replace(".PNG", "") %}
                        {# Manejar rutas que empiezan con src/ o con / #}
                        {% if "src/assets/images/" in imgPath %}
                            {% set imgRelativePath = imgPath.split("src/assets/images/")[1] %}
                        {% elif "/assets/images/" in imgPath %}
                            {% set imgRelativePath = imgPath.split("/assets/images/")[1] %}
                        {% else %}
                            {% set imgRelativePath = imgPath %}
                        {% endif %}
                        {% set imgBasePath = "/assets/images/optimized/" + imgRelativePath %}
                        
                        <picture>
                            <source 
                                srcset="{{ imgBasePath }}-320w.avif 320w, {{ imgBasePath }}-640w.avif 640w, {{ imgBasePath }}-1280w.avif 1280w, {{ imgBasePath }}-1920w.avif 1920w"
                                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
                                type="image/avif">
                            <source 
                                srcset="{{ imgBasePath }}-320w.webp 320w, {{ imgBasePath }}-640w.webp 640w, {{ imgBasePath }}-1280w.webp 1280w, {{ imgBasePath }}-1920w.webp 1920w"
                                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
                                type="image/webp">
                            <source 
                                srcset="{{ imgBasePath }}-320w.jpg 320w, {{ imgBasePath }}-640w.jpg 640w, {{ imgBasePath }}-1280w.jpg 1280w, {{ imgBasePath }}-1920w.jpg 1920w"
                                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
                                type="image/jpeg">
                            <img 
                                src="{{ imgBasePath }}-1280w.jpg" 
                                alt="{{ caso.image.alt if caso.image else 'Imagen del caso de éxito' }}" 
                                class="w-full aspect-[21/9] object-cover"
                                width="1200"
                                height="675"
                                loading="eager"
                                fetchpriority="high"
                                decoding="async">
                        </picture>
                        {% if caso.image and caso.image.caption %}
                        <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-6 pt-12">
                            <p class="text-white text-sm font-medium">{{ caso.image.caption }}</p>
                        </figcaption>
                        {% endif %}
                    </figure>
                    {% elif caso.images and caso.images.length > 0 %}
                <div class="mt-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {% for image in caso.images %}
                        <figure class="relative group overflow-hidden rounded-2xl shadow-lg bg-slate-100">
                            <img 
                                src="{{ image.url }}" 
                                alt="{{ image.alt | default('Imagen del caso de éxito') }}" 
                                class="w-full aspect-[4/3] object-cover transition-opacity duration-700 hover:opacity-90"
                                width="600"
                                height="450"
                                loading="lazy"
                                decoding="async">
                            {% if image.caption %}
                            <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-4">
                                <p class="text-white text-sm">{{ image.caption }}</p>
                            </figcaption>
                            {% endif %}
                        </figure>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

            </div>
        </div>
    </header>

    <!-- Main Content -->
    <article class="py-16 md:py-24 bg-white w-full" itemprop="articleBody">
        <div class="max-w-4xl mx-auto px-6 md:px-12 lg:px-16">
            
            <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:font-bold prose-p:text-slate-600 prose-a:text-cyan-600 prose-strong:text-slate-900" itemprop="text">
                {% if content %}
                    {{ content | safe }}
                {% else %}
                    <!-- Mostrar un mensaje de error si no hay contenido -->
                    <div class="bg-red-50 p-4 rounded-md">
                        <p class="text-red-600">No se encontró contenido para este caso.</p>
                    </div>
                {% endif %}
            </div>

            <!-- Related Service(s) CTA -->
            {% if caso.relatedServices and caso.relatedServices.length > 0 %}
            <div class="mt-20 p-10 bg-slate-50 rounded-3xl border border-slate-100 shadow-soft text-center relative overflow-hidden">
                <div class="absolute inset-0 bg-grid-pattern opacity-[0.4]"></div>
                <div class="relative z-10">
                    <h3 class="text-2xl font-black text-slate-900 mb-4">{{ metadata.caseCTA[lang].title }}</h3>
                    <p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
                        {{ metadata.caseCTA[lang].intro }}:
                    </p>
                    <div class="flex flex-wrap gap-3 justify-center mb-10">
                        {% for service in caso.relatedServices %}
                        <a href="{{ service.url }}" class="inline-flex items-center px-4 py-2 bg-white border border-slate-200 text-slate-700 font-bold rounded-full hover:border-cyan-500 hover:text-cyan-600 transition-colors shadow-sm">
                            {{ service.title }}
                            <svg class="w-4 h-4 ml-2 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                        {% endfor %}
                    </div>
                    <p class="text-slate-500 mb-8 font-medium">
                        {{ metadata.caseCTA[lang].help }}
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="{{ metadata.navBar[lang].linkPresupuesto }}" class="btn-primary">
                            {{ metadata.navBar[lang].ctaPresupuesto }}
                            <svg class="w-5 h-5 ml-2 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                        <a href="tel:{{ metadata.contact.phoneNumber | replace(' ', '') }}" class="btn-secondary">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                            {{ metadata.serviceChild[lang].llamarAhora }}
                        </a>
                    </div>
                </div>
            </div>
            {% elif caso.relatedService and caso.relatedService.title and caso.relatedService.url %}
             <div class="mt-20 p-10 bg-slate-50 rounded-3xl border border-slate-100 shadow-soft text-center relative overflow-hidden">
                <div class="absolute inset-0 bg-grid-pattern opacity-[0.4]"></div>
                <div class="relative z-10">
                    <h3 class="text-2xl font-black text-slate-900 mb-4">{{ metadata.caseCTA[lang].title }}</h3>
                    <p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
                        {{ metadata.caseCTA[lang].intro }} 
                        <a href="{{ caso.relatedService.url }}" class="text-cyan-600 font-bold hover:text-cyan-700 decoration-2 underline decoration-cyan-200 underline-offset-4">
                            {{ caso.relatedService.title }}
                        </a>. 
                        {{ metadata.caseCTA[lang].help }}
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="{{ metadata.navBar[lang].linkPresupuesto }}" class="btn-primary">
                            {{ metadata.navBar[lang].ctaPresupuesto }}
                            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                        <a href="tel:{{ metadata.contact.phoneNumber | replace(' ', '') }}" class="btn-secondary">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                            {{ metadata.serviceChild[lang].llamarAhora }}
                        </a>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </article>
</article>
{% else %}
<!-- Caso no publicado -->
<div class="pt-[70px] lg:pt-[120px]">
    <div class="max-w-[900px] mx-auto px-4 sm:px-8 md:px-12 py-20 text-center">
        <div class="bg-yellow-50 border border-yellow-100 p-8 rounded-xl shadow-sm">
            <svg class="w-16 h-16 mx-auto text-yellow-500 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <h1 class="text-2xl font-bold text-slate-800 mb-4">Contenido en Preparación</h1>
            <p class="text-lg text-slate-600 mb-8">Lo sentimos, este caso de éxito aún está siendo revisado y no está disponible para consulta.</p>
            <a href="/casos-exito/" class="btn-primary">
                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
                </svg>
                Volver a Casos de Éxito
            </a>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block pageStyles %}
 {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}

<style>
    {{ indexCSS | safe }}

/* Estilos mejorados para la página de caso individual */
.prose {
    @apply text-slate-600 max-w-none text-lg leading-relaxed;
}
/* Removed custom ad-hoc overrides, relying on .prose class in index.css as much as possible */
</style>
{% endblock %}
