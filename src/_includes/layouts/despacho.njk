{% extends "layouts/base.njk" %}

{% block content %}
<main id="main-content" class="bg-slate-50 overflow-hidden" itemscope itemtype="https://schema.org/ProfessionalService">
  <meta itemprop="name" content="{{ title }}">
  <meta itemprop="description" content="{{ description }}">
  
  <!-- Hero / Intro & Firm Description en Fila -->
  <header class="relative mt-[70px] lg:mt-[100px] bg-white overflow-hidden border-b border-slate-100" itemprop="mainEntity">
    <!-- Background Elements matching Home -->
    <div class="absolute inset-0 z-0">
        <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-100 skew-x-[-12deg] translate-x-1/4 origin-top"></div>
        <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-white to-transparent"></div>
    </div>

    <div class="relative z-10 w-full py-12 lg:py-20">
      <div class="w-full px-6 md:px-12 lg:px-16">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start lg:items-center">
          
          <!-- Izquierda: Título -->
          <div class="lg:col-span-5 flex flex-col justify-center animate-in fade-in slide-in-from-bottom-8 duration-700">
            <div class="mb-8 md:mb-10">
                <span class="flex items-center text-sm md:text-base font-bold tracking-[0.2em] uppercase text-teal-600 mb-6">
                    <span class="w-12 h-[2px] bg-teal-600 mr-4" aria-hidden="true"></span>
                    La Firma
                </span>
                <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-light leading-[0.95] tracking-tight text-slate-900 uppercase" itemprop="headline">
                  <span class="text-slate-900 font-light">{{ intro.title }}</span>
                  <strong class="block text-teal-400 font-normal mt-4">{{ intro.subtitle }}</strong>
                </h1>
            </div>
          </div>
          
          <!-- Derecha: Descripción de la Firma -->
          <div class="lg:col-span-7">
            <div class="prose prose-lg prose-slate font-light text-slate-600" itemprop="description">
              {% for paragraph in firm_description %}
                <p class="text-lg md:text-xl leading-relaxed mb-6 last:mb-0">{{ paragraph | safe }}</p>
              {% endfor %}
            </div>
          </div>

        </div>
      </div>
    </div>
  </header>

  <!-- Team Members Grid using Schema Microdata - Reorganizado en Columnas con su Contexto -->
  <section class="py-20 lg:py-28 px-6 md:px-12 lg:px-16 bg-gradient-to-br from-slate-100 via-white to-slate-50 border-t border-slate-100 relative isolate">
    <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.2)_1px,transparent_1px)] [background-size:32px_32px]"></div>
    
    <div class="relative z-10 w-full">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Izquierda: Título de la Sección de Equipo (Sticky on Scroll) -->
        <div class="lg:col-span-4 lg:sticky lg:top-32">
          <span class="text-teal-500 font-medium uppercase tracking-wider mb-4 block">Profesionales</span>
          <h2 class="text-3xl md:text-[2.5rem] font-light text-slate-900 leading-tight mb-6">{{ team_section.title }}</h2>
          <p class="text-xl text-slate-600 font-light">{{ team_section.description }}</p>
        </div>

        <!-- Derecha: Cards de los Empleados (Grid 2 Columnas Dentro de la Columna Principal) -->
        <div class="lg:col-span-8">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {% for member in team_members %}
            <div class="bg-white rounded-none shadow-xl hover:shadow-2xl transition-all duration-300 border border-slate-100 group flex flex-col h-full overflow-hidden" itemprop="employee" itemscope itemtype="https://schema.org/Person">
              <!-- Avatar & Header info en una pastilla superior -->
              <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-8 p-8 pb-6 border-b border-slate-50">
                <div class="flex-shrink-0">
                  {% if member.image %}
                    <div class="w-24 h-24 lg:w-28 lg:h-28 rounded-none overflow-hidden shadow-sm ring-4 ring-slate-50 bg-slate-100 relative employee-avatar-fit">
                      {% image member.image, member.name, "200px", "lazy", "high" %}
                    </div>
                  {% else %}
                    <div class="w-24 h-24 lg:w-28 lg:h-28 rounded-none overflow-hidden shadow-sm ring-4 ring-slate-50 bg-slate-100 flex items-center justify-center text-slate-300">
                      <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                      </svg>
                    </div>
                  {% endif %}
                </div>
                
                <div class="flex flex-col">
                  <div class="flex items-center gap-3 mb-2">
                    <h3 class="text-[1.75rem] font-bold text-slate-900 leading-tight" itemprop="name">{{ member.name }}</h3>
                    {% if member.linkedin %}
                      <a href="{{ member.linkedin }}" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-[#0A66C2] transition-colors" aria-label="LinkedIn de {{ member.name }}" itemprop="sameAs">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                        </svg>
                      </a>
                    {% endif %}
                  </div>
                  <div class="flex flex-col gap-1.5 items-start">
                    <span class="text-teal-600 font-medium text-lg" itemprop="jobTitle">{{ member.role }}</span>
                    {% if member.license %}
                      <span class="inline-flex items-center gap-1.5 text-xs text-slate-600 font-medium bg-slate-50 px-3 py-1 rounded-none border border-slate-200 mt-1" itemprop="identifier">
                        <svg class="w-3.5 h-3.5 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        {{ member.license_label }} <strong class="font-bold text-slate-700 ml-1">{{ member.license }}</strong>
                      </span>
                    {% endif %}
                  </div>
                </div>
              </div>
              
              <!-- Card Body Text -->
              <div class="p-8 pt-2 flex flex-col flex-grow bg-white">
                <div class="space-y-4 text-slate-600 text-[1.05rem] font-light leading-relaxed mb-8 flex-grow">
                  {% for para in member.description %}
                    <p>{{ para }}</p>
                  {% endfor %}
                </div>
                
                {% if member.specialties %}
                <div class="mt-auto pt-6 border-t border-slate-50">
                  <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">{{ member.specialties_title }}</h4>
                  <div class="flex flex-wrap gap-2.5">
                    {% for cert in member.specialties %}
                      <span class="bg-slate-50 text-slate-600 text-sm font-medium px-4 py-2 rounded-none border border-slate-100 group-hover:border-teal-100 group-hover:bg-teal-50/50 transition-colors shadow-sm">{{ cert }}</span>
                    {% endfor %}
                  </div>
                </div>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 md:py-32 bg-slate-900 overflow-hidden isolate">
    <div class="absolute inset-0">
        <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-800 skew-x-[-12deg] translate-x-1/4 origin-top opacity-30"></div>
    </div>
    
    <div class="w-full px-6 md:px-12 lg:px-16 relative z-10 max-w-3xl mx-auto text-center">
        <span class="text-teal-500 font-semibold tracking-wider uppercase mb-4 block">Contacto</span>
        <h2 class="text-[2.5rem] md:text-[3rem] font-black text-white mb-6 uppercase tracking-tight">{{ cta.title }}</h2>
        <p class="text-xl text-slate-300 mb-12 font-light">{{ cta.description }}</p>
        <a href="{{ cta.url }}" class="btn-primary bg-white text-slate-900 hover:bg-teal-50 hover:text-teal-600 border-none shadow-xl px-10">
            {{ cta.text }}
        </a>
    </div>
  </section>
</main>
{% endblock content %}

{% block pageStyles %}
  <style>
    /* Aseguramos que el contenido del shortcode rellenará perfectamente su contenedor redondeado */
    .employee-avatar-fit picture {
      display: contents;
    }
    .employee-avatar-fit picture img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }
  </style>
{% endblock pageStyles %}
