{% extends "layouts/base.njk" %}

{% block content %}
<main id="main-content" class="bg-slate-50 overflow-hidden">
    <!-- Hero Section con Grid de dos columnas en pantallas grandes -->
    <header class="relative mt-[70px] lg:mt-[100px] bg-white overflow-hidden border-b border-slate-100" itemprop="mainEntity">
        <!-- Background Elements matching Home -->
        <div class="absolute inset-0 z-0">
            <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-100 skew-x-[-12deg] translate-x-1/4 origin-top"></div>
            <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-white to-transparent"></div>
        </div>

        <div class="relative z-10 w-full py-12 lg:py-20">
            <div class="w-full px-6 md:px-12 lg:px-16">
                <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start lg:items-center">
                    <!-- Columna Izquierda: Título -->
                    <div class="lg:col-span-5 flex flex-col justify-center animate-in fade-in slide-in-from-bottom-8 duration-700">
                        <div class="mb-8 md:mb-10">
                            <span class="flex items-center text-sm md:text-base font-bold tracking-[0.2em] uppercase text-teal-600 mb-6">
                                <span class="w-12 h-[2px] bg-teal-600 mr-4" aria-hidden="true"></span>
                                Presupuesto
                            </span>
                            <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-light leading-[0.95] tracking-tight text-slate-900 uppercase" itemprop="headline">
                                <span class="text-slate-900 font-light">{{ hero.title }}</span>
                                <strong class="block text-teal-400 font-normal mt-4">{{ hero.subtitle }}</strong>
                            </h1>
                        </div>
                    </div>
                    <!-- Columna Derecha: Descripción -->
                    <div class="lg:col-span-7">
                        {% if hero.description %}
                        <p class="text-lg md:text-xl text-slate-600 font-light leading-relaxed" itemprop="description">
                            {{ hero.description }}
                        </p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Factors Section -->
    <section class="py-20 lg:py-28 px-6 md:px-12 lg:px-16 bg-white relative isolate border-b border-slate-100">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.2)_1px,transparent_1px)] [background-size:32px_32px]"></div>
        
        <div class="relative z-10 w-full">
            <!-- Grid del título y los factores -->
            <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
                
                <!-- Columna Izquierda: Título de Sección -->
                <div class="lg:col-span-4 lg:sticky lg:top-32">
                    <span class="text-teal-500 font-medium uppercase tracking-wider mb-4 block">Factores</span>
                    <h2 class="text-3xl md:text-[2.5rem] font-light text-slate-900 leading-tight mb-6">{{ factors.title }}</h2>
                    <p class="text-xl text-slate-600 font-light">{{ factors.description }}</p>
                </div>
                
                <!-- Columna Derecha: Factores (Grid) -->
                <div class="lg:col-span-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
                        {% for factor in factors.items %}
                        <div class="bg-white rounded-none p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 group">
                            <div class="w-12 h-12 rounded-none bg-teal-50 flex items-center justify-center mb-6 group-hover:bg-teal-100 transition-colors">
                                <svg class="w-6 h-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                            </div>
                            <h3 class="text-2xl font-bold text-slate-800 mb-4">{{ factor.name }}</h3>
                            <p class="text-slate-600 text-lg font-light leading-relaxed">{{ factor.description }}</p>
                        </div>
                        {% endfor %}
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Pricing Context -->
    <section class="py-24 px-6 md:px-12 lg:px-16 bg-gradient-to-b from-slate-50 to-white text-center border-b border-slate-100">
        <div class="w-full">
            <h2 class="text-[2rem] md:text-[2.5rem] font-light text-slate-800 mb-10">{{ pricing_context.title }}</h2>
            <div class="prose prose-lg prose-slate mx-auto text-slate-600 font-light mb-12">
                {% for paragraph in pricing_context.paragraphs %}
                <p class="text-[1.15rem] leading-relaxed mb-6">{{ paragraph | safe }}</p>
                {% endfor %}
            </div>
            <a href="{{ pricing_context.cta.url }}" class="btn-primary inline-flex mt-4 text-base font-semibold px-8 py-3.5 shadow-lg">
                {{ pricing_context.cta.text }}
            </a>
        </div>
    </section>

    <!-- FAQ Section -->
    <section style="background: var(--paper-50); border-top: 1px solid var(--border-subtle);"
             itemscope itemtype="https://schema.org/FAQPage">
      <div style="max-width: 880px; margin: 0 auto; padding: var(--section-y) var(--gutter);">
        <div style="margin-bottom: var(--block-gap);">
          <div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono);
                      font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                      text-transform: uppercase; font-weight: var(--fw-medium); color: var(--text-accent); margin-bottom: 18px;">
            <span style="width: 24px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
            § 06 · {{ faqs_section.eyebrow | default("Dudas resueltas") }}
          </div>
          <h2 style="font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 400;
                     line-height: var(--lh-display); letter-spacing: var(--tracking-tight); color: var(--text-strong); margin: 0;">
            {{ faqs_section.title }}
          </h2>
          {% if faqs_section.description %}
          <p style="margin-top: 14px; font-size: var(--fs-lede); line-height: var(--lh-lede); color: var(--text-muted); max-width: 60ch;">
            {{ faqs_section.description }}
          </p>
          {% endif %}
        </div>
        <div style="margin-top: 40px;">
          {% for faq in faqs %}
          <details style="border-top: 1px solid var(--border-hairline);" class="ds-faq"
                   itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
                   {{ 'open' if loop.first }}>
            <summary style="padding: 18px 0; cursor: pointer; display: grid; grid-template-columns: 36px 1fr 24px;
                            gap: 14px; align-items: center; list-style: none;">
              <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-faint);
                           letter-spacing: 0.06em; font-variant-numeric: tabular-nums;">{{ '%02d' | format(loop.index) }}</span>
              <span itemprop="name" style="font-family: var(--font-serif); font-size: 1.1rem;
                           font-weight: 500; color: var(--text-strong); line-height: 1.35;">{{ faq.question }}</span>
              <span class="ds-faq-icon" style="color: var(--text-faint); font-size: 1.1rem; font-weight: 300;
                           display: flex; align-items: center; justify-content: center; width: 24px; height: 24px;">+</span>
            </summary>
            <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer"
                 style="padding: 0 0 22px 50px; font-size: 0.95rem; color: var(--text-muted); line-height: 1.65; max-width: 58ch;">
              <div itemprop="text">
                {% if faq.answer is string %}
                <p>{{ faq.answer }}</p>
                {% else %}
                {% for paragraph in faq.answer %}
                <p style="margin: 0 0 10px;">{{ paragraph }}</p>
                {% endfor %}
                {% endif %}
              </div>
            </div>
          </details>
          {% endfor %}
        </div>
      </div>
    </section>
</main>
{% endblock content %}
