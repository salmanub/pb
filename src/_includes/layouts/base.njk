{#
base.njk — Layout raíz de perito.barcelona
AGENTES §6: microdata anidada html → WebPage
AGENTES §5: CSS inline (inyectado por transform), cero
<link> de CSS
#}
{# ── i18n contact paths (used by all CTAs) ── #}
{% set _contactPro = "/contacto/profesional/" if (not lang or lang == "es") else ("/en/contact/professional/" if lang == "en" else "/ca/contacte/professional/") %}
{% set _contactPart = "/contacto/particular/" if (not lang or lang == "es") else ("/en/contact/particular/" if lang == "en" else "/ca/contacte/particular/") %}
<!DOCTYPE html>
<html lang="{{ lang | default('es') }}" itemscope itemtype="https://schema.org/WebPage">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {# ── SEO ── #}
  <title>{{ title }} — {{ metadata.site.title }}</title>
  <meta name="description" content="{{ description }}">
  {% if noindex or seo == "noindex" or draft %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="canonical" href="{{ metadata.site.url }}{{ canonical | default(page.url) }}">

  {# ── Open Graph ── #}
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ metadata.site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ metadata.site.title }}">
  <meta property="og:locale" content="{{ lang | default('es') }}_{{ 'ES' if lang == 'es' or lang == 'ca' else 'GB' }}">

  {# ── Twitter ── #}
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">

  {# ── hreflang (AGENTES §8: recíproco + x-default) ── #}
  {# Priority: frontmatter translations > i18n.json lookup #}
  {% if translations and translations.length %}
  <link rel="alternate" hreflang="{{ lang | default('es') }}" href="{{ metadata.site.url }}{{ page.url }}">
  {% for t in translations %}
  <link rel="alternate" hreflang="{{ t.lang }}" href="{{ metadata.site.url }}{{ t.permalink }}">
  {% endfor %}
  {% set _esAlt = (translations | selectattr('lang', 'equalto', 'es') | first).permalink if lang and lang != 'es' else page.url %}
  <link rel="alternate" hreflang="x-default"
    href="{{ metadata.site.url }}{{ _esAlt | default(page.url) }}">
  {% else %}
  {% set alternates = page.url | hreflangAlternates(i18n.pages) %}
  {% for alt in alternates %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ metadata.site.url }}{{ alt.url }}">
  {% endfor %}
  {% if alternates | length %}
  <link rel="alternate" hreflang="x-default"
    href="{{ metadata.site.url }}{{ (alternates | selectattr('lang', 'equalto', 'es') | first).url | default(page.url) }}">
  {% endif %}
  {% endif %}

  {# ── Fonts (self-hosted from perito.barcelona) ── #}
  <style>
    {
      % include "../../assets/css/fonts.css" %
    }
  </style>

  {# ── Favicons ── #}
  {% favicons %}

  {# ── Speculation Rules: prefetch same-origin pages on hover/pointerdown ── #}
  <script type="speculationrules">
  {
    "prefetch": [
      {
        "source": "document",
        "eagerness": "moderate",
        "where": {
          "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": "/*\\?*" } },
            { "not": { "selector_matches": "[rel~=nofollow]" } },
            { "not": { "selector_matches": "[target=_blank]" } },
            { "not": { "selector_matches": "[href^=tel]" } },
            { "not": { "selector_matches": "[href^=mailto]" } }
          ]
        }
      }
    ]
  }
  </script>

  {# ── CSS: inyectado inline por el transform de .eleventy.js (AGENTES §5) ── #}
  {# NO hay
  <link rel="stylesheet"> — cero CSS externo #}

  {# ── View Transitions cross-document (sobria, acorde a la marca) ── #}
  <style>
    @view-transition { navigation: auto; }
    @media (prefers-reduced-motion: no-preference) {
      ::view-transition-old(root) { animation: pb-vt-out 200ms cubic-bezier(0.4, 0, 0.2, 1) both; }
      ::view-transition-new(root) { animation: pb-vt-in 300ms cubic-bezier(0.4, 0, 0.2, 1) both; }
      ::view-transition-group(casos-list) { animation-duration: 340ms; animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
      html[data-nav-dir="forward"]::view-transition-old(casos-list) { animation: pb-slide-out-left 260ms cubic-bezier(0.4, 0, 0.2, 1) both; }
      html[data-nav-dir="forward"]::view-transition-new(casos-list) { animation: pb-slide-in-right 340ms cubic-bezier(0.4, 0, 0.2, 1) both; }
      html[data-nav-dir="back"]::view-transition-old(casos-list) { animation: pb-slide-out-right 260ms cubic-bezier(0.4, 0, 0.2, 1) both; }
      html[data-nav-dir="back"]::view-transition-new(casos-list) { animation: pb-slide-in-left 340ms cubic-bezier(0.4, 0, 0.2, 1) both; }
    }
    @keyframes pb-vt-out { to { opacity: 0; transform: translateY(-6px); } }
    @keyframes pb-vt-in { from { opacity: 0; transform: translateY(8px); } }
    @keyframes pb-slide-out-left { to { opacity: 0; transform: translateX(-28px); } }
    @keyframes pb-slide-in-right { from { opacity: 0; transform: translateX(28px); } }
    @keyframes pb-slide-out-right { to { opacity: 0; transform: translateX(28px); } }
    @keyframes pb-slide-in-left { from { opacity: 0; transform: translateX(-28px); } }
  </style>
</head>

<body>
  {# ── Header (AGENTES §6: WPHeader → SiteNavigationElement) ── #}
  <header itemscope itemtype="https://schema.org/WPHeader">
    {% include "partials/nav.njk" %}
  </header>

  {# ── Main content ── #}
  <main itemprop="mainContentOfPage">
    {{ content | safe }}
  </main>

  {# ── Footer (AGENTES §6: WPFooter → LocalBusiness) ── #}
  <footer itemscope itemtype="https://schema.org/WPFooter">
    {% include "partials/footer.njk" %}
  </footer>
  {# ── Intake modal (JS autorizado solo para formulario — AGENTES §5.6 override) ── #}
  <script src="/assets/js/intake.js" defer></script>
  {# ── Micro-interactions + favicon attention ── #}
  <script src="/assets/js/motion.js" defer></script>

  {# ── Mobile bottom CTA bar ── #}
  {% set mbbCall = "Trucar" if lang == "ca" else ("Call" if lang == "en" else "Llamar") %}
  {% set mbbEmail = "Enviar email" if lang == "ca" else ("Send email" if lang == "en" else "Enviar email") %}
  <div class="mobile-bottom-bar" aria-label="Acciones rápidas">
    <a href="tel:{{ metadata.contact.phoneNumber | replace(' ', '') }}" class="mbb-btn mbb-btn--call"
      onmouseenter="this.style.backgroundColor='var(--stone-200)';this.querySelector('svg').style.stroke='var(--accent-dark, #145a38)'"
      onmouseleave="this.style.backgroundColor='var(--surface-card)';this.querySelector('svg').style.stroke='var(--accent)'">
      <svg class="mbb-icon-call" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      <span>{{ mbbCall }}</span>
    </a>
    <a href="mailto:{{ metadata.company.email }}" class="mbb-btn mbb-btn--form"
      onmouseenter="this.style.backgroundColor='#145a38';this.style.color='#fff';this.querySelector('svg').style.stroke='#fff'"
      onmouseleave="this.style.backgroundColor='var(--accent)';this.style.color='var(--accent-on)';this.querySelector('svg').style.stroke='currentColor'">
      <svg class="mbb-icon-form" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
        <polyline points="22,6 12,13 2,6" />
      </svg>
      <span>{{ mbbEmail }}</span>
    </a>
  </div>
  <script>
    {% include "components/instant-nav.njk" %}
  </script>
  {# ── openIntake toast removed — CTAs now link to /contacto/particular/ or /contacto/profesional/ ── #}
  {# ── Google Analytics (deferred load) ── #}
  {% include "components/analytics.njk" %}

  {# ── View Transitions + Navigation API (progressive enhancement) ── #}
  <script>
    (function () {
      if (!("startViewTransition" in document)) return;
      function pageNum(url) {
        try {
          var m = new URL(url, location.origin).pathname.match(/\/(?:pagina|page)\/(\d+)\//);
          return m ? parseInt(m[1], 10) : 1;
        } catch (e) { return 1; }
      }
      function setDir(fromUrl, toUrl) {
        document.documentElement.dataset.navDir =
          (fromUrl && toUrl && pageNum(toUrl) < pageNum(fromUrl)) ? "back" : "forward";
      }

      // Transiciones cross-document (navegaciones completas, p. ej. listado -> ficha)
      window.addEventListener("pageswap", function (e) {
        if (!e.viewTransition) return;
        var a = e.activation;
        if (a && a.from && a.entry) setDir(a.from.url, a.entry.url);
      });
      window.addEventListener("pagereveal", function (e) {
        if (!e.viewTransition) return;
        var a = (window.navigation && navigation.activation) || null;
        if (a && a.from && a.entry) setDir(a.from.url, a.entry.url);
      });

      // Paginacion de casos en el MISMO documento: sin recarga, sin salto al top
      if (!window.navigation) return;
      var LIST_RE = /^\/(?:casos-exito|ca\/casos-d-exit|en\/success-cases)\/(?:(?:pagina|page)\/\d+\/)?$/;
      function isList(u) { try { return LIST_RE.test(new URL(u, location.origin).pathname); } catch (e) { return false; } }

      navigation.addEventListener("navigate", function (e) {
        if (!e.canIntercept || e.hashChange || e.downloadRequest || e.formData) return;
        var dest = e.destination.url;
        if (!isList(dest) || !isList(location.href) || dest === location.href) return;
        var fromUrl = location.href;
        e.intercept({
          scroll: "manual",
          handler: function () {
            return fetch(dest).then(function (r) { return r.text(); }).then(function (html) {
              var doc = new DOMParser().parseFromString(html, "text/html");
              var newGrid = doc.querySelector("[data-casos-grid]");
              var newPager = doc.querySelector("[data-casos-pager]");
              var curGrid = document.querySelector("[data-casos-grid]");
              var curPager = document.querySelector("[data-casos-pager]");
              if (!newGrid || !curGrid) { location.assign(dest); return; }
              setDir(fromUrl, dest);
              var t = document.startViewTransition(function () {
                curGrid.replaceWith(newGrid);
                if (curPager && newPager) curPager.replaceWith(newPager);
                else if (curPager) curPager.remove();
                if (doc.title) document.title = doc.title;
              });
              return t.updateCallbackDone.then(function () {
                var g = document.querySelector("[data-casos-grid]");
                if (g) {
                  var y = g.getBoundingClientRect().top + window.scrollY - 96;
                  window.scrollTo(0, y > 0 ? y : 0);
                }
              });
            });
          }
        });
      });
    })();
  </script>
</body>

</html>