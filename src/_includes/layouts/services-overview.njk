{% extends "layouts/base.njk" %}

{% block content %}
<main class="overflow-hidden relative h-auto">
    <!-- Hero Section con variables -->
    <header class="relative bg-gradient-to-br from-slate-800 to-slate-900 mt-[70px] lg:mt-[120px]">
        <div aria-hidden="true" class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,slate-500_1px,transparent_1px)] bg-[size:40px_40px] opacity-[0.15]"></div>
        </div>

        <div class="relative mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
            <div class="py-12 lg:py-16">
                <div class="max-w-4xl">
                    <h1 class="text-4xl lg:text-5xl font-bold text-white mb-6">{{ hero.title }}</h1>
                    <p class="text-xl text-slate-300 mb-8">{{ hero.description }}</p>
                    {% if hero.cta %}
                    <a href="{{ hero.cta.url }}" class="inline-flex items-center bg-cyan-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-cyan-600 transition-colors">
                        {{ hero.cta.text }}
                        <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    <!-- Services Overview Section -->
    <section id="servicios" class="py-20 px-4 md:px-[5%] bg-slate-50">
        <div class="max-w-[1200px] mx-auto">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">{{ servicesSection.title }}</h2>
                <p class="text-lg text-slate-600 max-w-3xl mx-auto">{{ servicesSection.description }}</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for service in servicesSection.services %}
                <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow flex flex-col">
                    <div class="w-16 h-16 rounded-full {{ service.iconBgColor }} {{ service.iconTextColor }} flex items-center justify-center mb-6 self-start">
                        {{ service.icon | safe }}
                    </div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-4">{{ service.title }}</h3>
                    <p class="text-slate-600 mb-6 flex-grow">{{ service.description | safe }}</p>
                    <a href="{{ service.url }}" class="mt-auto inline-block {{ service.ctaBgColor }} text-white px-6 py-3 rounded-lg font-semibold {{ service.ctaHoverBgColor }} transition-colors">
                        {{ service.ctaText }}
                    </a>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Process Section -->
    {% if processSection %}
    <section class="py-20 px-4 md:px-[5%] bg-white">
        <div class="max-w-[1200px] mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">{{ processSection.title }}</h2>
                <p class="text-lg text-slate-600 max-w-3xl mx-auto">{{ processSection.description }}</p>
            </div>
            <!-- Process steps here -->
        </div>
    </section>
    {% endif %}

    <!-- Final CTA -->
    {% if finalCta %}
    <section class="py-20 px-4 md:px-[5%] bg-gradient-to-br from-cyan-600 to-cyan-700 text-white">
        <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">{{ finalCta.title }}</h2>
            <p class="text-xl text-cyan-100 mb-8">{{ finalCta.description }}</p>
            <a href="{{ finalCta.url }}" class="inline-flex items-center bg-white text-cyan-600 px-8 py-4 rounded-lg font-bold hover:bg-cyan-50 transition-colors">
                {{ finalCta.buttonText }}
            </a>
        </div>
    </section>
    {% endif %}
</main>
{% endblock %}


{% block pageStyles %}
 {% set servicesOverviewCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
<style>
    {{ servicesOverviewCSS | safe }}
</style>
{% endblock %}

