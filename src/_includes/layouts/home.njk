{#
  home.njk — Home page template (included by index.njk)
  Port 1:1 de HomePage.jsx
  AGENTES §6 microdata: WebSite + SearchAction + ItemList
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}
{% set h = home_ca if lang == "ca" else (home_en if lang == "en" else home) %}
{% set _contactPro = "/contacto/profesional/" if (not lang or lang == "es") else ("/en/contact/professional/" if lang == "en" else "/ca/contacte/professional/") %}
{% set _contactPart = "/contacto/particular/" if (not lang or lang == "es") else ("/en/contact/particular/" if lang == "en" else "/ca/contacte/particular/") %}

{# ── Microdata WebSite + SearchAction ── #}
<div itemscope itemtype="https://schema.org/WebSite" style="display:none;" aria-hidden="true">
  <meta itemprop="name" content="{{ metadata.site.title }}">
  <meta itemprop="url" content="{{ metadata.site.url }}">
  <div itemprop="potentialAction" itemscope itemtype="https://schema.org/SearchAction">
    <meta itemprop="target" content="{{ metadata.site.url }}/buscar?q={search_term_string}">
    <meta itemprop="query-input" content="required name=search_term_string">
  </div>
</div>

{# ===== HERO ===== #}
<section style="max-width: var(--container-wide); margin: 0 auto; padding: clamp(48px,8vw,104px) var(--gutter) var(--section-y) var(--gutter);">
  <div style="display: grid; grid-template-columns: 1.55fr 1fr; gap: clamp(32px,5vw,72px); align-items: center;" class="hero-grid">
    <div>
      <div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono);
                  font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                  text-transform: uppercase; font-weight: var(--fw-medium); color: var(--text-accent);">
        <span style="width: 24px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
        {{ h.hero.eyebrow }}
      </div>
      <h1 style="font-family: var(--font-serif); font-size: var(--fs-display-1);
                 line-height: var(--lh-display); letter-spacing: var(--tracking-tight);
                 color: var(--text-strong); margin: 22px 0 0; font-weight: 400;">
        {{ h.hero.h1 | safe }}
      </h1>
      <p style="margin-top: 26px; font-size: var(--fs-lede); line-height: var(--lh-lede);
                color: var(--text-muted); max-width: 52ch;">
        {{ h.hero.lede | safe }}
      </p>
      <div style="display: flex; gap: 14px; margin-top: 34px; flex-wrap: wrap;">
        <a href="{{ _contactPro }}" class="cta-hero"
           style="display: inline-flex; align-items: center; justify-content: center; gap: 9px;
                  padding: 14px 24px; font-family: var(--font-sans); font-size: var(--fs-body);
                  font-weight: var(--fw-semibold); line-height: 1; letter-spacing: 0.005em;
                  border-radius: var(--radius-sm); border: 1.5px solid transparent;
                  background: var(--accent); color: var(--accent-on);
                  transition: background-color 0.3s, color 0.3s, border-color 0.3s;"
           onmouseenter="this.style.backgroundColor='#145a38';this.style.borderColor='#145a38'"
           onmouseleave="this.style.backgroundColor='var(--accent)';this.style.borderColor='transparent'">
          {{ h.hero.cta_primary }}
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="{{ _contactPart }}"
           style="display: inline-flex; align-items: center; justify-content: center;
                  padding: 14px 24px; font-family: var(--font-sans); font-size: var(--fs-body);
                  font-weight: var(--fw-semibold); line-height: 1; letter-spacing: 0.005em;
                  border-radius: var(--radius-sm); border: 1.5px solid var(--ink-900);
                  background: transparent; color: var(--ink-900);">
          {{ h.hero.cta_secondary }}
        </a>
      </div>
    </div>
    <div style="position: relative;" class="hero-aside">
      <div style="aspect-ratio: 4 / 5; background: var(--stone-200); border-radius: var(--radius-md);
                  border: 1px solid var(--border-subtle); position: relative; overflow: hidden;">
        <img src="/assets/images/peritaje-construccion-ingenieros-obra.jpg" alt="Inspección técnica de obra civil"
             width="800" height="1000" loading="eager" style="position: absolute; inset: 0; width: 100%; height: 100%;
                                    object-fit: cover; filter: grayscale(0.18) contrast(1.02);">
        <div style="position: absolute; inset: 0; background: linear-gradient(0deg, rgba(28,26,23,0.55), rgba(28,26,23,0.04) 45%, transparent);"></div>
      </div>
      {# Badge flotante #}
      <div style="position: absolute; bottom: -22px; left: -22px; background: var(--paper-50);
                  border: 1px solid var(--border-hairline); border-radius: var(--radius-md);
                  padding: 16px 18px; box-shadow: var(--shadow-card); max-width: 230px;" class="hero-badge">
        <div style="display: flex; align-items: center; gap: 10px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)"
               stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
          </svg>
          <span style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em;
                       text-transform: uppercase; color: var(--text-muted);">{{ h.hero.badge_label }}</span>
        </div>
        <div style="margin-top: 8px; font-family: var(--font-serif); font-size: 1rem; color: var(--text-strong);">
          {{ h.hero.badge_text }}
        </div>
      </div>
    </div>
  </div>
</section>

{# ===== STATS STRIP ===== #}
<section style="background: var(--paper-50); border-top: 1px solid var(--border-subtle);
                border-bottom: 1px solid var(--border-subtle);">
  <div style="max-width: var(--container-wide); margin: 0 auto; padding: 64px var(--gutter);
              display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px;" class="stats-grid"
       itemscope itemtype="https://schema.org/ItemList">
    <meta itemprop="name" content="{{ h.cases_section.title }}">
    {% for stat in h.stats %}
    <div itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <meta itemprop="position" content="{{ loop.index }}">
      <div class="stat-value" style="font-family: var(--font-mono); font-size: var(--fs-data-xl);
                  font-weight: var(--fw-medium); line-height: 1;
                  color: {{ 'var(--oxide-400)' if stat.accent else 'var(--text-strong)' }};
                  font-variant-numeric: tabular-nums;">
        <span itemprop="name">{{ stat.value }}</span>
      </div>
      <div class="stat-label" style="margin-top: 10px; font-size: var(--fs-body-sm); color: var(--text-muted); line-height: 1.45;">
        {{ stat.label }}
      </div>
      <div class="stat-source" style="margin-top: 6px; font-family: var(--font-mono); font-size: 0.6875rem;
                  letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-faint);">
        {{ stat.source }}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{# ===== AUDIENCE SPLIT ===== #}
<section itemscope itemtype="https://schema.org/ItemList" style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
  <meta itemprop="name" content="{{ h.audience.title }}">
  <meta itemprop="description" content="{{ h.audience.lede }}">
  {# SectionHeader #}
  <div style="margin-bottom: var(--block-gap);">
    <div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono);
                font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                text-transform: uppercase; font-weight: var(--fw-medium); color: var(--text-accent); margin-bottom: 18px;">
      <span style="width: 24px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
      {{ h.audience.eyebrow }}
    </div>
    <h2 style="font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 400;
               line-height: var(--lh-display); letter-spacing: var(--tracking-tight); color: var(--text-strong); margin: 0;">
      {{ h.audience.title }}
    </h2>
    <p style="margin-top: 14px; font-size: var(--fs-lede); line-height: var(--lh-lede); color: var(--text-muted); max-width: 60ch;">
      {{ h.audience.lede }}
    </p>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 48px;" class="two-col">
    {% for card in h.audience.cards %}
    <div class="audience-card" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"
         style="padding: 32px 30px; border-radius: var(--radius-md);
                display: flex; flex-direction: column;
                border: 1px solid {{ 'var(--ink-700)' if card.tone == 'ink' else 'var(--border-hairline)' }};
                background: {{ 'var(--surface-ink)' if card.tone == 'ink' else 'var(--surface-card)' }};">
      <meta itemprop="position" content="{{ loop.index }}">
      {# Icon placeholder #}
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
           stroke="{{ 'var(--oxide-400)' if card.tone == 'ink' else 'var(--accent)' }}"
           stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {% if card.icon == "landmark" %}
        <line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/>
        {% elif card.icon == "home" %}
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        {% endif %}
      </svg>
      <div style="font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em;
                  text-transform: uppercase; margin-top: 20px;
                  color: {{ 'var(--text-on-dark-muted)' if card.tone == 'ink' else 'var(--text-muted)' }};">
        {{ card.tag }}
      </div>
      <h3 itemprop="name" style="font-family: var(--font-serif); font-size: var(--fs-h2); font-weight: 400; margin: 8px 0 0;
                 color: {{ 'var(--bone-100)' if card.tone == 'ink' else 'var(--text-strong)' }};">
        {{ card.title }}
      </h3>
      <div itemprop="description">
      <ul style="list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px;">
        {% for point in card.points %}
        <li style="display: flex; gap: 11px; align-items: flex-start;
                   color: {{ 'rgba(244,240,232,0.86)' if card.tone == 'ink' else 'var(--text-body)' }};
                   font-size: 0.95rem; line-height: 1.5;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
               stroke="{{ 'var(--oxide-400)' if card.tone == 'ink' else 'var(--accent)' }}"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               style="margin-top: 2px; flex-shrink: 0;" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          {{ point }}
        </li>
        {% endfor %}
      </ul>
      </div>
      <div style="margin-top: auto; padding-top: 28px; display: flex; justify-content: center;">
        {% if card.tone == 'ink' %}
        <a href="{{ _contactPro }}"
           class="cta-ink"
           style="display: inline-flex; align-items: center; gap: 8px;
                  padding: 10px 18px; font-family: var(--font-sans); font-size: var(--fs-body-sm);
                  font-weight: var(--fw-semibold); line-height: 1; border-radius: var(--radius-sm);
                  border: 1.5px solid var(--bone-100); background: transparent; color: var(--bone-100);
                  transition: background-color 0.3s, color 0.3s, border-color 0.3s;"
           onmouseenter="this.style.backgroundColor='var(--bone-100)';this.style.color='var(--ink-900)';this.style.borderColor='var(--bone-100)'"
           onmouseleave="this.style.backgroundColor='transparent';this.style.color='var(--bone-100)';this.style.borderColor='var(--bone-100)'">
          {{ card.cta }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        {% else %}
        <a href="{{ _contactPart }}" class="cta-light"
           style="display: inline-flex; align-items: center; gap: 8px;
                  padding: 10px 18px; font-family: var(--font-sans); font-size: var(--fs-body-sm);
                  font-weight: var(--fw-semibold); line-height: 1; border-radius: var(--radius-sm);
                  border: 1.5px solid var(--ink-900); background: transparent; color: var(--ink-900);
                  transition: background-color 0.3s, color 0.3s, border-color 0.3s;"
           onmouseenter="this.style.backgroundColor='var(--ink-900)';this.style.color='var(--bone-100)';this.style.borderColor='var(--ink-900)'"
           onmouseleave="this.style.backgroundColor='transparent';this.style.color='var(--ink-900)';this.style.borderColor='var(--ink-900)'">
          {{ card.cta }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{# ===== SERVICES ===== #}
<section id="servicios" itemscope itemtype="https://schema.org/CollectionPage" style="background: var(--paper-50); border-top: 1px solid var(--border-subtle);">
  <meta itemprop="name" content="{{ h.services_section.title }}">
  <meta itemprop="description" content="{{ h.services_section.lede }}">
  <div style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
    <div style="margin-bottom: var(--block-gap);">
      <div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono);
                  font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                  text-transform: uppercase; font-weight: var(--fw-medium); color: var(--text-accent); margin-bottom: 18px;">
        <span style="width: 24px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
        {{ h.services_section.eyebrow }}
      </div>
      <h2 style="font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 400;
                 line-height: var(--lh-display); letter-spacing: var(--tracking-tight); color: var(--text-strong); margin: 0;">
        {{ h.services_section.title }}
      </h2>
      <p style="margin-top: 14px; font-size: var(--fs-lede); line-height: var(--lh-lede); color: var(--text-muted); max-width: 60ch;">
        {{ h.services_section.lede }}
      </p>
      <a href="{{ langPrefix }}/informes-periciales/" style="display: inline-flex; align-items: center; gap: 7px; margin-top: 18px; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: var(--fw-semibold); color: var(--text-accent); text-decoration: none;">Ver todos los dictámenes<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px;" class="three-col">
      {% for svc in h.services_section.items %}
      <article itemprop="hasPart" itemscope itemtype="https://schema.org/Article" style="border-radius: var(--radius-md); border: 1px solid var(--border-hairline);
                  background: var(--surface-card); overflow: hidden; height: 100%;">
        {# refCode bar #}
        <div style="display: flex; justify-content: space-between; padding: 12px 18px;
                    border-bottom: 1px solid var(--border-subtle); font-family: var(--font-mono);
                    font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                    text-transform: uppercase; color: var(--text-muted);">
          <span>§ {{ svc.code }}</span>
          <span>{{ h.services_section.servicio_label }}</span>
        </div>
        {% set _svcBase = "/" %}
        <a itemprop="url" href="{{ svc.href if svc.href else (langPrefix + _svcBase + svc.slug + '/') }}"
           style="display: block; padding: 24px 24px 26px; cursor: pointer; position: relative;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)"
               stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {% if svc.icon == "building-2" %}
            <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>
            {% elif svc.icon == "house" %}
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            {% elif svc.icon == "droplets" %}
            <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>
            {% elif svc.icon == "hard-hat" %}
            <path d="M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v2z"/><path d="M10 15V6.5a3.5 3.5 0 0 1 7 0V15"/><path d="M4 15v-5a6 6 0 0 1 6-6"/>
            {% elif svc.icon == "scale" %}
            <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
            {% elif svc.icon == "file-check-2" %}
            <path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v4"/><polyline points="14 2 14 8 20 8"/><path d="m3 15 2 2 4-4"/>
            {% endif %}
          </svg>
          <h3 itemprop="name" style="font-family: var(--font-serif); font-size: 1.3rem; font-weight: 500;
                     color: var(--text-strong); margin: 18px 0 0;">
            {{ svc.t }}
          </h3>
          <p itemprop="description" style="margin: 10px 0 0; font-size: 0.9rem; color: var(--text-muted); line-height: 1.55;">
            {{ svc.d }}
          </p>
          <div class="card-arrow" style="margin-top: 14px; display: flex; justify-content: flex-end;
                      opacity: 0;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== METHOD ===== #}
<section id="metodo" itemscope itemtype="https://schema.org/HowTo" style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
  <meta itemprop="name" content="{{ h.method.title }}">
  <meta itemprop="description" content="{{ h.method.lede }}">
  <div style="text-align: center; margin-bottom: var(--block-gap);">
    <div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono);
                font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                text-transform: uppercase; font-weight: var(--fw-medium); color: var(--text-accent); margin-bottom: 18px;">
      <span style="width: 24px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
      {{ h.method.eyebrow }}
    </div>
    <h2 style="font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 400;
               line-height: var(--lh-display); letter-spacing: var(--tracking-tight); color: var(--text-strong); margin: 0;">
      {{ h.method.title }}
    </h2>
    <p style="margin: 14px auto 0; font-size: var(--fs-lede); line-height: var(--lh-lede); color: var(--text-muted); max-width: 60ch;">
      {{ h.method.lede }}
    </p>
  </div>
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 48px;
              border-top: 2px solid var(--ink-900);" class="method-grid">
    {% for step in h.method.steps %}
    <div itemprop="step" itemscope itemtype="https://schema.org/HowToStep" class="method-step"
         style="padding: 28px 26px 0;{{ ' border-right: 1px solid var(--border-hairline);' if not loop.last }}" class="method-cell">
      <meta itemprop="position" content="{{ loop.index }}">
      <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent); letter-spacing: 0.1em;">
        {{ step.n }}
      </div>
      <h3 itemprop="name" style="font-family: var(--font-serif); font-size: 1.35rem; font-weight: 400;
                 color: var(--text-strong); margin: 14px 0 0;">
        {{ step.t }}
      </h3>
      <p itemprop="text" style="margin: 10px 0 0; font-size: 0.9rem; color: var(--text-muted); line-height: 1.55;">
        {{ step.d }}
      </p>
    </div>
    {% endfor %}
  </div>
</section>

{# ===== CASES (dark) ===== #}
<section id="casos" style="background: var(--ink-900); color: var(--bone-100);">
  <div style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
    <div style="margin-bottom: var(--block-gap);">
      <div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono);
                  font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                  text-transform: uppercase; font-weight: var(--fw-medium); color: var(--oxide-400); margin-bottom: 18px;">
        <span style="width: 24px; height: 1.5px; background: var(--oxide-400); display: inline-block;"></span>
        {{ h.cases_section.eyebrow }}
      </div>
      <h2 style="font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 400;
                 line-height: var(--lh-display); letter-spacing: var(--tracking-tight); color: var(--bone-100); margin: 0;">
        {{ h.cases_section.title }}
      </h2>
      <p style="margin-top: 14px; font-size: var(--fs-lede); line-height: var(--lh-lede); color: var(--text-on-dark-muted); max-width: 60ch;">
        {{ h.cases_section.lede }}
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px;" class="three-col">
      {% for caso in h.cases_section.items %}
      <div style="border-radius: var(--radius-md); border: 1px solid var(--ink-700); background: var(--surface-ink); padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; color: var(--text-on-dark-muted);">
            {{ caso.exp }} · {{ caso.loc }}
          </span>
          <span style="display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-mono);
                       font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                       text-transform: uppercase; padding: 3px 8px; border-radius: var(--radius-xs);
                       background: var(--accent-tint); color: var(--text-accent);">
            <span style="width: 5px; height: 5px; border-radius: 50%; background: var(--accent); display: inline-block;"></span>
            {{ caso.tag }}
          </span>
        </div>
        <div style="font-family: var(--font-mono); font-size: 2rem; color: var(--bone-100);
                    margin: 20px 0 0; letter-spacing: -0.01em; font-variant-numeric: tabular-nums;">
          {{ caso.amount }}
        </div>
        <p style="margin: 10px 0 0; font-size: 0.92rem; color: rgba(244,240,232,0.78); line-height: 1.5;">
          {{ caso.t }}
        </p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== ABOUT ===== #}
<section id="sobre" style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
  <div style="display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px,5vw,72px); align-items: center;" class="two-col">
    <div style="aspect-ratio: 4 / 5; background: var(--stone-200); border-radius: var(--radius-md);
                border: 1px solid var(--border-subtle); position: relative; overflow: hidden;">
      <img src="/assets/images/professional-civil-engineer-examining-modern-build.png" alt="{{ h.about_section.title }}"
           width="680" height="850" loading="lazy" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;">
    </div>
    <div itemscope itemtype="https://schema.org/Person">
      <meta itemprop="name" content="{{ h.about_section.title }}">
      <meta itemprop="jobTitle" content="{{ metadata.author.jobTitle[lang | default('es')] }}">
      <div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono);
                  font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                  text-transform: uppercase; font-weight: var(--fw-medium); color: var(--text-accent); margin-bottom: 18px;">
        <span style="width: 24px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
        {{ h.about_section.eyebrow }}
      </div>
      <h2 style="font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 400;
                 line-height: var(--lh-display); letter-spacing: var(--tracking-tight); color: var(--text-strong); margin: 0;">
        {{ h.about_section.title }}
      </h2>
      <p style="margin-top: 14px; font-size: var(--fs-lede); line-height: var(--lh-lede); color: var(--text-muted); max-width: 60ch;">
        {{ h.about_section.lede }}
      </p>
      <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px;">
        {% for tag in h.about_section.tags %}
        <span style="display: inline-flex; align-items: center; font-family: var(--font-mono);
                     font-weight: var(--fw-medium); letter-spacing: var(--tracking-label);
                     text-transform: uppercase; line-height: 1.2; border-radius: var(--radius-xs);
                     font-size: var(--fs-mono-label); padding: 5px 10px;
                     color: var(--text-muted); border: 1px solid var(--border-hairline);
                     background: transparent;">
          {{ tag }}
        </span>
        {% endfor %}
      </div>
      <blockquote style="margin: 30px 0 0; padding-left: 22px; border-left: 2px solid var(--accent);
                         font-family: var(--font-serif); font-style: italic; font-size: 1.35rem;
                         line-height: 1.45; color: var(--text-strong);">
        {{ h.about_section.quote }}
      </blockquote>
    </div>
  </div>
</section>

{# ===== FAQ ===== #}
<section style="background: var(--paper-50); border-top: 1px solid var(--border-subtle);">
  <div style="max-width: 880px; margin: 0 auto; padding: var(--section-y) var(--gutter);"
       itemscope itemtype="https://schema.org/FAQPage">
    <div style="margin-bottom: var(--block-gap);">
      <div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono);
                  font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                  text-transform: uppercase; font-weight: var(--fw-medium); color: var(--text-accent); margin-bottom: 18px;">
        <span style="width: 24px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
        § 06 · {{ h.faq.eyebrow }}
      </div>
      <h2 style="font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 400;
                 line-height: var(--lh-display); letter-spacing: var(--tracking-tight); color: var(--text-strong); margin: 0;">
        {{ h.faq.title }}
      </h2>
    </div>
    <div style="margin-top: 40px;">
      {% for item in h.faq.items %}
      <details style="border-top: 1px solid var(--border-hairline);" class="ds-faq"
               itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
               {{ 'open' if loop.first }}>
        <summary style="padding: 18px 0; cursor: pointer; display: grid; grid-template-columns: 36px 1fr 24px;
                        gap: 14px; align-items: center; list-style: none;">
          <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-faint);
                       letter-spacing: 0.06em; font-variant-numeric: tabular-nums;">{{ '%02d' | format(loop.index) }}</span>
          <span itemprop="name" style="font-family: var(--font-serif); font-size: 1.1rem;
                       font-weight: 500; color: var(--text-strong); line-height: 1.35;">{{ item.q }}</span>
          <span class="ds-faq-icon" style="color: var(--text-faint); font-size: 1.1rem; font-weight: 300;
                       display: flex; align-items: center; justify-content: center; width: 24px; height: 24px;">+</span>
        </summary>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer"
             style="padding: 0 0 22px 50px; font-size: 0.95rem; color: var(--text-muted); line-height: 1.65; max-width: 58ch;">
          <span itemprop="text">{{ item.a }}</span>
        </div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== CONTACT CTA ===== #}
<section id="contacto" style="max-width: var(--container-wide); margin: 0 auto; padding: var(--section-y) var(--gutter);">
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,5vw,80px); align-items: center;" class="two-col">
    <div>
      <div style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono);
                  font-size: var(--fs-mono-label); letter-spacing: var(--tracking-label);
                  text-transform: uppercase; font-weight: var(--fw-medium); color: var(--text-accent); margin-bottom: 18px;">
        <span style="width: 24px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
        {{ h.contact_section.eyebrow }}
      </div>
      <h2 style="font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 400;
                 line-height: var(--lh-display); letter-spacing: var(--tracking-tight); color: var(--text-strong); margin: 0;">
        {{ h.contact_section.title }}
      </h2>
      <p style="margin-top: 14px; font-size: var(--fs-lede); line-height: var(--lh-lede); color: var(--text-muted); max-width: 60ch;">
        {{ h.contact_section.lede }}
      </p>
      <div style="display: flex; align-items: center; gap: 14px; margin-top: 28px;">
        <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); line-height: 1.7;">
          {{ metadata.contact.phoneNumber | replace('+34 ', '') }}<br>{{ metadata.company.email }}
        </div>
      </div>
    </div>
    <div id="home-form-wrapper" style="border-radius: var(--radius-md); border: 1px solid var(--border-hairline);
                background: var(--surface-card); padding: clamp(24px,3vw,38px);">
      <form id="home-contact-form" style="display: flex; flex-direction: column; gap: 18px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px;" class="form-row">
          <div>
            <label for="home-n" style="display: block; font-size: var(--fs-body-sm); font-weight: var(--fw-medium);
                   color: var(--text-strong); margin-bottom: 6px;">{{ h.contact_section.field_nombre }}</label>
            <input type="text" id="home-n" name="nombre" required autocomplete="name"
                   placeholder="{{ h.contact_section.placeholder_nombre }}"
                   style="width: 100%; padding: 10px 12px; font-family: var(--font-sans); font-size: var(--fs-body-sm);
                          border: 1px solid var(--border-hairline); border-radius: var(--radius-sm);
                          background: var(--surface-raised); color: var(--text-body);">
          </div>
          <div>
            <label for="home-r" style="display: block; font-size: var(--fs-body-sm); font-weight: var(--fw-medium);
                   color: var(--text-strong); margin-bottom: 6px;">{{ h.contact_section.field_soy }}</label>
            <input type="text" id="home-r" name="rol"
                   placeholder="{{ h.contact_section.placeholder_soy }}"
                   style="width: 100%; padding: 10px 12px; font-family: var(--font-sans); font-size: var(--fs-body-sm);
                          border: 1px solid var(--border-hairline); border-radius: var(--radius-sm);
                          background: var(--surface-raised); color: var(--text-body);">
          </div>
        </div>
        <div>
          <label for="home-e" style="display: block; font-size: var(--fs-body-sm); font-weight: var(--fw-medium);
                 color: var(--text-strong); margin-bottom: 6px;">{{ h.contact_section.field_email }}</label>
          <input type="email" id="home-e" name="email" required autocomplete="email"
                 placeholder="{{ h.contact_section.placeholder_email }}"
                 style="width: 100%; padding: 10px 12px; font-family: var(--font-sans); font-size: var(--fs-body-sm);
                        border: 1px solid var(--border-hairline); border-radius: var(--radius-sm);
                        background: var(--surface-raised); color: var(--text-body);">
        </div>
        <div>
          <label for="home-c" style="display: block; font-size: var(--fs-body-sm); font-weight: var(--fw-medium);
                 color: var(--text-strong); margin-bottom: 6px;">{{ h.contact_section.field_caso }}</label>
          <div style="font-size: 0.8rem; color: var(--text-faint); margin-bottom: 4px;">{{ h.contact_section.field_caso_hint }}</div>
          <textarea id="home-c" name="caso" rows="3"
                    placeholder="{{ h.contact_section.placeholder_caso }}"
                    style="width: 100%; padding: 10px 12px; font-family: var(--font-sans); font-size: var(--fs-body-sm);
                           border: 1px solid var(--border-hairline); border-radius: var(--radius-sm);
                           background: var(--surface-raised); color: var(--text-body); resize: vertical;"></textarea>
        </div>
        <button type="submit" id="home-submit-btn"
                style="width: 100%; padding: 14px 24px; font-family: var(--font-sans); font-size: var(--fs-body);
                       font-weight: var(--fw-semibold); line-height: 1; border-radius: var(--radius-sm);
                       border: 1.5px solid transparent; background: var(--accent); color: var(--accent-on);
                       cursor: pointer;">
          {{ h.contact_section.submit }}
        </button>
      </form>
    </div>
  </div>
</section>

<script>
(function(){
  'use strict';
  var form = document.getElementById('home-contact-form');
  var wrapper = document.getElementById('home-form-wrapper');
  if(!form || !wrapper) return;

  var i18n = {
    sending: {{ h.contact_section.sending | dump | safe }},
    successTitle: {{ h.contact_section.success_title | dump | safe }},
    successText: {{ h.contact_section.success_text | dump | safe }},
    errorTitle: {{ h.contact_section.error_title | dump | safe }},
    errorText: {{ h.contact_section.error_text | dump | safe }},
    errorEmailCta: {{ h.contact_section.error_email_cta | dump | safe }},
    errorPhoneCta: {{ h.contact_section.error_phone_cta | dump | safe }},
    errorRetry: {{ h.contact_section.error_retry | dump | safe }}
  };
  var lang = {{ (lang | default('es')) | dump | safe }};
  var thankYouUrl = lang === 'ca' ? '/ca/gracies/' : lang === 'en' ? '/en/thank-you/' : '/gracias/';

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var nombre = document.getElementById('home-n').value.trim();
    var rol = document.getElementById('home-r').value.trim();
    var email = document.getElementById('home-e').value.trim();
    var caso = document.getElementById('home-c').value.trim();

    var payload = {
      tipo_cliente: 'particular',
      lang: lang,
      nombre: nombre,
      email: email,
      telefono: '',
      ciudad: '',
      empresa: '',
      cargo: rol,
      problema: '',
      inmueble: '',
      importe: '',
      procesal: '',
      detalle: caso,
      origen: window.location.href,
      timestamp: new Date().toISOString()
    };

    var subject = encodeURIComponent('Consulta web — Homepage — ' + nombre);
    var bodyParts = 'CONSULTA WEB (perito.barcelona)\n========================================\n\n' +
      'Nombre: ' + nombre + '\nRol: ' + rol + '\nEmail: ' + email + '\n\nCaso:\n' + caso +
      '\n\nFecha: ' + new Date().toLocaleString('es-ES') + '\nOrigen: perito.barcelona (home)';
    var mailto = 'mailto:{{ metadata.company.email }}?subject=' + subject + '&body=' + encodeURIComponent(bodyParts);

    /* Show loading state */
    var submitBtn = document.getElementById('home-submit-btn');
    submitBtn.disabled = true;
    submitBtn.textContent = i18n.sending;

    var ctrl = new AbortController();
    var timer = setTimeout(function(){ ctrl.abort(); }, 10000);

    fetch('https://hook.eu2.make.com/76yaogaunrc9cqdtf26ldcoxb3fpndma', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
      signal: ctrl.signal
    })
    .then(function(r){
      clearTimeout(timer);
      if(!r.ok) throw new Error('HTTP ' + r.status);
      /* Success */
      wrapper.innerHTML =
        '<div style="text-align:center;padding:28px 0;">' +
          '<div style="width:52px;height:52px;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center;background:rgba(30,100,60,0.08);">' +
            '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' +
          '</div>' +
          '<h3 style="font-family:var(--font-serif);font-size:var(--fs-h2,1.75rem);font-weight:400;margin:16px 0 0;color:var(--text-strong);">' + i18n.successTitle + '</h3>' +
          '<p style="margin:10px auto 0;max-width:40ch;color:var(--text-muted);font-size:0.9rem;line-height:1.55;">' + i18n.successText + '</p>' +
        '</div>';
      setTimeout(function(){ window.location.href = thankYouUrl; }, 2500);
    })
    .catch(function(){
      clearTimeout(timer);
      /* Error — show mailto/phone fallback */
      wrapper.innerHTML =
        '<div style="padding:20px 0;">' +
          '<div style="text-align:center;margin-bottom:24px;">' +
            '<div style="width:52px;height:52px;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center;background:rgba(220,53,69,0.1);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>' +
            '<h3 style="font-family:var(--font-serif);font-size:var(--fs-h2,1.75rem);font-weight:400;margin:16px 0 0;color:var(--text-strong);">' + i18n.errorTitle + '</h3>' +
            '<p style="margin:8px auto 0;max-width:38ch;color:var(--text-muted);font-size:0.9rem;line-height:1.55;">' + i18n.errorText + '</p>' +
          '</div>' +
          '<div style="display:flex;flex-direction:column;gap:10px;">' +
            '<a href="' + mailto + '" style="display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:var(--radius-sm);border:1.5px solid var(--accent);background:var(--accent);text-decoration:none;transition:opacity 0.2s;" onmouseenter="this.style.opacity=\'0.9\'" onmouseleave="this.style.opacity=\'1\'">' +
              '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-on,#fff)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>' +
              '<span style="flex:1;"><span style="display:block;font-family:var(--font-sans);font-size:0.9rem;font-weight:600;color:var(--accent-on,#fff);">' + i18n.errorEmailCta + '</span><span style="display:block;font-family:var(--font-mono);font-size:0.7rem;color:rgba(255,255,255,0.7);margin-top:2px;">{{ metadata.company.email }}</span></span>' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>' +
            '</a>' +
            '<a href="tel:+34614194985" style="display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:var(--radius-sm);border:1.5px solid var(--border-hairline);background:var(--surface-raised,#fff);text-decoration:none;transition:border-color 0.2s;" onmouseenter="this.style.borderColor=\'var(--accent)\'" onmouseleave="this.style.borderColor=\'var(--border-hairline)\'">' +
              '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>' +
              '<span style="flex:1;"><span style="display:block;font-family:var(--font-sans);font-size:0.9rem;font-weight:600;color:var(--text-strong);">' + i18n.errorPhoneCta + '</span><span style="display:block;font-family:var(--font-mono);font-size:0.7rem;color:var(--text-muted);margin-top:2px;">614 194 985</span></span>' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-faint)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>' +
            '</a>' +
          '</div>' +
          '<button type="button" onclick="location.reload()" style="display:block;width:100%;margin-top:16px;padding:10px;font-family:var(--font-sans);font-size:0.8rem;font-weight:500;color:var(--text-muted);background:transparent;border:none;cursor:pointer;text-decoration:underline;text-underline-offset:3px;">' + i18n.errorRetry + '</button>' +
        '</div>';
    });
  });
})();
</script>
