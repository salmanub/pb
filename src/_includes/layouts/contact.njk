{#
  contact.njk — Layout para página de contacto
  Port de SitePages.jsx → Contacto
  AGENTES §6 microdata: ContactPoint
  Cadena: content.md → contact.njk → base.njk
  Datos: frontmatter + {lang}.json + metadata.json
#}
{% set ui = es %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}

{# ===== BREADCRUMB (above hero) ===== #}
<div style="max-width: var(--container-wide); margin: 0 auto; padding: 0 var(--gutter); padding-top: clamp(20px,3vw,32px);">
  {% include "partials/breadcrumb.njk" %}
</div>

{# ===== PAGE HERO ===== #}
<section style="max-width: var(--container-wide); margin: 0 auto;
                padding: clamp(24px,4vw,48px) var(--gutter) 48px var(--gutter);">
  <div>
    <h1 style="font-family: var(--font-serif); font-size: var(--fs-display-1);
               line-height: var(--lh-display); letter-spacing: var(--tracking-tight);
               color: var(--text-strong); margin: 0; font-weight: 400;">
      {{ title | safe }}
    </h1>
    <p style="margin-top: 22px; font-size: var(--fs-lede); line-height: var(--lh-lede);
              color: var(--text-muted); max-width: 60ch;">
      {{ description }}
    </p>
  </div>
</section>

{# ===== BODY + SIDEBAR (qual) ===== #}
<section style="max-width: var(--container-wide); margin: 0 auto; padding: 24px var(--gutter) var(--section-y);">
  <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(28px,4vw,56px); align-items: start;" class="site-two">
    <div>
      {# Body blocks #}
      {% for block in body_blocks %}
      <h3 style="font-family: var(--font-serif); font-size: var(--fs-h3); font-weight: 500;
                 color: var(--text-strong); margin: 26px 0 10px; padding-bottom: 8px;
                 border-bottom: 2px solid var(--accent); display: inline-block;">
        {{ block.h }}
      </h3>
      <p style="font-size: 1rem; line-height: 1.75; color: var(--text-muted); margin: 0 0 12px; max-width: 62ch;">
        {{ block.p | safe }}
      </p>
      {% endfor %}

      {# ContactPoint microdata #}
      <div itemprop="contactPoint" itemscope itemtype="https://schema.org/ContactPoint">
        <meta itemprop="telephone" content="{{ metadata.contact.phoneNumber }}">
        <meta itemprop="email" content="{{ metadata.company.email }}">
        <meta itemprop="contactType" content="customer service">
        <meta itemprop="availableLanguage" content="Spanish">
        <meta itemprop="availableLanguage" content="Catalan">
        <meta itemprop="availableLanguage" content="English">
      </div>

      {# Formulario (partial reutilizable) #}
      <div style="margin-top: 40px;">
        {% include "partials/form.njk" %}
      </div>

      {# Injected content from .md #}
      {{ content | safe }}
    </div>

    {# Sidebar qual #}
    {% include "partials/qual.njk" %}
  </div>
</section>
