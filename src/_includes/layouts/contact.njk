{% extends "layouts/base.njk" %}

{% set currentLanguage = page.lang or lang or 'es' %}

{% block content %}
<main class="contact-page" itemscope itemtype="https://schema.org/ContactPage">
    {# Hero Section con dos columnas #}
    <header class="relative mt-[70px] lg:mt-[120px] bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] text-white overflow-hidden isolate" itemprop="mainEntity">
        <!-- Efectos decorativos consistentes con heroWithImage -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
        </div>

        <div class="relative z-10 w-full py-12 lg:py-16">
            {# Centrado en pantallas grandes #}
            <div class="w-full px-4 sm:px-8 md:px-12 lg:px-0 md:w-[95%] max-w-[1400px] mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                    {# Columna izquierda - Info principal #}
                    <div class="space-y-8">
                        {# Breadcrumbs #}
                        {% include "partials/breadcrumb.njk" %}
                        
                        <h1 class="text-[2.5rem] md:text-[3.5rem] font-light leading-[1.1] text-center md:text-left" itemprop="headline">
                            {{ contact.title | safe}}
                        </h1>
                        
                        <p class="text-lg md:text-xl text-cyan-50 font-light max-w-3xl mx-auto md:mx-0 text-center md:text-left py-2 lg:py-4" itemprop="description">
                        {{ contact.intro }}
                        </p>
                    </div>
                    
                    {# Contacto rápido en hero - Columna derecha, visible siempre #}
                    <div class="space-y-6" itemscope itemtype="https://schema.org/ContactPoint">
                        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
                            <h3 class="text-xl font-medium text-white mb-4 text-center md:text-left">{{contact.direct_contact.title }}</h3>
                            <div class="space-y-4">
                                <a href="tel:{{metadata.contact.phoneNumber}}" class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-xl transition-colors group" itemprop="telephone">
                                    <svg class="w-6 h-6 text-cyan-400 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                    <div>
                                        <div class="text-white font-medium">{{metadata.contact.phoneNumber}}</div>
                                        <p class="text-xs text-white/70">{{metadata.contactLocation[currentLanguage].schedule.hours}}</p>
                                    </div>
                                </a>
                                
                                <a href="mailto:info@perito.barcelona" class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-xl transition-colors group" itemprop="email">
                                    <svg class="w-6 h-6 text-cyan-400 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                    <div>
                                        <div class="text-white font-medium">{{metadata.contact.email}}</div>
                                        <p class="text-xs text-white/70">{{contact.direct_contact.email_response }}</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        {# Patrón de fondo #}
        <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
    </header>

    

    {# Contenido Principal - 2 Columnas con Typeform y Mapas #}
    <section class="py-24 relative z-10 bg-gradient-to-br from-slate-100 via-white to-slate-50 overflow-hidden isolate">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.1)_1px,transparent_1px)] [background-size:48px_48px]"></div>
        <div class="max-w-[1400px] mx-auto px-4 md:px-8">
            <div class="grid lg:grid-cols-2 items-start lg:items-stretch gap-12 lg:gap-16">
                <div class="order-2 lg:order-1" itemscope itemtype="https://schema.org/Place">
                    {# Sticky wrapper #}
                    <div class="sticky top-24 space-y-8">
                        {# Encabezado descriptivo para las ubicaciones #}
                        <div class="text-center lg:text-left">
                             <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-3 flex items-center gap-2" itemprop="name">
                                <svg class="w-7 h-7 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                {{ metadata.contactLocation[currentLanguage].title }}
                             </h2>
                        </div>
                        
                        {# Ubicaciones con tabs para mapas #}
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-slate-100 flex flex-col">

                            
                            {# Contenido de la dirección #}
                            <div class="flex-grow">
                                <!-- Dirección Barcelona -->
                                <div class="h-full flex flex-col" itemscope itemtype="https://schema.org/Place">
                                    <meta itemprop="name" content="Oficina de Barcelona">
                                    <div class="p-6 lg:p-8 bg-white">
                                        <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                                            <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                                                <p class="text-lg font-bold text-slate-800 mb-1" itemprop="addressLocality">
                                                    {{ metadata.contact.address.city }}
                                                </p>
                                                <p class="text-slate-600"><span itemprop="streetAddress">{{ metadata.contact.address.street }}</span>, <span itemprop="postalCode">{{ metadata.contact.address.postalCode }}</span> <span itemprop="addressLocality">{{ metadata.contact.address.city }}</span>, <span itemprop="addressCountry">{{ metadata.contact.address.country }}</span></p>
                                                <p class="text-sm text-slate-500 mt-1">Metro L5 Entença</p>
                                            </div>
                                            <div class="md:pl-4 md:border-l md:border-slate-200 flex-shrink-0 mt-4 md:mt-0">
                                                <p class="text-sm font-semibold text-slate-700">{{ metadata.contactLocation[currentLanguage].schedule.title }}</p>
                                                <p class="text-sm text-slate-600">{{ metadata.contactLocation[currentLanguage].schedule.hours }}</p>
                                                <p class="text-xs text-slate-500 mt-1">{{ metadata.contactLocation[currentLanguage].schedule.note }}</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="h-[350px] flex-grow relative">
                                        <iframe 
                                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2993.6856624264604!2d2.136047!3d41.3850643!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4987ae76a9c89%3A0xd6c91a8d003a5417!2sC.%20de%20Numancia%2C%2095%2C%20L-5%2C%2008029%20Barcelona!5e0!3m2!1ses!2ses!4v1660123456789!5m2!1ses!2ses"
                                            class="w-full h-full border-0"
                                            allowfullscreen=""
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"
                                            title="Oficina de Barcelona - C/ Numancia 95, Local 5">
                                        </iframe>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="order-1 lg:order-2" itemscope itemtype="https://schema.org/ContactPoint">
                    <div class="bg-white rounded-2xl shadow-xl p-8 lg:p-12 border border-slate-100">
                <div id="typeform-wrapper" class="flex flex-col h-full">
                    <!-- Encabezado del formulario -->
                    <div class="text-center mb-8">
                        <h3 class="text-2xl font-bold text-slate-800 mb-2">{{ metadata.ctaForm[currentLanguage].formTitle }}</h3>
                        <p class="text-slate-600">{{ metadata.ctaForm[currentLanguage].formSubtitle }}</p>
                    </div>
                    <div id="typeform-container" class="flex-grow flex flex-col justify-between relative min-h-[350px]">
                        <div id="typeform-steps-container">
                            <!-- Paso Inicial - Tipo de Contacto -->
                            <div class="typeform-step active space-y-8" data-step="tipo-contacto">
                                <div class="space-y-3 mb-6">
                                    <p class="text-base text-cyan-600 font-medium">{{ metadata.ctaForm[currentLanguage].questions.tipoContacto.number }}</p>
                                    <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.tipoContacto.title }}</h3>
                                </div>
                                <div class="space-y-4">
                                    {% for option in metadata.ctaForm[currentLanguage].questions.tipoContacto.options %}
                                    <button type="button" data-value="{{ option.value }}" class="tipo-contacto-option w-full px-6 py-4 text-left bg-slate-50 hover:bg-slate-100 border-2 border-slate-200 rounded-xl transition-all duration-200 group focus:outline-none focus:ring-2 focus:ring-cyan-500/50">
                                        <span class="text-lg text-slate-800">{{ option.label }}</span>
                                    </button>
                                    {% endfor %}
                                </div>
                            </div>

                            <!-- Paso Nombre Empresa (Condicional) -->
                            <div class="typeform-step hidden space-y-8" data-step="nombre-empresa">
                                <div class="space-y-3 mb-6">
                                    <p class="text-base text-cyan-600 font-medium">{{ metadata.ctaForm[currentLanguage].questions.nombreEmpresa.number }}</p>
                                    <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.nombreEmpresa.title }}</h3>
                                </div>
                                <input type="text" id="nombreEmpresa" name="nombreEmpresa" class="w-full px-4 py-3 text-lg bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200" required>
                                <div class="flex justify-between">
                                    <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                        </svg>
                                        {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                    </button>
                                    <button type="button" class="typeform-next px-6 py-3 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:shadow-cyan-500/20 transition-all duration-200 group flex items-center gap-2 text-sm">
                                        {{ metadata.contactForm[currentLanguage].buttons.next }}
                                        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Paso Nombre -->
                            <div class="typeform-step hidden space-y-8" data-step="intro">
                                <div class="space-y-3 mb-6">
                                    <p class="text-base text-cyan-600 font-medium">{{ metadata.ctaForm[currentLanguage].questions.nombre.number }}</p>
                                    <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.nombre.title }}</h3>
                                </div>
                                <input type="text" id="nombre" name="nombre" class="w-full px-4 py-3 text-lg bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200" required>
                                <p class="text-sm text-slate-500 mt-2">{{ metadata.ctaForm[currentLanguage].helpText.nombre }}</p>
                                <div class="flex justify-between items-center">
                                    <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50 {% if currentStep == 0 %}hidden{% endif %}">
                                        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                        </svg>
                                        {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                    </button>
                                    <button type="button" class="typeform-next px-6 py-3 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:shadow-cyan-500/20 transition-all duration-200 group flex items-center gap-2 text-sm">
                                        {{ metadata.contactForm[currentLanguage].buttons.next }}
                                        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Paso Email -->
                            <div class="typeform-step hidden space-y-8" data-step="email">
                                <div class="space-y-3 mb-6">
                                    <p class="text-base text-cyan-600 font-medium">{{ metadata.ctaForm[currentLanguage].questions.email.number }}</p>
                                    <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.email.title }}</h3>
                                </div>
                                <input type="email" id="email" name="email" class="w-full px-4 py-3 text-lg bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200" required>
                                <p class="text-sm text-slate-500 mt-2">{{ metadata.ctaForm[currentLanguage].helpText.email }}</p>
                                <div class="flex justify-between">
                                    <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                        </svg>
                                        {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                    </button>
                                    <button type="button" class="typeform-next px-6 py-3 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:shadow-cyan-500/20 transition-all duration-200 group flex items-center gap-2 text-sm">
                                        {{ metadata.contactForm[currentLanguage].buttons.next }}
                                        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Paso Teléfono -->
                            <div class="typeform-step hidden space-y-8" data-step="telefono">
                                <div class="space-y-3 mb-6">
                                    <p class="text-base text-cyan-600 font-medium">{{ metadata.ctaForm[currentLanguage].questions.telefono.number }}</p>
                                    <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.telefono.title }}</h3>
                                </div>
                                <input type="tel" id="telefono" name="telefono" class="w-full px-4 py-3 text-lg bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200">
                                <p class="text-sm text-slate-500 mt-2">{{ metadata.ctaForm[currentLanguage].helpText.telefono }}</p>
                                <div class="flex justify-between">
                                    <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                        </svg>
                                        {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                    </button>
                                    <button type="button" class="typeform-next px-6 py-3 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:shadow-cyan-500/20 transition-all duration-200 group flex items-center gap-2 text-sm">
                                        {{ metadata.contactForm[currentLanguage].buttons.next }}
                                        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Paso Área de Interés -->
                            <div class="typeform-step hidden space-y-8" data-step="area-interes">
                                <div class="space-y-3 mb-6">
                                    <p class="text-base text-cyan-600 font-medium">{{ metadata.ctaForm[currentLanguage].questions.areaInteres.number }}</p>
                                    <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.areaInteres.title }}</h3>
                                </div>
                                <div class="space-y-4">
                                    {% for option in metadata.ctaForm[currentLanguage].questions.areaInteres.options %}
                                    <button type="button" data-value="{{ option.value }}" class="area-interes-option w-full px-6 py-4 text-left bg-slate-50 hover:bg-slate-100 border-2 border-slate-200 rounded-xl transition-all duration-200 group focus:outline-none focus:ring-2 focus:ring-cyan-500/50">
                                        <span class="text-lg text-slate-800">{{ option.label }}</span>
                                    </button>
                                    {% endfor %}
                                </div>
                                <div class="flex justify-between">
                                    <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                        </svg>
                                        {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                    </button>
                                </div>
                            </div>

                            <!-- Paso Mensaje -->
                            <div class="typeform-step hidden space-y-8" data-step="mensaje">
                                <div class="space-y-3 mb-6">
                                    <p class="text-base text-cyan-600 font-medium">{{ metadata.ctaForm[currentLanguage].questions.mensaje.number }}</p>
                                    <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.mensaje.title }}</h3>
                                </div>
                                <textarea id="mensaje" name="mensaje" rows="4" class="w-full px-4 py-3 text-lg bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200 resize-none" required></textarea>
                                <p class="text-sm text-slate-500 mt-2">{{ metadata.ctaForm[currentLanguage].helpText.mensaje }}</p>
                                <div class="flex justify-between">
                                    <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                        </svg>
                                        {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                    </button>
                                    <button type="button" class="typeform-next px-6 py-3 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:shadow-cyan-500/20 transition-all duration-200 group flex items-center gap-2 text-sm">
                                        {{ metadata.contactForm[currentLanguage].buttons.next }}
                                        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Paso Privacidad -->
                            <div class="typeform-step hidden space-y-8" data-step="privacidad">
                                <div class="space-y-3 mb-6">
                                    <p class="text-base text-cyan-600 font-medium">{{ metadata.ctaForm[currentLanguage].questions.privacidad.number }}</p>
                                    <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.privacidad.title }}</h3>
                                </div>
                                <div class="space-y-6">
                                    <label for="privacidad" class="flex items-start gap-4 p-4 bg-slate-50 border-2 border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors has-[:checked]:bg-cyan-50 has-[:checked]:border-cyan-400">
                                        <input type="checkbox" 
                                               id="privacidad" 
                                               name="privacidad" 
                                               class="mt-1 w-5 h-5 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 shrink-0"
                                               required>
                                        <div class="text-slate-600 text-base">
                                            {{ metadata.ctaForm[currentLanguage].privacyText | safe }}
                                        </div>
                                    </label>
                                    <p id="privacy-error" class="text-red-500 text-sm hidden ml-4">
                                        {{ metadata.ctaForm[currentLanguage].privacyError }}
                                    </p>
                                    <div class="flex justify-between items-center pt-4">
                                        <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                            <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                            </svg>
