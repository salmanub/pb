{% block scripts %}
<script>
    const currentLang = '{{ currentLanguage }}';
</script>
<script>
                document.addEventListener('DOMContentLoaded', () => {
                    const formWrapper = document.getElementById('typeform-wrapper');
                    const steps = Array.from(formWrapper.querySelectorAll('.typeform-step'));
                    const progress = document.getElementById('typeform-progress');
                    const webhookUrl = 'https://hook.eu2.make.com/76yaogaunrc9cqdtf26ldcoxb3fpndma';
                    let currentStep = 0;
                    const totalSteps = steps.filter(s => !s.id.includes('-state') && !s.id.includes('-message')).length;
                    let formData = {
                        tipoContacto: '',
                        nombreEmpresa: '',
                        areaInteres: ''
                    };

                    function showStep(stepIndex) {
                        steps.forEach((step, index) => {
                            step.classList.toggle('active', index === stepIndex);
                            step.classList.toggle('hidden', index !== stepIndex);
                        });
                        if (progress) {
                            const progressPercentage = Math.max(0, (stepIndex / (totalSteps - 1)) * 100);
                            progress.style.width = `${progressPercentage}%`;
                        }
                        const newStepEl = steps[stepIndex];
                        const input = newStepEl.querySelector('input, textarea');
                        if (input) setTimeout(() => input.focus(), 300);
                    }

                    function validateCurrentStep() {
                        const currentStepEl = steps[currentStep];
                        const input = currentStepEl.querySelector('input[required]:not([type="checkbox"]), textarea[required]');
                        if (input && !input.value.trim()) {
                            input.classList.add('border-red-400');
                            input.focus();
                            input.addEventListener('input', () => input.classList.remove('border-red-400'), { once: true });
                            return false;
                        }
                        const checkbox = currentStepEl.querySelector('input[type="checkbox"][required]');
                        if (checkbox && !checkbox.checked) {
                            const privacyError = document.getElementById('privacy-error');
                            privacyError.classList.remove('hidden');
                            checkbox.focus();
                            return false;
                        }
                        return true;
                    }

                    function updateSubmitButton() {
                        const privacidadCheckbox = document.getElementById('privacidad');
                        const submitButton = document.getElementById('submit-form-btn');
                        const privacyError = document.getElementById('privacy-error');
                        
                        if (privacidadCheckbox.checked) {
                            submitButton.removeAttribute('disabled');
                            privacyError.classList.add('hidden');
                        } else {
                            submitButton.setAttribute('disabled', '');
                        }
                    }

                    const privacidadCheckbox = document.getElementById('privacidad');
                    if (privacidadCheckbox) {
                        privacidadCheckbox.addEventListener('change', updateSubmitButton);
                    }

                    async function submitForm() {
                        if (!validateCurrentStep()) return;

                        showStep(steps.findIndex(s => s.id === 'loading-state'));
                        const formDataToSend = new FormData();
                        formDataToSend.append('tipoContacto', formData.tipoContacto);
                        if (formData.tipoContacto === 'empresa') {
                            formDataToSend.append('nombreEmpresa', document.getElementById('nombreEmpresa').value);
                        }
                        formDataToSend.append('nombre', document.getElementById('nombre').value);
                        formDataToSend.append('email', document.getElementById('email').value);
                        formDataToSend.append('telefono', document.getElementById('telefono').value);
                        formDataToSend.append('areaInteres', formData.areaInteres);
                        formDataToSend.append('mensaje', document.getElementById('mensaje').value);
                        formDataToSend.append('privacidad', 'Aceptada');
                        formDataToSend.append('origen', 'CTA Form perito.barcelona');
                        
                        const now = new Date();
                        const isoDate = now.toISOString();
                        const localDate = now.toLocaleString('es-ES', {
                            year: 'numeric',
                            month: 'numeric',
                            day: 'numeric',
                            hour: 'numeric',
                            minute: 'numeric',
                            second: 'numeric',
                            hour12: false
                        });
                        const formattedDate = `${isoDate}	${localDate}`;
                        formDataToSend.append('fecha', formattedDate);

                        try {
                            const response = await fetch(webhookUrl, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(Object.fromEntries(formDataToSend))
                            });
                            if (!response.ok) throw new Error('Network response was not ok');
                            showStep(steps.findIndex(s => s.id === 'success-message'));
                        } catch (error) {
                            console.error('Error:', error);
                            showStep(steps.findIndex(s => s.id === 'error-message'));
                        }
                    }

                    formWrapper.addEventListener('click', (e) => {
                        const target = e.target;
                        const tipoContactoOption = target.closest('.tipo-contacto-option');
                        const areaInteresOption = target.closest('.area-interes-option');
                        
                        if (tipoContactoOption) {
                            formData.tipoContacto = tipoContactoOption.dataset.value;
                            currentStep = formData.tipoContacto === 'empresa' ? 1 : 2;
                            showStep(currentStep);
                        } else if (areaInteresOption) {
                            formData.areaInteres = areaInteresOption.dataset.value;
                            currentStep++;
                            showStep(currentStep);
                        } else if (target.closest('.typeform-next')) {
                            if (validateCurrentStep()) {
                                currentStep++;
                                showStep(currentStep);
                            }
                        } else if (target.closest('.typeform-prev')) {
                            if (currentStep > 0) {
                                if (currentStep === 2 && formData.tipoContacto !== 'empresa') {
                                    currentStep = 0;
                                } else {
                                    currentStep--;
                                }
                                showStep(currentStep);
                            }
                        } else if (target.closest('#submit-form-btn')) {
                            submitForm();
                        } else if (target.closest('#retry-button')) {
                            currentStep = 0;
                            formData = { tipoContacto: '', nombreEmpresa: '', areaInteres: '' };
                            // Reset form fields if needed
                            formWrapper.querySelectorAll('input, textarea').forEach(el => {
                                if(el.type === 'checkbox') el.checked = false;
                                else el.value = '';
                            });
                            updateSubmitButton();
                            showStep(currentStep);
                        }
                    });

                    formWrapper.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            const currentStepEl = steps[currentStep];
                            const nextButton = currentStepEl.querySelector('.typeform-next');
                            const submitButton = currentStepEl.querySelector('#submit-form-btn');
                            
                            if (currentStepEl.querySelector('textarea') && !e.ctrlKey) return;

                            e.preventDefault();
                            if (submitButton) {
                                submitForm();
                            } else if (nextButton) {
                                nextButton.click();
                            }
                        }
                    });

                    showStep(0);
                });
                </script>
{% endblock scripts %}

