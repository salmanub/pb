{% extends "layouts/base.njk" %}

{% set currentLanguage = page.lang or lang or 'es' %}

{% block content %}
<main class="contact-page" itemscope itemtype="https://schema.org/ContactPage">
    {# Hero Section con dos columnas #}
    <header class="relative mt-[70px] lg:mt-[120px] bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] text-white overflow-hidden isolate" itemprop="mainEntity">
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
        </div>

        <div class="relative z-10 w-full py-12 lg:py-16">
            {# Centrado en pantallas grandes #}
            <div class="w-full px-4 sm:px-8 md:px-12 lg:px-0 md:w-[95%] max-w-[1400px] mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                    {# Columna izquierda - Info principal #}
                    <div class="space-y-8">
                        {# Breadcrumbs #}
                        {% include "partials/breadcrumb.njk" %}
                        
                        <h1 class="text-[2.5rem] md:text-[3.5rem] font-light leading-[1.1] text-center md:text-left" itemprop="headline">
                            {{ contact.title | safe}}
                        </h1>
                        
                        <p class="text-lg md:text-xl text-cyan-50 font-light max-w-3xl mx-auto md:mx-0 text-center md:text-left py-2 lg:py-4" itemprop="description">
                        {{ contact.intro }}
                        </p>
                    </div>
                    
                    {# Contacto rápido en hero - Columna derecha, visible siempre #}
                    <div class="space-y-6" itemscope itemtype="https://schema.org/ContactPoint">
                        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
                            <h3 class="text-xl font-medium text-white mb-4 text-center md:text-left">{{contact.direct_contact.title }}</h3>
                            <div class="space-y-4">
                                <a href="tel:{{metadata.contact.phoneNumber}}" class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-xl transition-colors group" itemprop="telephone">
                                    <svg class="w-6 h-6 text-cyan-400 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                    <div>
                                        <div class="text-white font-medium">{{metadata.contact.phoneNumber}}</div>
                                        <p class="text-xs text-white/70">{{metadata.contactLocation[currentLanguage].schedule.hours}}</p>
                                    </div>
                                </a>
                                
                                <a href="mailto:{{metadata.contact.email}}" class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-xl transition-colors group" itemprop="email">
                                    <svg class="w-6 h-6 text-cyan-400 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                    <div>
                                        <div class="text-white font-medium">{{metadata.contact.email}}</div>
                                        <p class="text-xs text-white/70">{{contact.direct_contact.email_response }}</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        {# Patrón de fondo #}
        <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
    </header>

    {# Contenido Principal - 2 Columnas con Formulario y Mapas #}
    <section class="py-24 relative z-10 bg-gradient-to-br from-slate-100 via-white to-slate-50 overflow-hidden isolate">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.1)_1px,transparent_1px)] [background-size:48px_48px]"></div>
        <div class="max-w-[1400px] mx-auto px-4 md:px-8">
            <div class="grid lg:grid-cols-2 items-start gap-12 lg:gap-16">
                
                <div class="order-1 lg:order-1">
                    <div class="bg-white rounded-2xl shadow-xl p-8 lg:p-12 border border-slate-100">
                        <div id="typeform-wrapper" class="flex flex-col h-full">
                            <div class="text-center mb-8">
                                <h3 class="text-2xl font-bold text-slate-800 mb-2">{{ metadata.ctaForm[currentLanguage].formTitle }}</h3>
                                <p class="text-slate-600">{{ metadata.ctaForm[currentLanguage].formSubtitle }}</p>
                            </div>
                            <div id="typeform-container" class="flex-grow flex flex-col justify-between relative min-h-[350px]">
                                <div id="typeform-steps-container">
                                    
                                    <div class="typeform-step active space-y-8" data-step="area-interes">
                                        <div class="space-y-3 mb-6">
                                            <p class="step-counter text-base text-cyan-600 font-medium"></p>
                                            <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.areaInteres.title }}</h3>
                                        </div>
                                        <div class="space-y-4">
                                            {% for option in metadata.ctaForm[currentLanguage].questions.areaInteres.options %}
                                            <button type="button" data-value="{{ option.value }}" class="area-interes-option w-full px-6 py-4 text-left bg-slate-50 hover:bg-slate-100 border-2 border-slate-200 rounded-xl transition-all duration-200 group focus:outline-none focus:ring-2 focus:ring-cyan-500/50">
                                                <span class="text-lg text-slate-800">{{ option.label }}</span>
                                            </button>
                                            {% endfor %}
                                        </div>
                                    </div>

                                    <div class="typeform-step hidden space-y-8" data-step="mensaje">
                                        <div class="space-y-3 mb-6">
                                            <p class="step-counter text-base text-cyan-600 font-medium"></p>
                                            <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.mensaje.title }}</h3>
                                        </div>
                                        <textarea id="mensaje" name="mensaje" rows="4" class="w-full px-4 py-3 text-lg bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200 resize-none" required></textarea>
                                        <p class="text-sm text-slate-500 mt-2">{{ metadata.ctaForm[currentLanguage].helpText.mensaje }}</p>
                                        <div class="flex justify-between">
                                            <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                                <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                                                {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                            </button>
                                            <button type="button" class="typeform-next px-6 py-3 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:shadow-cyan-500/20 transition-all duration-200 group flex items-center gap-2 text-sm">
                                                {{ metadata.contactForm[currentLanguage].buttons.next }}
                                                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="typeform-step hidden space-y-8" data-step="nombre">
                                        <div class="space-y-3 mb-6">
                                            <p class="step-counter text-base text-cyan-600 font-medium"></p>
                                            <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.nombre.title }}</h3>
                                        </div>
                                        <input type="text" id="nombre" name="nombre" class="w-full px-4 py-3 text-lg bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200" required>
                                        <p class="text-sm text-slate-500 mt-2">{{ metadata.ctaForm[currentLanguage].helpText.nombre }}</p>
                                        <div class="flex justify-between items-center">
                                             <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                                <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                                                {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                            </button>
                                            <button type="button" class="typeform-next px-6 py-3 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:shadow-cyan-500/20 transition-all duration-200 group flex items-center gap-2 text-sm">
                                                {{ metadata.contactForm[currentLanguage].buttons.next }}
                                                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="typeform-step hidden space-y-8" data-step="email">
                                        <div class="space-y-3 mb-6">
                                            <p class="step-counter text-base text-cyan-600 font-medium"></p>
                                            <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.email.title }}</h3>
                                        </div>
                                        <input type="email" id="email" name="email" class="w-full px-4 py-3 text-lg bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200" required>
                                        <p class="text-sm text-slate-500 mt-2">{{ metadata.ctaForm[currentLanguage].helpText.email }}</p>
                                        <div class="flex justify-between">
                                            <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                                <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                                                {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                            </button>
                                            <button type="button" class="typeform-next px-6 py-3 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:shadow-cyan-500/20 transition-all duration-200 group flex items-center gap-2 text-sm">
                                                {{ metadata.contactForm[currentLanguage].buttons.next }}
                                                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <div class="typeform-step hidden space-y-8" data-step="telefono">
                                        <div class="space-y-3 mb-6">
                                            <p class="step-counter text-base text-cyan-600 font-medium"></p>
                                            <h3 class="text-3xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].questions.telefono.title }}</h3>
                                        </div>
                                        <input type="tel" id="telefono" name="telefono" class="w-full px-4 py-3 text-lg bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200">
                                        <p class="text-sm text-slate-500 mt-2">{{ metadata.ctaForm[currentLanguage].helpText.telefono }}</p>
                                        <div class="space-y-6">
                                            <div class="flex items-start gap-3 py-4">
                                                <input type="checkbox" id="privacidad" name="privacidad" class="mt-1 w-5 h-5 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 cursor-pointer" required>
                                                <label for="privacidad" class="text-slate-600 cursor-pointer text-base">{{ metadata.ctaForm[currentLanguage].privacyText | safe }}</label>
                                            </div>
                                            <p id="privacy-error" class="text-red-500 text-sm hidden ml-4">{{ metadata.ctaForm[currentLanguage].privacyError }}</p>
                                            <div class="flex justify-between">
                                                <button type="button" class="typeform-prev group px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-2 text-sm rounded-lg hover:bg-slate-50">
                                                    <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                                                    {{ metadata.contactForm[currentLanguage].buttons.prev }}
                                                </button>
                                                <button type="button" id="submit-form-btn" class="px-8 py-4 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-lg transition-all duration-200 group flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-lg enabled:hover:shadow-xl enabled:hover:shadow-cyan-500/25" disabled>
                                                    {{ metadata.ctaContact[currentLanguage].form.submitText }}
                                                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div id="loading-state" class="typeform-step hidden space-y-6 text-center" data-step="loading">
                                         <div class="w-16 h-16 mx-auto mb-6 border-4 border-cyan-200 border-t-cyan-500 rounded-full animate-spin"></div>
                                         <h3 class="text-2xl font-light text-slate-800">{{ metadata.ctaForm[currentLanguage].messages.loading.title }}</h3>
                                         <p class="text-lg text-slate-600">{{ metadata.ctaForm[currentLanguage].messages.loading.subtitle }}</p>
                                     </div>
                                     <div id="success-message" class="typeform-step hidden space-y-8 text-center" data-step="success">
                                         <div class="relative"><div class="w-20 h-20 mx-auto mb-8 bg-gradient-to-br from-green-50 to-green-100 rounded-full p-5"><div class="w-full h-full bg-green-500 rounded-full flex items-center justify-center"><svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg></div></div></div>
                                         <h3 class="text-3xl font-bold bg-gradient-to-r from-green-600 to-green-500 bg-clip-text text-transparent">{{ metadata.ctaForm[currentLanguage].messages.success.title }}</h3>
                                         <p class="text-lg text-slate-500 font-light max-w-md mx-auto">{{ metadata.ctaForm[currentLanguage].messages.success.subtitle }}</p>
                                         <a href="{% if currentLanguage != 'es' %}/{{ currentLanguage }}/{% else %}/{% endif %}" class="inline-flex items-center justify-center mt-6 px-8 py-4 bg-gradient-to-r from-green-500 to-green-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:shadow-green-500/25 transform hover:scale-105 transition-all duration-200">{{ metadata.contactForm[currentLanguage].buttons.home }}</a>
                                     </div>
                                     <div id="error-message" class="typeform-step hidden space-y-8 text-center" data-step="error">
                                         <div class="relative"><div class="w-20 h-20 mx-auto mb-8 bg-gradient-to-br from-red-50 to-red-100 rounded-full p-5"><div class="w-full h-full bg-red-500 rounded-full flex items-center justify-center"><svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg></div></div></div>
                                         <h3 class="text-3xl font-bold bg-gradient-to-r from-red-600 to-red-500 bg-clip-text text-transparent">{{ metadata.ctaForm[currentLanguage].messages.error.title }}</h3>
                                         <p class="text-lg text-slate-500 font-light max-w-md mx-auto">{{ metadata.ctaForm[currentLanguage].messages.error.subtitle }}</p>
                                         <button id="retry-button" type="button" class="inline-flex items-center justify-center mt-6 px-8 py-4 bg-gradient-to-r from-red-500 to-red-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:shadow-red-500/25 transform hover:scale-105 transition-all duration-200">{{ metadata.contactForm[currentLanguage].buttons.retry }}</button>
                                     </div>
                                </div>
                            </div>
                            <div id="progress-bar-container" class="mt-8 w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                                <div id="typeform-progress" class="bg-gradient-to-r from-cyan-400 to-cyan-600 h-full w-0 transition-all duration-300"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="order-2 lg:order-2" itemscope itemtype="https://schema.org/Place">
                    <div class="sticky top-24 space-y-8">
                        <div class="text-center lg:text-left">
                             <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-3 flex items-center gap-2" itemprop="name">
                                <svg class="w-7 h-7 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                {{ metadata.contactLocation[currentLanguage].title }}
                             </h2>
                        </div>
                        
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-slate-100 flex flex-col">
                            <div class="flex-grow">
                                <div class="h-full flex flex-col" itemscope itemtype="https://schema.org/Place">
                                    <meta itemprop="name" content="Oficina de Barcelona">
                                    <div class="p-6 lg:p-8 bg-white">
                                        <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                                            <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                                                <p class="text-lg font-bold text-slate-800 mb-1" itemprop="addressLocality">
                                                    {{ metadata.contact.address.city }}
                                                </p>
                                                <p class="text-slate-600"><span itemprop="streetAddress">{{ metadata.contact.address.street }}</span>, <span itemprop="postalCode">{{ metadata.contact.address.postalCode }}</span> <span itemprop="addressLocality">{{ metadata.contact.address.city }}</span>, <span itemprop="addressCountry">{{ metadata.contact.address.country }}</span></p>
                                                <p class="text-sm text-slate-500 mt-1">Metro L5 Entença</p>
                                            </div>
                                            <div class="md:pl-4 md:border-l md:border-slate-200 flex-shrink-0 mt-4 md:mt-0">
                                                <p class="text-sm font-semibold text-slate-700">{{ metadata.contactLocation[currentLanguage].schedule.title }}</p>
                                                <p class="text-sm text-slate-600">{{ metadata.contactLocation[currentLanguage].schedule.hours }}</p>
                                                <p class="text-xs text-slate-500 mt-1">{{ metadata.contactLocation[currentLanguage].schedule.note }}</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="h-[350px] flex-grow relative">
                                        <iframe 
                                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2993.686548425261!2d2.141527315425677!3d41.3810189792649!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4a27e1c1b0f1d%3A0x2f15e7e72e27645b!2sCarrer%20de%20Num%C3%A0ncia%2C%2095%2C%2008029%20Barcelona%2C%20Spain!5e0!3m2!1sen!2sie!4v1620293072041!5m2!1sen!2sie"
                                            class="w-full h-full border-0"
                                            allowfullscreen=""
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"
                                            title="Oficina de Barcelona - C/ Numancia 95, Local 5">
                                        </iframe>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
    
    {# Contenido Markdown adicional si existe #}
    {% if content | length > 10 %}
    <section class="py-16 lg:py-24 relative z-10 bg-white">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="prose prose-lg prose-slate max-w-4xl mx-auto">
                {{ content | safe }}
            </div>
        </div>
    </section>
    {% endif %}
</main>
{% endblock %}

{% block scripts %}
{{ super() }}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const formWrapper = document.getElementById('typeform-wrapper');
        if (!formWrapper) return;

        const steps = Array.from(formWrapper.querySelectorAll('.typeform-step'));
        const progress = document.getElementById('typeform-progress');
        const webhookUrl = 'https://hook.eu2.make.com/76yaogaunrc9cqdtf26ldcoxb3fpndma';
        let currentStep = 0;
        
        const questionSteps = steps.filter(step => step.dataset.step && !['loading', 'success', 'error'].includes(step.dataset.step));
        const totalQuestionSteps = questionSteps.length;
        
        let formData = { areaInteres: '' };

        function showStep(stepIndex) {
            const currentStepEl = steps[stepIndex];
            steps.forEach((step, index) => {
                step.classList.toggle('active', index === stepIndex);
                step.classList.toggle('hidden', index !== stepIndex);
            });

            const questionStepIndex = questionSteps.indexOf(currentStepEl);
            if (progress) {
                const progressPercentage = questionStepIndex >= 0 ? ((questionStepIndex + 1) / totalQuestionSteps) * 100 : (currentStepEl.id.includes('success') || currentStepEl.id.includes('error') ? 100 : 0);
                progress.style.width = `${progressPercentage}%`;
            }

            if (questionStepIndex !== -1) {
                const stepCounter = currentStepEl.querySelector('.step-counter');
                if (stepCounter) {
                    const lang = '{{ currentLanguage }}';
                    const questionText = lang === 'es' ? 'Pregunta' : 'Question';
                    stepCounter.textContent = `${questionText} ${questionStepIndex + 1} de ${totalQuestionSteps}`;
                }
            }

            const input = currentStepEl.querySelector('input, textarea');
            if (input) setTimeout(() => input.focus(), 300);
        }

        function validateCurrentStep() {
            const currentStepEl = steps[currentStep];
            const input = currentStepEl.querySelector('input[required], textarea[required]');
            if (input && !input.value.trim()) {
                input.classList.add('border-red-400');
                input.focus();
                input.addEventListener('input', () => input.classList.remove('border-red-400'), { once: true });
                return false;
            }
            if (input && input.type === 'email' && !/^\S+@\S+\.\S+$/.test(input.value)) {
                 input.classList.add('border-red-400');
                 input.focus();
                 return false;
            }
            return true;
        }

        function updateSubmitButton() {
            const privacidadCheckbox = document.getElementById('privacidad');
            const submitButton = document.getElementById('submit-form-btn');
            const privacyError = document.getElementById('privacy-error');
            if (privacidadCheckbox.checked) {
                submitButton.removeAttribute('disabled');
                privacyError.classList.add('hidden');
            } else {
                submitButton.setAttribute('disabled', '');
                if (privacidadCheckbox.dataset.touched === 'true') {
                    privacyError.classList.remove('hidden');
                }
            }
        }

        const privacidadCheckbox = document.getElementById('privacidad');
        privacidadCheckbox.addEventListener('change', updateSubmitButton);
        privacidadCheckbox.addEventListener('blur', () => {
            privacidadCheckbox.dataset.touched = 'true';
            updateSubmitButton();
        });

        async function submitForm() {
            if (!privacidadCheckbox.checked) {
                privacidadCheckbox.dataset.touched = 'true';
                privacidadCheckbox.focus();
                privacyError.classList.remove('hidden');
                return;
            }

            showStep(steps.findIndex(s => s.id === 'loading-state'));
            
            const formDataToSend = {
                areaInteres: formData.areaInteres,
                mensaje: document.getElementById('mensaje').value,
                nombre: document.getElementById('nombre').value,
                email: document.getElementById('email').value,
                telefono: document.getElementById('telefono').value,
                privacidad: 'Aceptada',
                origen: 'Página de Contacto',
                fecha: new Date().toISOString()
            };

            try {
                const response = await fetch(webhookUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formDataToSend)
                });
                if (!response.ok) throw new Error('Network response was not ok');
                showStep(steps.findIndex(s => s.id === 'success-message'));
            } catch (error) {
                console.error('Error:', error);
                showStep(steps.findIndex(s => s.id === 'error-message'));
            }
        }

        formWrapper.addEventListener('click', (e) => {
            const target = e.target;
            const areaInteresOption = target.closest('.area-interes-option');
            const nextButton = target.closest('.typeform-next');
            const prevButton = target.closest('.typeform-prev');
            const submitButton = target.closest('#submit-form-btn');
            const retryButton = target.closest('#retry-button');

            if (areaInteresOption) {
                formData.areaInteres = areaInteresOption.dataset.value;
                currentStep++;
                showStep(currentStep);
            } else if (nextButton) {
                if (validateCurrentStep()) {
                    currentStep++;
                    showStep(currentStep);
                }
            } else if (prevButton) {
                if (currentStep > 0) {
                    currentStep--;
                    showStep(currentStep);
                }
            } else if (submitButton) {
                if (validateCurrentStep()) submitForm();
            } else if (retryButton) {
                currentStep = 0;
                formData = { areaInteres: '' };
                document.getElementById('mensaje').value = '';
                document.getElementById('nombre').value = '';
                document.getElementById('email').value = '';
                document.getElementById('telefono').value = '';
                privacidadCheckbox.checked = false;
                updateSubmitButton();
                showStep(currentStep);
            }
        });

        formWrapper.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                const currentStepEl = steps[currentStep];
                if (currentStepEl.querySelector('#submit-form-btn')) {
                    if (validateCurrentStep()) submitForm();
                } else if(currentStepEl.querySelector('.area-interes-option')) {
                    return;
                } else if (validateCurrentStep()) {
                    currentStep++;
                    showStep(currentStep);
                }
            }
        });

        showStep(0);
    });
</script>
{% endblock scripts %}

{% block pageStyles %}
    {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
    <style>
        {{ indexCSS | safe }}
    </style>
{% endblock pageStyles %}
