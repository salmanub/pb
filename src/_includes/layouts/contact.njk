{% extends "layouts/base.njk" %}

{% block content %}
<main class="contact-page" itemscope itemtype="https://schema.org/ContactPage">
    {# Hero Section con dos columnas #}
    <header class="relative mt-[70px] lg:mt-[120px] bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] text-white overflow-hidden isolate" itemprop="mainEntity">
        <!-- Efectos decorativos consistentes con heroWithImage -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
        </div>

        <div class="relative z-10 w-full py-12 lg:py-16">
            {# Centrado en pantallas grandes #}
            <div class="w-full px-4 sm:px-8 md:px-12 lg:px-0 md:w-[95%] max-w-[1400px] mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                    {# Columna izquierda - Info principal #}
                    <div class="space-y-8">
                        {# Breadcrumbs #}
                        {% include "partials/breadcrumb.njk" %}
                        
                        
                        
                        <h1 class="text-[2.5rem] md:text-[3.5rem] font-light leading-[1.1] text-center md:text-left" itemprop="headline">
                            {{ contact.title | safe}}
                        </h1>
                        
                        <p class="text-lg md:text-xl text-cyan-50 font-light max-w-3xl mx-auto md:mx-0 text-center md:text-left py-2 lg:py-4" itemprop="description">
                        {{ contact.intro }}
                        </p>
                    </div>
                    
                    {# Contacto rápido en hero - Columna derecha, visible siempre #}
                    <div class="space-y-6" itemscope itemtype="https://schema.org/ContactPoint">
                        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
                            <h3 class="text-xl font-medium text-white mb-4 text-center md:text-left">{{contact.direct_contact.title }}</h3>
                            <div class="space-y-4">
                                <a href="tel:{{metadata.contact.phoneNumber}}" class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-xl transition-colors group" itemprop="telephone">
                                    <svg class="w-6 h-6 text-cyan-400 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                    <div>
                                        <div class="text-white font-medium">{{metadata.contact.phoneNumber}}</div>
                                        <p class="text-xs text-white/70">{{contact.direct_contact.phone_hours}}</p>
                                    </div>
                                </a>
                                
                                <a href="mailto:info@perito.barcelona" class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-xl transition-colors group" itemprop="email">
                                    <svg class="w-6 h-6 text-cyan-400 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                    <div>
                                        <div class="text-white font-medium">{{metadata.contact.email}}</div>
                                        <p class="text-xs text-white/70">{{contact.direct_contact.email_response }}</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        {# Patrón de fondo #}
        <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
    </header>

    {# Contenido Markdown #}
    {% if content | length > 10 %}
    <section class="py-16 lg:py-24 relative z-10 bg-white">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="prose prose-lg prose-slate max-w-4xl mx-auto">
                {{ content | safe }}
            </div>
        </div>
    </section>
    {% endif %}

    {# Contenido Principal - 2 Columnas con Typeform y Mapas #}
    <section class="py-24 relative z-10 bg-gradient-to-br from-slate-100 via-white to-slate-50 overflow-hidden isolate">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.1)_1px,transparent_1px)] [background-size:48px_48px]"></div>
        <div class="max-w-[1400px] mx-auto px-4 md:px-8">
            <div class="grid lg:grid-cols-2 items-start lg:items-stretch gap-12 lg:gap-16">
                <div class="order-1" itemscope itemtype="https://schema.org/ContactPoint">
                    <div id="typeform-wrapper" class="bg-white rounded-2xl shadow-xl p-8 lg:p-12 border border-slate-100 h-full flex flex-col">
                        <div class="mb-12 text-center lg:text-left">
                            <span class="inline-block text-sm uppercase tracking-wider text-cyan-600 font-semibold mb-3">{{ metadata.contactForm[lang].formSubtitle }}</span>
                            <h2 class="text-3xl md:text-4xl font-extrabold text-slate-800 mb-4 leading-tight" itemprop="name">{{ metadata.contactForm[lang].formTitle }}</h2>
                            <p class="text-lg text-slate-500 font-light leading-relaxed max-w-2xl" itemprop="description">{{ metadata.contactForm[lang].formDescription }}</p>
                        </div>
                        <div id="typeform-container" class="flex-grow flex flex-col justify-between relative min-h-[350px]">
                            <div id="typeform-steps-container">
                                {% for step in metadata.contactForm[lang].steps %}
                                <div class="typeform-step hidden space-y-8" data-step="{{ step.name }}">
                                    <div class="space-y-3">
                                        <label for="input-{{ step.name }}" class="text-2xl font-bold bg-gradient-to-r from-slate-800 to-slate-600 bg-clip-text text-transparent block leading-tight">{{ step.label }}</label>
                                        {% if step.helpText %}<p class="text-slate-600 text-lg font-light leading-relaxed">{{ step.helpText }}</p>{% endif %}
                                    </div>

                                    {% if step.type == "textarea" %}
                                        <textarea id="input-{{ step.name }}" name="{{ step.name }}" rows="4" class="w-full px-4 py-3 text-lg bg-slate-100 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200" placeholder="{{ step.placeholder }}" {% if step.required %}required{% endif %}></textarea>
                                    
                                    {% elif step.type == "checkbox" %}
                                        <div class="flex items-start gap-3 py-4">
                                            <input type="checkbox" id="input-{{ step.name }}" name="{{ step.name }}" {% if step.required %}required{% endif %} class="mt-1 w-5 h-5 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 cursor-pointer">
                                            <label for="input-{{ step.name }}" class="text-slate-600 cursor-pointer text-base">{{ step.text | safe }}</label>
                                        </div>
                                    
                                    {% elif step.type == "select" %}
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4">
                                            {% for option in step.options %}
                                                <button type="button" class="interest-option-btn w-full text-left p-4 border-2 border-slate-200 rounded-xl text-slate-700 hover:border-cyan-400 hover:bg-cyan-50/50 transition-all duration-200 flex items-center justify-between" data-value="{{ option.key }}">
                                                    <span class="font-medium pointer-events-none">{{ option.label }}</span>
                                                    <span class="check-icon opacity-0 transition-opacity pointer-events-none">
                                                        <svg class="w-6 h-6 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                                    </span>
                                                </button>
                                            {% endfor %}
                                        </div>
                                        <input type="hidden" id="input-{{ step.name }}" name="{{ step.name }}" {% if step.required %}required{% endif %}>
                                    
                                    {% else %}
                                        <input type="{{ step.type }}" id="input-{{ step.name }}" name="{{ step.name }}" class="w-full px-4 py-3 text-lg bg-slate-100 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:bg-white outline-none transition-all duration-200" placeholder="{{ step.placeholder }}" {% if step.required %}required{% endif %}>
                                    {% endif %}

                                    <div class="pt-6 flex justify-between items-center {% if step.type == 'select' %}hidden{% endif %}">
                                        {% if not loop.first %}
                                        <button type="button" class="typeform-prev px-5 py-2 text-slate-500 hover:text-slate-800 transition-colors flex items-center gap-2 text-sm font-medium">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                                            {{ metadata.contactForm[lang].buttons.prev }}
                                        </button>
                                        {% else %}<div></div>{% endif %}
                                        {% if loop.last %}
                                        <button id="submit-form-btn" type="button" class="px-8 py-4 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 shadow-sm hover:shadow-md transform hover:scale-105 transition-all duration-200 group flex items-center gap-2">
                                            {{ metadata.contactForm[lang].buttons.submit }}
                                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                                        </button>
                                        {% else %}
                                        <button type="button" class="typeform-next px-6 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 shadow-sm hover:shadow-md transform hover:scale-105 transition-all duration-200 group flex items-center gap-2 text-sm">
                                            {{ metadata.contactForm[lang].buttons.next }}
                                            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                                        </button>
                                        {% endif %}
                                    </div>
                                </div>
                                {% endfor %}
                                <div id="loading-state" class="typeform-step hidden space-y-6 text-center" data-step="loading">
                                    <div class="w-16 h-16 mx-auto mb-6 border-4 border-cyan-200 border-t-cyan-500 rounded-full animate-spin"></div>
                                    <h3 class="text-2xl font-light text-slate-800">{{ metadata.contactForm[lang].messages.loading.title }}</h3>
                                    <p class="text-lg text-slate-600">{{ metadata.contactForm[lang].messages.loading.subtitle }}</p>
                                </div>

                                <div id="success-message" class="typeform-step hidden space-y-8 text-center" data-step="success">
                                    <div class="relative">
                                        <div class="w-20 h-20 mx-auto mb-8 bg-gradient-to-br from-green-50 to-green-100 rounded-full p-5">
                                            <div class="w-full h-full bg-green-500 rounded-full flex items-center justify-center">
                                                <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                    <h3 class="text-3xl font-bold bg-gradient-to-r from-green-600 to-green-500 bg-clip-text text-transparent">{{ metadata.contactForm[lang].messages.success.title }}</h3>
                                    <p class="text-lg text-slate-500 font-light max-w-md mx-auto">{{ metadata.contactForm[lang].messages.success.subtitle }}</p>
                                    <a href="{% if lang != 'es' %}/{{ lang }}/{% else %}/{% endif %}" class="inline-flex items-center justify-center mt-6 px-8 py-4 bg-gradient-to-r from-green-500 to-green-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:shadow-green-500/25 transform hover:scale-105 transition-all duration-200">
                                        {{ metadata.contactForm[lang].buttons.home }}
                                    </a>
                                </div>

                                <div id="error-message" class="typeform-step hidden space-y-8 text-center" data-step="error">
                                    <div class="relative">
                                        <div class="w-20 h-20 mx-auto mb-8 bg-gradient-to-br from-red-50 to-red-100 rounded-full p-5">
                                            <div class="w-full h-full bg-red-500 rounded-full flex items-center justify-center">
                                                <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                    <h3 class="text-3xl font-bold bg-gradient-to-r from-red-600 to-red-500 bg-clip-text text-transparent">{{ metadata.contactForm[lang].messages.error.title }}</h3>
                                    <p class="text-lg text-slate-500 font-light max-w-md mx-auto">{{ metadata.contactForm[lang].messages.error.subtitle }}</p>
                                    <button id="retry-button" type="button" class="inline-flex items-center justify-center mt-6 px-8 py-4 bg-gradient-to-r from-red-500 to-red-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:shadow-red-500/25 transform hover:scale-105 transition-all duration-200">
                                        {{ metadata.contactForm[lang].buttons.retry }}
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div id="progress-bar-container" class="mt-8 w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                            <div id="typeform-progress" class="bg-gradient-to-r from-cyan-400 to-cyan-600 h-full w-0 transition-all duration-300"></div>
                        </div>
                        <form id="contactForm" class="hidden" aria-hidden="true"><input type="hidden" name="nombre" id="form-nombre"><input type="hidden" name="email" id="form-email"><input type="hidden" name="telefono" id="form-telefono"><input type="hidden" name="area-interes" id="form-area-interes"><input type="hidden" name="mensaje" id="form-mensaje"><input type="hidden" name="privacidad" id="form-privacidad"><input type="hidden" name="origen" value="Formulario Web perito.barcelona"><input type="hidden" name="fecha" id="form-fecha"></form>
                    </div>
                </div>
                <div class="order-2" itemscope itemtype="https://schema.org/Place">
                    <!-- Sección de Ubicaciones -->
                    <div class="space-y-12">
                        <!-- Título -->
                        <div class="text-center lg:text-left">
                            <span class="inline-block text-sm uppercase tracking-wider text-cyan-600 font-semibold mb-3">{{ metadata.footer[lang].location.title }}</span>
                            <h2 class="text-3xl md:text-4xl font-extrabold text-slate-800 mb-4 leading-tight">Nuestras Oficinas</h2>
                            <p class="text-lg text-slate-500 font-light leading-relaxed">Visítanos en cualquiera de nuestras oficinas principales.</p>
                        </div>

                        <!-- Lista de Oficinas -->
                        <div class="grid gap-6">
                            {% for office in metadata.footer[lang].location.offices %}
                            <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-cyan-400 transition-colors shadow-sm hover:shadow-md">
                                <div class="flex items-start gap-4">
                                    <!-- Icono -->
                                    <div class="w-12 h-12 rounded-xl bg-cyan-50 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-6 h-6 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                        </svg>
                                    </div>
                                    <!-- Información -->
                                    <div class="flex-grow">
                                        <h3 class="text-xl font-bold text-slate-800 mb-2">{{ office.city }}</h3>
                                        <p class="text-slate-600 mb-2">{{ office.address }}</p>
                                        <p class="text-sm text-slate-500">{{ office.transport }}</p>
                                    </div>
                                </div>
                                <!-- Mapa -->
                                <div class="mt-4 rounded-xl overflow-hidden h-[200px] bg-slate-100">
                                    {% if office.city == "Barcelona" %}
                                    <iframe class="w-full h-full" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2993.6862831842784!2d2.1444813!3d41.3845096!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4a27c9d9b4489%3A0x18ae9952199f22c4!2sC%2F%20de%20Num%C3%A0ncia%2C%2095%2C%20Local%205%2C%2008029%20Barcelona!5e0!3m2!1ses!2ses!4v1650000000000!5m2!1ses!2ses" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                                    {% else %}
                                    <iframe class="w-full h-full" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2982.4012668567366!2d2.2841666!3d41.6087499!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4c7c91a647eb7%3A0x44b876c0c5cdec21!2sC%2F%20Navarra%2C%2014%2C%2008401%20Granollers%2C%20Barcelona!5e0!3m2!1ses!2ses!4v1650000000000!5m2!1ses!2ses" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="py-24 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden isolate">{# ... Contenido del CTA final ... #}</section>
</main>
{% endblock %}

{% block scripts %}
<script>
    const currentLang = '{{ lang }}';
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const formWrapper = document.getElementById('typeform-wrapper');
    if (!formWrapper) return;
    const steps = Array.from(formWrapper.querySelectorAll('.typeform-step'));
    const retryBtn = formWrapper.querySelector('#retry-button');
    const webhookUrl = 'https://hook.eu2.make.com/76yaogaunrc9cqdtf26ldcoxb3fpndma';
    let currentStepIndex = 0;
    const totalInputSteps = formWrapper.querySelectorAll('.typeform-step[data-step]:not([data-step="loading"]):not([data-step="success"]):not([data-step="error"])').length;

    const showStep = (stepIndex) => {
        if (stepIndex < 0 || stepIndex >= steps.length) return;
        currentStepIndex = stepIndex;
        steps.forEach((step, index) => {
            step.classList.toggle('active', index === currentStepIndex);
            step.classList.toggle('hidden', index !== currentStepIndex);
        });
        const progress = formWrapper.querySelector('#typeform-progress');
        if (progress) {
            const activeInputSteps = steps.slice(0, currentStepIndex + 1).filter(s => s.dataset.step && !['loading','success','error'].includes(s.dataset.step)).length;
            const progressPercentage = totalInputSteps > 1 ? ((activeInputSteps - 1) / (totalInputSteps - 1)) * 100 : 0;
            progress.style.width = `${Math.max(0, progressPercentage)}%`;
        }
    };

    const validateCurrentStep = () => {
        const currentStepEl = steps[currentStepIndex];
        const input = currentStepEl.querySelector('input:not([type="checkbox"]):not([type="hidden"]), textarea');
        if (input && input.required && !input.value.trim()) {
            input.classList.add('border-red-400');
            input.focus();
            input.addEventListener('input', () => input.classList.remove('border-red-400'), { once: true });
            return false;
        }
        const checkbox = currentStepEl.querySelector('input[type="checkbox"]');
        if (checkbox && checkbox.required && !checkbox.checked) {
            const label = currentStepEl.querySelector('label');
            if (label) {
                label.classList.add('text-red-500', 'font-semibold');
                checkbox.addEventListener('change', () => label.classList.remove('text-red-500', 'font-semibold'), { once: true });
            }
            return false;
        }
        const stepName = currentStepEl.dataset.step;
        const hiddenInput = document.getElementById(`form-${stepName}`);
        if (hiddenInput) {
            if (input) hiddenInput.value = input.value;
            if (checkbox) hiddenInput.value = checkbox.checked ? 'Aceptada' : 'No Aceptada';
        }
        return true;
    };

    const goToNextStep = () => {
        if (!validateCurrentStep()) return;
        showStep(currentStepIndex + 1);
    };
    const goToPrevStep = () => showStep(currentStepIndex - 1);

    const submitForm = async () => {
        if (!validateCurrentStep()) return;
        showStep(steps.findIndex(s => s.id === 'loading-state'));
        const localeLangMap = { 'es': 'es-ES', 'en': 'en-GB', 'ca': 'ca-ES' };
        const locale = localeLangMap[currentLang] || 'es-ES';
        const formData = {
            nombre: document.getElementById('form-nombre')?.value,
            email: document.getElementById('form-email')?.value,
            telefono: document.getElementById('form-telefono')?.value || 'No proporcionado',
            area_interes: document.getElementById('form-area-interes')?.value,
            mensaje: document.getElementById('form-mensaje')?.value,
            privacidad: document.getElementById('form-privacidad')?.value,
            origen: "Formulario Web perito.barcelona",
            fecha: new Date().toLocaleString(locale),
            fechaISO: new Date().toISOString()
        };
        try {
            const response = await fetch(webhookUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(formData) });
            if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
            showStep(steps.findIndex(s => s.id === 'success-message'));
        } catch (error) {
            console.error('Error al enviar el formulario:', error);
            showStep(steps.findIndex(s => s.id === 'error-message'));
        }
    };

    formWrapper.addEventListener('click', (e) => {
        const target = e.target;
        if (target.closest('.typeform-next')) goToNextStep();
        else if (target.closest('.typeform-prev')) goToPrevStep();
        else if (target.closest('#submit-form-btn')) submitForm();
        else if (target.closest('.interest-option-btn')) {
            const button = target.closest('.interest-option-btn');
            if (!button) return;
            const value = button.dataset.value;
            const currentStepEl = steps[currentStepIndex];
            const finalFormInput = document.getElementById('form-area-interes');
            if (finalFormInput) finalFormInput.value = value;
            const allButtons = currentStepEl.querySelectorAll('.interest-option-btn');
            allButtons.forEach(btn => {
                const checkIcon = btn.querySelector('.check-icon');
                btn.classList.remove('bg-cyan-500', 'text-white', 'border-cyan-500', 'shadow-lg');
                if (checkIcon) checkIcon.classList.add('opacity-0');
            });
            const currentCheckIcon = button.querySelector('.check-icon');
            button.classList.add('bg-cyan-500', 'text-white', 'border-cyan-500', 'shadow-lg');
            if (currentCheckIcon) currentCheckIcon.classList.remove('opacity-0');
            setTimeout(() => showStep(currentStepIndex + 1), 200);
        }
    });

    if (retryBtn) retryBtn.addEventListener('click', () => showStep(steps.findIndex(s => s.dataset.step === 'privacidad')));
    
    const fechaInput = document.getElementById('form-fecha');
    if (fechaInput) fechaInput.value = new Date().toISOString();
    
    steps[0].classList.add('active');
    steps[0].classList.remove('hidden');
    updateProgress();
});

function switchTab(location) { /* ... */ }
</script>
