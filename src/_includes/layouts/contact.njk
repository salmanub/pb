                                                id="submit-form-btn" 
                                                class="px-8 py-4 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-xl shadow-lg transition-all duration-200 group flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-lg enabled:hover:shadow-xl enabled:hover:shadow-cyan-500/25"
                                                disabled>
                                            {{ metadata.ctaContact[currentLanguage].form.submitText }}
                                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                            </svg>
                                        </button>
