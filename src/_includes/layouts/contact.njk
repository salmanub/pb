{% extends "layouts/base.njk" %}

{% set currentLanguage = page.lang or lang or 'es' %}

{% block content %}
<main class="contact-page" itemscope itemtype="https://schema.org/ContactPage">
    {# Hero Section con dos columnas #}
    {# Hero Section con dos columnas #}
    <header class="relative mt-[70px] lg:mt-[100px] bg-white overflow-hidden border-b border-slate-100" itemprop="mainEntity">
        <div class="relative z-10 w-full py-12 lg:py-20">
            {# Centrado en pantallas grandes #}
            <div class="w-full px-6 md:px-12 lg:px-16">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-start">
                    {# Columna izquierda - Info principal #}
                    <div class="space-y-8 animate-in fade-in slide-in-from-bottom-8 duration-700">
                        {# Breadcrumbs #}
                        {% include "partials/breadcrumb.njk" %}
                        
                        <h1 class="text-4xl md:text-5xl lg:text-7xl font-black leading-[0.95] tracking-tight text-slate-900 text-center md:text-left" itemprop="headline">
                            {{ contact.title | safe}}
                        </h1>
                        
                        <p class="text-xl md:text-2xl text-slate-600 font-light max-w-3xl mx-auto md:mx-0 text-center md:text-left py-2 leading-relaxed" itemprop="description">
                        {{ contact.intro }}
                        </p>
                    </div>
                    
                    {# Contacto rápido en hero - Columna derecha, visible siempre #}
                    <div class="space-y-6 animate-in fade-in slide-in-from-right-8 duration-700 delay-200" itemscope itemtype="https://schema.org/ContactPoint">

                        <div class="bg-white/80 backdrop-blur-sm rounded-3xl p-6 md:p-8 border border-slate-200/60 shadow-xl shadow-slate-200/50">
                            <h3 class="text-xl font-bold text-slate-900 mb-6 text-center md:text-left tracking-tight">{{contact.direct_contact.title }}</h3>
                            <div class="space-y-4">
                                <a href="tel:{{metadata.contact.phoneNumber}}" class="flex items-center gap-4 md:gap-5 p-4 md:p-5 bg-white hover:bg-slate-50 border border-slate-100 hover:border-cyan-200 rounded-2xl transition-all group shadow-sm hover:shadow-md" itemprop="telephone">
                                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-xl bg-cyan-50 flex items-center justify-center text-cyan-600 group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
                                        <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                        </svg>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-lg md:text-xl font-bold text-slate-900 truncate">{{metadata.contact.phoneNumber}}</div>
                                        <p class="text-sm text-slate-500 font-medium truncate">{{metadata.contactLocation[currentLanguage].schedule.hours}}</p>
                                    </div>
                                </a>
                                
                                <a href="mailto:{{metadata.contact.email}}" class="flex items-center gap-4 md:gap-5 p-4 md:p-5 bg-white hover:bg-slate-50 border border-slate-100 hover:border-cyan-200 rounded-2xl transition-all group shadow-sm hover:shadow-md" itemprop="email">
                                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-xl bg-cyan-50 flex items-center justify-center text-cyan-600 transition-colors duration-300 flex-shrink-0">
                                        <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-lg md:text-xl font-bold text-slate-900 break-all md:break-normal">{{metadata.contact.email}}</div>
                                        <p class="text-sm text-slate-500 font-medium">{{contact.direct_contact.email_response }}</p>
                                    </div>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </header>

    {# Contenido Principal - 2 Columnas con Formulario y Mapas #}
    <section class="py-24 relative z-10 bg-slate-50 overflow-hidden isolate">
        <div class="absolute inset-0 bg-white/50"></div>
        <div class="w-full px-6 md:px-12 lg:px-16 relative">
            <div class="grid lg:grid-cols-2 items-start gap-12 lg:gap-20">
                
                <div class="order-1 lg:order-1">

                    <div class="bg-white rounded-2xl shadow-xl p-8 lg:p-12 border border-slate-100">
                        {% set contactFormOrigin = "Página de Contacto" %}
                        {% include "partials/contact-form.njk" %}
                    </div>

                </div>

                <div class="order-2 lg:order-2" itemscope itemtype="https://schema.org/Place">
                    <div class="sticky top-24 space-y-8">
                        <div class="text-center lg:text-left">
                             <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-3 flex items-center gap-2" itemprop="name">
                                <svg class="w-7 h-7 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                {{ metadata.contactLocation[currentLanguage].title }}
                             </h2>
                        </div>
                        
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-slate-100 flex flex-col">
                            <div class="flex-grow">
                                <div class="h-full flex flex-col" itemscope itemtype="https://schema.org/Place">
                                    <meta itemprop="name" content="Oficina de Barcelona">
                                    <div class="p-6 lg:p-8 bg-white">
                                        <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                                            <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                                                <p class="text-lg font-bold text-slate-800 mb-1" itemprop="addressLocality">
                                                    {{ metadata.contact.address.city }}
                                                </p>
                                                <p class="text-slate-600"><span itemprop="streetAddress">{{ metadata.contact.address.street }}</span>, <span itemprop="postalCode">{{ metadata.contact.address.postalCode }}</span> <span itemprop="addressLocality">{{ metadata.contact.address.city }}</span>, <span itemprop="addressCountry">{{ metadata.contact.address.country }}</span></p>
                                                <p class="text-sm text-slate-500 mt-1">Metro L5 Entença</p>
                                            </div>
                                            <div class="md:pl-4 md:border-l md:border-slate-200 flex-shrink-0 mt-4 md:mt-0">
                                                <p class="text-sm font-semibold text-slate-700">{{ metadata.contactLocation[currentLanguage].schedule.title }}</p>
                                                <p class="text-sm text-slate-600">{{ metadata.contactLocation[currentLanguage].schedule.hours }}</p>
                                                <p class="text-xs text-slate-500 mt-1">{{ metadata.contactLocation[currentLanguage].schedule.note }}</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="h-[350px] flex-grow relative">
                                        <iframe 
                                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2993.686548425261!2d2.141527315425677!3d41.3810189792649!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4a27e1c1b0f1d%3A0x2f15e7e72e27645b!2sCarrer%20de%20Num%C3%A0ncia%2C%2095%2C%2008029%20Barcelona%2C%20Spain!5e0!3m2!1sen!2sie!4v1620293072041!5m2!1sen!2sie"
                                            class="w-full h-full border-0"
                                            allowfullscreen=""
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"
                                            title="Oficina de Barcelona - C/ Numancia 95, Local 5">
                                        </iframe>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
    
    {# Contenido Markdown adicional si existe #}
    {% if content | length > 10 %}
    <section class="py-16 lg:py-24 relative z-10 bg-white">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="prose prose-lg prose-slate max-w-4xl mx-auto">
                {{ content | safe }}
            </div>
        </div>
    </section>
    {% endif %}
</main>
{% endblock %}

{% block scripts %}
{{ super() }}
{% endblock scripts %}

{% block pageStyles %}
    {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
    <style>
        {{ indexCSS | safe }}
    </style>
{% endblock pageStyles %}
