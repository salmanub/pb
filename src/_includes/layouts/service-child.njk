{% extends "layouts/base.njk" %}

{% block content %}
<main itemscope itemtype="https://schema.org/Article">
    <!-- Schema mejorado para Article -->
    <div hidden>
        {# <meta itemprop="datePublished" content="{{ page.date | date('YYYY-MM-DD') }}">
        <meta itemprop="dateModified" content="{{ page.inputPath | lastModifiedDate('YYYY-MM-DD') }}"> #}
        <meta itemprop="mainEntityOfPage" content="{{ metadata.site.url }}{{ page.url }}">
        <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
            <meta itemprop="name" content="{{ metadata.site.title }}">
            <meta itemprop="url" content="{{ metadata.site.url }}">
            <meta itemprop="sameAs" content="{{ metadata.company.linkedin }}">
            <div itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
                <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
                <meta itemprop="width" content="600">
                <meta itemprop="height" content="60">
            </div>
        </div>
        <div itemprop="author" itemscope itemtype="https://schema.org/Person">
            <meta itemprop="name" content="{{ metadata.author.name }}">
            <meta itemprop="sameAs" content="{{ metadata.author.linkedin }}">
        </div>
        {% if hero and hero.image %}
        <div itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
             <div class="absolute inset-0 z-0">
                {% image hero.image, 
                        hero.alt, 
                        "(min-width: 1024px) 100vw, 100vw", 
                        "eager", 
                        "high" 
                %}
            </div>
            <div class="absolute inset-0 bg-gradient-to-r from-white via-white/95 to-white/20 z-10"></div>
            <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/{{ hero.image }}">
            <meta itemprop="width" content="1200">
            <meta itemprop="height" content="630">
        </div>
        {% endif %}
        {% if parentService %}
        <div itemprop="isPartOf" itemscope itemtype="https://schema.org/WebPage">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ parentService.url }}">
            <meta itemprop="name" content="{{ parentService.title }}">
        </div>
        {% endif %}
    </div>
    <header class="relative mt-[70px] md:mt-[90px] lg:mt-[120px] min-h-[400px] bg-white text-slate-900 overflow-hidden isolate border-b border-slate-100">
        {% if hero and hero.image %}
        <div class="absolute inset-0 z-0 opacity-20 md:opacity-30">
            {% image hero.image, 
                    hero.alt, 
                    "(min-width: 1024px) 100vw, 100vw", 
                    "eager", 
                    "high",
                    "w-full h-full object-cover" 
            %}
            <div class="absolute inset-0 bg-gradient-to-r from-white via-white/80 to-transparent"></div>
        </div>
        {% else %}
        <!-- Efectos decorativos modernos (Light Theme) -->
        <div class="absolute inset-0">
            <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-100 skew-x-[-12deg] translate-x-1/4 origin-top"></div>
            <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-white to-transparent"></div>
        </div>
        {% endif %}

        <div class="relative z-10 container mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-0">
            <div class="py-16 lg:py-20">
                <!-- Breadcrumb con el parentService -->
                {% include "partials/breadcrumb.njk" %}
                
                <div class="max-w-4xl mt-8">
                    {% if hero %}
                        <h1 class="text-[2.75rem] md:text-[3.5rem] xl:text-[4rem] font-light text-slate-900 leading-[1.1] tracking-tight mb-8 uppercase" itemprop="headline">
                            {{ hero.title | safe }}
                            {% if hero.strong %}
                                <strong class="block text-teal-400 font-normal mt-2 text-[0.85em]">{{ hero.strong | safe }}</strong>
                            {% endif %}
                        </h1>
                        <div class="prose prose-xl prose-slate">
                            <p class="text-xl text-slate-600 leading-relaxed font-light" itemprop="description">
                                {{ hero.description | safe }}
                            </p>
                            {% if subtitle %}
                                <p class="text-lg text-teal-600/80 mt-4 italic">{{ subtitle | safe }}</p>
                            {% endif %}
                        </div>
                        <div hidden>
                            <span itemprop="keywords">{{ hero.title }}, {{ parentService.title }}</span>
                        </div>
                    {% else %}
                        <h1 class="text-[2.75rem] md:text-[3.5rem] xl:text-[4rem] font-light text-slate-900 leading-[1.1] tracking-tight uppercase" itemprop="headline">{{ title | safe }}</h1>
                        {% if subtitle %}
                            <p class="text-lg text-teal-600/80 mt-4 italic">{{ subtitle | safe }}</p>
                            <div hidden>
                                <span itemprop="keywords">{{ title }}, {{ parentService.title }}</span>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    <article class="py-16 lg:py-24 bg-white" itemprop="articleBody">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="flex flex-col lg:flex-row gap-16">
                
                <div class="lg:w-2/3">
                    {# Aquí se renderiza todo el contenido Markdown que escribimos #}
                    <div class="prose prose-lg max-w-none mb-12" itemprop="articleBody">
                        {{ content | safe }}

                        <!-- Renderiza FAQs estructuradas si existen en el frontmatter -->
                        {% include "partials/faqs.njk" %}
                        
                        <div hidden>
                            <div itemprop="speakable" itemscope itemtype="https://schema.org/SpeakableSpecification">
                                <meta itemprop="cssSelector" content=".prose h2:first-of-type, .prose p:first-of-type">
                            </div>
                            <meta itemprop="wordCount" content="{{ content | striptags | wordcount }}">
                        </div>
                    </div>
                    
                    {% if testimonials and testimonials.length > 0 %}
                    <section class="mt-16 pt-12 border-t border-slate-200" itemprop="review" itemscope itemtype="https://schema.org/Review">
                        <h2 class="text-2xl md:text-3xl font-light uppercase text-slate-900 mb-8">{{ metadata.serviceChild[lang].casosExito }}</h2>
                        <div class="space-y-8">
                            {% for testimonial in testimonials %}
                            <div class="bg-gradient-to-br from-white to-slate-50 p-6 rounded-none shadow-md border-l-4 border-teal-400" itemprop="reviewBody">
                                <p class="text-slate-700 mb-4 text-lg relative pl-6">
                                    <span class="absolute top-[-1rem] left-[-0.5rem] text-[4rem] text-teal-400/20 font-serif">"</span>
                                    {{ testimonial.quote | safe }}
                                </p>
                                <div class="flex items-center mt-auto pt-4">
                                    <span class="w-10 h-[2px] bg-teal-400/30 mr-4"></span>
                                    <div>
                                        <p class="font-semibold text-teal-600" itemprop="author">{{ testimonial.author | safe }}</p>
                                        {% if testimonial.role %}
                                            <p class="text-sm text-slate-500">{{ testimonial.role | safe }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </section>
                    {% endif %}
                </div>
                
                <aside class="lg:w-1/3">
                    <div class="sticky top-24 space-y-10">
                        <div class="bg-white rounded-none shadow-lg border border-slate-100 p-6 lg:p-8">
                            <h2 class="text-xl font-light uppercase text-slate-900 mb-4">{{ metadata.serviceChild[lang].sufresProblema }}</h2>
                            <p class="text-slate-600 mb-6">{{ metadata.serviceChild[lang].contacteAnalisis }}</p>
                            
                            {% set contactPath = "" %}
                            {% if lang == "es" %}
                                {% set contactPath = "/contacto/" %}
                            {% elif lang == "en" %}
                                {% set contactPath = "/en/contact/" %}
                            {% elif lang == "ca" %}
                                {% set contactPath = "/ca/contacte/" %}
                            {% endif %}
                            
                            <div class="space-y-4">
                                <a href="{{ contactPath }}?origen={{ title | slugify }}&analisis=true" class="block w-full text-center bg-teal-500 text-white font-medium py-3 px-6 rounded-none hover:bg-teal-600 transition-colors shadow-sm hover:shadow">
                                    {{ metadata.serviceChild[lang].solicitarAnalisis }}
                                </a>
                                <a href="tel:{{metadata.contact.phoneNumber}}" class="block w-full text-center border border-teal-500 text-teal-600 font-medium py-3 px-6 rounded-none hover:bg-teal-50 transition-colors">
                                    <span class="flex items-center justify-center">
                                        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                        {{ metadata.serviceChild[lang].llamarAhora }}
                                    </span>
                                </a>
                            </div>
                        </div>
                        
                        {# NUEVO BLOQUE: Enlace de vuelta a la página pilar. Crucial para SEO y UX. #}
                        {# Utiliza la variable `parentService` que definimos en el frontmatter. #}
                        {% if parentService %}
                        <div class="bg-white rounded-none shadow-lg border border-slate-100 p-6 lg:p-8">
                             <h3 class="font-light uppercase text-slate-900 mb-4">{{ metadata.serviceChild[lang].parteServicios }}<br><span class="text-teal-400 font-normal">{{ parentService.title }}</span></h3>
                             <p class="text-slate-600 mb-6">{{ metadata.serviceChild[lang].problemaEspecifico }}</p>
                             <a href="{{ parentService.url }}" class="inline-flex items-center text-teal-600 hover:text-teal-700 font-semibold group">
                                 {{ metadata.serviceChild[lang].verTodos }} {{ parentService.title | lower }}
                                 <svg class="w-5 h-5 ml-2 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                             </a>
                        </div>
                        {% endif %}
                        
                        {# ELIMINADO: Se han quitado los bucles de `serviceBenefits` y `serviceProcess`. #}
                        {# Esa información es repetitiva y pertenece a la página pilar, no a esta página específica. #}
                        {# Esto hace la página más limpia y enfocada en el problema del usuario. #}

                    </div>
                </aside>
            </div>
        </div>
    </article>

    <section class="relative py-24 md:py-32 bg-slate-900 overflow-hidden isolate">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
             <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-800 skew-x-[-12deg] translate-x-1/4 origin-top opacity-30"></div>
        </div>

        <div class="w-full px-6 md:px-12 lg:px-16 relative z-10">
            <div class="max-w-3xl mx-auto text-center">
                <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-white mb-6 uppercase tracking-tight">
                    {{ metadata.serviceChild[lang].listoSolucion }}
                </h2>
                <p class="text-xl text-slate-300 mb-12 font-light">{{ metadata.serviceChild[lang].noDejeProblema }}</p>
                {% set contactPath = "" %}
                {% if lang == "es" %}
                    {% set contactPath = "/contacto/" %}
                {% elif lang == "en" %}
                    {% set contactPath = "/en/contact/" %}
                {% elif lang == "ca" %}
                    {% set contactPath = "/ca/contacte/" %}
                {% endif %}
                <a href="{{ contactPath }}?origen={{ title | slugify }}" class="inline-flex items-center justify-center px-8 py-4 font-bold uppercase tracking-wider text-sm rounded-none transition-colors duration-300 bg-white text-slate-900 hover:bg-teal-50 hover:text-teal-600 shadow-xl">
                    {{ metadata.serviceChild[lang].contactarAhora }}
                </a>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block pageStyles %}
 {% set childPageCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}

{% endblock %}

{% block scripts %}
<!-- Scripts heredados de base.njk -->
{{ super() }}
{% endblock %}
