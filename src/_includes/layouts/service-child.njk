{% extends "layouts/base.njk" %}

{% block content %}
<main itemscope itemtype="https://schema.org/Article">
    <!-- Schema mejorado para Article -->
    <div hidden>
        {# <meta itemprop="datePublished" content="{{ page.date | date('YYYY-MM-DD') }}">
        <meta itemprop="dateModified" content="{{ page.inputPath | lastModifiedDate('YYYY-MM-DD') }}"> #}
        <meta itemprop="mainEntityOfPage" content="{{ metadata.site.url }}{{ page.url }}">
        <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
            <meta itemprop="name" content="{{ metadata.site.title }}">
            <meta itemprop="url" content="{{ metadata.site.url }}">
            <div itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
                <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
                <meta itemprop="width" content="600">
                <meta itemprop="height" content="60">
            </div>
        </div>
        <div itemprop="author" itemscope itemtype="https://schema.org/Person">
            <meta itemprop="name" content="{{ metadata.author.name }}">
            <meta itemprop="url" content="{{ metadata.author.linkedin }}">
        </div>
        {% if hero and hero.image %}
        <div itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/{{ hero.image }}">
            <meta itemprop="width" content="1200">
            <meta itemprop="height" content="630">
        </div>
        {% endif %}
        {% if parentService %}
        <div itemprop="isPartOf" itemscope itemtype="https://schema.org/WebPage">
            <meta itemprop="url" content="{{ metadata.site.url }}{{ parentService.url }}">
            <meta itemprop="name" content="{{ parentService.title }}">
        </div>
        {% endif %}
    </div>
    <header class="relative mt-[70px] md:mt-[90px] lg:mt-[120px] min-h-[400px] bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] text-white overflow-hidden isolate">
        <!-- Efectos decorativos modernos -->
        <div class="absolute inset-0">
            <!-- Patrón de puntos con mejor contraste -->
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <!-- Gradientes suaves -->
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <!-- Efecto de luz moderna -->
            <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
            <!-- Velo sutil para mejorar legibilidad -->
            <div class="absolute inset-0 bg-gradient-to-b from-slate-900/10 to-slate-900/30 mix-blend-overlay"></div>
        </div>

        <div class="relative z-10 container mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-0">
            <div class="py-16 lg:py-20">
                <!-- Breadcrumb con el parentService -->
                {% include "partials/breadcrumb.njk" %}
                
                <div class="max-w-4xl mt-8">
                    {% if hero %}
                        <h1 class="text-[2.75rem] md:text-[3.5rem] xl:text-[4rem] font-light text-white leading-[1.1] tracking-tight mb-8" itemprop="headline">
                            {{ hero.title | safe }}
                            {% if hero.strong %}
                                <span class="block text-[0.85em] text-cyan-400 font-normal mt-6">{{ hero.strong | safe }}</span>
                            {% endif %}
                        </h1>
                        <div class="prose prose-xl prose-invert">
                            <p class="text-xl text-white/90 leading-relaxed" itemprop="description">
                                {{ hero.description | safe }}
                            </p>
                            {% if subtitle %}
                                <p class="text-lg text-cyan-300/80 mt-4 italic">{{ subtitle | safe }}</p>
                            {% endif %}
                        </div>
                        <div hidden>
                            <span itemprop="keywords">{{ hero.title }}, {{ parentService.title }}</span>
                        </div>
                    {% else %}
                        <h1 class="text-[2.75rem] md:text-[3.5rem] xl:text-[4rem] font-light text-white leading-[1.1] tracking-tight" itemprop="headline">{{ title | safe }}</h1>
                        {% if subtitle %}
                            <p class="text-lg text-cyan-300/80 mt-4 italic">{{ subtitle | safe }}</p>
                            <div hidden>
                                <span itemprop="keywords">{{ title }}, {{ parentService.title }}</span>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    <article class="py-16 lg:py-24 bg-white" itemprop="articleBody">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="flex flex-col lg:flex-row gap-16">
                
                <div class="lg:w-2/3">
                    {# Aquí se renderiza todo el contenido Markdown que escribimos #}
                    <div class="prose prose-lg max-w-none mb-12" itemprop="articleBody">
                        {{ content | safe }}
                        
                        <div hidden>
                            <div itemprop="speakable" itemscope itemtype="https://schema.org/SpeakableSpecification">
                                <meta itemprop="cssSelector" content=".prose h2:first-of-type, .prose p:first-of-type">
                            </div>
                            <meta itemprop="wordCount" content="{{ content | striptags | wordcount }}">
                        </div>
                    </div>
                    
                    {% if testimonials and testimonials.length > 0 %}
                    <section class="mt-16 pt-12 border-t border-slate-200" itemprop="review" itemscope itemtype="https://schema.org/Review">
                        <h2 class="text-2xl md:text-3xl font-light text-slate-800 mb-8">{{ metadata.serviceChild[lang].casosExito }}</h2>
                        <div class="space-y-8">
                            {% for testimonial in testimonials %}
                            <div class="bg-gradient-to-br from-white to-slate-50 p-6 rounded-lg shadow-md border-l-4 border-cyan-400" itemprop="reviewBody">
                                <p class="text-slate-700 mb-4 text-lg relative pl-6">
                                    <span class="absolute top-[-1rem] left-[-0.5rem] text-[4rem] text-cyan-400/20 font-serif">"</span>
                                    {{ testimonial.quote | safe }}
                                </p>
                                <div class="flex items-center mt-auto pt-4">
                                    <span class="w-10 h-[2px] bg-cyan-400/30 mr-4"></span>
                                    <div>
                                        <p class="font-semibold text-cyan-600" itemprop="author">{{ testimonial.author | safe }}</p>
                                        {% if testimonial.role %}
                                            <p class="text-sm text-slate-500">{{ testimonial.role | safe }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </section>
                    {% endif %}
                </div>
                
                <aside class="lg:w-1/3">
                    <div class="sticky top-24 space-y-10">
                        <div class="bg-gradient-to-br from-cyan-50 to-white rounded-2xl shadow-lg border border-cyan-100 p-6 lg:p-8">
                            <h2 class="text-xl font-bold text-slate-800 mb-4">{{ metadata.serviceChild[lang].sufresProblema }}</h2>
                            <p class="text-slate-600 mb-6">{{ metadata.serviceChild[lang].contacteAnalisis }}</p>
                            
                            {% set contactPath = "" %}
                            {% if lang == "es" %}
                                {% set contactPath = "/contacto/" %}
                            {% elif lang == "en" %}
                                {% set contactPath = "/en/contact/" %}
                            {% elif lang == "ca" %}
                                {% set contactPath = "/ca/contacte/" %}
                            {% endif %}
                            
                            <div class="space-y-4">
                                <a href="{{ contactPath }}?origen={{ title | slugify }}&analisis=true" class="block w-full text-center bg-cyan-500 text-white font-medium py-3 px-6 rounded-lg hover:bg-cyan-600 transition-colors shadow-sm hover:shadow">
                                    {{ metadata.serviceChild[lang].solicitarAnalisis }}
                                </a>
                                <a href="tel:{{metadata.contact.phoneNumber}}" class="block w-full text-center border border-cyan-500 text-cyan-600 font-medium py-3 px-6 rounded-lg hover:bg-cyan-50 transition-colors">
                                    <span class="flex items-center justify-center">
                                        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                        {{ metadata.serviceChild[lang].llamarAhora }}
                                    </span>
                                </a>
                            </div>
                        </div>
                        
                        {# NUEVO BLOQUE: Enlace de vuelta a la página pilar. Crucial para SEO y UX. #}
                        {# Utiliza la variable `parentService` que definimos en el frontmatter. #}
                        {% if parentService %}
                        <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl shadow-lg border border-slate-100 p-6 lg:p-8">
                             <h3 class="font-bold text-slate-800 mb-4">{{ metadata.serviceChild[lang].parteServicios }}<br><span class="text-cyan-600">{{ parentService.title }}</span></h3>
                             <p class="text-slate-600 mb-6">{{ metadata.serviceChild[lang].problemaEspecifico }}</p>
                             <a href="{{ parentService.url }}" class="inline-flex items-center text-cyan-600 hover:text-cyan-700 font-semibold group">
                                 {{ metadata.serviceChild[lang].verTodos }} {{ parentService.title | lower }}
                                 <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                             </a>
                        </div>
                        {% endif %}
                        
                        {# ELIMINADO: Se han quitado los bucles de `serviceBenefits` y `serviceProcess`. #}
                        {# Esa información es repetitiva y pertenece a la página pilar, no a esta página específica. #}
                        {# Esto hace la página más limpia y enfocada en el problema del usuario. #}

                    </div>
                </aside>
            </div>
        </div>
    </article>

    <section class="py-16 lg:py-24 bg-gradient-to-br from-[#0B1030] to-[#1a2452] text-white">
      <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
        <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-[2.5rem] md:text-[3rem] font-light mb-6">
                {{ metadata.serviceChild[lang].listoSolucion }}
            </h2>
            <p class="text-xl text-white/80 mb-10">{{ metadata.serviceChild[lang].noDejeProblema }}</p>
            {% set contactPath = "" %}
            {% if lang == "es" %}
                {% set contactPath = "/contacto/" %}
            {% elif lang == "en" %}
                {% set contactPath = "/en/contact/" %}
            {% elif lang == "ca" %}
                {% set contactPath = "/ca/contacte/" %}
            {% endif %}
            <a href="{{ contactPath }}?origen={{ title | slugify }}" class="inline-flex items-center justify-center px-8 py-4 bg-cyan-400 text-white font-semibold rounded-lg hover:bg-cyan-500 transition-all group shadow-lg shadow-cyan-500/20">
                {{ metadata.serviceChild[lang].contactarAhora }}
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
        </div>
      </div>
    </section>
</main>
{% endblock %}

{% block pageStyles %}
 {% set childPageCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
<style>
/* Nuevo estilo base para el contenido */
.prose {
    @apply text-slate-600 max-w-none text-lg leading-relaxed;
}

/* Estilos de encabezados modernos */
.prose h2 {
    @apply text-3xl md:text-4xl font-light text-slate-800 mt-16 mb-10;
    background: linear-gradient(to right, #0891b2, #0e7490);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.prose h3 {
    @apply text-2xl font-semibold text-slate-700 mt-12 mb-6;
    border-bottom: 2px solid #06b6d4;
    display: inline-block;
}

.prose h4 {
    @apply text-xl font-bold text-cyan-700 mt-8 mb-4;
}

/* Párrafos y texto con énfasis */
.prose p {
    @apply mb-6 text-slate-600;
}

.prose strong {
    @apply font-semibold text-cyan-700 bg-cyan-50 px-1 rounded;
}

.prose em {
    @apply text-slate-700 italic;
}

/* Citas modernas */
.prose blockquote {
    @apply my-8 pl-8 py-6 bg-gradient-to-r from-cyan-50 to-transparent rounded-r-lg border-l-4 border-cyan-400;
}

/* Listas estilizadas */
.prose ul, .prose ol {
    @apply my-8 space-y-4 list-none;
}

.prose li {
    @apply relative py-3 pl-6 pr-4 rounded-lg;
    background: linear-gradient(to right, rgba(8, 145, 178, 0.05) 0%, transparent 100%);
}

.prose li > * {
    @apply my-0;
    display: inline;
}

.prose li > strong {
    @apply mr-1;
}

.prose li:hover {
    @apply translate-x-2;
    background: linear-gradient(to right, rgba(8, 145, 178, 0.1) 0%, transparent 100%);
}

.prose li p {
    @apply mt-0;
}

/* Ajustes específicos para párrafos dentro de listas */
.prose li p {
    display: inline;
    margin: 0;
}

/* Marcador para listas ordenadas */
.prose ol {
    list-style: none;
}

.prose ol > li {
    counter-increment: list;
}

.prose ol > li::before {
    content: attr(value) ". ";
    @apply absolute left-2 top-2 flex items-center justify-center w-6 h-6 rounded-full bg-cyan-100 text-cyan-600 font-bold text-sm;
    content: attr(start);
}

/* Preservar la numeración original del markdown */
.prose ol[start] {
    counter-reset: list-counter attr(start);
}

.prose ol > li[value] {
    counter-reset: list attr(value);
}

/* Definiciones con estilo moderno */
.prose dl {
    @apply space-y-6 my-8;
}

.prose dt {
    @apply text-xl text-slate-700 mb-2;
    background: linear-gradient(to right, #0891b2, #0e7490);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
}

.prose dd {
    @apply pl-6 border-l-2 border-cyan-200 ml-2 mb-8;
}

/* Enlaces con efecto hover */
.prose a {
    @apply text-cyan-600 font-medium relative inline-block;
    background-image: linear-gradient(transparent 70%, rgba(8, 145, 178, 0.2) 70%);
    background-size: 0 100%;
    background-repeat: no-repeat;
    transition: background-size .4s ease;
}

.prose a:hover {
    background-size: 100% 100%;
}

{{ childPageCSS | safe }}
</style>
{% endblock %}

{% block scripts %}
<!-- Scripts heredados de base.njk -->
{{ super() }}
{% endblock %}
