{% extends "layouts/base.njk" %}

{% block content %}

{# ── Resolución de textos por idioma ── #}
{% set badgeText = heroBadge or "Colaboración Profesional" %}
{% set titleLine1 = heroTitle or "INGENIERÍA FORENSE" %}
{% set titleLine2 = heroHighlight or "PARA LITIGIOS" %}

{% if lang == 'ca' %}
  {% set badgeText = heroBadge or "Col·laboració Professional" %}
  {% set titleLine1 = heroTitle or "ENGINYERIA FORENSE" %}
  {% set titleLine2 = heroHighlight or "PER A LITIGIS" %}
{% endif %}
{% if lang == 'en' %}
  {% set badgeText = heroBadge or "Legal Practice" %}
  {% set titleLine1 = heroTitle or "FORENSIC ENGINEERING" %}
  {% set titleLine2 = heroHighlight or "FOR LITIGATION" %}
{% endif %}
{% if lang == 'fr' %}
  {% set badgeText = heroBadge or "Espace Juridique" %}
  {% set titleLine1 = heroTitle or "INGÉNIERIE FORENSIQUE" %}
  {% set titleLine2 = heroHighlight or "POUR LES LITIGES" %}
{% endif %}
{% if lang == 'it' %}
  {% set badgeText = heroBadge or "Area Legale" %}
  {% set titleLine1 = heroTitle or "INGEGNERIA FORENSE" %}
  {% set titleLine2 = heroHighlight or "PER LE CONTROVERSIE" %}
{% endif %}

<main itemscope itemtype="https://schema.org/Article">

  {# ══════════════════════════════════════════════
     HERO — Patrón canónico del sitio (= service-pillar.njk)
     bg-white, panel slate inclinado, grid 12 cols
  ══════════════════════════════════════════════ #}
  <header class="relative mt-[70px] md:mt-[90px] lg:mt-[120px] min-h-[calc(100vh-70px)] sm:min-h-0 bg-white text-slate-900 overflow-hidden isolate border-b border-slate-100">

    {# Efectos decorativos — idéntico a service-pillar #}
    <div class="absolute inset-0">
      <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-100 skew-x-[-12deg] translate-x-1/4 origin-top"></div>
      <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-white to-transparent"></div>
    </div>

    <div class="relative z-10 w-full px-6 md:px-12 lg:px-16">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 min-h-[calc(100vh-90px)] lg:min-h-[600px] items-center py-12 lg:py-16">

        {# Columna izquierda — Contenido #}
        <div class="lg:col-span-7">
          {% include "partials/breadcrumb.njk" %}
          <div class="space-y-6">

            {# Badge área legal #}
            <span class="text-teal-500 font-medium uppercase tracking-wider text-sm block">{{ badgeText }}</span>

            {# H1 — tipografía canónica del sitio #}
            <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-light text-slate-900 leading-[0.95] tracking-tight uppercase" itemprop="headline">
              <span class="text-slate-900 font-light">{{ titleLine1 }}</span>
              <strong class="block text-teal-400 font-normal mt-2">{{ titleLine2 }}</strong>
              <span class="block text-[0.45em] text-slate-500 font-normal mt-6 uppercase tracking-wider">{{ subtitle }}</span>
            </h1>

            {# Descripción #}
            <p class="text-xl text-slate-600 font-light" itemprop="description">{{ description }}</p>

            {# Intro (del frontmatter) #}
            {% if intro %}
            <div class="prose prose-lg prose-slate">
              <div class="text-lg text-slate-600 tracking-wide font-light">
                {{ intro | safe }}
              </div>
            </div>
            {% endif %}

          </div>
        </div>

        {# Columna derecha — Key features como tarjeta de autoridad #}
        <div class="lg:col-span-5">
          <div class="rounded-none border border-slate-200 bg-white shadow-xl shadow-slate-100/50 overflow-hidden">

            {# Header tarjeta #}
            <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-none bg-teal-400"></span>
              <span class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500">
                {% if lang == 'ca' %}Capacitats Forensas
                {% elif lang == 'en' %}Forensic Capabilities
                {% elif lang == 'fr' %}Capacités Forensiques
                {% elif lang == 'it' %}Capacità Forensi
                {% else %}Capacidades Forenses{% endif %}
              </span>
            </div>

            {# Lista de features #}
            {% if keyFeatures %}
            <ul class="divide-y divide-slate-100">
              {% for feat in keyFeatures %}
              <li class="flex items-start gap-4 px-6 py-4">
                <span class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-none flex items-center justify-center bg-teal-50 border border-teal-100">
                  <svg class="w-3 h-3 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </span>
                <span class="text-sm text-slate-600 leading-snug">{{ feat }}</span>
              </li>
              {% endfor %}
            </ul>
            {% endif %}

            {# CTA rápido en la tarjeta #}
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100">
              <a href="{{ ctaButtonUrl1 }}"
                 class="inline-flex items-center gap-2 text-sm font-semibold text-teal-700 hover:text-teal-800 transition-colors">
                {{ ctaButtonText1 }}
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>
  </header>


  {# ══════════════════════════════════════════════
     PROCESO — Pasos de colaboración
  ══════════════════════════════════════════════ #}
  {% if serviceProcess %}
  <section class="py-20 bg-slate-50 border-b border-slate-100">
    <div class="container mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-0">

      <div class="max-w-2xl mb-12">
        <p class="text-[11px] font-black uppercase tracking-[0.22em] text-teal-600 mb-3">
          {% if lang == 'ca' %}Procés de Col·laboració
          {% elif lang == 'en' %}Collaboration Process
          {% elif lang == 'fr' %}Processus de Collaboration
          {% elif lang == 'it' %}Processo di Collaborazione
          {% else %}Proceso de Colaboración{% endif %}
        </p>
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 leading-tight tracking-tight">
          {% if lang == 'ca' %}Metodologia Forense en 4 Fases
          {% elif lang == 'en' %}Forensic Methodology in 4 Phases
          {% elif lang == 'fr' %}Méthodologie Forensique en 4 Phases
          {% elif lang == 'it' %}Metodologia Forense in 4 Fasi
          {% else %}Metodología Forense en 4 Fases{% endif %}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {% for step in serviceProcess %}
        <div class="relative group">
          {# Número de paso #}
          <div class="flex items-center gap-3 mb-4">
            <span class="flex items-center justify-center w-10 h-10 rounded-none font-black text-sm text-white flex-shrink-0"
                  style="background: linear-gradient(135deg, #0891b2, #06b6d4);">
              {{ loop.index }}
            </span>
            {% if not loop.last %}
            <div class="flex-1 h-px hidden lg:block" style="background: linear-gradient(90deg, rgba(6,182,212,0.4), transparent);"></div>
            {% endif %}
          </div>
          <h3 class="text-base font-black text-slate-900 mb-2 leading-tight">{{ step.title }}</h3>
          <p class="text-sm text-slate-500 leading-relaxed">{{ step.description }}</p>
        </div>
        {% endfor %}
      </div>

    </div>
  </section>
  {% endif %}

  {# ══════════════════════════════════════════════
     CONTENIDO PRINCIPAL — Prose forense
  ══════════════════════════════════════════════ #}
  <article class="py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-0">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-16 max-w-6xl mx-auto">

        {# Columna principal: contenido markdown #}
        <div class="prose-forensic" itemprop="articleBody">
          {{ content | safe }}
        </div>

        {# Sidebar: autoridad + beneficios #}
        <aside class="space-y-6">

          {# Bloque Duty to the Court #}
          <div class="rounded-none overflow-hidden border border-teal-900/20"
               style="background: linear-gradient(160deg, #0f172a, #0e2536);">
            <div class="px-6 pt-6 pb-4 border-b border-teal-900/20">
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-teal-400 mb-1">Estándar de imparcialidad</p>
              <p class="text-white font-black text-lg leading-tight">Duty to the Court</p>
            </div>
            <div class="px-6 py-5">
              <p class="text-slate-400 text-sm leading-relaxed mb-4">
                {% if lang == 'ca' %}El dictamen pericial és objectivament correcte, independentment de qui el sol·liciti. Principi recollit a l'art. 335.2 LEC.
                {% elif lang == 'en' %}The expert report is objectively correct, regardless of who instructs it. Principle enshrined in CPR Part 35.
                {% elif lang == 'fr' %}Le rapport d'expertise est objectivement correct, indépendamment de qui le commande. Principe consacré par le CPR Part 35.
                {% elif lang == 'it' %}La perizia è oggettivamente corretta, indipendentemente da chi la commissiona. Principio sancito dal CPR Part 35.
                {% else %}El dictamen pericial es objetivamente correcto, independientemente de quién lo encargue. Principio recogido en el art. 335.2 LEC.{% endif %}
              </p>
              <div class="flex flex-col gap-2">
                {% for benefit in serviceBenefits %}
                <div class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-teal-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-slate-300 text-xs leading-snug">{{ benefit }}</span>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>

          {# Credenciales técnicas #}
          <div class="rounded-none p-6 border border-slate-200 bg-slate-50">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 mb-4">
              {% if lang == 'ca' %}Normativa i Estàndards
              {% elif lang == 'en' %}Standards & Methodology
              {% elif lang == 'fr' %}Normes & Méthodologie
              {% elif lang == 'it' %}Norme & Metodologia
              {% else %}Normativa y Estándares{% endif %}
            </p>
            <div class="flex flex-wrap gap-2">
              {% set standards = ["Eurocódigos EC2/EC3/EC7", "ISO 17020", "EN 13791", "CTE DB-SE", "FEA / MEF", "BCIS · BEDEC", "ICC · CIADI · LCIA", "Art. 335.2 LEC"] %}
              {% for s in standards %}
              <span class="inline-block text-[11px] font-semibold text-slate-600 px-3 py-1.5 rounded-none bg-white border border-slate-200">{{ s }}</span>
              {% endfor %}
            </div>
          </div>

          {# Testimoniales #}
          {% if testimonials %}
          <div class="space-y-4">
            {% for t in testimonials %}
            <blockquote class="rounded-none p-5 border border-slate-200 bg-white">
              <svg class="w-6 h-6 text-teal-200 mb-3" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
              <p class="text-slate-700 text-sm leading-relaxed italic mb-4">{{ t.quote }}</p>
              <footer>
                <span class="block text-xs font-black text-slate-900">{{ t.author }}</span>
                <span class="block text-[11px] text-slate-500 mt-0.5">{{ t.role }}</span>
              </footer>
            </blockquote>
            {% endfor %}
          </div>
          {% endif %}

        </aside>
      </div>
    </div>
  </article>

  {# ══════════════════════════════════════════════
     CTA — Dark premium
  ══════════════════════════════════════════════ #}
  <section class="py-24 relative overflow-hidden isolate"
           style="background: linear-gradient(160deg, #0f172a 0%, #0e2536 100%);">

    <div class="absolute inset-0 opacity-[0.06]"
         style="background-image: linear-gradient(rgba(6,182,212,0.6) 1px, transparent 1px), linear-gradient(90deg, rgba(6,182,212,0.6) 1px, transparent 1px); background-size: 48px 48px;"></div>
    <div class="absolute inset-x-0 top-0 h-px"
         style="background: linear-gradient(90deg, transparent, rgba(6,182,212,0.5), transparent);"></div>

    <div class="container mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-0 relative z-10">
      <div class="max-w-3xl mx-auto text-center">

        <span class="inline-flex items-center gap-2 mb-6">
          <span class="w-2 h-2 rounded-none bg-teal-400 animate-pulse"></span>
          <span class="text-[11px] font-black uppercase tracking-[0.25em] text-teal-400">
            {% if lang == 'ca' %}Consulta Sense Compromís
            {% elif lang == 'en' %}No-Obligation Consultation
            {% elif lang == 'fr' %}Consultation Sans Engagement
            {% elif lang == 'it' %}Consulenza Senza Impegno
            {% else %}Consulta Sin Compromiso{% endif %}
          </span>
        </span>

        <h2 class="text-5xl md:text-6xl font-light text-white leading-[0.95] tracking-tight uppercase mb-4">
          {{ ctaTitle }}
        </h2>
        <p class="text-slate-400 text-lg font-light mb-10 max-w-xl mx-auto">{{ ctaDescription }}</p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="{{ ctaButtonUrl1 }}"
             class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-none font-bold text-white text-sm transition-all duration-300 hover:opacity-90 hover:scale-[1.02]"
             style="background: linear-gradient(135deg, #0891b2, #06b6d4); box-shadow: 0 8px 28px rgba(6,182,212,0.35);">
            {{ ctaButtonText1 }}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="{{ ctaButtonUrl2 }}"
             class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-none font-bold text-slate-200 text-sm transition-all duration-300 hover:text-white hover:border-teal-500/50"
             style="border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04);">
            {{ ctaButtonText2 }}
          </a>
        </div>

      </div>
    </div>
  </section>

</main>
{% endblock %}

{% block pageStyles %}
<style>
/* ─── Prose Forense: tipografía premium para contenido técnico B2B ─── */
.prose-forensic {
  color: #334155;
  font-size: 1.0625rem;
  line-height: 1.75;
}

.prose-forensic h1 {
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 300;
  color: #0f172a;
  letter-spacing: -0.02em;
  line-height: 1.05;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  margin-top: 0;
}

.prose-forensic h2 {
  font-size: clamp(1.2rem, 3vw, 1.6rem);
  font-weight: 300;
  color: #0f172a;
  letter-spacing: -0.01em;
  line-height: 1.15;
  text-transform: uppercase;
  margin-top: 3rem;
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid #e2e8f0;
}

.prose-forensic h3 {
  font-weight: 700;
  color: #0891b2;
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-top: 2rem;
  margin-bottom: 0.5rem;
}

.prose-forensic p {
  color: #475569;
  margin-bottom: 1.25rem;
}

.prose-forensic strong {
  font-weight: 800;
  color: #0f172a;
}

.prose-forensic em {
  font-style: italic;
  color: #0891b2;
  font-weight: 600;
}

.prose-forensic ul {
  list-style: none;
  padding: 0;
  margin: 1.25rem 0;
  space-y: 0.5rem;
}

.prose-forensic ul li {
  position: relative;
  padding-left: 1.5rem;
  margin-bottom: 0.5rem;
  color: #475569;
}

.prose-forensic ul li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.6em;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #06b6d4;
}

.prose-forensic ol {
  counter-reset: forensic-ol;
  list-style: none;
  padding: 0;
  margin: 1.25rem 0;
}

.prose-forensic ol li {
  counter-increment: forensic-ol;
  position: relative;
  padding-left: 2.5rem;
  margin-bottom: 0.75rem;
  color: #475569;
}

.prose-forensic ol li::before {
  content: counter(forensic-ol);
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  background: linear-gradient(135deg, #0891b2, #06b6d4);
  color: white;
  border-radius: 6px;
  font-size: 0.7rem;
  font-weight: 900;
  line-height: 1;
}

.prose-forensic blockquote {
  border-left: 3px solid #06b6d4;
  padding: 1rem 1.25rem;
  background: #f8fafc;
  border-radius: 0 0.75rem 0.75rem 0;
  color: #334155;
  font-style: italic;
  margin: 1.5rem 0;
}
</style>
{% endblock %}
