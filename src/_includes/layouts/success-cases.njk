{% extends "layouts/base.njk" %}

{% block content %}
{# Debug info - solo visible en modo desarrollo #}
{% set showDebug = true %}
{% if showDebug %}
<div class="fixed top-0 right-0 z-50 p-4 bg-yellow-100 text-yellow-800 shadow-lg rounded-bl-lg max-w-sm" style="font-family: monospace; font-size: 12px;">
    <h4 class="font-bold mb-2">Debug Info:</h4>
    <p>Información de depuración</p>
    {% if casosExito %}
    <p>Número de casos: {{ casosExito | length }}</p>
    {% else %}
    <p>No se encontraron datos de casosExito</p>
    {% endif %}
</div>
{% endif %}

<main itemscope itemtype="https://schema.org/CollectionPage">
    {# Hero Section #}
    <header class="relative mt-[70px] lg:mt-[120px] bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] overflow-hidden isolate" itemprop="mainContentOfPage">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
        </div>

        <div class="relative z-10 w-full py-8 lg:py-12">
            <div class="w-full px-4 sm:px-8 md:px-12 lg:px-0 md:w-[95%] max-w-[1400px] mx-auto">
                {# Breadcrumbs #}
                <nav class="mb-8 text-sm text-cyan-300/80">
                    <div class="flex items-center gap-2">
                        <a href="/" class="hover:text-cyan-300 transition-colors">Inicio</a>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <span class="text-white">Casos de Éxito</span>
                    </div>
                </nav>

                <div class="max-w-[1000px] mx-auto text-center">
                    <h1 class="text-[2.5rem] md:text-[3.5rem] font-light leading-[1.1] mb-8 text-white" itemprop="headline">
                        Resultados Reales:
                        <span class="block text-cyan-400 mt-4">Vea Cómo Ayudamos a Nuestros Clientes</span>
                    </h1>
                    <p class="text-lg md:text-xl text-white/90 max-w-3xl mx-auto" itemprop="description">
                        Descubra ejemplos concretos de cómo nuestros informes periciales técnicos y de seguros han resuelto conflictos, fundamentado reclamaciones y proporcionado claridad en situaciones complejas en Barcelona y provincia.
                    </p>
                </div>
            </div>
        </div>

        {# Patrón de fondo #}
        <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
    </header>

    {# Filtros y Grid de Casos #}
    <section class="py-24 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden isolate" itemprop="hasPart" itemscope itemtype="https://schema.org/ItemList">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.1)_1px,transparent_1px)] [background-size:48px_48px]"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-50/40 via-transparent to-slate-100/30"></div>
        </div>

        <div class="relative z-10 max-w-[1400px] mx-auto">
            {# Filtros mantenidos y actualizados #}
            <div class="flex flex-wrap gap-4 justify-center md:justify-start mb-12">
                <button class="px-4 py-2 rounded-full bg-cyan-500 text-white font-medium hover:bg-cyan-600 transition-colors active cursor-pointer" data-filter="all">
                    Todos los casos
                </button>
                <button class="px-4 py-2 rounded-full bg-white text-slate-700 font-medium hover:bg-slate-50 border border-slate-200 transition-colors cursor-pointer" data-filter="construcción">
                    Construcción
                </button>
                <button class="px-4 py-2 rounded-full bg-white text-slate-700 font-medium hover:bg-slate-50 border border-slate-200 transition-colors cursor-pointer" data-filter="patologías">
                    Patologías
                </button>
                <select class="px-4 py-2 rounded-full bg-white text-slate-700 font-medium border border-slate-200 focus:outline-none focus:ring-2 focus:ring-cyan-500 cursor-pointer" id="filtro-problema">
                    <option value="all">Tipo de Problema...</option>
                    <option value="humedades">Humedades y Filtraciones</option>
                    <option value="estructural">Problemas Estructurales</option>
                    <option value="comunidades">Comunidades de Propietarios</option>
                </select>
            </div>

            {# Grid de Casos con mejor contraste #}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="grid-casos-exito">
                {% for caso in casosExito %}
                {# Debug info si no hay casos #}
                {% if loop.first and loop.last and not caso.title %}
                <div class="col-span-3 bg-yellow-100 p-6 rounded-xl">
                    <h3 class="text-xl font-bold text-yellow-800">No se encontraron casos.</h3>
                    <p>Verifica que los datos de casos-exito.json estén cargados correctamente.</p>
                </div>
                {% endif %}
                <a href="/casos-exito/{{ caso.slug }}/" class="group/card relative block h-full bg-gradient-to-br from-white to-slate-50/80 rounded-2xl p-6 pb-20 shadow-lg hover:shadow-xl transition-all duration-500 overflow-hidden isolate no-underline"
                     data-category="{{ caso.tags | join(' ') | lower | replace(' ', '-') }}">
                    <!-- Efecto hover background -->
                    <div class="absolute inset-0 bg-gradient-to-br from-cyan-50 to-white opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>
                    
                    <!-- Contenido principal -->
                    <div class="relative z-10">
                        <h2 class="text-xl font-bold text-slate-800 mb-3" itemprop="headline">{{ caso.title }}</h2>
                        <p class="text-slate-600 text-sm leading-relaxed mb-4 flex-grow" itemprop="description">{{ caso.description | truncate(120) }}</p>
                        
                        <!-- Tags -->
                        <div class="flex flex-wrap gap-2 mt-4">
                            {% for tag in caso.tags | slice(0, 3) %}
                            <span class="text-xs font-semibold px-2 py-1 rounded-full 
                                {% if tag == 'Construcción' or tag == 'Estructural' %}bg-cyan-100 text-cyan-700
                                {% elif tag == 'Humedades' %}bg-blue-100 text-blue-700
                                {% elif tag == 'Patologías' %}bg-purple-100 text-purple-700
                                {% else %}bg-slate-100 text-slate-700{% endif %}">
                                {{ tag }}
                            </span>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- CTA con texto localizado -->
                    <div class="absolute bottom-6 right-6 flex items-center gap-2 text-cyan-400 group-hover/card:text-cyan-500 transition-colors">
                        <span class="text-sm font-medium opacity-0 translate-x-4 group-hover/card:opacity-100 group-hover/card:translate-x-0 transition-all duration-300">Ver detalles</span>
                        <div class="w-8 h-8 rounded-full bg-cyan-50 flex items-center justify-center group-hover/card:bg-cyan-100 transition-all duration-300">
                            <svg class="w-4 h-4 group-hover/card:scale-110 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </div>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </section>

    {# CTA Final con mejor contraste #}
    <section class="relative py-24 md:py-32 bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] overflow-hidden isolate">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
        </div>

        <div class="relative z-10 max-w-[1400px] mx-auto px-4 md:px-[5%] text-center">
            <h2 class="text-[2.5rem] font-light mb-6 text-white">¿Tiene un caso similar?</h2>
            <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                Permítanos evaluar su situación. Un informe pericial puede ser la clave para su solución.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/contacto/" class="inline-flex items-center justify-center px-8 py-4 bg-cyan-400 text-white font-semibold rounded-lg hover:bg-cyan-500 transition-all group">
                    Solicitar Consulta Gratuita
                    <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
                <a href="tel:+34932123456" class="inline-flex items-center justify-center px-8 py-4 border-2 border-cyan-400 text-cyan-300 font-semibold rounded-lg hover:bg-white/5 transition-all">
                    <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    Llamar Ahora
                </a>
            </div>
        </div>
    </section>
</main>

<script>
    // Funcionalidad de filtros
    document.addEventListener('DOMContentLoaded', function() {
        const filterButtons = document.querySelectorAll('[data-filter]');
        const filterSelect = document.getElementById('filtro-problema');
        const cases = document.querySelectorAll('#grid-casos-exito > a');

        function updateFilters() {
            const activeFilter = document.querySelector('[data-filter].active')?.dataset.filter || 'all';
            const selectFilter = filterSelect.value;

            cases.forEach(caso => {
                const categories = caso.dataset.category ? caso.dataset.category.toLowerCase().split(' ') : [];
                const showForButton = activeFilter === 'all' || 
                                     categories.some(cat => cat.includes(activeFilter.toLowerCase()));
                const showForSelect = selectFilter === 'all' || 
                                     categories.some(cat => cat.includes(selectFilter.toLowerCase()));
                
                caso.style.display = (showForButton && showForSelect) ? 'block' : 'none';
            });
        }

        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                filterButtons.forEach(btn => {
                    btn.classList.remove('active', 'bg-cyan-500', 'text-white');
                    btn.classList.add('bg-white', 'text-slate-700');
                });
                button.classList.add('active', 'bg-cyan-500', 'text-white');
                button.classList.remove('bg-white', 'text-slate-700');
                updateFilters();
            });
        });

        filterSelect.addEventListener('change', updateFilters);
    });
</script>
{% endblock %}

{% block pageStyles %}
 {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}

<style>
    {{ indexCSS | safe }}
    
    /* Estilos adicionales para las tarjetas como enlaces */
    #grid-casos-exito a.group\/card {
        text-decoration: none;
        color: inherit;
        cursor: pointer;
    }
    
    #grid-casos-exito a.group\/card:hover {
        text-decoration: none;
    }
</style>
{% endblock pageStyles %}