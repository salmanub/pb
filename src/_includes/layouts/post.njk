---
layout: layouts/base.njk
---
{#
  post.njk — Layout para articulos individuales de Blog
  Cadena: pagination → post.njk → base.njk
  Hero via page-hero.njk (igual que service pages)
  2-col body: articulo (65%) + sidebar (35%)
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}
{% set _blogUrl = "/blog/" if (not lang or lang == "es") else ("/en/blog/" if lang == "en" else "/ca/blog/") %}
{% set _contactPart = "/contacto/particular/" if (not lang or lang == "es") else ("/en/contact/particular/" if lang == "en" else "/ca/contacte/particular/") %}
{% set breadcrumb_parent = { label: "Blog", url: _blogUrl } %}
{% set title = post.title %}
{% set heroTitle = post.title %}
{% set description = post.excerpt | default(post.description) %}
<div itemscope itemtype="https://schema.org/BlogPosting" style="display:none;" aria-hidden="true"><meta itemprop="headline" content="{{ post.title | truncate(110) }}"><meta itemprop="description" content="{{ post.description }}"><meta itemprop="url" content="{{ metadata.site.url }}{{ page.url }}"><meta itemprop="datePublished" content="{{ post.datePublished }}T00:00:00+01:00"><meta itemprop="dateModified" content="{{ post.dateModified }}T00:00:00+01:00"><meta itemprop="inLanguage" content="{{ lang | default('es') }}"><div itemprop="author" itemscope itemtype="https://schema.org/Person"><meta itemprop="name" content="{{ post.author }}"></div><div itemprop="publisher" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="{{ metadata.company.name }}"></div></div>
{% include "partials/page-hero.njk" %}
<div style="max-width: var(--container-wide); margin: 0 auto; padding: 0 var(--gutter); padding-bottom: var(--space-12);">
<div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:20px;border-top:1px solid var(--border-hairline);">
<div style="display:flex;align-items:center;gap:12px;"><div style="width:36px;height:36px;border-radius:50%;background:var(--surface-ink);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:0.7rem;font-weight:700;color:var(--bone-100);flex-shrink:0;">AV</div><div><div style="font-family:var(--font-sans);font-size:0.875rem;font-weight:600;color:var(--text-strong);">{{ post.author }}</div><div style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-faint);">{{ "Ingeniero Civil · ECCAT 16448" if (not lang or lang == "es") else ("Civil Engineer · ECCAT 16448" if lang == "en" else "Enginyer Civil · ECCAT 16448") }}</div></div></div>
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
{% if post.category %}<span style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-accent);font-weight:600;">{{ post.category }}</span>{% endif %}
{% for tag in post.tags | slice(0, 3) %}<span style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;padding:3px 9px;border-radius:var(--radius-xs);border:1px solid var(--border-hairline);color:var(--text-muted);">{{ tag }}</span>{% endfor %}
<time datetime="{{ post.datePublished }}" style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-faint);">{{ post.datePublished | replace("-", " · ") }}</time>
</div>
</div>
</div>
<div style="max-width:var(--container-wide);margin:0 auto;padding:0 var(--gutter);"><div style="height:1px;background:var(--border-hairline);"></div></div>
<section style="max-width:var(--container-wide);margin:0 auto;padding:var(--section-y) var(--gutter);">
<div style="display:grid;grid-template-columns:1.6fr 0.4fr;gap:clamp(32px,5vw,72px);align-items:start;" class="hero-grid">
<div class="prose">
{{ post.content | markdown | safe }}
</div>
<aside>
{% if post.relatedServices and post.relatedServices.length > 0 %}
<div style="border:1px solid var(--border-hairline);border-radius:var(--radius-md);background:var(--surface-card);overflow:hidden;margin-bottom:20px;">
<div style="padding:14px 18px;border-bottom:1px solid var(--border-hairline);font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-muted);">{{ "Servicios relacionados" if (not lang or lang == "es") else ("Related services" if lang == "en" else "Serveis relacionats") }}</div>
<div>{% for svc in post.relatedServices %}<a href="{{ svc.url }}" style="display:grid;grid-template-columns:1fr 24px;gap:14px;align-items:center;border-top:1px solid var(--border-hairline);padding:16px 12px;text-decoration:none;color:inherit;" class="svc-row"><div><span style="display:block;font-family:var(--font-serif);font-size:1.05rem;font-weight:400;color:var(--text-strong);line-height:1.2;">{{ svc.title }}</span>{% if svc.norm %}<span style="display:block;margin-top:3px;font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.06em;text-transform:uppercase;color:var(--text-faint);line-height:1.5;">{{ svc.norm }}</span>{% endif %}</div><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-faint)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>{% endfor %}</div>
</div>
{% endif %}
{% set _contactPath = _contactPart %}
{% set audience = "particular" %}
{% include "partials/qual.njk" %}
</aside>
</div>
</section>
<section style="background:var(--surface-tint);border-top:1px solid var(--oxide-200);">
<div style="max-width:var(--container-wide);margin:0 auto;padding:var(--section-y) var(--gutter);text-align:center;">
<div style="display:inline-flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;font-weight:600;color:var(--text-accent);margin-bottom:18px;"><span style="width:24px;height:1.5px;background:var(--accent);display:inline-block;"></span>{{ "Necesita un informe pericial?" if (not lang or lang == "es") else ("Need an expert report?" if lang == "en" else "Necessita un dictamen pericial?") }}</div>
<h2 style="font-family:var(--font-serif);font-size:var(--fs-h1);font-weight:400;line-height:var(--lh-display);letter-spacing:var(--tracking-tight);color:var(--text-strong);margin:0;">{{ "Primera consulta gratuita" if (not lang or lang == "es") else ("Free initial consultation" if lang == "en" else "Primera consulta gratuita") }}</h2>
<p style="margin-top:14px;font-size:var(--fs-lede);line-height:var(--lh-lede);color:var(--text-muted);max-width:58ch;margin-left:auto;margin-right:auto;">{{ "Evaluamos su caso sin compromiso y le indicamos si tiene recorrido pericial. Respuesta en 24 h." if (not lang or lang == "es") else ("We assess your case at no charge and advise whether it has expert potential. Reply within 24 h." if lang == "en" else "Valorem el seu cas sense compromis i l'informem si te recorregut pericial. Resposta en 24 h.") }}</p>
<div style="margin-top:28px;"><a href="{{ _contactPart }}" class="cta-hero" style="display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:16px 28px;font-family:var(--font-sans);font-size:var(--fs-body);font-weight:var(--fw-semibold);line-height:1;letter-spacing:0.005em;border-radius:var(--radius-sm);border:1.5px solid transparent;background:var(--accent);color:var(--accent-on);text-decoration:none;">{{ "Solicitar consulta" if (not lang or lang == "es") else ("Request a consultation" if lang == "en" else "Sol·licitar consulta") }} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></div>
<div style="margin-top:16px;"><a href="{{ _blogUrl }}" style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-muted);text-decoration:none;">← Blog</a></div>
</div>
</section>
