---
layout: layouts/base.njk
---
{#
post.njk — Layout DS-pixel-fiel para artículos de Blog
Clases CSS del DS: .post-header .post-eyebrow .post-h1 .post-lede
.post-author .post-banner .post-grid .post-prose
.post-aside .post-aside-refs .post-aside-cta
.post-author-bio .art-card .band-cta--tint
Textos i18n: ui.post.* desde es.json / ca.json / en.json
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}
{% set _blogUrl = "/blog/" if (not lang or lang == "es") else ("/en/blog/" if lang == "en" else "/ca/blog/") %}
{% set _blogLabel = "Blog" %}
{% set _contactPart = "/contacto/particular/" if (not lang or lang == "es") else ("/en/contact/particular/" if lang ==
"en" else "/ca/contacte/particular/") %}

{# Schema SEO invisible #}
<div itemscope itemtype="https://schema.org/BlogPosting" style="display:none;" aria-hidden="true">
  <meta itemprop="headline" content="{{ post.title | truncate(110) }}">
  <meta itemprop="description" content="{{ post.description }}">
  <meta itemprop="url" content="{{ metadata.site.url }}{{ page.url }}">
  <meta itemprop="datePublished" content="{{ post.datePublished }}T00:00:00+01:00">
  <meta itemprop="dateModified" content="{{ post.dateModified }}T00:00:00+01:00">
  <meta itemprop="inLanguage" content="{{ lang | default('es') }}">
  <div itemprop="author" itemscope itemtype="https://schema.org/Person">
    <meta itemprop="name" content="{{ post.author }}">
  </div>
  <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
    <meta itemprop="name" content="{{ metadata.company.name }}">
  </div>
</div>

{# ── BREADCRUMB (banda verde contenida al ancho del cuerpo, como en service.njk) ── #}
{% set breadcrumb_items = [
  { label: ui.post.breadcrumb_home, url: "/" },
  { label: _blogLabel, url: _blogUrl },
  { label: post.category }
] %}
<div style="max-width: var(--container-wide); margin: 0 auto; padding: 0 var(--gutter); padding-top: clamp(20px,3vw,32px);">
  {% include "partials/breadcrumb.njk" %}
</div>

{# ── 1. CABECERA (DS Post — .post-header max 820px center) ── #}
<article>
  <div class="post-header">

    {# Eyebrow: categoría + audiencia #}
    <div class="post-eyebrow">
      <span class="post-eyebrow__cat">{{ post.category }}</span>
      {% if post.audience %}
      <span class="post-eyebrow__sep">·</span>
      <span class="post-eyebrow__aud">{{ post.audience }}</span>
      {% endif %}
    </div>

    {# H1 #}
    <h1 class="post-h1">{{ post.title }}</h1>

    {# Lede #}
    <p class="post-lede">{{ post.excerpt | default(post.description) }}</p>

    {# Author strip #}
    <div class="post-author">
      <div class="post-author__avatar">AV</div>
      <div>
        <div class="post-author__name">{{ post.author | default("Albert Vilardell Serra") }}</div>
        <div class="post-author__meta">{{ post.datePublished | replace("-", " / ") | truncate(8, true, "") }}{% if
          post.readTime %} · {{ post.readTime }} {{ ui.post.read_time }}{% endif %}</div>
      </div>
    </div>
  </div>

  {# ── 2. IMAGEN BANNER 21/9 (DS: .post-banner max 1040px) ── #}
  {% if post.image and post.image.url and "placeholder" not in post.image.url %}
  <div class="post-banner">
    <img src="{{ post.image.url }}" alt="{{ post.image.alt | default(post.title) }}" loading="lazy" decoding="async">
    {% if post.image.caption %}<p
      style="margin-top:10px;font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:0.04em;color:var(--text-faint);">
      {{ post.image.caption }}</p>{% endif %}
  </div>
  {% endif %}

  {# ── 3. GRID: prose + aside sticky (DS: .post-grid) ── #}
  <div class="post-grid">

    {# PROSE — DS Prose + AuthorBio #}
    <div class="post-prose">
      {{ post.content | markdown | safe }}
    </div>

    {# ASIDE sticky (DS: .post-aside, sticky top:92px) #}
    <aside class="post-aside" style="position:sticky;top:92px;display:flex;flex-direction:column;gap:20px;">
      {% if post.tags and post.tags | length > 0 %}
      {# Referencias card #}
      <div class="post-aside-refs">
        <div class="post-aside-refs__label">{{ ui.post.aside_refs_label }}</div>
        <div style="display:flex;flex-direction:column;gap:9px;">
          {% for tag in post.tags %}
          <div class="post-aside-refs__item">
            <span class="post-aside-refs__item-sym">§</span>{{ tag }}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {# CTA oscuro i18n #}
      <div class="post-aside-cta">
        <div class="post-aside-cta__title">{{ ui.post.aside_cta_title }}</div>
        <p class="post-aside-cta__lede">{{ ui.post.aside_cta_lede }}</p>
        <a href="{{ _contactPart }}" class="band-cta__btn"
          style="width:100%;box-sizing:border-box;justify-content:center;">
          {{ ui.post.aside_cta_btn }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        {% if post.relatedServices and post.relatedServices.length > 0 %}
        <div style="margin-top:16px;border-top:1px solid var(--ink-700);padding-top:16px;">
          <div
            style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-on-dark-muted);margin-bottom:10px;">
            {{ ui.footer.col_dictamenes }}</div>
          {% for svc in post.relatedServices %}
          <a href="{{ svc.url }}"
            style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--ink-700);text-decoration:none;">
            <span style="font-family:var(--font-serif);font-size:0.95rem;color:var(--bone-100);line-height:1.2;">{{
              svc.title }}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-on-dark-muted)"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </aside>
  </div>
</article>

{# ── 4. ARTÍCULOS RELACIONADOS (DS: 2-col ArtCard) ── #}
{% set _postsData = posts if (not lang or lang == "es") else (posts_en if lang == "en" else posts_ca) %}
{% set allPosts = _postsData | published | sort(attribute="datePublished") | reverse %}
{% set relCount = 0 %}{% set rel1 = null %}{% set rel2 = null %}
{% for p in allPosts %}{% if p.slug != post.slug and p.category == post.category and relCount < 2 %}{% if relCount==0
  %}{% set rel1=p %}{% else %}{% set rel2=p %}{% endif %}{% set relCount=relCount + 1 %}{% endif %}{% endfor %} {% if
  relCount < 2 %}{% for p in allPosts %}{% if p.slug !=post.slug and p.slug !=(rel1.slug if rel1 else "" ) and relCount
  < 2 %}{% if relCount==0 %}{% set rel1=p %}{% else %}{% set rel2=p %}{% endif %}{% set relCount=relCount + 1 %}{% endif
  %}{% endfor %}{% endif %} {% if relCount> 0 %}
  <section class="post-related">
    <div class="sec-head">
      <div class="sec-head__left">
        <div class="sec-head__eyebrow"><span class="page-hero__eyebrow-line"></span>{{ ui.post.related_eyebrow }}</div>
        <h2 class="sec-head__title">{{ ui.post.related_title }}</h2>
      </div>
      <a href="{{ _blogUrl }}" class="caso-related__link">
        {{ ui.post.related_all }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(28px,4vw,56px);" class="two-col">
      {% for rp in [rel1, rel2] %}{% if rp %}
      <a href="{{ _blogUrl }}{{ rp.slug }}/" class="art-card">
        <div class="art-card__img-wrap">
          {% if rp.image and rp.image.url and "placeholder" not in rp.image.url %}
          <img src="{{ rp.image.url }}" alt="{{ rp.image.alt | default(rp.title) }}" loading="lazy" decoding="async">
          {% else %}
          <div
            style="width:100%;height:100%;background:linear-gradient(135deg,var(--surface-tint) 0%,var(--paper-50,#eef1ee) 100%);display:flex;align-items:center;justify-content:center;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--text-faint)" stroke-width="1"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg></div>
          {% endif %}
        </div>
        <div class="art-card__meta">
          <span class="art-card__cat">{{ rp.category }}</span>
        </div>
        <h3 class="art-card__h3">{{ rp.title }}</h3>
        <p class="art-card__lede">{{ rp.excerpt | default(rp.description) | truncate(160) }}</p>
        <time datetime="{{ rp.datePublished }}" class="art-card__date">{{ rp.datePublished | replace("-", "/") |
          truncate(7, true, "") }}</time>
      </a>
      {% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {# ── 5. BAND CTA (DS: band-cta--tint) i18n ── #}
  <section class="band-cta band-cta--tint">
    <div style="max-width:var(--container-wide);margin:0 auto;">
      <div class="band-cta__eyebrow"><span class="page-hero__eyebrow-line"></span>{{ ui.post.band_eyebrow }}</div>
      <h2 class="band-cta__h2">{{ ui.post.band_title }}<br>{{ ui.post.band_title2 }}</h2>
      <p class="band-cta__lede">{{ ui.post.band_lede }}</p>
      <div class="band-cta__btn-wrap">
        <a href="{{ _contactPart }}" class="band-cta__btn">
          {{ ui.post.band_btn }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      <div style="margin-top:16px;"><a href="{{ _blogUrl }}"
          style="font-family:var(--font-mono);font-size:var(--fs-mono-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-muted);text-decoration:none;">←
          {{ _blogLabel }}</a></div>
    </div>
  </section>