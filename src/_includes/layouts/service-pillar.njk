{% extends "layouts/base.njk" %}

{% block content %}
<main itemscope itemtype="https://schema.org/Article">
    <!-- Schema mejorado para Article -->
    <div hidden>
        {# <meta itemprop="datePublished" content="{{ page.date | date('YYYY-MM-DD') }}">
        <meta itemprop="dateModified" content="{{ page.inputPath | lastModifiedDate('YYYY-MM-DD') }}"> #}
        <meta itemprop="mainEntityOfPage" content="{{ metadata.site.url }}{{ page.url }}">
        <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
            <meta itemprop="name" content="{{ metadata.site.title }}">
            <meta itemprop="url" content="{{ metadata.site.url }}">
            <meta itemprop="sameAs" content="{{ metadata.company.linkedin }}">
            <div itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
                <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/logos/logo.png">
                <meta itemprop="width" content="600">
                <meta itemprop="height" content="60">
            </div>
        </div>
        <div itemprop="author" itemscope itemtype="https://schema.org/Person">
            <meta itemprop="name" content="{{ metadata.author.name }}">
            <meta itemprop="sameAs" content="{{ metadata.author.linkedin }}">
        </div>
        <div itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ metadata.site.url }}/assets/images/{{ hero.image }}">
            <meta itemprop="width" content="1200">
            <meta itemprop="height" content="630">
        </div>
    </div>
    <!-- Hero Section mejorado -->
    <!-- Hero Section mejorado -->
    <header class="relative mt-[70px] md:mt-[90px] lg:mt-[120px] min-h-[calc(100vh-70px)] sm:min-h-0 bg-white text-slate-900 overflow-hidden isolate border-b border-slate-100">
        <!-- Efectos decorativos modernos -->
        <div class="absolute inset-0">
            <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-100 skew-x-[-12deg] translate-x-1/4 origin-top"></div>
            <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-white to-transparent"></div>
        </div>

        <div class="relative z-10 w-full px-6 md:px-12 lg:px-16">
            <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 min-h-[calc(100vh-90px)] lg:min-h-[600px] items-center py-12 lg:py-16">
                <!-- Columna izquierda - Contenido -->
                <div class="lg:col-span-7">
                    {% include "partials/breadcrumb.njk" %}
                    <div class="space-y-6">
                        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-light text-slate-900 leading-[0.95] tracking-tight" itemprop="headline">
                            <span class="text-slate-900 font-light">{{ hero.title }}</span>
                            <strong class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600 font-bold block mt-2">{{ hero.strong }}</strong>
                            <span class="block text-[0.45em] text-slate-500 font-normal mt-6 uppercase tracking-wider">{{ hero.subtitle }}</span>
                        </h1>
                        <p class="text-xl text-slate-600 mt-8 font-light" itemprop="description">{{ hero.description }}</p>
                        <div class="prose prose-lg prose-slate mt-8">
                            <div class="text-lg text-slate-600 tracking-wide font-light" itemprop="articleBody">
                                {{ hero.intro | safe }}
                            </div>
                        </div>
                        <div hidden>
                            <span itemprop="keywords">{{ hero.title }}, {{ hero.strong }}, {{ hero.subtitle }}</span>
                        </div>
                    </div>
                </div>

                <!-- Columna derecha - Imagen con efectos mejorados -->
                <div class="lg:col-span-5">
                    <div class="aspect-video rounded-2xl overflow-hidden shadow-2xl shadow-slate-200/50 relative border border-slate-100">
                        <!-- Imagen con clip-path y hover suave -->
                        <div class="service-pillar-image-wrapper w-full h-full bg-white">
                            {% image hero.image, 
                                    hero.alt or hero.title or title, 
                                    "(min-width: 1200px) 40vw, (min-width: 768px) 50vw, 100vw", 
                                    "eager", 
                                    "high" 
                            %}
                            <style>
                                /* Aplicar estilos al contenedor de imagen generado por el shortcode */
                                .service-pillar-image-wrapper img {
                                    width: 100%;
                                    height: 100%;
                                    object-fit: cover;
                                    transform: scale(1.05);
                                    transition: transform 700ms ease-out;
                                }
                                .service-pillar-image-wrapper:hover img {
                                    transform: scale(1.1);
                                }
                            </style>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Service Grid Section actualizado -->
    <section class="py-24 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden isolate">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.1)_1px,transparent_1px)] [background-size:48px_48px]"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-50/40 via-transparent to-slate-100/30"></div>
        </div>

        <div class="relative z-10 w-full px-6 md:px-12 lg:px-16">
            <div class="max-w-3xl mx-auto text-center mb-16">
                <span class="text-cyan-500 font-medium uppercase tracking-wider mb-4 block">{{ serviceCluster.title }}</span>
                <h2 class="text-3xl md:text-4xl font-light text-slate-800" itemprop="name">
                    {{ serviceCluster.intro }}
                </h2>
            </div>

            <!-- Grid de servicios actualizado -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" itemprop="hasPart">
                {% for service in serviceCluster.services %}
                <a href="{{ service.url }}" class="group block h-full card-avant animate-in fade-in slide-in-from-bottom-4" style="animation-delay: {{ loop.index0 * 100 }}ms">
                    <div class="p-6 lg:p-8 flex flex-col h-full">
                        <div class="w-14 h-14 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-6">
                            <div class="w-8 h-8 text-cyan-500">
                                {% set iconPath = "icons/" + service.icon + ".svg" %}
                                {% if service.icon %}
                                    {% include iconPath ignore missing %}
                                {% else %}
                                    {% include "icons/document.svg" %}
                                {% endif %}
                            </div>
                        </div>

                        <h3 class="text-xl font-bold text-slate-800 mb-4">{{ service.title }}</h3>
                        <p class="text-slate-600 mb-6 flex-grow">{{ service.description }}</p>
                        
                        <div class="pt-6 border-t border-slate-100 group-hover:border-cyan-100/50 transition-colors">
                            <ul class="space-y-2">
                                {% for feature in (service.features or []) | slice(0, 3) %}
                                <li class="flex items-start gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 flex-shrink-0 mt-2"></span>
                                    <span class="text-slate-600 text-sm font-medium" itemprop="feature">{{ feature }}</span>
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                        <span class="inline-flex items-center text-cyan-600 hover:text-cyan-700 font-semibold group mt-auto pt-6">
                            Saber más
                            <svg class="w-5 h-5 ml-2 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </span>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- What Is Section -->
    <section class="py-24 bg-gradient-to-b from-slate-50 to-white">
        <div class="w-full px-6 md:px-12 lg:px-16">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
                <!-- Left Column - Title -->
                <div>
                    <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 leading-tight max-w-xl" itemprop="about">
                        {{ sections.title | safe }}
                    </h2>
                </div>

                <!-- Right Column - Content -->
                <div class="prose prose-lg prose-slate">
                    <div class="space-y-8" itemprop="articleBody">
                        {{ sections.what_is.text }}
                        <ul class="space-y-4">
                            {% for feature in sections.what_is.features %}
                            <li class="flex items-start gap-3">
                                <svg class="w-6 h-6 text-cyan-500 flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                <span class="text-slate-600" itemprop="feature">{{ feature }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Section actualizado -->
    <section class="relative py-24 md:py-32 bg-slate-50 overflow-hidden isolate">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.4)_1px,transparent_1px)] [background-size:48px_48px]"></div>
        </div>

        <div class="w-full px-6 md:px-12 lg:px-16">
            <div class="max-w-3xl mx-auto text-center mb-16">
                <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-900 mb-6">
                    {{ metadata.servicePillar[lang].processTitle | replace(metadata.servicePillar[lang].processStrong, '<strong class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600 font-bold">' + metadata.servicePillar[lang].processStrong + '</strong>') | safe }}
                </h2>
                <p class="text-xl text-slate-600">{{ metadata.servicePillar[lang].processDescription }}</p>
            </div>

            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
                {% for step in process.steps %}
                <div class="bg-white p-8 rounded-xl relative group hover:shadow-xl transition-all duration-300 border border-slate-100">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-cyan-50 text-cyan-600 transition-colors">
                            {% if step.icon %}
                                {% include "icons/" + step.icon + ".svg" ignore missing %}
                            {% else %}
                                {% include "icons/clock.svg" %}
                            {% endif %}
                        </div>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-4">{{ step.title }}</h3>
                    <p class="text-slate-600">{{ step.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Benefits Section -->
    <section class="relative py-24 md:py-32 bg-gradient-to-b from-slate-50 to-white">
        <div class="w-full px-6 md:px-12 lg:px-16">
            <div class="max-w-3xl mx-auto text-center mb-16">
                <span class="text-cyan-500 font-semibold tracking-wider uppercase mb-4 block">{{ metadata.servicePillar[lang].whyChooseUs }}</span>
                <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6">
                    {{ metadata.servicePillar[lang].expertsTitle }} <strong class="text-cyan-500 font-bold">{{ metadata.servicePillar[lang].expertsStrong }}</strong>
                </h2>
            </div>

            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
                {% for item in benefits.items %}
                <div class="card-avant group h-full">
                    <div class="p-6 lg:p-8 flex flex-col h-full">
                        <div class="w-14 h-14 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-6">
                            <div class="w-8 h-8 text-cyan-500">
                                {% include "icons/" + item.icon + ".svg" %}
                            </div>
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-4">{{ item.title }}</h3>
                        <p class="text-slate-600 flex-grow">{{ item.description }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# New Testimonials Section - Conditionally Rendered #}
    {% if testimonials and testimonials.items %}
    <section class="py-24 px-4 md:px-[5%] bg-white">
        <div class="w-full px-6 md:px-12 lg:px-16">
            <!-- Título de sección -->
            <div class="max-w-3xl mx-auto text-center mb-16">
                 <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6">
                    {{ testimonials.title | default(metadata.servicePillar[lang].successCasesTitle) }}
                </h2>
            </div>

            <!-- Grid de testimonios -->
            {# Adaptado de casos-home.njk para 2 columnas #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto">
                {% for item in testimonials.items %}
                <div class="bg-white p-8 lg:p-10 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 relative border-l-4 border-cyan-400">
                    <p class="text-slate-700 mb-6 text-lg relative pl-6">
                        <span class="absolute top-[-1rem] left-[-0.5rem] text-[4rem] text-cyan-400/20 font-serif">"</span>
                        {{ item.quote }}
                    </p>
                    <div class="flex items-center mt-auto pt-4">
                        <span class="w-12 h-[2px] bg-cyan-400/30 mr-4"></span>
                        <div>
                            <p class="font-semibold text-cyan-500">{{ item.author }}</p>
                            {% if item.role %}
                            <p class="text-sm text-slate-500">{{ item.role }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Content Section -->
    <section class="py-24 px-4 md:px-[5%] bg-white">
        <div class="w-full px-6 md:px-12 lg:px-16">
            <div class="prose prose-lg prose-slate max-w-4xl mx-auto">
                <!-- Renderiza el contenido markdown -->
                {{ content | safe }}

                <!-- Renderiza FAQs estructuradas si existen en el frontmatter -->
                {% include "partials/faqs.njk" %}
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-24 md:py-32 bg-slate-900 overflow-hidden isolate">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
             <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-800 skew-x-[-12deg] translate-x-1/4 origin-top opacity-30"></div>
        </div>

        <div class="w-full px-6 md:px-12 lg:px-16 relative z-10">
            <div class="max-w-3xl mx-auto text-center">
                <h2 class="text-[2.5rem] md:text-[3.5rem] font-black text-white mb-6 uppercase tracking-tight">
                    {{ cta.title }}
                </h2>
                <p class="text-xl text-slate-300 mb-12 font-light">{{ cta.description }}</p>
                <!-- Actualización de botones CTA sin flechas -->
                <a href="{{ cta.button.url }}" class="btn-primary bg-white text-slate-900 hover:bg-cyan-50 hover:text-cyan-600 border-none shadow-xl">
                    {{ cta.button.text }}
                </a>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block pageStyles %}
 {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
<style>
/* Estilos revisados */
.section-spacing {
    @apply py-12 md:py-16 lg:py-24;
}

/* Ajustes de jerarquía visual */
.hero-content {
    @apply relative z-20;
}

/* Transiciones mejoradas */
.section-transition {
    @apply transition-all duration-500 ease-in-out;
}

/* Mejoras de layout */
.content-grid {
    @apply grid gap-6 lg:gap-8;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
}

/* Optimización de altura */
.above-fold {
    height: calc(100vh - 90px);
    min-height: 600px;
}

/* Efectos de profundidad */
.depth-effect {
    @apply shadow-lg hover:shadow-xl transition-all duration-300;
    transform: translateY(0);
}

.depth-effect:hover {
    transform: translateY(-4px);
}

/* Estilos base */
.section-spacing {
    @apply py-16 md:py-24 lg:py-32;
}

.section-container {
    @apply max-w-[1400px] mx-auto px-4 sm:px-8 md:px-12 lg:px-16;
}

/* Efectos y transiciones */
.section-transition {
    @apply transition-all duration-300 ease-in-out;
}

/* Optimización de espaciado vertical */
.vertical-rhythm > * + * {
    @apply mt-16 md:mt-24 lg:mt-32;
}

.vertical-rhythm--compact > * + * {
    @apply mt-8 md:mt-12 lg:mt-16;
}

/* Mejoras de diseño responsivo */
@screen lg {
    .content-grid {
        display: grid;
        grid-template-columns: 1fr minmax(auto, 33%);
        gap: 4rem;
    }

    .content-grid--reverse {
        grid-template-columns: minmax(auto, 33%) 1fr;
    }
}

/* Mejoras visuales */
.section-divider {
    @apply relative;
}

.section-divider::after {
    content: '';
    @apply absolute left-1/2 -translate-x-1/2 bottom-0 w-16 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent;
}

/* Optimización de contraste y legibilidad */
.content-prose {
    @apply prose prose-lg max-w-none 
           prose-headings:text-slate-800 
           prose-p:text-slate-600 
           prose-a:text-cyan-600 
           prose-a:no-underline 
           prose-a:font-semibold;
}

.content-prose--light {
    @apply prose-invert 
           prose-headings:text-white/90 
           prose-p:text-white/80 
           prose-a:text-cyan-400;
}

/* Efectos de interacción */
.hover-card {
    @apply transform transition-all duration-300;
}

.hover-card:hover {
    @apply -translate-y-1 shadow-lg;
}

/* Fondos y gradientes */
.gradient-overlay {
    background: linear-gradient(
        to right,
        rgb(15 23 42 / 0.9),
        rgb(15 23 42 / 0.8),
        rgb(15 23 42 / 0.1)
    );
}

/* Correcciones de diseño */
.sticky-sidebar {
    @apply lg:sticky lg:top-24 lg:self-start;
}

.section-overlap {
    @apply relative z-10 -mt-16 md:-mt-24 lg:-mt-32;
}

{{ indexCSS | safe }}
</style>
{% endblock pageStyles %}

{% block scripts %}
<!-- Scripts heredados de base.njk -->
{{ super() }}
{% endblock %}


