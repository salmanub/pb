{% extends "layouts/base.njk" %}

{% block content %}
<main itemscope itemtype="https://schema.org/Article">
    <!-- Hero Section mejorado -->
    <header class="relative mt-[70px] md:mt-[90px] lg:mt-[120px] min-h-[calc(100vh-70px)] sm:min-h-0 bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] text-white overflow-hidden isolate">
        <!-- Efectos decorativos modernos -->
        <div class="absolute inset-0">
            <!-- Patrón de puntos con mejor contraste -->
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <!-- Gradientes suaves -->
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <!-- Efecto de luz moderna -->
            <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
            <!-- Velo sutil para mejorar legibilidad -->
            <div class="absolute inset-0 bg-gradient-to-b from-slate-900/10 to-slate-900/30 mix-blend-overlay"></div>
        </div>

        <div class="relative z-10 container mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-0">
            <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 min-h-[calc(100vh-90px)] lg:min-h-[600px] items-center py-12 lg:py-16">
                <!-- Columna izquierda - Contenido -->
                <div class="lg:col-span-7">
                    {% include "partials/breadcrumb.njk" %}
                    <div class="space-y-6">
                        <h1 class="text-[2.75rem] md:text-[3.5rem] xl:text-[4rem] font-light text-white leading-[1.1] tracking-tight" itemprop="headline">
                            <span class="text-white font-light">{{ hero.title }}</span>
                            <strong class="text-cyan-400 font-bold block mt-2">{{ hero.strong }}</strong>
                            <span class="block text-[0.85em] text-cyan-400 font-normal mt-6">{{ hero.subtitle }}</span>
                        </h1>
                        <p class="text-xl text-white/90 mt-8" itemprop="description">{{ hero.description }}</p>
                        <div class="prose prose-lg prose-invert mt-8">
                            <div class="text-lg text-white/80 tracking-wide" itemprop="articleBody">
                                {{ hero.intro }}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Columna derecha - Imagen con efectos mejorados -->
                <div class="lg:col-span-5">
                    <div class="aspect-video rounded-2xl overflow-hidden shadow-2xl relative">
                        <!-- Overlay gradiente mejorado -->
                        <div class="absolute inset-0 bg-gradient-to-tr from-slate-900/50 via-slate-900/30 to-transparent mix-blend-overlay z-10"></div>
                        <!-- Imagen con clip-path y hover suave -->
                        <div class="service-pillar-image-wrapper w-full h-full">
                            {% image hero.image, 
                                    hero.title, 
                                    "(min-width: 1200px) 40vw, (min-width: 768px) 50vw, 100vw", 
                                    "eager", 
                                    "high" 
                            %}
                            <style>
                                /* Aplicar estilos al contenedor de imagen generado por el shortcode */
                                .service-pillar-image-wrapper img {
                                    width: 100%;
                                    height: 100%;
                                    object-fit: cover;
                                    transform: scale(1.05);
                                    transition: transform 700ms ease-out;
                                }
                                .service-pillar-image-wrapper:hover img {
                                    transform: scale(1.1);
                                }
                            </style>
                        </div>
                        <!-- Efecto de brillo en hover -->
                        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-400/0 to-cyan-400/0 opacity-0 group-hover:opacity-20 transition-opacity duration-700 z-20"></div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Service Grid Section actualizado -->
    <section class="py-24 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden isolate">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.1)_1px,transparent_1px)] [background-size:48px_48px]"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-50/40 via-transparent to-slate-100/30"></div>
        </div>

        <div class="relative z-10 max-w-[1400px] mx-auto">
            <div class="max-w-3xl mx-auto text-center mb-16">
                <span class="text-cyan-500 font-medium uppercase tracking-wider mb-4 block">{{ serviceCluster.title }}</span>
                <h2 class="text-3xl md:text-4xl font-light text-slate-800" itemprop="name">
                    {{ serviceCluster.intro }}
                </h2>
            </div>

            <!-- Grid de servicios actualizado -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" itemprop="hasPart">
                {% for service in serviceCluster.services %}
                <a href="{{ service.url }}" class="group/card relative block h-full bg-gradient-to-br from-white to-slate-50/80 rounded-2xl p-6 pb-20 shadow-lg hover:shadow-xl transition-all duration-500 overflow-hidden isolate">
                    <!-- Efecto hover background -->
                    <div class="absolute inset-0 bg-gradient-to-br from-cyan-50 to-white opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>
                    
                    <!-- Contenido principal -->
                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-6 group-hover/card:scale-110 group-hover/card:bg-cyan-500/20 transition-all duration-500">
                            <div class="w-8 h-8 text-cyan-500">
                                {% set iconPath = "icons/" + service.icon + ".svg" %}
                                {% if service.icon %}
                                    {% include iconPath ignore missing %}
                                {% else %}
                                    {% include "icons/document.svg" %}
                                {% endif %}
                            </div>
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-4 group-hover/card:text-cyan-600 transition-colors" itemprop="name">{{ service.title }}</h3>
                        <p class="text-slate-600 mb-6 flex-grow" itemprop="description">{{ service.description }}</p>
                        <ul class="space-y-3 mb-6">
                            {% for feature in service.features %}
                            <li class="flex items-start gap-2">
                                <span class="p-1 rounded bg-cyan-50 flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                    </svg>
                                </span>
                                <span class="text-slate-600 text-sm" itemprop="feature">{{ feature }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>

                    <!-- CTA posicionado abajo a la derecha -->
                    <div class="absolute bottom-6 right-6 flex items-center gap-2 text-cyan-400 group-hover/card:text-cyan-500 transition-colors">
                        <div class="w-8 h-8 rounded-full bg-cyan-50 flex items-center justify-center group-hover/card:bg-cyan-100 transition-all duration-300">
                            <svg class="w-4 h-4 group-hover/card:scale-110 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </div>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- What Is Section -->
    <section class="py-24 bg-gradient-to-b from-slate-50 to-white">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
                <!-- Left Column - Title -->
                <div>
                    <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 leading-tight max-w-xl" itemprop="about">
                        {{ sections.title | safe }}
                    </h2>
                </div>

                <!-- Right Column - Content -->
                <div class="prose prose-lg prose-slate">
                    <div class="space-y-8" itemprop="articleBody">
                        {{ sections.what_is.text }}
                        <ul class="space-y-4">
                            {% for feature in sections.what_is.features %}
                            <li class="flex items-start gap-3">
                                <svg class="w-6 h-6 text-cyan-500 flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                <span class="text-slate-600" itemprop="feature">{{ feature }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Section actualizado -->
    <section class="relative py-24 md:py-32 bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] overflow-hidden isolate">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
        </div>

        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="max-w-3xl mx-auto text-center mb-16">
                <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-white mb-6">
                    {{ metadata.servicePillar[lang].processTitle | replace(metadata.servicePillar[lang].processStrong, '<strong class="text-cyan-400 font-bold">' + metadata.servicePillar[lang].processStrong + '</strong>') | safe }}
                </h2>
                <p class="text-xl text-white/80">{{ metadata.servicePillar[lang].processDescription }}</p>
            </div>

            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
                {% for step in process.steps %}
                <div class="bg-white/5 backdrop-blur-sm p-8 rounded-xl relative group hover:bg-white/10 transition-all duration-300">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-cyan-400/20 text-cyan-400 group-hover:scale-110 transition-transform">
                            {% if step.icon %}
                                {% include "icons/" + step.icon + ".svg" ignore missing %}
                            {% else %}
                                {% include "icons/clock.svg" %}
                            {% endif %}
                        </div>
                    </div>
                    <h3 class="text-xl font-bold text-cyan-400 mb-4">{{ step.title }}</h3>
                    <p class="text-white/80">{{ step.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Benefits Section -->
    <section class="relative py-24 md:py-32 bg-gradient-to-b from-slate-50 to-white">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="max-w-3xl mx-auto text-center mb-16">
                <span class="text-cyan-500 font-semibold tracking-wider uppercase mb-4 block">{{ metadata.servicePillar[lang].whyChooseUs }}</span>
                <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6">
                    {{ metadata.servicePillar[lang].expertsTitle }} <strong class="text-cyan-500 font-bold">{{ metadata.servicePillar[lang].expertsStrong }}</strong>
                </h2>
            </div>

            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
                {% for item in benefits.items %}
                <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group border border-slate-100">
                    <div class="w-14 h-14 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-6">
                        <div class="w-8 h-8 text-cyan-500 group-hover:scale-110 transition-transform">
                            {% include "icons/" + item.icon + ".svg" %}
                        </div>
                    </div>
                    <h3 class="text-xl font-bold text-slate-800 mb-3">{{ item.title }}</h3>
                    <p class="text-slate-600">{{ item.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# New Testimonials Section - Conditionally Rendered #}
    {% if testimonials and testimonials.items %}
    <section class="py-24 px-4 md:px-[5%] bg-white">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <!-- Título de sección -->
            <div class="max-w-3xl mx-auto text-center mb-16">
                 <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6">
                    {{ testimonials.title | default(metadata.servicePillar[lang].successCasesTitle) }}
                </h2>
            </div>

            <!-- Grid de testimonios -->
            {# Adaptado de casos-home.njk para 2 columnas #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto">
                {% for item in testimonials.items %}
                <div class="bg-white p-8 lg:p-10 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 relative border-l-4 border-cyan-400">
                    <p class="text-slate-700 mb-6 text-lg relative pl-6">
                        <span class="absolute top-[-1rem] left-[-0.5rem] text-[4rem] text-cyan-400/20 font-serif">"</span>
                        {{ item.quote }}
                    </p>
                    <div class="flex items-center mt-auto pt-4">
                        <span class="w-12 h-[2px] bg-cyan-400/30 mr-4"></span>
                        <div>
                            <p class="font-semibold text-cyan-500">{{ item.author }}</p>
                            {% if item.role %}
                            <p class="text-sm text-slate-500">{{ item.role }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Content Section -->
    <section class="py-24 px-4 md:px-[5%] bg-white">
        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
            <div class="prose prose-lg prose-slate max-w-4xl mx-auto">
                <!-- Renderiza el contenido markdown -->
                {{ content | safe }}
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-24 md:py-32 bg-gradient-to-br from-[#0B1030] via-[#141d3d] to-[#1a2452] overflow-hidden isolate">
        <!-- Efectos decorativos -->
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] opacity-25"></div>
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-transparent to-cyan-400/5"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-400/20 blur-[100px] rounded-full"></div>
        </div>

        <div class="container mx-auto px-4 sm:px-8 md:px-12 lg:px-16 relative z-10">
            <div class="max-w-3xl mx-auto text-center">
                <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-white mb-6">
                    {{ cta.title }}
                </h2>
                <p class="text-xl text-white/80 mb-12">{{ cta.description }}</p>
                <!-- Actualización de botones CTA sin flechas -->
                <a href="{{ cta.button.url }}" class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-cyan-200/20 hover:-translate-y-0.5 transition-all">
                    {{ cta.button.text }}
                </a>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block pageStyles %}
 {% set indexCSS %} {% include "dist/assets/styles/index.css" %} {% endset %}
<style>
/* Estilos revisados */
.section-spacing {
    @apply py-12 md:py-16 lg:py-24;
}

/* Ajustes de jerarquía visual */
.hero-content {
    @apply relative z-20;
}

/* Transiciones mejoradas */
.section-transition {
    @apply transition-all duration-500 ease-in-out;
}

/* Mejoras de layout */
.content-grid {
    @apply grid gap-6 lg:gap-8;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
}

/* Optimización de altura */
.above-fold {
    height: calc(100vh - 90px);
    min-height: 600px;
}

/* Efectos de profundidad */
.depth-effect {
    @apply shadow-lg hover:shadow-xl transition-all duration-300;
    transform: translateY(0);
}

.depth-effect:hover {
    transform: translateY(-4px);
}

/* Estilos base */
.section-spacing {
    @apply py-16 md:py-24 lg:py-32;
}

.section-container {
    @apply max-w-[1400px] mx-auto px-4 sm:px-8 md:px-12 lg:px-16;
}

/* Efectos y transiciones */
.section-transition {
    @apply transition-all duration-300 ease-in-out;
}

/* Optimización de espaciado vertical */
.vertical-rhythm > * + * {
    @apply mt-16 md:mt-24 lg:mt-32;
}

.vertical-rhythm--compact > * + * {
    @apply mt-8 md:mt-12 lg:mt-16;
}

/* Mejoras de diseño responsivo */
@screen lg {
    .content-grid {
        display: grid;
        grid-template-columns: 1fr minmax(auto, 33%);
        gap: 4rem;
    }

    .content-grid--reverse {
        grid-template-columns: minmax(auto, 33%) 1fr;
    }
}

/* Mejoras visuales */
.section-divider {
    @apply relative;
}

.section-divider::after {
    content: '';
    @apply absolute left-1/2 -translate-x-1/2 bottom-0 w-16 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent;
}

/* Optimización de contraste y legibilidad */
.content-prose {
    @apply prose prose-lg max-w-none 
           prose-headings:text-slate-800 
           prose-p:text-slate-600 
           prose-a:text-cyan-600 
           prose-a:no-underline 
           prose-a:font-semibold;
}

.content-prose--light {
    @apply prose-invert 
           prose-headings:text-white/90 
           prose-p:text-white/80 
           prose-a:text-cyan-400;
}

/* Efectos de interacción */
.hover-card {
    @apply transform transition-all duration-300;
}

.hover-card:hover {
    @apply -translate-y-1 shadow-lg;
}

/* Fondos y gradientes */
.gradient-overlay {
    background: linear-gradient(
        to right,
        rgb(15 23 42 / 0.9),
        rgb(15 23 42 / 0.8),
        rgb(15 23 42 / 0.1)
    );
}

/* Correcciones de diseño */
.sticky-sidebar {
    @apply lg:sticky lg:top-24 lg:self-start;
}

.section-overlap {
    @apply relative z-10 -mt-16 md:-mt-24 lg:-mt-32;
}

{{ indexCSS | safe }}
</style>
{% endblock pageStyles %}

{% block scripts %}
<!-- Scripts heredados de base.njk -->
{{ super() }}
{% endblock %}


