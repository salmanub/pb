{# =========================================================
   FLOATING CTAs — Derecha, siempre visibles
   1. Llamada directa al perito
   2. Abrir chatbot
   Estilo: Premium, catchy, alta conversión
   ========================================================= #}

<div id="floating-cta-group"
     class="hidden md:flex flex-col gap-2.5 fixed right-0 top-1/2 z-40"
     style="transform: translateY(-50%) translateX(110%); opacity:0; transition: transform 0.65s cubic-bezier(0.22,1,0.36,1), opacity 0.5s ease;">

  {# ── BOTÓN 1: Llamada telefónica ── #}
  <a href="tel:+34614194985"
     aria-label="Llamar al perito ahora"
     class="group relative flex items-center gap-0 rounded-l-2xl overflow-hidden
            shadow-[0_8px_28px_rgba(6,182,212,0.55)]
            hover:shadow-[0_12px_40px_rgba(6,182,212,0.75)]
            hover:-translate-x-1
            transition-all duration-300 ease-out"
     style="background: linear-gradient(135deg, #0891b2 0%, #06b6d4 60%, #22d3ee 100%);">

    {# Brillo interior superior #}
    <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/50 to-transparent pointer-events-none"></span>

    {# Contenido #}
    <span class="flex items-center gap-3 pl-5 pr-4 py-3.5 w-full">
      {# Icono teléfono con ping #}
      <span class="relative flex-shrink-0">
        <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-white/20 backdrop-blur-sm border border-white/30 group-hover:bg-white/30 transition-colors">
          <svg class="w-[18px] h-[18px] text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </span>
        {# Dot de disponibilidad #}
        <span class="absolute -top-1 -right-1 flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-80"></span>
          <span class="relative inline-flex h-3 w-3 rounded-full bg-emerald-400 border-2 border-white shadow-sm"></span>
        </span>
      </span>

      {# Texto #}
      <span class="flex flex-col items-start leading-none">
        <span class="text-[9px] font-black uppercase tracking-[0.22em] text-cyan-100/80 mb-1">Perito disponible</span>
        <span class="text-[14px] font-bold text-white whitespace-nowrap leading-tight drop-shadow-sm">Hablar con un perito</span>
      </span>
    </span>

    {# Borde derecho de cierre del botón (efecto revista) #}
    <span class="absolute right-0 top-0 bottom-0 w-0.5 bg-white/10 pointer-events-none"></span>
  </a>

  {# ── BOTÓN 2: Abrir chatbot ── #}
  <button
     id="floating-chat-trigger"
     aria-label="Abrir asistente técnico"
     type="button"
     class="group relative flex items-center gap-0 rounded-l-2xl overflow-hidden w-full text-left
            bg-slate-900 border border-slate-700/80
            shadow-[0_8px_28px_rgba(0,0,0,0.45)]
            hover:shadow-[0_12px_40px_rgba(0,0,0,0.6)]
            hover:border-cyan-600/50
            hover:-translate-x-1
            transition-all duration-300 ease-out cursor-pointer">

    {# Brillo interior superior #}
    <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent pointer-events-none"></span>
    {# Línea izquierda de acento #}
    <span class="absolute left-0 top-3 bottom-3 w-[2px] rounded-r bg-cyan-500/0 group-hover:bg-cyan-400 transition-all duration-400 pointer-events-none"></span>

    {# Contenido #}
    <span class="flex items-center gap-3 pl-5 pr-4 py-3.5 w-full">
      {# Icono chat #}
      <span class="relative flex-shrink-0">
        <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-white/5 border border-slate-600 group-hover:bg-cyan-500/10 group-hover:border-cyan-500/50 transition-colors">
          <svg class="w-[18px] h-[18px] text-slate-300 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </span>
        {# Badge de IA #}
        <span class="absolute -top-1.5 -right-1.5 flex items-center justify-center h-4 w-4 rounded-full bg-cyan-500 border-2 border-slate-900 shadow-sm">
          <span class="text-[7px] font-black text-white leading-none">AI</span>
        </span>
      </span>

      {# Texto #}
      <span class="flex flex-col items-start leading-none">
        <span class="text-[9px] font-black uppercase tracking-[0.22em] text-cyan-400/80 mb-1 group-hover:text-cyan-300 transition-colors">Asistente técnico</span>
        <span class="text-[14px] font-bold text-slate-100 whitespace-nowrap leading-tight group-hover:text-white transition-colors">Consulta por chat</span>
      </span>
    </span>

    <span class="absolute right-0 top-0 bottom-0 w-0.5 bg-white/5 pointer-events-none"></span>
  </button>

</div>

<script>
  (function () {
    const g = document.getElementById('floating-cta-group');
    if (!g) return;

    // Entrada con animación scroll-aware
    let shown = false;
    function show() {
      if (shown) return;
      shown = true;
      g.style.transform = 'translateY(-50%) translateX(0)';
      g.style.opacity = '1';
    }
    window.addEventListener('scroll', function () { if (window.scrollY > 150) show(); }, { passive: true });
    setTimeout(show, 2200);

    // Botón de chat: carga el script y abre el chatbot
    const chatTrigger = document.getElementById('floating-chat-trigger');
    if (chatTrigger) {
      chatTrigger.addEventListener('mouseenter', function () {
        // Precarga el script del chatbot disparando el mouseover del botón nativo
        const nativeBtn = document.getElementById('chat-button');
        if (nativeBtn) nativeBtn.dispatchEvent(new MouseEvent('mouseover', { bubbles: true }));
      });
      chatTrigger.addEventListener('click', function () {
        const nativeBtn = document.getElementById('chat-button');
        if (nativeBtn) {
          // Primero mouseover para asegurar que el script está cargado
          nativeBtn.dispatchEvent(new MouseEvent('mouseover', { bubbles: true }));
          // Breve delay para que el script lazy cargue antes del click
          setTimeout(function () { nativeBtn.click(); }, 80);
        }
      });
    }
  })();
</script>

{# Solo ocultamos el botón circular del chatbot en desktop —
   el #chat-window (fixed) sigue funcionando y el script JS se inicializa #}
<style>
  @media (min-width: 768px) {
    #chat-button { display: none !important; }
  }
</style>


