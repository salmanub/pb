{% if metadata.site.revisandoContenidos %}
<div id="floating-notice" 
     class="fixed bottom-24 md:bottom-8 left-[50%] -translate-x-[50%] z-50 px-6 py-4 bg-slate-900/90 backdrop-blur-md border border-slate-700/50 text-white rounded-2xl shadow-2xl flex items-center gap-4 transform opacity-0 translate-y-2 ring-1 ring-white/10" 
     style="visibility: hidden;">
    <div class="flex flex-col text-sm">
        <strong class="font-bold text-cyan-400 mb-0.5 tracking-wide">
            {{ metadata.notificaciones.actualizandoContenidos[lang].titulo }}
        </strong>
        <span class="text-slate-300 font-medium">
            {{ metadata.notificaciones.actualizandoContenidos[lang].mensaje }}
        </span>
    </div>
    <a href="/contacto/" class="hidden sm:inline-flex items-center justify-center px-4 py-2 bg-slate-900 text-white text-xs font-bold uppercase tracking-wider rounded-lg hover:bg-black transition-colors shadow-lg shadow-slate-900/20 ml-4">
        Hablar con un perito
    </a>
    <div class="h-8 w-px bg-slate-700 mx-2"></div>
    <button onclick="closeNotice()" class="text-slate-400 hover:text-white transition-colors p-1.5 hover:bg-white/10 rounded-full">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const notice = document.getElementById('floating-notice');
    
    // Mostrar el aviso después de un pequeño delay
    setTimeout(() => {
        notice.style.visibility = 'visible';
        notice.classList.add('opacity-100', 'translate-y-0', 'transition-all', 'duration-500', 'ease-out');
        notice.classList.remove('opacity-0', 'translate-y-2');
    }, 500);
});

function closeNotice() {
    const notice = document.getElementById('floating-notice');
    notice.classList.remove('opacity-100', 'translate-y-0');
    notice.classList.add('opacity-0', 'translate-y-2');
    setTimeout(() => notice.remove(), 500);
}
</script>
{% endif %}
