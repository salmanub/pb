{% if metadata.site.revisandoContenidos %}
<div id="floating-notice" 
     class="fixed bottom-0 left-0 w-full md:w-auto md:bottom-8 md:left-[50%] md:-translate-x-[50%] z-40 px-4 py-3 md:px-6 md:py-4 bg-slate-900/95 backdrop-blur-md border-t md:border border-slate-700/50 text-white rounded-t-xl md:rounded-2xl shadow-2xl flex items-center justify-between md:justify-start gap-4 transform opacity-0 translate-y-full md:translate-y-2 ring-1 ring-white/10 transition-all duration-500" 
     style="visibility: hidden;">
    <div class="hidden md:flex flex-col text-sm">
        <strong class="font-bold text-cyan-400 mb-0.5 tracking-wide">
            {{ metadata.notificaciones.actualizandoContenidos[lang].titulo }}
        </strong>
        <span class="text-slate-300 font-medium">
            {{ metadata.notificaciones.actualizandoContenidos[lang].mensaje }}
        </span>
    </div>
    <a href="/contacto/" class="flex flex-1 md:flex-none items-center justify-center px-4 py-3 md:py-2 bg-cyan-600 md:bg-slate-900 text-white text-sm md:text-xs font-bold uppercase tracking-wider rounded-lg hover:bg-cyan-500 md:hover:bg-black transition-colors shadow-lg mr-14 md:mr-0 md:ml-4">
        Hablar con un perito
    </a>
    <div class="hidden md:block h-8 w-px bg-slate-700 mx-2"></div>
    <button onclick="closeNotice()" class="hidden md:block text-slate-400 hover:text-white transition-colors p-1.5 hover:bg-white/10 rounded-full">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const notice = document.getElementById('floating-notice');
    
    // Mostrar el aviso después de un pequeño delay
    setTimeout(() => {
        notice.style.visibility = 'visible';
        notice.classList.add('opacity-100', 'translate-y-0', 'transition-all', 'duration-500', 'ease-out');
        notice.classList.remove('opacity-0', 'translate-y-full', 'translate-y-2', 'md:translate-y-2');
    }, 500);
});

function closeNotice() {
    const notice = document.getElementById('floating-notice');
    notice.classList.remove('opacity-100', 'translate-y-0');
    notice.classList.add('opacity-0', 'translate-y-full', 'md:translate-y-2');
    setTimeout(() => notice.remove(), 500);
}
</script>
{% endif %}
