    <div class="relative bg-gradient-to-br from-cyan-600 to-cyan-700 rounded-full p-2 lg:p-2.5 xl:p-3 group-hover:from-cyan-500 group-hover:to-cyan-600 transition-all duration-500 shadow-lg shadow-cyan-900/50 group-hover:shadow-cyan-500/30 group-hover:rotate-12">
