{% set currentLanguage = page.lang or lang %} 

<footer class="relative bg-white overflow-hidden isolate" itemscope itemtype="https://schema.org/WPFooter">
    <!-- Efectos decorativos optimizados -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.1)_1px,transparent_1px)] [background-size:48px_48px]"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-50/40 via-transparent to-slate-50/30"></div>
        <div class="absolute -bottom-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-200/20 blur-[100px] rounded-full"></div>
    </div>

    <div class="relative pt-1">
        <!-- Gradiente superior mejorado -->
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyan-400 via-cyan-500 to-cyan-400"></div>
        
        <div class="max-w-[1400px] mx-auto px-4 md:px-[5%] py-12 md:py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16">
                <!-- Columna de marca -->
                <div class="lg:col-span-1" itemscope itemtype="https://schema.org/Organization">
                    <div class="flex items-center gap-3 mb-8 group hover:-translate-y-0.5 transition-transform duration-300">
                        <svg class="w-10 h-10 sm:w-11 sm:h-11 text-cyan-400 transition-all duration-300 filter group-hover:drop-shadow-[0_4px_8px_rgba(0,184,212,0.3)]"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 375 375"
                            preserveAspectRatio="xMidYMid meet">
                            

                    <defs>
                        <clipPath id="2717b77dc4">
                            <path
                                d="M 223.109375 37.496094 L 314.597656 37.496094 L 314.597656 337.6875 L 223.109375 337.6875 Z M 223.109375 37.496094"
                                clip-rule="nonzero"
                            />
                        </clipPath>

                        <clipPath id="9422b2d12e">
                            <path
                                d="M 314.597656 67.992188 L 314.597656 337.496094 L 223.109375 307 L 223.109375 37.496094 Z M 314.597656 67.992188"
                                clip-rule="nonzero"
                            />
                        </clipPath>

                        <clipPath id="b07c821656">
                            <path
                                d="M 146.625 37.496094 L 223.117188 37.496094 L 223.117188 249.945312 L 146.625 249.945312 Z M 146.625 37.496094"
                                clip-rule="nonzero"
                            />
                        </clipPath>

                        <clipPath id="55959a45ff">
                            <path
                                d="M 146.625 62.996094 L 146.625 249.945312 L 223.117188 224.449219 L 223.117188 37.496094 Z M 146.625 62.996094"
                                clip-rule="nonzero"
                            />
                        </clipPath>

                        <clipPath id="a83aa56b9b">
                            <path
                                d="M 112.101562 111.523438 L 177.742188 111.523438 L 177.742188 291.515625 L 112.101562 291.515625 Z M 112.101562 111.523438"
                                clip-rule="nonzero"
                            />
                        </clipPath>

                        <clipPath id="1c3af9afe2">
                            <path
                                d="M 177.742188 133.402344 L 177.742188 291.402344 L 112.101562 269.523438 L 112.101562 111.523438 Z M 177.742188 133.402344"
                                clip-rule="nonzero"
                            />
                        </clipPath>

                        <clipPath id="a2157cede2">
                            <path
                                d="M 60.398438 111.367188 L 112.109375 111.367188 L 112.109375 237.410156 L 60.398438 237.410156 Z M 60.398438 111.367188"
                                clip-rule="nonzero"
                            />
                        </clipPath>

                        <clipPath id="1adccc21aa">
                            <path
                                d="M 60.398438 128.75 L 60.398438 237.410156 L 112.109375 220.175781 L 112.109375 111.515625 Z M 60.398438 128.75"
                                clip-rule="nonzero"
                            />
                        </clipPath>
                    </defs>

                    <g clip-path="url(#2717b77dc4)">
                        <g clip-path="url(#9422b2d12e)">
                            <path
                                fill="currentColor"
                                d="M 314.597656 37.496094 L 314.597656 337.332031 L 223.109375 337.332031 L 223.109375 37.496094 Z M 314.597656 37.496094"
                                fill-opacity="1"
                                fill-rule="nonzero"
                            />
                        </g>
                    </g>

                    <g clip-path="url(#b07c821656)">
                        <g clip-path="url(#55959a45ff)">
                            <path
                                fill="currentColor"
                                d="M 146.625 249.945312 L 146.625 37.496094 L 223.117188 37.496094 L 223.117188 249.945312 Z M 146.625 249.945312"
                                fill-opacity="1"
                                fill-rule="nonzero"
                            />
                        </g>
                    </g>

                    <g clip-path="url(#a83aa56b9b)">
                        <g clip-path="url(#1c3af9afe2)">
                            <path
                                fill="currentColor"
                                d="M 177.742188 111.523438 L 177.742188 291.515625 L 112.101562 291.515625 L 112.101562 111.523438 Z M 177.742188 111.523438"
                                fill-opacity="1"
                                fill-rule="nonzero"
                            />
                        </g>
                    </g>

                    <g clip-path="url(#a2157cede2)">
                        <g clip-path="url(#1adccc21aa)">
                            <path
                                fill="currentColor"
                                d="M 60.398438 237.410156 L 60.398438 111.570312 L 112.109375 111.570312 L 112.109375 237.410156 Z M 60.398438 237.410156"
                                fill-opacity="1"
                                fill-rule="nonzero"
                            />
                        </g>
                    </g>
                
                        </svg>
                        <div class="flex flex-col">
                            <span class="text-base sm:text-lg font-extrabold leading-tight text-slate-800 tracking-wide" itemprop="name">PERITO</span>
                            <span class="text-sm sm:text-base font-semibold text-slate-500 tracking-wider">BARCELONA</span>
                        </div>
                    </div>
                    
                    <p class="text-gray-600 text-base leading-relaxed mb-8" itemprop="description">
                        {{ metadata.footer[currentLanguage].brand.description }}
                    </p>
                    
                    <!-- Social links -->
                    <div class="flex gap-4" itemprop="sameAs">
                        <!-- LinkedIn (en negativo) -->
                        <a href="{{ metadata.contact.social.linkedin }}" class="group" aria-label="LinkedIn" target="_blank" rel="noopener">
                            <div class="w-10 h-10 rounded-xl bg-cyan-600 flex items-center justify-center flex-shrink-0 group-hover:bg-cyan-700 transition-colors">
                                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                                    <rect x="2" y="9" width="4" height="12"></rect>
                                    <circle cx="4" cy="4" r="2"></circle>
                                </svg>
                            </div>
                        </a>
                        
                        <!-- Otras redes sociales si existen -->
                        {% for social in metadata.footer[currentLanguage].brand.social %}
                        {% if social.icon != 'linkedin' %}
                        <a href="{{ social.url }}" class="group" aria-label="{{ social.label }}" target="_blank" rel="noopener">
                            <div class="w-10 h-10 rounded-xl bg-cyan-50 flex items-center justify-center flex-shrink-0 group-hover:bg-cyan-100 transition-colors">
                                {% include "icons/" + social.icon + ".svg" ignore missing %}
                            </div>
                        </a>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <!-- Columna Servicios -->
                <div>
                    <h5 class="text-lg font-bold text-slate-800 mb-6 relative after:content-[''] after:absolute after:bottom-[-8px] after:left-0 after:w-12 after:h-0.5 after:bg-cyan-400">
                        {{ metadata.footer[currentLanguage].services.title }}
                    </h5>
                    <ul class="space-y-4">
                        {% for service in metadata.footer[currentLanguage].services.items %}
                        <li>
                            <a href="{{ service.url }}" class="text-gray-600 hover:text-cyan-500 transition-colors flex items-center gap-2 group">
                                <svg class="w-4 h-4 text-cyan-400 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 5l7 7-7 7"/>
                                </svg>
                                {{ service.title }}
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>

                <!-- Columna Contacto -->
                <div>
                    <h5 class="text-lg font-bold text-slate-800 mb-6 relative after:content-[''] after:absolute after:bottom-[-8px] after:left-0 after:w-12 after:h-0.5 after:bg-cyan-400">
                        {{ metadata.footer[currentLanguage].contact.title }}
                    </h5>
                    <div class="space-y-6">
                        {% for item in metadata.footer[currentLanguage].contact.items %}
                        <a href="{{ item.url }}" class="flex items-start gap-3 text-gray-600 hover:text-cyan-500 transition-colors group">
                            {% include "icons/" + item.icon + ".svg" ignore missing %}
                            <div>
                                <span class="block text-sm font-medium text-slate-800 group-hover:text-cyan-500">{{ item.label }}:</span>
                                <span class="text-gray-600 group-hover:text-cyan-500">{{ item.value }}</span>
                            </div>
                        </a>
                        {% endfor %}
                    </div>
                </div>

                <!-- Columna Ubicación -->
                <div>
                    <h5 class="text-lg font-bold text-slate-800 mb-6 relative after:content-[''] after:absolute after:bottom-[-8px] after:left-0 after:w-12 after:h-0.5 after:bg-cyan-400">
                        {{ metadata.footer[currentLanguage].location.title }}
                    </h5>
                    <div class="space-y-6">
                        {% for office in metadata.footer[currentLanguage].location.offices %}
                        <div class="flex items-start gap-3 text-gray-600 group">
                            <div class="w-10 h-10 rounded-xl bg-cyan-50 flex items-center justify-center flex-shrink-0 group-hover:bg-cyan-100 transition-colors">
                                <svg class="w-5 h-5 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="font-medium text-slate-800">{{ office.city }}</p>
                                <p class="text-slate-600">{{ office.address }}, {{ metadata.contact.address.postalCode }} {{ office.city }}, {{ metadata.contact.address.country }}</p>
                                <p class="text-sm text-slate-500 mt-1">{{ office.transport }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Links legales y copyright integrados - Espaciado reducido -->
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 mt-12 pt-6 border-t border-slate-100">
                <p class="text-slate-500 text-sm text-center md:text-left">{{ metadata.footer[currentLanguage].bottom.copyright }}</p>
                <div class="flex flex-wrap justify-center md:justify-end gap-x-4 gap-y-2">
                    <!-- Enlaces legales usando metadata.footer para tener URLs correctas según el idioma -->
                    {% for link in metadata.footer[currentLanguage].bottom.links %}
                        {% if not loop.first %}
                            <span class="text-slate-300">·</span>
                        {% endif %}
                        <a href="{{ link.url }}" class="text-slate-500 text-sm hover:text-cyan-500 transition-colors">{{ link.text }}</a>
                    {% endfor %}
                    
                    <!-- Los enlaces ya están incluidos en el bucle anterior -->
                </div>
            </div>
        </div>
    </div>
</footer>

{% css %}
<style>
/* Optimizaciones de rendimiento para gradientes y efectos */
@media (prefers-reduced-motion: no-preference) {
    .footer-hover-effect {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
}

@media (prefers-reduced-motion: reduce) {
    .footer-hover-effect {
        transition: none;
    }
}
</style>
{% endcss %}
    
