{#
  footer.njk — Footer del sitio (ink background, 4 columnas)
  AGENTES §6: WPFooter + schema-business.njk anidado
  Fuente: SiteChrome.jsx → SiteFooter + FooterCol
  Datos: metadata.json + {lang}.json — CERO texto hardcodeado
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}
{% set _contactPro = "/contacto/profesional/" if (not lang or lang == "es") else ("/en/contact/professional/" if lang == "en" else "/ca/contacte/professional/") %}

{# El hairline superior separa el footer de la sección que lo precede. Sin él, una
   banda CTA oscura (la de /cuadro-de-expertos/, p. ej.) y el footer comparten tono
   y se leen como una sola masa. `--ink-700` es el hairline sobre oscuro que este
   mismo footer ya usa en sus separadores internos: no se introduce color nuevo. #}
<div style="background: var(--ink-900); color: var(--bone-100); border-top: 1px solid var(--ink-700);">
  <div style="max-width: var(--container-wide); margin: 0 auto; padding: 80px var(--gutter) 48px;">
    <div style="display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 48px;" class="footer-grid">

      {# ── Col 1: Marca ── #}
      <div>
        {# Wordmark stacked (Wordmark.jsx tone=light) #}
        <span style="display: inline-flex; flex-direction: column; gap: 6px;">
          <span style="display: inline-flex; align-items: baseline; line-height: 1; font-size: 24px;">
            <span style="font-family: var(--font-serif); font-weight: 500; color: var(--bone-100); letter-spacing: -0.01em;">perito</span><span style="color: var(--accent); font-family: var(--font-serif); font-weight: 600;">.</span><span style="font-family: var(--font-mono); font-weight: 500; color: var(--text-on-dark-muted); font-size: 14.88px; letter-spacing: 0.01em;">barcelona</span>
          </span>
          <span style="font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-on-dark-muted); font-weight: 500;">Peritaje · Ingeniería forense</span>
        </span>
        <p style="margin-top: 22px; max-width: 34ch; color: var(--text-on-dark-muted);
                  font-size: 0.9rem; line-height: 1.6;">
          {{ ui.footer.brand_desc }}
        </p>
        <div style="display: flex; gap: 8px; margin-top: 22px; flex-wrap: wrap;">
          {% for cred in metadata.credentials %}
          <span style="display: inline-flex; align-items: center; font-family: var(--font-mono);
                       font-weight: var(--fw-medium); letter-spacing: var(--tracking-label);
                       text-transform: uppercase; line-height: 1.2; border-radius: var(--radius-xs);
                       font-size: var(--fs-mono-label); padding: 4px 9px;
                       color: var(--text-on-dark-muted); border: 1px solid var(--ink-700);
                       background: transparent;">
            {{ cred.name }}
          </span>
          {% endfor %}
        </div>
      </div>

      {# ── Col 2: Dictámenes ── #}
      {% set fSvcHub = "/informes-pericials/" if lang == "ca" else ("/expert-witness-reports/" if lang == "en" else "/informes-periciales/") %}
      {# ES dictamen pages now live at root (/{slug}/); the catalog link still points to the /informes-periciales/ hub. #}
      {% set fSvcBase = "/" %}{# páginas de servicio PLANAS en los tres idiomas; la forma anidada 301ea (mismo bug que se corrigió en nav.njk el 30/08) #}
      <div>
        <div style="font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em;
                    text-transform: uppercase; color: var(--text-on-dark-muted); margin-bottom: 18px;">
          {{ ui.footer.col_dictamenes }}
        </div>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px;">
          {% for svc in metadata.services %}{% if svc.cat == "Patologías" or svc.cat == "Informes periciales" %}
          {% set fSlug = svc["path_" + lang] if svc["path_" + lang] else svc.path %}
          {% set fName = svc["name_" + lang] if svc["name_" + lang] else svc.name %}
          <li><a href="{{ langPrefix + fSvcBase + fSlug + '/' }}"
                 style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ fName }}</a></li>
          {% endif %}{% endfor %}
          <li><a href="{{ langPrefix + fSvcHub }}"
                 style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ ui.footer.ver_catalogo }}</a></li>
        </ul>
      </div>

      {# ── Col 3: Despacho ── #}
      {% set fConstruccion = "/construccio/" if lang == "ca" else ("/construction-expert/" if lang == "en" else "/construccion/") %}
      {% set fCasos = "/casos-exit/" if lang == "ca" else ("/success-cases/" if lang == "en" else "/casos-exito/") %}
      {% set fAbogados = "/collaboracio-advocats/" if lang == "ca" else ("/lawyer-collaboration/" if lang == "en" else "/colaboracion-abogados/") %}
      {% set fHonorarios = "/honoraris/" if lang == "ca" else ("/fees/" if lang == "en" else "/honorarios-perito-judicial-barcelona/") %}
      {% set fDespacho = "/el-despatx/" if lang == "ca" else ("/the-firm/" if lang == "en" else "/el-despacho/") %}
      {% set fExpertos = "/quadre-experts/" if lang == "ca" else ("/expert-panel/" if lang == "en" else "/cuadro-de-expertos/") %}
      <div>
        <div style="font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em;
                    text-transform: uppercase; color: var(--text-on-dark-muted); margin-bottom: 18px;">
          {{ ui.footer.col_despacho }}
        </div>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px;">
          <li><a href="{{ langPrefix + fConstruccion }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ ui.footer.perito_construccion }}</a></li>
          <li><a href="{{ langPrefix + fCasos }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ ui.footer.casos_ratificados }}</a></li>
          <li><a href="{{ langPrefix + fAbogados }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ ui.footer.abogados_seguros }}</a></li>
          <li><a href="{{ langPrefix + fHonorarios }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ ui.nav.honorarios }}</a></li>
          <li><a href="{{ langPrefix + fExpertos }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ ui.footer.cuadro_expertos }}</a></li>
          <li><a href="{{ langPrefix + fDespacho }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ ui.footer.el_despacho }}</a></li>
        </ul>
      </div>

      {# ── Col 4: Contacto ── #}
      {% set fContacto = _contactPro %}
      <div>
        <div style="font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em;
                    text-transform: uppercase; color: var(--text-on-dark-muted); margin-bottom: 18px;">
          {{ ui.footer.col_contacto }}
        </div>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px;">
          <li><a href="{{ fContacto }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ ui.nav.solicitar }}</a></li>
          <li><a href="{{ fContacto }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ ui.footer.primera_consulta }}</a></li>
          <li><a href="tel:{{ metadata.contact.phoneNumber | replace(' ', '') }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ metadata.contact.phoneNumber | replace('+34 ', '') }}</a></li>
          <li><a href="mailto:{{ metadata.company.email }}" style="color: var(--bone-100); font-size: 0.9rem; opacity: 0.82;">{{ metadata.company.email }}</a></li>
        </ul>
      </div>
    </div>

    {# ── Red profesional (referral entre marcas — enlace de marca, no keyword) ── #}
    <div class="red-marcas" style="margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--ink-700);
                display: flex; gap: 16px; flex-wrap: wrap; align-items: center;
                font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em;
                text-transform: uppercase; color: var(--text-on-dark-muted);">
      <span style="opacity: 0.7;">{{ ui.footer.red_profesional }}</span>
      <a href="https://refuerzofibra.es" style="color: var(--bone-100); opacity: 0.82;">refuerzofibra.es</a>
      <span style="opacity: 0.4;">·</span>
      <a href="https://urbenis.com" style="color: var(--bone-100); opacity: 0.82;">urbenis.com</a>
    </div>

    {# ── Bottom bar ── #}
    {% set fLegal = "/avis-legal/" if lang == "ca" else ("/legal-notice/" if lang == "en" else "/aviso-legal/") %}
    {% set fPriv = "/privadesa/" if lang == "ca" else ("/privacy/" if lang == "en" else "/privacidad/") %}
    <div style="margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--ink-700);
                display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
                font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em;
                text-transform: uppercase; color: var(--text-on-dark-muted);">
      <span>{{ ui.footer.copyright }}</span>
      <span>
        <a href="{{ langPrefix + fLegal }}" style="color: inherit;">{{ ui.footer.aviso_legal }}</a>
        ·
        <a href="{{ langPrefix + fPriv }}" style="color: inherit;">{{ ui.footer.privacidad }}</a>
      </span>
    </div>
  </div>

  {# ── Schema de negocio (partial reutilizable) ── #}
  {% include "partials/schema-business.njk" %}
</div>
