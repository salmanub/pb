<div class="flex flex-col items-center md:items-center lg:items-start w-full lg:w-[70%] space-y-10 md:space-y-12 lg:space-y-16 mx-auto lg:mx-0">
    {# Tag y título #}
    <div class="w-full mb-8 md:mb-10">
        {% if hero.tag %}
        <h1 class="flex justify-center md:justify-start items-center text-sm font-semibold tracking-[2px] uppercase text-cyan-600 mb-6" itemprop="headline">
            <span class="hidden lg:block w-8 h-0.5 bg-cyan-600 mr-3"></span>
            {{ hero.tag }}
        </h1>
        {% endif %}

        <div class="text-center md:text-left">
            <div class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] xl:text-[3.5rem] font-light leading-[1.1] tracking-tight uppercase text-slate-900" itemprop="description">
                {{ hero.title | safe }}
                {% if hero.strong %}
                <strong class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600 font-bold">{{ hero.strong }}</strong>
                {% endif %}
                {% if hero.subtitle %}
                <div class="text-2xl md:text-3xl mt-4 normal-case font-normal text-slate-600">
                    {{ hero.subtitle }}
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Descripción y CTA #}
    <div class="w-full max-w-2xl lg:max-w-3xl mb-8 lg:mb-12">
        {% if hero.description %}
        <p class="text-lg md:text-xl text-slate-600 mb-8 font-light leading-relaxed">{{ hero.description }}</p>
        {% endif %}
        
        {# CTAs #}
        <div class="flex flex-col sm:flex-row gap-3 md:gap-4">
            <a href="{{ hero.cta.primaryUrl }}" 
               class="flex-1 inline-flex items-center justify-center px-4 sm:px-8 py-4 bg-slate-900 text-white font-semibold uppercase tracking-wider rounded-lg shadow-lg hover:bg-black transition-all duration-300 text-sm sm:text-base whitespace-nowrap">
                {{ hero.cta.primary }}
            </a>
            <a href="tel:{{ metadata.contact.phoneNumber }}" 
               class="flex-1 inline-flex items-center justify-center px-4 sm:px-8 py-4 border-2 border-slate-200 text-slate-900 font-semibold uppercase tracking-wider rounded-lg hover:border-cyan-500 hover:text-cyan-600 transition-all duration-300 text-sm sm:text-base whitespace-nowrap">
                <svg class="w-5 h-5 mr-2 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                {{ hero.cta.secondary }}
            </a>
        </div>
    </div>
</div>
