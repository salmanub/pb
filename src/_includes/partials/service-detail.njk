<div class="service-detail {{ 'flex-row-reverse' if service.order == 'reversed' }} {{ additionalClasses }}">
  <div class="service-content">
    <h2 class="service-title">{{ service.title }}</h2>
    <p class="service-description">{{ service.description }}</p>
    <ul class="service-features">
      {% for feature in service.features %}
        <li>{{ feature }}</li>
      {% endfor %}
    </ul>
    {% if service.cta_text and service.url %}
      <div class="service-cta">
        <a href="{{ service.url }}" class="cta-button">{{ service.cta_text }}</a>
      </div>
    {% endif %}
  </div>
  <div class="service-image">
    <img src="{{ service.image }}" alt="{{ service.title }}">
  </div>
  
  {% if service.urbenis_cta and service.urbenis_cta.show %}
    <div class="mt-6 flex justify-start">
      <a href="{{ service.urbenis_cta.url }}" 
         target="_blank"
         rel="noopener"
         class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-medium rounded-lg hover:from-emerald-700 hover:to-emerald-600 transition-all">
        <span>{{ service.urbenis_cta.text }}</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  {% endif %}
</div>