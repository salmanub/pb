<section class="py-20 px-4 md:px-[5%] bg-white relative" itemprop="mentions" itemscope itemtype="https://schema.org/Blog">
    {# Calcular la fecha del artículo más reciente #}
    {% if posts and posts.length > 0 %}
        {% set sortedPosts = posts | sort(attribute='datePublished') | reverse %}
        {% set latestPost = sortedPosts[0] %}
        <meta itemprop="dateModified" content="{{ latestPost.datePublished }}T00:00:00+01:00">
        <meta itemprop="datePublished" content="{{ latestPost.datePublished }}T00:00:00+01:00">
    {% endif %}
    
    {# Contenido Principal #}
    <div class="relative z-10 max-w-[1400px] mx-auto">
        {# Header de la sección #}
        <div class="text-center mb-16">
            <div class="inline-flex flex-col items-center">
                <span class="badge badge-primary mb-6">BLOG TÉCNICO</span>
                <h2 class="section-title" itemprop="headline">
                    Artículos y Guías <br>
                    <span class="text-teal-400 font-normal">Sobre Peritajes</span>
                </h2>
                <p class="section-subtitle">
                    Informes técnicos detallados y guías legales sobre construcción y edificación.
                </p>
            </div>
        </div>

        {# Grid de Posts del Blog #}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
            {% if posts and posts.length > 0 %}
                {% set sortedPosts = posts | sort(attribute='datePublished') | reverse %}
                {% for post in sortedPosts %}
                    {% if loop.index0 < 2 and (not post.estado or post.estado == "publicado") %}
                    <article class="card-avant group p-0 flex flex-col h-full" itemscope itemtype="https://schema.org/BlogPosting">
                        <a href="/blog/{{ post.slug }}/" class="flex flex-col flex-grow relative z-20" itemprop="url">
                            {% set imgSrc = post.image.url if post.image else metadata.site.placeholderImage %}
                            {% set imgPath = imgSrc | replace(".jpg", "") | replace(".jpeg", "") | replace(".png", "") | replace(".JPG", "") | replace(".JPEG", "") | replace(".PNG", "") %}
                            {% set imgRelativePath = imgPath.split("/assets/images/")[1] if "/assets/images/" in imgPath else imgPath %}
                            {% set imgBasePath = "/assets/images/" + imgRelativePath %}
                            
                            <div class="overflow-hidden h-48 relative">
                                <div class="absolute inset-0 bg-slate-900/5 group-hover:bg-transparent transition-colors z-10"></div>
                                <picture>
                                    <source srcset="{{ imgBasePath }}-320w.avif 320w, {{ imgBasePath }}-480w.avif 480w" sizes="(max-width: 640px) 100vw, 400px" type="image/avif">
                                    <source srcset="{{ imgBasePath }}-320w.webp 320w, {{ imgBasePath }}-480w.webp 480w" sizes="(max-width: 640px) 100vw, 400px" type="image/webp">
                                    <source srcset="{{ imgBasePath }}-320w.jpg 320w, {{ imgBasePath }}-480w.jpg 480w" sizes="(max-width: 640px) 100vw, 400px" type="image/jpeg">
                                    <img src="{{ imgBasePath }}-480w.jpg" alt="{{ post.image.alt if post.image else 'Imagen del artículo' }}" class="w-full h-full object-cover transition-opacity duration-500 hover:opacity-90" loading="lazy" width="400" height="192" itemprop="image">
                                </picture>
                            </div>

                            <div class="p-8 flex flex-col flex-grow">
                                <div class="mb-4 flex items-center justify-between">
                                    <span class="badge bg-slate-100 text-slate-600 border border-slate-200" itemprop="articleSection">{{ post.category }}</span>
                                    <time datetime="{{ post.datePublished }}T00:00:00+01:00" class="text-xs text-slate-400 font-medium" itemprop="datePublished">{{ post.datePublished }}</time>
                                </div>
                                <h3 class="text-xl font-light uppercase text-slate-900 mb-3 line-clamp-2 group-hover:text-teal-600 transition-colors" itemprop="headline">{{ post.title }}</h3>
                                <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-grow line-clamp-3" itemprop="description">{{ post.excerpt }}</p>
                                
                                <div class="inline-flex items-center text-teal-600 hover:text-teal-700 font-semibold group mt-auto">
                                    Leer artículo
                                    <svg class="w-5 h-5 ml-2 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                    </svg>
                                </div>
                            </div>
                        </a>
                    </article>
                    {% endif %}
                {% endfor %}
            {% endif %}

            {# Card de "Ver más blog" Refactored to Light Theme #}
            <div class="group h-full">
                <a href="/blog/" class="flex flex-col items-center justify-center bg-slate-50 border border-slate-200 rounded-none p-8 text-center h-full hover:border-teal-200 hover:shadow-xl hover:shadow-slate-200/50 transition-all duration-300 relative overflow-hidden group/more">
                     <div class="absolute inset-0 bg-grid-pattern opacity-[0.3]"></div>
                     <div class="relative z-10 flex flex-col items-center">
                        <div class="w-16 h-16 rounded-none bg-white border border-slate-100 flex items-center justify-center mb-6 shadow-sm group-hover/more:scale-110 group-hover/more:border-teal-100 transition-all">
                            <svg class="w-8 h-8 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                            </svg>
                        </div>
                        <h3 class="text-2xl font-light uppercase text-slate-900 mb-3">Biblioteca Técnica</h3>
                        <p class="text-slate-500 mb-8 max-w-xs">Acceda a nuestra colección completa de casos de éxito y normativas.</p>
                        <span class="btn-secondary">
                            Ver Todo
                        </span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>
