<header class="min-h-[100vh] lg:min-h-[auto] bg-white text-slate-900 py-20 lg:py-32 flex items-center overflow-hidden border-b border-slate-100 mt-[70px]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-[5%] grid lg:grid-cols-[1.2fr_0.8fr] gap-12 lg:gap-16 items-center w-full">
        <div class="flex flex-col gap-8 max-w-[650px] lg:max-w-none mx-auto lg:mx-0 text-center lg:text-left">
            <span class="inline-flex py-3 px-5 bg-cyan-50 border border-cyan-100 rounded-full text-sm font-bold text-cyan-700 w-fit mx-auto lg:mx-0">
                N°1 EN PERITAJES CONSTRUCCIÓN
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight text-slate-900">
                Informes Periciales
                <strong class="block text-cyan-600 mt-2">Que Ganan Casos</strong>
            </h1>
            <div class="flex justify-center lg:justify-start gap-8 my-2">
                <div class="text-lg text-slate-600">
                    <strong class="block text-3xl font-extrabold text-cyan-600 leading-none mb-1">97%</strong> Casos Ganados
                </div>
                <div class="text-lg text-slate-600">
                    <strong class="block text-3xl font-extrabold text-cyan-600 leading-none mb-1">24h</strong> Respuesta
                </div>
            </div>
            <p class="text-xl leading-relaxed text-slate-600">
                Soluciones técnicas garantizadas para litigios complejos en construcción y seguros. Máxima efectividad.
            </p>
            <div class="flex flex-col gap-4 items-center lg:items-start">
                <a href="#contacto" class="inline-flex items-center gap-3 px-8 py-5 bg-slate-900 text-white font-bold rounded-xl hover:bg-black hover:-translate-y-0.5 transition-all shadow-xl shadow-slate-200/50">
                    SOLICITAR INFORME AHORA
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <span class="text-sm font-medium text-cyan-600">✓ Primera consulta gratuita</span>
            </div>
        </div>

        <picture class="relative rounded-2xl overflow-hidden shadow-2xl shadow-slate-200 lg:h-full block w-full max-w-[600px] mx-auto lg:max-w-none">
            <source 
                media="(min-width: 992px)"
                srcset="/assets/images/perito-construccion-obra-edificacion-1280.avif"
            >
            <source 
                media="(min-width: 768px)"
                srcset="/assets/images/perito-construccion-obra-edificacion-768.avif"
            >
            <img
                src="/assets/images/perito-construccion-obra-edificacion-640.avif"
                alt="Perito experto realizando inspección técnica"
                loading="eager"
                decoding="async"
                class="w-full h-auto lg:h-full object-cover"
            >
        </picture>
    </div>
</header>
