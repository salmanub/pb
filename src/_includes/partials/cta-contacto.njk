<section class="py-24 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden">
    <!-- Overlay decorativo con gradientes -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-50/30 via-transparent to-slate-100/20"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(0,0,0,.02)_0%,transparent_50%)] mix-blend-overlay"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/50 to-transparent"></div>
    </div>
    
    <div class="max-w-[1400px] mx-auto relative z-10">
        <!-- Grid de contenido -->
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
            <!-- Columna de información -->
            <div>
                <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6 leading-tight">
                    {{ contactCTA.titulo }} <strong class="text-cyan-500 font-bold">{{ contactCTA.highlight }}</strong>
                </h2>
                <p class="text-xl text-slate-600 mb-12">{{ contactCTA.descripcion }}</p>

                <!-- Información de contacto -->
                <div class="space-y-8">
                    {% for contacto in contactCTA.contactInfo %}
                    <div class="flex items-start gap-4 group">
                        <div class="w-12 h-12 rounded-xl bg-cyan-50 flex items-center justify-center flex-shrink-0 group-hover:bg-cyan-100 transition-colors">
                            {% include "icons/" + contacto.icon + ".svg" ignore missing %}
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-slate-800 mb-1">{{ contacto.titulo }}</h3>
                            <a href="{{ contacto.url }}" class="text-2xl font-bold text-cyan-500 hover:text-cyan-600 transition-colors">{{ contacto.valor }}</a>
                            <p class="text-slate-600 mt-2">{{ contacto.horario }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Formulario de contacto optimizado -->
            <div class="bg-white p-6 lg:p-8 rounded-2xl shadow-lg">
                <form id="cta-contacto-form" class="space-y-3" method="POST">
                    <!-- Campos principales en grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label for="nombre" class="block text-sm font-medium text-slate-700 mb-1">{{ contactCTA.form.campos[0].label }}</label>
                            <input type="text" id="nombre" name="nombre" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all text-sm" required>
                        </div>
                        <div>
                            <label for="telefono" class="block text-sm font-medium text-slate-700 mb-1">{{ contactCTA.form.campos[2].label }}</label>
                            <input type="tel" id="telefono" name="telefono" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all text-sm" required>
                        </div>
                    </div>

                    <!-- Email en línea completa -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-slate-700 mb-1">{{ contactCTA.form.campos[1].label }}</label>
                        <input type="email" id="email" name="email" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all text-sm" required>
                    </div>

                    <!-- Textarea optimizado -->
                    <div>
                        <label for="mensaje" class="block text-sm font-medium text-slate-700 mb-1">{{ contactCTA.form.campos[3].label }}</label>
                        <textarea id="mensaje" name="mensaje" rows="3" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all text-sm resize-none" required></textarea>
                    </div>

                    <!-- Botón submit con mejor espaciado -->
                    <button type="submit" class="w-full mt-2 bg-cyan-500 text-white font-semibold py-3 px-6 rounded-lg hover:bg-cyan-600 transition-colors flex items-center justify-center gap-2">
                        {{ contactCTA.form.submitText }}
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </button>

                    <!-- Notificaciones más compactas -->
                    <div id="cta-contacto-msg" class="hidden mt-4">
                        <div class="flex items-center gap-2 p-3 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm">
                            <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            <span>{{ contactCTA.form.successMessage }}</span>
                        </div>
                    </div>
                    <div id="cta-contacto-error" class="hidden mt-4">
                        <div class="flex items-center gap-2 p-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm">
                            <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                            <span>{{ contactCTA.form.errorMessage }}</span>
                        </div>
                    </div>
                </form>
                <script>
                    const form = document.getElementById('cta-contacto-form');
                    const msg = document.getElementById('cta-contacto-msg');
                    const error = document.getElementById('cta-contacto-error');
                    form.addEventListener('submit', async function(e) {
                        e.preventDefault();
                        msg.classList.add('hidden');
                        error.classList.add('hidden');
                        const data = new FormData(form);
                        try {
                            await fetch('https://hook.eu2.make.com/76yaogaunrc9cqdtf26ldcoxb3fpndma', {
                                method: 'POST',
                                body: data
                            });
                            msg.classList.remove('hidden');
                            form.reset();
                        } catch (err) {
                            error.classList.remove('hidden');
                        }
                    });
                </script>
            </div>
        </div>
    </div>
</section>
