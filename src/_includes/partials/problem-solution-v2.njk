<section class="py-28 px-4 md:px-[5%] bg-gradient-to-br from-slate-50 to-white relative overflow-hidden">
    <div class="max-w-[1400px] mx-auto relative z-10">

        <!-- Encabezado -->
        <div class="max-w-4xl mx-auto mb-16 text-center">
            <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6 leading-tight">
                {{ ayuda.encabezado.title }} <strong class="text-cyan-500 font-bold">{{ ayuda.encabezado.highlight }}</strong>?
            </h2>
            <p class="text-xl text-slate-600 max-w-3xl mx-auto">
                {{ ayuda.encabezado.subtitle }}
            </p>
        </div>

        <!-- Introducción -->
        <div class="mb-12">
            <h3 class="text-2xl font-semibold text-slate-700 mb-8 text-center md:text-left">
                {{ ayuda.introduccion.title }}
            </h3>
        </div>

        <!-- Grid de problemas -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for problema in ayuda.problemas %}
            <a href="{{ problema.url }}" class="block bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 group">
                <div class="w-12 h-12 rounded-lg bg-cyan-500/10 flex items-center justify-center mb-4">
                    {% if problema.icon %}
                        {% include "icons/" + problema.icon + ".svg" ignore missing %}
                    {% else %}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    {% endif %}
                </div>
                <h3 class="text-xl font-semibold text-cyan-700 mb-2">{{ problema.title }}</h3>
                <p class="text-sm text-slate-600">{{ problema.description }}</p>
            </a>
            {% endfor %}
        </div>

    </div>
</section>
