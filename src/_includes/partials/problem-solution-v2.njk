<section class="relative py-28 px-4 md:px-[5%] bg-gradient-to-br from-slate-50 to-white overflow-hidden isolate">
    <!-- Decorative backgrounds -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,slate-200_1px,transparent_1px)] [background-size:48px_48px] opacity-[0.15]"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-50/40 via-transparent to-slate-100/30"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-200/20 blur-3xl rounded-full"></div>
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">
        <!-- Header -->
        <header class="max-w-4xl mx-auto mb-16 text-center">
            <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6 leading-tight">
                {{ ayuda.encabezado.title }} <strong class="text-cyan-500 font-bold">{{ ayuda.encabezado.highlight }}</strong>?
            </h2>
            <p class="text-xl text-slate-600 max-w-3xl mx-auto">
                {{ ayuda.encabezado.subtitle }}
            </p>
        </header>

        <!-- Grid de problemas mejorado -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for problema in ayuda.problemas %}
            <a href="{{ problema.url }}" class="group/card relative block bg-gradient-to-br from-white to-slate-50/80 p-6 pb-20 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-500 overflow-hidden isolate">
                <!-- Hover background effect -->
                <div class="absolute inset-0 bg-gradient-to-br from-cyan-50 to-white opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>
                
                <div class="relative z-10">
                    <div class="w-12 h-12 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-6 group-hover/card:scale-110 group-hover/card:bg-cyan-500/20 transition-all duration-500">
                        {% if problema.icon %}
                            {% include "icons/" + problema.icon + ".svg" ignore missing %}
                        {% endif %}
                    </div>
                    <h3 class="text-xl font-semibold text-slate-800 group-hover/card:text-cyan-600 transition-colors mb-3">{{ problema.title }}</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">{{ problema.description }}</p>
                </div>
                
                <!-- Botón de CTA con texto localizado -->
                <div class="absolute bottom-6 right-6 flex items-center gap-2 text-cyan-400 group-hover/card:text-cyan-500 transition-colors">
                    <span class="text-sm font-medium opacity-0 translate-x-4 group-hover/card:opacity-100 group-hover/card:translate-x-0 transition-all duration-300">{{ ayuda.cta }}</span>
                    <div class="w-8 h-8 rounded-full bg-cyan-50 flex items-center justify-center group-hover/card:bg-cyan-100 transition-all duration-300">
                        <svg class="w-4 h-4 group-hover/card:scale-110 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                        </svg>
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
