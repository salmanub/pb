<section class="relative py-28 md:py-36 px-6 md:px-12 lg:px-16 bg-white overflow-hidden isolate border-b border-slate-100">
    <!-- Decorative backgrounds -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
        <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-white to-transparent"></div>
    </div>

    <div class="w-full relative z-10">
        <!-- Header -->
        <header class="max-w-4xl mx-auto mb-20 text-center animate-in fade-in slide-in-from-bottom-8 duration-700 delay-100">
            <h2 class="text-5xl md:text-7xl font-light text-slate-900 mb-8 leading-[0.9] tracking-tighter uppercase">
                {{ ayuda.encabezado.title }} <span class="text-teal-400 font-normal">{{ ayuda.encabezado.highlight }}</span>?
            </h2>
            <p class="text-xl md:text-2xl text-slate-500 max-w-2xl mx-auto font-light leading-relaxed">
                {{ ayuda.encabezado.subtitle }}
            </p>
        </header>

        <!-- Grid de problemas mejorado -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for problema in ayuda.problemas %}
            <a href="{{ problema.url }}" class="group/card relative block bg-white p-10 pb-24 rounded-[2rem] shadow-xl shadow-slate-200/40 hover:shadow-2xl hover:shadow-teal-900/10 transition-all duration-500 overflow-hidden isolate border border-slate-100/80 hover:border-teal-100 hover:-translate-y-2 animate-in fade-in slide-in-from-bottom-4" style="animation-delay: {{ loop.index * 150 }}ms">
                <!-- Hover background effect -->
                <div class="absolute inset-0 bg-gradient-to-br from-teal-50/50 to-transparent opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>
                
                <div class="relative z-10">
                    <div class="w-16 h-16 rounded-none bg-slate-50 flex items-center justify-center mb-8 group-hover/card:scale-110 group-hover/card:bg-teal-500 group-hover/card:text-white transition-all duration-500 shadow-sm border border-slate-100">
                        {% if problema.icon %}
                            <div class="w-8 h-8 flex items-center justify-center text-teal-600 group-hover/card:text-white transition-colors duration-500">
                                {% include "icons/" + problema.icon + ".svg" ignore missing %}
                            </div>
                        {% endif %}
                    </div>
                    <h3 class="text-2xl font-light uppercase text-slate-900 group-hover/card:text-teal-600 transition-colors mb-4 tracking-tight leading-tight">{{ problema.title }}</h3>
                    <p class="text-slate-500 text-lg leading-relaxed font-light group-hover/card:text-slate-600 transition-colors">{{ problema.description }}</p>
                </div>
                
                <!-- Botón de CTA con texto localizado -->
                <div class="absolute bottom-8 right-8 flex items-center gap-3">
                    <span class="text-sm font-bold uppercase tracking-widest text-teal-600 opacity-0 -translate-x-4 group-hover/card:opacity-100 group-hover/card:translate-x-0 transition-all duration-500 delay-75">{{ ayuda.cta }}</span>
                    <div class="w-10 h-10 rounded-none bg-slate-100 flex items-center justify-center group-hover/card:bg-teal-500 group-hover/card:text-white transition-all duration-500 shadow-md">
                        <svg class="w-5 h-5 group-hover/card:-rotate-45 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
