<header class="relative mt-[70px] lg:mt-[90px] h-auto lg:min-h-[85vh] bg-gradient-to-br from-[#0B1030] to-[#1a2452] text-white overflow-hidden">
    <div class="relative z-10 w-full h-auto lg:h-[85vh] flex items-center">
        <div class="w-full px-4 sm:px-8 md:px-12 lg:px-0 md:w-[95%] max-w-[1400px] md:mx-auto lg:ml-[5%] py-8 md:py-12 lg:py-8">
            <!-- Hero Content -->
            <div class="flex flex-col items-center md:items-center lg:items-start w-full lg:w-[70%] space-y-10 md:space-y-12 lg:space-y-16 mx-auto lg:mx-0">
                <!-- Tag y título -->
                <div class="w-full mb-8 md:mb-10">
                    <h1 class="flex justify-center md:justify-start items-center text-sm font-semibold tracking-[2px] uppercase text-teal-400 mb-6" itemprop="headline">
                        <span class="hidden lg:block w-8 h-0.5 bg-teal-400 mr-3"></span>
                        {{ hero.tag }}
                    </h1>

                    <div class="text-center md:text-left">
                        <div class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] xl:text-[3.5rem] font-light leading-[1.1] tracking-tight uppercase" itemprop="description">
                            {{ hero.title | safe }}
                            {% if hero.strong %}
                            <strong class="text-teal-400">{{ hero.strong }}</strong>
                            {% endif %}
                            {% if hero.subtitle %}
                            <div class="text-2xl md:text-3xl mt-4 normal-case font-normal">
                                {{ hero.subtitle }}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Descripción y CTA -->
                <div class="w-full max-w-2xl lg:max-w-3xl mb-8 lg:mb-12">
                    {% if hero.description %}
                    <p class="text-lg md:text-xl text-slate-300 mb-8">{{ hero.description }}</p>
                    {% endif %}
                    
                    <!-- CTAs -->
                    <div class="flex flex-col sm:flex-row gap-3 md:gap-4">
                        <a href="{{ hero.cta.primaryUrl }}" 
                           class="flex-1 inline-flex items-center justify-center px-4 sm:px-8 py-4 bg-teal-400 text-white font-semibold uppercase tracking-wider rounded-none shadow-lg hover:bg-teal-500 transition-all duration-300 text-sm sm:text-base whitespace-nowrap">
                            {{ hero.cta.primary }}
                        </a>
                        <a href="tel:{{ metadata.contact.phoneNumber }}" 
                           class="flex-1 inline-flex items-center justify-center px-4 sm:px-8 py-4 border-2 border-teal-400 text-teal-400 font-semibold uppercase tracking-wider rounded-none hover:bg-teal-400/10 transition-all duration-300 text-sm sm:text-base whitespace-nowrap">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                            {{ hero.cta.secondary }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hero Image -->
    {% if hero.image %}
    <div class="hidden lg:block absolute top-0 right-0 w-[45%] h-full z-[1]">
        <picture class="h-full">
            <img src="{{ hero.image }}"
                 alt="{{ hero.title }}"
                 class="w-full h-full object-cover opacity-80"
                 style="clip-path: polygon(150px 0, 100% 0, 100% 100%, 50px 100%);"
                 loading="eager"
                 width="100%"
                 height="100%"
                 decoding="async">
        </picture>
    </div>
    {% endif %}

    <!-- Scroll Indicator -->
    <div class="hidden lg:flex flex-col items-center absolute bottom-8 left-1/2 -translate-x-1/2 z-20 animate-bounce">
        <span class="text-white/60 text-sm mb-2">{{ hero.cta.descubreMas }}</span>
        <svg class="w-6 h-6 text-teal-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
    </div>
</header>

{% if hero.image %}
<!-- Hero Image - Mobile -->
<div class="lg:hidden relative w-full h-[300px]">
    <img src="{{ hero.image }}"
         alt="{{ hero.title }}"
         class="w-full h-full object-cover opacity-80"
         loading="eager"
         decoding="async">
</div>
{% endif %}
