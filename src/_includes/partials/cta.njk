<section class="relative py-20 bg-gradient-to-br from-slate-900 to-slate-800 text-white overflow-hidden">
    <div class="container relative z-10">
        <div class="max-w-4xl mx-auto text-center">
            {% if cta.title %}
            <h2 class="text-3xl md:text-4xl font-bold mb-6">{{ cta.title }}</h2>
            {% endif %}
            
            {% if cta.description %}
            <p class="text-lg text-slate-300 mb-10">{{ cta.description | safe }}</p>
            {% endif %}
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                {% if cta.button_text %}
                <a href="{{ cta.button_url }}" 
                   class="inline-flex items-center justify-center px-8 py-4 bg-cyan-400 text-white font-semibold uppercase tracking-wider rounded-lg shadow-lg hover:bg-cyan-500 transition-all duration-300">
                    {{ cta.button_text }}
                </a>
                {% endif %}
                
                <a href="tel:{{ metadata.contact.phoneNumber }}" 
                   class="inline-flex items-center justify-center px-8 py-4 border-2 border-cyan-400 text-cyan-400 font-semibold uppercase tracking-wider rounded-lg hover:bg-cyan-400/10 transition-all duration-300">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    Llamar ahora
                </a>
            </div>
        </div>
    </div>

    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
                <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"/>
            </pattern>
            <rect width="100%" height="100%" fill="url(#grid)"/>
        </svg>
    </div>
</section>
