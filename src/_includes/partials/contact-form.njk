{% set formLang = currentLanguage or lang or 'es' %}
<div id="typeform-wrapper" class="flex flex-col h-full font-onest">
    <div class="text-center mb-10">
        <h3 class="text-3xl lg:text-4xl font-black text-slate-900 mb-3 tracking-tight">{{ metadata.ctaForm[formLang].formTitle }}</h3>
        <p class="text-lg text-slate-600 font-light max-w-lg mx-auto leading-relaxed">{{ metadata.ctaForm[formLang].formSubtitle }}</p>
    </div>
    <div id="typeform-container" class="flex-grow flex flex-col justify-between relative min-h-[400px]">
        <div id="typeform-steps-container">
            
            <div class="typeform-step active space-y-8" data-step="area-interes">
                <div class="space-y-4 mb-8">
                    <p class="step-counter text-sm font-bold tracking-widest text-slate-500 uppercase"></p>
                    <h3 id="label-area" class="text-2xl md:text-3xl font-light text-slate-900 leading-tight">{{ metadata.ctaForm[formLang].questions.areaInteres.title }}</h3>
                </div>
                <div class="space-y-3">
                    {% for option in metadata.ctaForm[formLang].questions.areaInteres.options %}
                    <button type="button" data-value="{{ option.value }}" class="area-interes-option w-full px-6 py-5 text-left bg-white hover:bg-slate-50 border border-slate-200 hover:border-slate-300 rounded-2xl transition-all duration-300 group focus:outline-none focus:ring-2 focus:ring-slate-900/10 shadow-sm hover:shadow-md">
                        <div class="flex items-center justify-between">
                            <span class="text-lg font-medium text-slate-700 group-hover:text-slate-900 transition-colors">{{ option.label }}</span>
                            <span class="w-6 h-6 rounded-full border border-slate-300 group-hover:border-slate-900 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300">
                                <svg class="w-3 h-3 text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            </span>
                        </div>
                    </button>
                    {% endfor %}
                </div>
            </div>

            <div class="typeform-step hidden space-y-8" data-step="mensaje">
                <div class="space-y-4 mb-8">
                    <p class="step-counter text-sm font-bold tracking-widest text-slate-500 uppercase"></p>
                    <h3 id="label-mensaje" class="text-2xl md:text-3xl font-light text-slate-900 leading-tight">{{ metadata.ctaForm[formLang].questions.mensaje.title }}</h3>
                </div>
                <textarea id="mensaje" aria-labelledby="label-mensaje" name="mensaje" rows="4" class="w-full px-6 py-5 text-xl bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 outline-none transition-all duration-300 resize-none shadow-sm placeholder-slate-400 text-slate-800" required placeholder="{{ metadata.ctaForm[formLang].helpText.mensaje }}"></textarea>
                
                <div class="flex justify-between items-center pt-4">
                    <button type="button" class="typeform-prev group px-4 py-2 text-slate-500 hover:text-slate-700 transition-colors flex items-center gap-2 text-sm font-medium">
                        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        {{ metadata.contactForm[formLang].buttons.prev }}
                    </button>
                    <button type="button" class="typeform-next px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-black transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5 flex items-center gap-3">
                        {{ metadata.contactForm[formLang].buttons.next }}
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <div class="typeform-step hidden space-y-8" data-step="nombre">
                <div class="space-y-4 mb-8">
                    <p class="step-counter text-sm font-bold tracking-widest text-slate-500 uppercase"></p>
                    <h3 id="label-nombre" class="text-2xl md:text-3xl font-light text-slate-900 leading-tight">{{ metadata.ctaForm[formLang].questions.nombre.title }}</h3>
                </div>
                <input type="text" id="nombre" aria-labelledby="label-nombre" name="nombre" class="w-full px-6 py-5 text-xl bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 outline-none transition-all duration-300 shadow-sm placeholder-slate-400 text-slate-800" required placeholder="{{ metadata.ctaForm[formLang].helpText.nombre }}">
                
                <div class="flex justify-between items-center pt-4">
                        <button type="button" class="typeform-prev group px-4 py-2 text-slate-500 hover:text-slate-700 transition-colors flex items-center gap-2 text-sm font-medium">
                        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        {{ metadata.contactForm[formLang].buttons.prev }}
                    </button>
                    <button type="button" class="typeform-next px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-black transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5 flex items-center gap-3">
                        {{ metadata.contactForm[formLang].buttons.next }}
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <div class="typeform-step hidden space-y-8" data-step="email">
                <div class="space-y-4 mb-8">
                    <p class="step-counter text-sm font-bold tracking-widest text-slate-500 uppercase"></p>
                    <h3 id="label-email" class="text-2xl md:text-3xl font-light text-slate-900 leading-tight">{{ metadata.ctaForm[formLang].questions.email.title }}</h3>
                </div>
                <input type="email" id="email" aria-labelledby="label-email" name="email" class="w-full px-6 py-5 text-xl bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 outline-none transition-all duration-300 shadow-sm placeholder-slate-400 text-slate-800" required placeholder="{{ metadata.ctaForm[formLang].helpText.email }}">
                
                <div class="flex justify-between items-center pt-4">
                    <button type="button" class="typeform-prev group px-4 py-2 text-slate-500 hover:text-slate-700 transition-colors flex items-center gap-2 text-sm font-medium">
                        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        {{ metadata.contactForm[formLang].buttons.prev }}
                    </button>
                    <button type="button" class="typeform-next px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-black transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5 flex items-center gap-3">
                        {{ metadata.contactForm[formLang].buttons.next }}
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>
            
            <div class="typeform-step hidden space-y-8" data-step="telefono">
                <div class="space-y-4 mb-8">
                    <p class="step-counter text-sm font-bold tracking-widest text-slate-500 uppercase"></p>
                    <h3 id="label-telefono" class="text-2xl md:text-3xl font-light text-slate-900 leading-tight">{{ metadata.ctaForm[formLang].questions.telefono.title }}</h3>
                </div>
                <input type="tel" id="telefono" aria-labelledby="label-telefono" name="telefono" class="w-full px-6 py-5 text-xl bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 outline-none transition-all duration-300 shadow-sm placeholder-slate-400 text-slate-800" required placeholder="{{ metadata.ctaForm[formLang].helpText.telefono }}">
                
                <div class="space-y-8">
                    <div class="flex items-center gap-4 py-4 bg-slate-50 px-6 rounded-2xl border border-slate-100">
                        <input type="checkbox" id="privacidad" name="privacidad" class="w-6 h-6 rounded-lg border-slate-300 text-slate-900 focus:ring-slate-900 cursor-pointer transition-colors" required>
                        <label for="privacidad" class="text-slate-600 cursor-pointer text-sm leading-relaxed">{{ metadata.ctaForm[formLang].privacyText | safe }}</label>
                    </div>
                    <p id="privacy-error" class="text-red-500 text-sm hidden font-medium flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        {{ metadata.ctaForm[formLang].privacyError }}
                    </p>
                    
                    <div class="flex justify-between items-center pt-2">
                        <button type="button" class="typeform-prev group px-4 py-2 text-slate-500 hover:text-slate-700 transition-colors flex items-center gap-2 text-sm font-medium">
                            <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                            {{ metadata.contactForm[formLang].buttons.prev }}
                        </button>
                        <button type="button" id="submit-form-btn" class="px-8 py-4 bg-gradient-to-r from-slate-900 to-slate-800 text-white font-bold rounded-2xl shadow-lg transition-all duration-300 group flex items-center gap-3 disabled:opacity-50 disabled:cursor-not-allowed disabled:shadow-none enabled:hover:shadow-xl enabled:hover:-translate-y-0.5" disabled>
                            {{ metadata.ctaContact[formLang].form.submitText }}
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                </div>
            </div>
            
            <div id="loading-state" class="typeform-step hidden space-y-8 text-center py-12" data-step="loading">
                    <div class="w-20 h-20 mx-auto border-4 border-slate-100 border-t-slate-900 rounded-full animate-spin"></div>
                    <div class="space-y-2">
                        <h3 class="text-2xl font-bold text-slate-900">{{ metadata.ctaForm[formLang].messages.loading.title }}</h3>
                        <p class="text-slate-500">{{ metadata.ctaForm[formLang].messages.loading.subtitle }}</p>
                    </div>
                </div>
                <div id="success-message" class="typeform-step hidden space-y-8 text-center py-8" data-step="success">
                    <div class="relative inline-block">
                        <div class="absolute inset-0 bg-green-100 rounded-full blur-xl opacity-50"></div>
                        <div class="relative w-24 h-24 mx-auto bg-green-50 rounded-full flex items-center justify-center mb-6 border border-green-100">
                            <svg class="w-10 h-10 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <h3 class="text-3xl font-black text-slate-900">{{ metadata.ctaForm[formLang].messages.success.title }}</h3>
                        <p class="text-xl text-slate-600 font-light max-w-md mx-auto leading-relaxed">{{ metadata.ctaForm[formLang].messages.success.subtitle }}</p>
                    </div>
                    <a href="{% if formLang != 'es' %}/{{ formLang }}/{% else %}/{% endif %}" class="inline-flex items-center justify-center mt-8 px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl shadow-lg hover:shadow-xl hover:bg-black transition-all duration-300 hover:-translate-y-0.5">{{ metadata.contactForm[formLang].buttons.home }}</a>
                </div>
                <div id="error-message" class="typeform-step hidden space-y-8 text-center py-8" data-step="error">
                     <div class="relative inline-block">
                        <div class="absolute inset-0 bg-red-100 rounded-full blur-xl opacity-50"></div>
                        <div class="relative w-24 h-24 mx-auto bg-red-50 rounded-full flex items-center justify-center mb-6 border border-red-100">
                            <svg class="w-10 h-10 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <h3 class="text-3xl font-black text-slate-900">{{ metadata.ctaForm[formLang].messages.error.title }}</h3>
                        <p class="text-xl text-slate-600 font-light max-w-md mx-auto leading-relaxed">{{ metadata.ctaForm[formLang].messages.error.subtitle }}</p>
                    </div>
                    <button id="retry-button" type="button" class="inline-flex items-center justify-center mt-8 px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl shadow-lg hover:shadow-xl hover:bg-black transition-all duration-300 hover:-translate-y-0.5">{{ metadata.contactForm[formLang].buttons.retry }}</button>
                </div>
        </div>
    </div>
    <div id="progress-bar-container" class="mt-12 w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
        <div id="typeform-progress" class="bg-slate-900 h-full w-0 transition-all duration-500 ease-out"></div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const formWrapper = document.getElementById('typeform-wrapper');
        if (!formWrapper) return;

        const steps = Array.from(formWrapper.querySelectorAll('.typeform-step'));
        const progress = document.getElementById('typeform-progress');
        const webhookUrl = 'https://hook.eu2.make.com/76yaogaunrc9cqdtf26ldcoxb3fpndma';
        let currentStep = 0;
        
        const questionSteps = steps.filter(step => step.dataset.step && !['loading', 'success', 'error'].includes(step.dataset.step));
        const totalQuestionSteps = questionSteps.length;
        
        let formData = { areaInteres: '' };

        function showStep(stepIndex) {
            const currentStepEl = steps[stepIndex];
            steps.forEach((step, index) => {
                step.classList.toggle('active', index === stepIndex);
                step.classList.toggle('hidden', index !== stepIndex);
            });

            const questionStepIndex = questionSteps.indexOf(currentStepEl);
            if (progress) {
                const progressPercentage = questionStepIndex >= 0 ? ((questionStepIndex + 1) / totalQuestionSteps) * 100 : (currentStepEl.id.includes('success') || currentStepEl.id.includes('error') ? 100 : 0);
                progress.style.width = `${progressPercentage}%`;
            }

            if (questionStepIndex !== -1) {
                const stepCounter = currentStepEl.querySelector('.step-counter');
                if (stepCounter) {
                    const lang = '{{ formLang }}';
                    const questionText = lang === 'es' ? 'PREGUNTA' : 'QUESTION';
                    stepCounter.textContent = `${questionText} ${questionStepIndex + 1} / ${totalQuestionSteps}`;
                }
            }

            const input = currentStepEl.querySelector('input, textarea');
            if (input) setTimeout(() => input.focus(), 300);
        }

        function validateCurrentStep() {
            const currentStepEl = steps[currentStep];
            const inputs = currentStepEl.querySelectorAll('input[required], textarea[required]');
            let isValid = true;
            let firstInvalidInput = null;

            inputs.forEach(input => {
                let inputValid = true;
                
                if (input.type === 'checkbox') {
                    if (!input.checked) inputValid = false;
                } else if (!input.value.trim()) {
                    inputValid = false;
                } else if (input.type === 'email' && !/^\S+@\S+\.\S+$/.test(input.value)) {
                    inputValid = false;
                }

                if (!inputValid) {
                    input.classList.add('border-red-400');
                    input.addEventListener('input', () => input.classList.remove('border-red-400'), { once: true });
                    // For checkboxes, handle change event too
                    if(input.type === 'checkbox') {
                         input.addEventListener('change', () => input.classList.remove('border-red-400'), { once: true });
                    }
                    isValid = false;
                    if (!firstInvalidInput) firstInvalidInput = input;
                }
            });

            if (firstInvalidInput) {
                firstInvalidInput.focus();
            }

            return isValid;
        }

        function updateSubmitButton() {
            const privacidadCheckbox = document.getElementById('privacidad');
            const submitButton = document.getElementById('submit-form-btn');
            const privacyError = document.getElementById('privacy-error');
            if (privacidadCheckbox && submitButton) {
                if (privacidadCheckbox.checked) {
                    submitButton.removeAttribute('disabled');
                    if (privacyError) privacyError.classList.add('hidden');
                } else {
                    submitButton.setAttribute('disabled', '');
                    if (privacidadCheckbox.dataset.touched === 'true' && privacyError) {
                        privacyError.classList.remove('hidden');
                    }
                }
            }
        }

        const privacidadCheckbox = document.getElementById('privacidad');
        if (privacidadCheckbox) {
            privacidadCheckbox.addEventListener('change', updateSubmitButton);
            privacidadCheckbox.addEventListener('blur', () => {
                privacidadCheckbox.dataset.touched = 'true';
                updateSubmitButton();
            });
        }

        async function submitForm() {
            if (privacidadCheckbox && !privacidadCheckbox.checked) {
                privacidadCheckbox.dataset.touched = 'true';
                privacidadCheckbox.focus();
                const privacyError = document.getElementById('privacy-error');
                if(privacyError) privacyError.classList.remove('hidden');
                return;
            }

            showStep(steps.findIndex(s => s.id === 'loading-state'));
            
            const formDataToSend = {
                areaInteres: formData.areaInteres,
                mensaje: document.getElementById('mensaje').value,
                nombre: document.getElementById('nombre').value,
                email: document.getElementById('email').value,
                telefono: document.getElementById('telefono').value,
                privacidad: 'Aceptada',
                origen: '{{ contactFormOrigin | default("Página de Contacto", true) }}',
                fecha: new Date().toISOString()
            };

            try {
                const response = await fetch(webhookUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formDataToSend)
                });
                if (!response.ok) throw new Error('Network response was not ok');
                showStep(steps.findIndex(s => s.id === 'success-message'));
            } catch (error) {
                console.error('Error:', error);
                showStep(steps.findIndex(s => s.id === 'error-message'));
            }
        }

        formWrapper.addEventListener('click', (e) => {
            const target = e.target;
            const areaInteresOption = target.closest('.area-interes-option');
            const nextButton = target.closest('.typeform-next');
            const prevButton = target.closest('.typeform-prev');
            const submitButton = target.closest('#submit-form-btn');
            const retryButton = target.closest('#retry-button');

            if (areaInteresOption) {
                formData.areaInteres = areaInteresOption.dataset.value;
                currentStep++;
                showStep(currentStep);
            } else if (nextButton) {
                if (validateCurrentStep()) {
                    currentStep++;
                    showStep(currentStep);
                }
            } else if (prevButton) {
                if (currentStep > 0) {
                    currentStep--;
                    showStep(currentStep);
                }
            } else if (submitButton) {
                if (validateCurrentStep()) submitForm();
            } else if (retryButton) {
                currentStep = 0;
                formData = { areaInteres: '' };
                const inputs = formWrapper.querySelectorAll('input:not([type="checkbox"]), textarea');
                inputs.forEach(input => input.value = '');
                if(privacidadCheckbox) {
                    privacidadCheckbox.checked = false;
                    privacidadCheckbox.dataset.touched = 'false';
                }
                updateSubmitButton();
                showStep(currentStep);
            }
        });

        formWrapper.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                const currentStepEl = steps[currentStep];
                // Allow normal enter behavior on textarea
                if (document.activeElement.tagName === 'TEXTAREA') return;

                e.preventDefault();
                
                if (currentStepEl.querySelector('#submit-form-btn')) {
                    if (validateCurrentStep()) submitForm();
                } else if(currentStepEl.querySelector('.area-interes-option')) {
                    return;
                } else if (validateCurrentStep()) {
                    currentStep++;
                    showStep(currentStep);
                }
            }
        });

        showStep(0);
    });
</script>
