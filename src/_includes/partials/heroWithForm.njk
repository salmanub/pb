<header class="relative mt-[70px] lg:mt-[100px] min-h-[85vh] flex items-center bg-white overflow-hidden isolate border-b border-slate-100">
    <!-- Background Elements -->
    <div class="absolute inset-0 z-0">
        <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-50 skew-x-[-12deg] translate-x-1/4 origin-top opacity-50"></div>
        <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-white to-transparent"></div>
        <!-- Nueva textura sutil -->
        <div class="absolute inset-0 bg-grid-pattern opacity-[0.4]"></div>
    </div>

    <div class="w-full px-6 md:px-12 lg:px-16 relative z-10 py-12 lg:py-0">
        <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-12 lg:gap-20 items-center">
            
            <!-- Content -->
            <div class="flex flex-col justify-center animate-in fade-in slide-in-from-bottom-8 duration-700">
                <div class="mb-8">
                    <h1 class="text-4xl md:text-5xl lg:text-7xl font-black leading-[0.95] tracking-tight text-slate-900 mb-6">
                        INFORMES PERICIALES <br>
                        <strong class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600">QUE GANAN CASOS</strong>
                    </h1>
                    <p class="section-subtitle max-w-2xl ml-0">
                        Informes de ingeniería civil con rigor científico y claridad expositiva. Especialistas en construcción y seguros.
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="#contacto" class="btn-primary">
                        Solicitar Ahora
                    </a>
                </div>
            </div>

            <!-- Form -->
            <div class="relative w-full max-w-md mx-auto lg:mr-0 animate-in fade-in slide-in-from-right-8 duration-700 delay-200">
                <div class="card-avant p-8 border-slate-200 shadow-2xl shadow-slate-200/50">
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyan-400 to-blue-600"></div>
                    
                    <h2 class="text-2xl font-bold text-slate-900 mb-2">EVALUACIÓN EXPRÉS</h2>
                    <p class="text-slate-500 mb-6 text-sm">Respuesta profesional en menos de 24 horas</p>
                    
                    <form id="express-form" class="space-y-4">
                        <div>
                            <input type="text" name="nombre" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-all outline-none text-slate-900 placeholder:text-slate-400" placeholder="Nombre y Apellidos" required>
                        </div>
                        <div>
                            <input type="email" name="email" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-all outline-none text-slate-900 placeholder:text-slate-400" placeholder="Email" required>
                        </div>
                        <div>
                            <input type="tel" name="telefono" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-all outline-none text-slate-900 placeholder:text-slate-400" placeholder="Teléfono" required>
                        </div>
                        <div>
                            <select name="tipoSiniestro" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-all outline-none text-slate-900" required>
                                <option value="" disabled selected>Seleccione tipo de siniestro / presupuesto</option>
                                <option value="construccion">Peritaje de Construcción</option>
                                <option value="seguros">Peritaje para Seguros</option>
                                <option value="judicial">Informe Judicial</option>
                            </select>
                        </div>
                        <button type="submit" class="w-full btn-primary bg-gradient-to-r from-cyan-600 to-blue-600 hover:shadow-cyan-500/25">
                            Solicitar Evaluación
                        </button>
                    </form>
                    <div id="express-success" class="hidden mt-4 text-green-600 font-medium text-sm text-center bg-green-50 rounded-lg p-3 border border-green-100">¡Solicitud enviada correctamente! En breve nos pondremos en contacto.</div>
                    <div id="express-error" class="hidden mt-4 text-red-600 font-medium text-sm text-center bg-red-50 rounded-lg p-3 border border-red-100">Error al enviar. Por favor, intente de nuevo.</div>
                    
                    <script>
                        document.addEventListener("DOMContentLoaded", () => {
                            const expressForm = document.getElementById("express-form");
                            if (!expressForm) return;

                            expressForm.addEventListener("submit", async (e) => {
                                e.preventDefault();
                                const form = e.target;
                                const submitBtn = form.querySelector('button[type="submit"]');
                                submitBtn.disabled = true;
                                submitBtn.textContent = 'Enviando...';

                                const formData = new FormData(form);
                                const payload = {
                                    nombre: formData.get('nombre'),
                                    email: formData.get('email'),
                                    telefono: formData.get('telefono'),
                                    tipoSiniestro: formData.get('tipoSiniestro'),
                                    mensaje: "Solicitud de Evaluación Exprés desde la Home",
                                    origen: 'Evaluación Exprés (Home)'
                                };

                                try {
                                    const response = await fetch('https://hook.eu2.make.com/76yaogaunrc9cqdtf26ldcoxb3fpndma', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(payload)
                                    });

                                    if (response.ok) {
                                        form.style.display = 'none';
                                        document.getElementById('express-success').classList.remove('hidden');
                                        document.getElementById('express-error').classList.add('hidden');
                                    } else {
                                        throw new Error('Network error');
                                    }
                                } catch (error) {
                                    document.getElementById('express-error').classList.remove('hidden');
                                    submitBtn.disabled = false;
                                    submitBtn.textContent = 'Solicitar Evaluación';
                                }
                            });
                        });
                    </script>
                </div>
            </div>
        </div>
    </div>
</header>