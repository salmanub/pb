{% block content %}

<header class="relative pt-28 lg:pt-48 min-h-[80vh] flex items-center bg-white overflow-hidden" role="banner">
    <!-- Background Elements for WOW effect -->
    <div class="absolute inset-0 z-0">
        <div class="absolute top-0 right-0 w-2/3 h-full bg-slate-100 skew-x-[-12deg] translate-x-1/4 origin-top"></div>
        <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-white to-transparent"></div>
    </div>

    <div class="w-full px-6 md:px-12 lg:px-16 relative z-10 h-full">
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-20 items-center h-full">
            
            <!-- Text Content -->
            <div class="flex flex-col justify-center animate-in fade-in slide-in-from-bottom-8 duration-700 delay-100">
                <div class="mb-8 md:mb-10">
                    <h1 class="flex items-center text-sm md:text-base font-bold tracking-[0.2em] uppercase text-cyan-600 mb-6" itemprop="headline">
                        <span class="w-12 h-[2px] bg-cyan-600 mr-4" aria-hidden="true"></span>
                        {{ hero.tag | escape }}
                    </h1>

                    <div class="relative z-20">
                        <div class="text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-light leading-[0.95] tracking-tight text-slate-900 uppercase" aria-label="Título principal del héroe">
                            <span class="text-slate-900 font-light">{{ hero.title | safe }}</span>
                            <!-- Fixed height container REPLACED by Grid Stack for stability -->
                            <div class="mt-4 grid grid-cols-1 grid-rows-1" aria-live="polite" aria-atomic="true">
                                {% for item in hero.rotatingTexts.items %}
                                <strong class="hero-rotating-text col-start-1 row-start-1 block text-cyan-400 transition-opacity duration-700 leading-[1.1] font-normal {{ 'opacity-100' if loop.first else 'opacity-0' }}" aria-hidden="{{ 'false' if loop.first else 'true' }}">
                                    {{ item | escape }}
                                </strong>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="max-w-2xl text-lg md:text-xl text-slate-600 mb-10 leading-relaxed font-light">
                    {{ hero.description | safe }}
                </div>

                <div class="flex flex-col sm:flex-row gap-5 mb-12" role="group" aria-label="Llamadas a la acción">
                    <a href="{{ hero.cta.primaryUrl | url }}" 
                       class="btn-primary group">
                        {{ hero.cta.primary | escape }}
                        <svg class="w-4 h-4 ml-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    </a>
                    <a href="tel:{{ metadata.contact.phoneNumber | url }}" 
                       class="btn-secondary group">
                        <svg class="w-5 h-5 mr-3 text-cyan-500 transition-transform group-hover:text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        {{ hero.cta.secondary | escape }}
                    </a>
                </div>

                <div class="flex gap-8 md:gap-12 pt-8 border-t border-slate-200/60" role="list">
                     {% for badge in hero.badges %}
                    <div class="flex flex-col" role="listitem">
                        <div class="text-3xl lg:text-4xl font-black text-slate-900 mb-1 tracking-tighter">{{ badge.value }}</div>
                        <div class="text-xs uppercase tracking-wider font-bold text-slate-500">{{ badge.text | escape }}</div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Hero Image / Visual -->
            <div class="relative h-full min-h-[500px] lg:min-h-[auto] w-full hidden lg:block animate-in fade-in slide-in-from-right-8 duration-1000 delay-300">
                 <!-- Refined Background - No rotation, subtle -->
                 <div class="absolute inset-0 bg-slate-100/50 rounded-3xl -z-10 transform scale-[0.98] translate-y-4"></div>
                 
                 <!-- Image Container - Clean, specific aspect ratio, refined shadow -->
                 <div class="hero-image-wrapper relative w-full h-[500px] lg:h-[600px] rounded-2xl overflow-hidden shadow-2xl shadow-slate-200 ring-1 ring-slate-900/5 bg-white">
                     {% image hero.image.path, 
                        hero.image.alt, 
                        "(min-width: 1200px) 50vw, 100vw", 
                        "eager", 
                        "high" 
                     %}
                     <!-- Gradient Overlay for Contrast if needed -->
                     <div class="absolute inset-0 bg-gradient-to-t from-slate-900/20 to-transparent pointer-events-none"></div>
                     
                     <style>
                        .hero-image-wrapper img {
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                            transition: transform 1.5s cubic-bezier(0.2, 0, 0.2, 1);
                        }
                        .hero-image-wrapper:hover img {
                            transform: scale(1.03); /* Subtle scale */
                        }
                     </style>
                 </div>
            </div>
        </div>
    </div>
</header>

{% endblock content %}

{% block scripts %}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const items = document.querySelectorAll('.hero-rotating-text');
        if (!items.length) return;

        let index = 0;
        setInterval(() => {
            // Fade out current
            items[index].classList.remove('opacity-100');
            items[index].classList.add('opacity-0');
            items[index].setAttribute('aria-hidden', 'true');

            // Move to next
            index = (index + 1) % items.length;

            // Fade in next (CSS transition handles the cross-fade)
            items[index].classList.remove('opacity-0');
            items[index].classList.add('opacity-100');
            items[index].setAttribute('aria-hidden', 'false');
        }, 3500);
    });
</script>

{% endblock scripts %}
