<section id="servicios" class="relative py-24 md:py-32 px-6 md:px-12 lg:px-16 bg-gradient-to-br from-slate-100 via-white to-slate-50 overflow-hidden">
    <!-- Decorative background -->
    <div class="absolute inset-0">
        <!-- Patrón de puntos centralizado -->
        <div class="absolute inset-0 bg-grid-pattern opacity-[0.3]"></div>
        <!-- Gradiente decorativo -->
        <div class="absolute inset-0 bg-radial-fade"></div>
    </div>

    <div class="w-full relative z-10">
        <header class="max-w-4xl mx-auto text-center mb-20 md:mb-28 animate-in fade-in slide-in-from-bottom-8 duration-700 delay-100">
            <span class="badge badge-primary mb-6">{{ highlightedServices.tag | default("Servicios Especializados") }}</span>
            <h2 class="section-title mb-8">
                {{ highlightedServices.titulo }} <strong class="text-teal-400 font-normal block mt-2">{{ highlightedServices.highlight }}</strong>
            </h2>
            <p class="section-subtitle">{{ highlightedServices.descripcion }}</p>
        </header>

        {% set numItems = (highlightedServices.items | length) %}
        {% set gridCols = "lg:grid-cols-3" %}
        {% if numItems == 2 %}
            {% set gridCols = "lg:grid-cols-2 max-w-5xl mx-auto" %}
        {% endif %}

        <div class="grid gap-8 lg:gap-12 w-full {{ gridCols }}">
            {% for servicio in highlightedServices.items %}
            <article class="group/card relative isolate animate-in fade-in slide-in-from-bottom-8 duration-700" style="animation-delay: {{ 200 + loop.index * 100 }}ms">
                <a href="{{ servicio.url }}" class="block h-full card-avant p-8 pb-24" title="Ver detalles de {{ servicio.titulo }}" aria-labelledby="service-title-{{ loop.index }}">
                    
                    <!-- Background accent -->
                    <div class="absolute top-0 right-0 w-64 h-64 bg-teal-50/50 rounded-none blur-3xl -translate-y-1/2 translate-x-1/2 group-hover/card:bg-teal-100/50 transition-colors duration-500"></div>

                    <!-- Contenido principal -->
                    <div class="relative z-10">
                        <header class="mb-6">
                            <!-- Icono -->
                            <div class="mb-8">
                                <div class="w-16 h-16 rounded-none bg-slate-50 flex items-center justify-center group-hover/card:bg-teal-500 group-hover/card:rotate-6 transition-all duration-500 ease-out border border-slate-100">
                                    <div class="w-8 h-8 flex items-center justify-center text-slate-900 group-hover/card:text-white transition-colors duration-500">
                                        {% include "icons/" + servicio.icon + ".svg" ignore missing %}
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Título -->
                            <h3 id="service-title-{{ loop.index }}" class="text-2xl font-light uppercase text-slate-900 group-hover/card:text-teal-600 transition-colors mb-4 leading-tight tracking-tight">
                                {{ servicio.titulo }}
                            </h3>
                            
                            <!-- Descripción -->
                            <p class="text-slate-500 leading-relaxed text-lg font-light group-hover/card:text-slate-600 transition-colors mb-6">{{ servicio.descripcion }}</p>
                            
                            <span class="inline-flex items-center text-teal-600 hover:text-teal-700 font-semibold group mt-auto">
                                {{ highlightedServices.cta }}
                                <svg class="w-5 h-5 ml-2 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                </svg>
                            </span>
                        </header>
                    </div>

                    <!-- Botón flotante -->

                </a>
            </article>
            {% endfor %}
        </div>
    </div>
</section>