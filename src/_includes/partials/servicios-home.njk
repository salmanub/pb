<section id="servicios" class="py-20 md:py-28 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden">
    <!-- Overlay decorativo con gradientes -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-50/30 via-transparent to-slate-100/20"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(0,0,0,.02)_0%,transparent_50%)] mix-blend-overlay"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/50 to-transparent"></div>
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">
        <!-- Encabezado de Sección -->
        <div class="max-w-3xl mx-auto text-center mb-16 md:mb-20">
            <div class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6 leading-tight">
                {{ highlightedServices.titulo }} <strong class="text-cyan-500 font-bold">{{ highlightedServices.highlight }}</strong>
            </div>
            <p class="text-xl text-slate-600">{{ highlightedServices.descripcion }}</p>
        </div>

        <!-- Grid de Servicios -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
            {% for servicio in highlightedServices.items %}
            <div class="bg-slate-50 rounded-xl p-8 lg:p-10 shadow-sm hover:shadow-lg transition-shadow duration-300 flex flex-col">
                <div class="mb-6 flex items-center gap-4">
                    <span class="flex-shrink-0 w-12 h-12 rounded-lg bg-cyan-500/10 flex items-center justify-center">
                        {% include "icons/" + servicio.icon + ".svg" ignore missing %}
                    </span>
                    <h2 class="text-2xl font-bold text-slate-800">
                        <a href="{{ servicio.url }}" class="hover:text-cyan-500 transition-colors">{{ servicio.titulo }}</a>
                    </h2>
                </div>

                <p class="text-slate-600 leading-relaxed mb-6 flex-grow">{{ servicio.descripcion }}</p>

                <a href="{{ servicio.url }}" class="mt-auto inline-flex items-center justify-center w-full px-6 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors duration-300 group">
                    {{ servicio.cta }}
                    <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
    </div>
</section>