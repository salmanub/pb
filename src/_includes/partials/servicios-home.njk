<section id="servicios" class="py-20 md:py-28 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden">
    <!-- Overlay decorativo con gradientes -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-50/30 via-transparent to-slate-100/20"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(0,0,0,.02)_0%,transparent_50%)] mix-blend-overlay"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/50 to-transparent"></div>
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">
        <header class="max-w-3xl mx-auto text-center mb-16 md:mb-20">
            <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6 leading-tight">
                {{ highlightedServices.titulo }} <strong class="text-cyan-500 font-bold">{{ highlightedServices.highlight }}</strong>
            </h2>
            <p class="text-xl text-slate-600">{{ highlightedServices.descripcion }}</p>
        </header>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-8">
            {% for servicio in highlightedServices.items %}
            <article class="h-full">
                <a href="{{ servicio.url }}" class="block h-full bg-slate-50 rounded-xl p-6 lg:p-8 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col group" title="Ver detalles de {{ servicio.titulo }}" aria-labelledby="service-title-{{ loop.index }}">
                    <header class="mb-4 flex items-start gap-3">
                        <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-cyan-500/10 flex items-center justify-center group-hover:bg-cyan-500/20 transition-colors" aria-hidden="true">
                            {% include "icons/" + servicio.icon + ".svg" ignore missing %}
                        </span>
                        <h3 id="service-title-{{ loop.index }}" class="text-xl font-bold text-slate-800 group-hover:text-cyan-600 transition-colors">
                            {{ servicio.titulo }}
                        </h3>
                    </header>

                    <div class="flex flex-col flex-grow">
                        <p class="text-slate-600 leading-relaxed mb-6 flex-grow text-sm">{{ servicio.descripcion }}</p>
                        
                        <div class="mt-auto inline-flex items-center justify-end text-cyan-500 group-hover:text-cyan-600 transition-colors">
                            <span class="sr-only">Más información sobre {{ servicio.titulo }}</span>
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </div>
                    </div>
                </a>
            </article>
            {% endfor %}
        </div>
    </div>
</section>