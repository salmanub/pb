<section id="servicios" class="relative py-24 md:py-32 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 overflow-hidden">
    <!-- Decorative background -->
    <div class="absolute inset-0">
        <!-- Patrón de puntos mejorado -->
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,slate-200_1px,transparent_1px)] [background-size:48px_48px] opacity-[0.15]"></div>
        <!-- Gradiente decorativo más suave -->
        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-50/40 via-transparent to-slate-100/30"></div>
        <!-- Efecto de luz -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-200/20 blur-3xl rounded-full"></div>
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">
        <header class="max-w-3xl mx-auto text-center mb-20">
            <span class="block text-cyan-500 font-medium tracking-wider mb-4 uppercase text-sm">{{ highlightedServices.tag | default("Servicios Especializados") }}</span>
            <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6 leading-[1.1]">
                {{ highlightedServices.titulo }} <strong class="text-cyan-500 font-bold">{{ highlightedServices.highlight }}</strong>
            </h2>
            <p class="text-xl text-slate-600 max-w-2xl mx-auto">{{ highlightedServices.descripcion }}</p>
        </header>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-8">
            {% for servicio in highlightedServices.items %}
            <article class="group/card">
                <a href="{{ servicio.url }}" class="group/card relative block h-full bg-gradient-to-br from-white to-slate-50/80 rounded-2xl p-6 pb-20 shadow-lg hover:shadow-xl transition-all duration-500 overflow-hidden isolate" title="Ver detalles de {{ servicio.titulo }}" aria-labelledby="service-title-{{ loop.index }}">
                    <!-- Efecto de hover background -->
                    <div class="absolute inset-0 bg-gradient-to-br from-cyan-50 to-white opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>
                    
                    <!-- Contenido principal -->
                    <div class="relative z-10">
                        <header class="mb-6">
                            <div class="flex items-start gap-4 mb-4">
                                <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-cyan-500/10 flex items-center justify-center group-hover/card:scale-110 group-hover/card:bg-cyan-500/20 transition-all duration-500">
                                    {% include "icons/" + servicio.icon + ".svg" ignore missing %}
                                </div>
                                <h3 id="service-title-{{ loop.index }}" class="text-xl font-bold text-slate-800 group-hover/card:text-cyan-600 transition-colors">
                                    {{ servicio.titulo }}
                                </h3>
                            </div>
                            <p class="text-slate-600 leading-relaxed">{{ servicio.descripcion }}</p>
                        </header>
                    </div>

                    <!-- Flecha siempre visible con microinteracción -->
                    <div class="absolute bottom-6 right-6 flex items-center gap-2 text-cyan-400 group-hover/card:text-cyan-500 transition-colors">
                        <span class="text-sm font-medium opacity-0 translate-x-4 group-hover/card:opacity-100 group-hover/card:translate-x-0 transition-all duration-300">Saber más</span>
                        <div class="w-8 h-8 rounded-full bg-cyan-50 flex items-center justify-center group-hover/card:bg-cyan-100 transition-all duration-300">
                            <svg class="w-4 h-4 group-hover/card:translate-x-0.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </div>
                    </div>
                </a>
            </article>
            {% endfor %}
        </div>
    </div>
</section>