<section class="py-24 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden isolate">
    <!-- Efectos decorativos -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(203,213,225,0.1)_1px,transparent_1px)] [background-size:48px_48px]"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-50/40 via-transparent to-slate-100/30"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-200/20 blur-[100px] rounded-full"></div>
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">
        <div class="max-w-4xl mx-auto text-center mb-16">
            <span class="text-cyan-500 font-semibold tracking-wider uppercase mb-4 block">{{ testimonios.tag }}</span>
            <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6 leading-none">
                {{ testimonios.titulo }} <strong class="text-cyan-500 font-bold">{{ testimonios.highlight }}</strong>
            </h2>
            <p class="text-lg text-slate-600 max-w-3xl mx-auto">{{ testimonios.descripcion }}</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for testimonio in testimonios.items %}
            <div class="bg-gradient-to-br from-white to-slate-50/80 p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 group/card hover:bg-gradient-to-br hover:from-cyan-50/50 hover:to-white">
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-16 h-16 rounded-full bg-cyan-50 overflow-hidden flex items-center justify-center p-3 group-hover/card:scale-110 group-hover/card:bg-cyan-100 transition-all duration-500">
                        {% if testimonio.imagen %}
                            <img src="{{ testimonio.imagen }}" 
                                 alt="Foto de {{ testimonio.nombre }}" 
                                 class="w-full h-full object-cover" 
                                 loading="lazy">
                        {% else %}
                            {% if testimonio.tipo == 'empresa' %}
                                {% include "icons/avatar-company.svg" %}
                            {% else %}
                                {% include "icons/avatar-person.svg" %}
                            {% endif %}
                        {% endif %}
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800 group-hover/card:text-cyan-600 transition-colors">{{ testimonio.nombre }}</h3>
                        <p class="text-slate-500 text-sm">{{ testimonio.rol }}</p>
                    </div>
                </div>
                <div class="relative mb-6">
                    <svg class="absolute -top-2 -left-1 w-8 h-8 text-cyan-100" fill="currentColor" viewBox="0 0 32 32">
                        <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4z"/>
                    </svg>
                    <blockquote class="text-slate-600 leading-relaxed pl-7">
                        "{{ testimonio.cita }}"
                    </blockquote>
                </div>
                <div class="flex items-center gap-2">
                    <div class="text-cyan-400">★★★★★</div>
                    <span class="text-slate-400 text-sm">{{ testimonio.fecha }}</span>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
