<section class="py-24 px-4 md:px-[5%] bg-gradient-to-br from-slate-100 via-white to-slate-50 relative overflow-hidden">
    <!-- Overlay decorativo con gradientes -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-50/30 via-transparent to-slate-100/20"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(0,0,0,.02)_0%,transparent_50%)] mix-blend-overlay"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/50 to-transparent"></div>
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">
        <div class="max-w-4xl mx-auto text-center mb-16">
            <span class="text-cyan-500 font-semibold tracking-wider uppercase mb-4 block">{{ testimonios.tag }}</span>
            <h2 class="text-[2.5rem] md:text-[3.5rem] font-light text-slate-800 mb-6 leading-none">
                {{ testimonios.titulo }} <strong class="text-cyan-500 font-bold">{{ testimonios.highlight }}</strong>
            </h2>
            <p class="text-lg text-slate-600 max-w-3xl mx-auto">{{ testimonios.descripcion }}</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for testimonio in testimonios.items %}
            <div class="bg-white p-8 pb-16 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 flex flex-col group/card relative">
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-16 h-16 rounded-full bg-cyan-50 overflow-hidden flex items-center justify-center p-3 group transition-all duration-300 hover:bg-cyan-100">
                        {% if testimonio.imagen %}
                            <img src="{{ testimonio.imagen }}" 
                                 alt="Foto de {{ testimonio.nombre }}" 
                                 class="w-full h-full object-cover" 
                                 loading="lazy">
                        {% else %}
                            {% if testimonio.tipo == 'empresa' %}
                                {% include "icons/avatar-company.svg" %}
                            {% else %}
                                {% include "icons/avatar-person.svg" %}
                            {% endif %}
                        {% endif %}
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800">{{ testimonio.nombre }}</h3>
                        <p class="text-slate-500 text-sm">{{ testimonio.rol }}</p>
                    </div>
                </div>
                <div class="flex-grow">
                    <svg class="w-10 h-10 text-cyan-100 mb-4" fill="currentColor" viewBox="0 0 32 32">
                        <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"/>
                    </svg>
                    <blockquote class="text-slate-600 leading-relaxed mb-6">
                        "{{ testimonio.cita }}"
                    </blockquote>
                </div>
                <div class="flex items-center gap-2">
                    <div class="text-cyan-400">★★★★★</div>
                    <span class="text-slate-400 text-sm">{{ testimonio.fecha }}</span>
                </div>
                <div class="absolute bottom-4 right-4 w-12 h-12 flex items-center justify-center overflow-hidden">
                    <div class="w-24 h-24 bg-cyan-500/10 rounded-full group-hover/card:scale-100 scale-0 transition-transform duration-500"></div>
                    <svg class="absolute w-5 h-5 text-cyan-500 transform group-hover/card:translate-x-0 group-hover/card:translate-y-0 translate-x-6 translate-y-6 transition-all duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
