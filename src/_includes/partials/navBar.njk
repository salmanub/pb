{% set currentLanguage = page.lang or lang %} 
{% set defaultLanguage = metadata.default_lang %}
{% set navPages = collections.langCollections[currentLanguage] | eleventyNavigation %}

{% macro renderNavListItem(entry) %}
    {% if not entry.notshow %}
        <li class="nav-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            {% if entry.key == "Servicios" and entry.children %}
                <div class="group relative">
                    <button class="flex items-center gap-1.5 text-slate-600 hover:text-cyan-600 font-medium text-sm
                                 {% if entry.url == page.url %}text-cyan-600{% endif %}
                                 py-2 transition-colors">
                        {% if entry.icon %}
                            <svg class="w-4 h-4 text-slate-400 group-hover:text-cyan-600 transition-colors" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                {{entry.icon | safe}}
                            </svg>
                        {% endif %}
                        <span>{{ entry.title }}</span>
                        <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 text-slate-400 group-hover:text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div class="absolute top-full left-0 hidden group-hover:block w-64 bg-white rounded-xl shadow-xl shadow-slate-200/50 border border-slate-100 py-3 z-50">
                        {% for child in entry.children %}
                            <a href="{{ child.url }}" 
                               class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 {% if child.url == page.url %}text-cyan-600 bg-slate-50{% else %}text-slate-600{% endif %} hover:text-cyan-600 transition-colors group/item">
                                <span class="text-cyan-500 opacity-0 group-hover/item:opacity-100 transition-opacity">→</span>
                                <span class="font-medium text-sm">{{ child.title }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <a href="{{ entry.url }}"
                   class="flex items-center gap-1.5 text-slate-600 hover:text-cyan-600 font-medium text-sm transition-colors
                          {% if entry.url == page.url %}text-cyan-600 font-semibold{% endif %}">
                    {% if entry.icon %}
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-cyan-600 transition-colors" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            {{entry.icon | safe}}
                        </svg>
                    {% endif %}
                    <span>{{ entry.title }}</span>
                </a>
            {% endif %}
        </li>
    {% endif %}
{% endmacro %}

{% macro renderMobileNavItems(entry) %}
    {% if not entry.notshow %}
        {% if entry.children %}
            <li class="nav-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <div class="flex flex-col">
                    <a href="{{ entry.url }}" class="flex items-center gap-3 text-slate-800 font-semibold text-lg hover:text-cyan-600 hover:bg-slate-50 rounded-lg px-4 py-3 transition-colors">
                        {% if entry.icon %}
                            <svg class="w-5 h-5 text-slate-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            {{ entry.icon | safe }}
                        </svg>
                        {% endif %}
                        <span>{{ entry.title }}</span>
                    </a>
                    <ul class="ml-4 mt-1 border-l border-slate-100 pl-2 space-y-1">
                        {% for child in entry.children %}
                            <li class="nav-item">
                                <a href="{{ child.url }}" 
                                class="flex items-center gap-3 text-slate-600 font-medium text-base hover:text-cyan-600 hover:bg-slate-50 rounded-lg px-4 py-2 transition-colors">
                                    <span>{{ child.title }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </li>
        {% elif entry.key != "Servicios" and not entry.parent %}
            <li class="nav-item">
                <a href="{{ entry.url }}"
                class="flex items-center gap-3 text-slate-800 font-semibold text-lg hover:text-cyan-600 hover:bg-slate-50 rounded-lg px-4 py-3 transition-colors">
                    {% if entry.icon %}
                            <svg class="w-4 h-4 text-slate-400 group-hover:text-cyan-600 transition-colors" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                {{entry.icon | safe}}
                            </svg>
                    {% endif %}
                    <span>{{ entry.title }}</span>
                </a>
            </li>
        {% endif %}
    {% endif %}
{% endmacro %}

<header id="mainHeader" class="fixed top-0 left-0 right-0 bg-white/90 backdrop-blur-md border-b border-slate-100 z-50 transition-all duration-500 ease-in-out" itemscope itemtype="https://schema.org/SiteNavigationElement">
    <div class="w-full px-6 md:px-12 lg:px-16">
        <!-- Top Bar - Minimalist fade-in animation -->
        <div class="hidden lg:flex justify-end items-center h-10 border-b border-slate-50 text-xs animate-in fade-in slide-in-from-top-2 duration-700 delay-100">
            <!-- Language Selector with hover animation -->
            <div class="flex items-center gap-4 px-4 border-l border-slate-50">
                {% for language in metadata.languages %}
                    {% set translatedUrl = '/' %}
                    
                    {# Logic to find translations if not directly available #}
                    {% set pageTranslations = translations %}
                    {% if not pageTranslations and post and post.translations %}
                        {% set pageTranslations = post.translations %}
                    {% endif %}
                    {% if not pageTranslations and caso and caso.translations %}
                        {% set pageTranslations = caso.translations %}
                    {% endif %}

                    {% if pageTranslations and pageTranslations.length %}
                        {% for translation in pageTranslations %}
                            {% if translation.lang == language %}
                                {% set translatedUrl = translation.permalink %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    
                    <a href="{% if language == currentLanguage %}{{permalink}}{% else %}{{ translatedUrl }}{% endif %}" 
                       class="font-medium tracking-wide uppercase transition-colors duration-300 {% if language == currentLanguage %}text-cyan-600 font-bold{% else %}text-slate-400 hover:text-slate-800{% endif %}"
                       {% if language == currentLanguage %}aria-current="true"{% endif %}>
                        {{ language | upper }}
                    </a>
                {% endfor %}
            </div>

            <!-- CTAs Minimalist with subtle hover lift -->
            <div class="flex items-center">
                <!-- Lawyer Button -->
                <a href="{{metadata.navBar[currentLanguage].linkAbogados}}" 
                   class="flex items-center gap-2 px-4 py-1.5 text-slate-600 hover:text-cyan-600 border-l border-slate-50 transition-colors group">
                    <span class="font-medium relative overflow-hidden">
                        {{ metadata.navBar[currentLanguage].ctaAbogados }}
                        <span class="absolute bottom-0 left-0 w-full h-[1px] bg-cyan-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                    </span>
                </a>
                <!-- Phone Number -->
                <a href="tel:{{metadata.contact.phoneNumber}}" class="flex items-center gap-2 px-4 py-1.5 text-slate-600 hover:text-cyan-600 border-l border-slate-50 transition-colors" itemprop="url">
                    <span class="font-medium tracking-wide">{{metadata.contact.phoneNumber}}</span>
                </a>
                <a href="{{ metadata.navBar[currentLanguage].linkPresupuesto }}" class="btn-primary !px-6 !py-2 !text-xs !rounded-lg" itemprop="url">
                    {{ metadata.navBar[currentLanguage].ctaPresupuesto | upper }}
                </a>
            </div>
        </div>

