                </div>
            </a>

            <!-- Desktop Navigation -->
            <nav class="hidden lg:block" itemprop="hasPart" itemscope itemtype="https://schema.org/SiteNavigationElement">
                <ul class="flex items-center gap-10">
                    {%- for entry in navPages %}{{ renderNavListItem(entry) }}{%- endfor -%}
                </ul>
            </nav>

            <!-- Hamburger Menu Button -->
            <input type="checkbox" id="menuToggle" class="sr-only peer">
            <label for="menuToggle" id="menuButton" class="lg:hidden flex flex-col justify-center items-center w-12 h-12 rounded-full hover:bg-slate-50 transition-all duration-300 relative gap-1.5 cursor-pointer z-50">
                <span class="w-6 h-0.5 bg-slate-900 transition-all duration-300 ease-out p-origin-center peer-checked:transform peer-checked:translate-y-[8px] peer-checked:rotate-45"></span>
                <span class="w-6 h-0.5 bg-slate-900 transition-all duration-300 ease-out peer-checked:opacity-0 peer-checked:transform peer-checked:translate-x-4"></span>
                <span class="w-6 h-0.5 bg-slate-900 transition-all duration-300 ease-out p-origin-center peer-checked:transform peer-checked:translate-y-[-8px] peer-checked:rotate-[-45deg]"></span>
            </label>
