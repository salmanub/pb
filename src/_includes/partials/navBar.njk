</header>

<!-- Mobile Menu -->
<div id="mobileMenu" class="fixed top-[70px] lg:top-[80px] inset-x-0 bottom-0 pb-24 bg-white transform translate-x-full transition-transform duration-300 ease-in-out z-40 flex flex-col peer-checked:translate-x-0 border-t border-slate-100">
    <div class="max-w-[1600px] mx-auto px-[5%] flex-1 overflow-y-auto flex flex-col">
        <!-- Navigation -->
        <nav class="flex-1 flex items-stretch">
            <ul class="w-full py-8 space-y-2">
                {%- for entry in navPages %}{{ renderMobileNavItems(entry) }}{%- endfor -%}
                
                <!-- Botón de área de abogados - Mobile -->
                <li class="nav-item mt-6 pt-6 border-t border-slate-100">
                    <a href="{{metadata.navBar[currentLanguage].linkAbogados}}" 
                    class="flex items-center gap-3 text-slate-600 font-medium text-lg hover:text-cyan-600 hover:bg-slate-50 rounded-lg px-4 py-3 transition-colors">
                        <span class="font-medium">{{ metadata.navBar[currentLanguage].ctaAbogados }}</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>

    <!-- Footer actions Mobile -->
    <div class="py-6 border-t border-slate-100 bg-slate-50">
        <!-- Language selector -->
        <div class="flex justify-center gap-4 px-4">
            {% for language in metadata.languages %}
                {% set translatedUrl = '/' %}
                
                {# Logic to find translations if not directly available #}
                {% set pageTranslations = translations %}
                {% if not pageTranslations and post and post.translations %}
                    {% set pageTranslations = post.translations %}
                {% endif %}
                {% if not pageTranslations and caso and caso.translations %}
                    {% set pageTranslations = caso.translations %}
                {% endif %}

                {% if pageTranslations and pageTranslations.length %}
                    {% for translation in pageTranslations %}
                        {% if translation.lang == language %}
                            {% set translatedUrl = translation.permalink %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
                
                <a href="{% if language == currentLanguage %}{{permalink}}{% else %}{{ translatedUrl }}{% endif %}" 
                   class="font-medium px-4 py-2 rounded-md transition-all text-sm {% if language == currentLanguage %}text-white bg-slate-900 shadow-sm{% else %}text-slate-500 hover:text-slate-900 hover:bg-white{% endif %}"
                   {% if language == currentLanguage %}aria-current="true"{% endif %}>
                    {{ language | upper }}
                </a>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Botón flotante para hablar con un perito -->
<a href="tel:{{metadata.contact.phoneNumber}}" id="talkToExpert" class="hidden md:flex fixed top-1/2 right-0 z-[100] transform -translate-y-1/2 items-center justify-center pl-6 pr-5 py-4 font-bold uppercase tracking-wider text-sm rounded-l-2xl rounded-r-none transition-all duration-300 bg-cyan-600 text-white shadow-2xl hover:bg-cyan-500 hover:-translate-x-2 shadow-cyan-900/20">
    <svg class="w-5 h-5 mr-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    {{metadata.contact.floating_cta_text[currentLanguage]}}
</a>

{# {% css %} #}
<style>
    #menuButton.active span:first-child {
        transform: translateY(8px) rotate(45deg);
    }
    #menuButton.active span:nth-child(2) {
        opacity: 0;
        transform: translateX(-10px);
    }
    #menuButton.active span:last-child {
        transform: translateY(-8px) rotate(-45deg);
    }

    @keyframes softGlow {
        0%, 100% {
            box-shadow: 0 4px 6px -1px rgba(8, 145, 178, 0.2), 
                       0 2px 4px -1px rgba(8, 145, 178, 0.1);
        }
        50% {
            box-shadow: 0 10px 15px -3px rgba(8, 145, 178, 0.4), 
                       0 4px 6px -2px rgba(8, 145, 178, 0.2);
            transform: translateY(-2px);
        }
    }

    .animate-soft-glow {
        animation: softGlow 3s ease-in-out infinite;
    }

    /* Pause animation on hover */
    .animate-soft-glow:hover {
        animation-play-state: paused;
    }
</style>
{# {% endcss %} #}

