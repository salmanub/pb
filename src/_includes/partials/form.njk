{#
  form.njk — Formulario de contacto multipaso con :target (zero-JS)
  AGENTES §5.6: checkbox :checked + :target, validación HTML5 nativa
  AGENTES §6: ContactPoint microdata
  Fuente: SiteData.jsx → Qual component + HomePage contact section
  Datos: {lang}.json (form.*) + metadata.json (contact.*)
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}

<div itemprop="contactPoint" itemscope itemtype="https://schema.org/ContactPoint">
  <meta itemprop="telephone" content="{{ metadata.contact.phoneNumber }}">
  <meta itemprop="email" content="{{ metadata.company.email }}">
  <meta itemprop="contactType" content="customer service">

  <form action="https://hook.eu2.make.com/76yaogaunrc9cqdtf26ldcoxb3fpndma" method="POST"
        style="max-width: var(--container-text); margin: 0 auto;">
    <input type="hidden" name="lang" value="{{ lang | default('es') }}">

    {# ── Paso 1: Tipo de dictamen ── #}
    <div id="step-1" class="form-step">
      <div style="font-family: var(--font-mono); font-size: var(--fs-mono-label);
                  letter-spacing: var(--tracking-label); text-transform: uppercase;
                  color: var(--text-accent); margin-bottom: 8px;">
        {{ ui.form.step }} 1 {{ ui.form.de }} 3
      </div>
      <div style="font-family: var(--font-serif); font-size: var(--fs-h3);
                  color: var(--text-strong); margin-bottom: 24px;">
        {{ ui.form.asunto }}
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        {% for key, label in ui.form.opciones %}
        <label style="display: flex; align-items: center; gap: 10px; padding: 14px 16px;
                      border: 1px solid var(--border-hairline); border-radius: var(--radius-sm);
                      cursor: pointer; font-size: 0.9rem; color: var(--text-body);
                      transition: border-color var(--dur-fast) var(--ease-out);">
          <input type="radio" name="asunto" value="{{ key }}" required
                 style="accent-color: var(--accent); width: 16px; height: 16px;">
          {{ label }}
        </label>
        {% endfor %}
      </div>

      <div style="margin-top: 24px; text-align: right;">
        <a href="#step-2"
           style="display: inline-flex; align-items: center; justify-content: center;
                  padding: 12px 22px; font-family: var(--font-sans); font-size: 0.9375rem;
                  font-weight: var(--fw-semibold); line-height: 1; letter-spacing: 0.005em;
                  border-radius: var(--radius-sm); border: 1.5px solid transparent;
                  background: var(--accent); color: var(--accent-on);">
          {{ ui.form.siguiente }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               style="margin-left: 8px;" aria-hidden="true">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </a>
      </div>
    </div>

    {# ── Paso 2: Datos personales ── #}
    <div id="step-2" class="form-step">
      <div style="font-family: var(--font-mono); font-size: var(--fs-mono-label);
                  letter-spacing: var(--tracking-label); text-transform: uppercase;
                  color: var(--text-accent); margin-bottom: 8px;">
        {{ ui.form.step }} 2 {{ ui.form.de }} 3
      </div>
      <div style="font-family: var(--font-serif); font-size: var(--fs-h3);
                  color: var(--text-strong); margin-bottom: 24px;">
        {{ ui.form.nombre }}
      </div>

      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div>
          <label for="contact-name" style="display: block; font-size: var(--fs-body-sm);
                 font-weight: var(--fw-medium); color: var(--text-strong); margin-bottom: 6px;">
            {{ ui.form.nombre }}
          </label>
          <input type="text" id="contact-name" name="nombre" required autocomplete="name"
                 style="width: 100%; padding: 12px 14px; font-family: var(--font-sans);
                        font-size: var(--fs-body); border: 1px solid var(--border-hairline);
                        border-radius: var(--radius-sm); background: var(--surface-card);
                        color: var(--text-body); transition: border-color var(--dur-fast) var(--ease-out);">
        </div>
        <div>
          <label for="contact-email" style="display: block; font-size: var(--fs-body-sm);
                 font-weight: var(--fw-medium); color: var(--text-strong); margin-bottom: 6px;">
            {{ ui.form.email }}
          </label>
          <input type="email" id="contact-email" name="email" required autocomplete="email"
                 style="width: 100%; padding: 12px 14px; font-family: var(--font-sans);
                        font-size: var(--fs-body); border: 1px solid var(--border-hairline);
                        border-radius: var(--radius-sm); background: var(--surface-card);
                        color: var(--text-body); transition: border-color var(--dur-fast) var(--ease-out);">
        </div>
        <div>
          <label for="contact-phone" style="display: block; font-size: var(--fs-body-sm);
                 font-weight: var(--fw-medium); color: var(--text-strong); margin-bottom: 6px;">
            {{ ui.form.telefono }}
          </label>
          <input type="tel" id="contact-phone" name="telefono" autocomplete="tel"
                 style="width: 100%; padding: 12px 14px; font-family: var(--font-sans);
                        font-size: var(--fs-body); border: 1px solid var(--border-hairline);
                        border-radius: var(--radius-sm); background: var(--surface-card);
                        color: var(--text-body); transition: border-color var(--dur-fast) var(--ease-out);">
        </div>
      </div>

      <div style="margin-top: 24px; display: flex; justify-content: space-between;">
        <a href="#step-1"
           style="display: inline-flex; align-items: center; justify-content: center;
                  padding: 12px 22px; font-family: var(--font-sans); font-size: 0.9375rem;
                  font-weight: var(--fw-semibold); line-height: 1; border-radius: var(--radius-sm);
                  border: 1.5px solid var(--ink-900); background: transparent; color: var(--ink-900);">
          {{ ui.form.anterior }}
        </a>
        <a href="#step-3"
           style="display: inline-flex; align-items: center; justify-content: center;
                  padding: 12px 22px; font-family: var(--font-sans); font-size: 0.9375rem;
                  font-weight: var(--fw-semibold); line-height: 1; border-radius: var(--radius-sm);
                  border: 1.5px solid transparent; background: var(--accent); color: var(--accent-on);">
          {{ ui.form.siguiente }}
        </a>
      </div>
    </div>

    {# ── Paso 3: Mensaje + envío ── #}
    <div id="step-3" class="form-step">
      <div style="font-family: var(--font-mono); font-size: var(--fs-mono-label);
                  letter-spacing: var(--tracking-label); text-transform: uppercase;
                  color: var(--text-accent); margin-bottom: 8px;">
        {{ ui.form.step }} 3 {{ ui.form.de }} 3
      </div>
      <div style="font-family: var(--font-serif); font-size: var(--fs-h3);
                  color: var(--text-strong); margin-bottom: 24px;">
        {{ ui.form.mensaje }}
      </div>

      <textarea id="contact-message" name="mensaje" rows="5" required
                style="width: 100%; padding: 12px 14px; font-family: var(--font-sans);
                       font-size: var(--fs-body); border: 1px solid var(--border-hairline);
                       border-radius: var(--radius-sm); background: var(--surface-card);
                       color: var(--text-body); resize: vertical;"></textarea>

      <div style="margin-top: 16px;">
        <label style="display: flex; align-items: flex-start; gap: 10px; font-size: var(--fs-body-sm);
                      color: var(--text-muted); cursor: pointer;">
          <input type="checkbox" name="privacidad" required
                 style="accent-color: var(--accent); margin-top: 3px; width: 16px; height: 16px;">
          <span>{{ ui.form.privacidad }}
            <a href="{{ langPrefix }}/privacidad/"
               style="color: var(--text-accent); text-decoration: underline;">{{ ui.form.politica_privacidad }}</a>.
          </span>
        </label>
      </div>

      <div style="margin-top: 24px; display: flex; justify-content: space-between;">
        <a href="#step-2"
           style="display: inline-flex; align-items: center; justify-content: center;
                  padding: 12px 22px; font-family: var(--font-sans); font-size: 0.9375rem;
                  font-weight: var(--fw-semibold); line-height: 1; border-radius: var(--radius-sm);
                  border: 1.5px solid var(--ink-900); background: transparent; color: var(--ink-900);">
          {{ ui.form.anterior }}
        </a>
        <button type="submit"
                style="display: inline-flex; align-items: center; justify-content: center;
                       padding: 12px 22px; font-family: var(--font-sans); font-size: 0.9375rem;
                       font-weight: var(--fw-semibold); line-height: 1; border-radius: var(--radius-sm);
                       border: 1.5px solid transparent; background: var(--accent); color: var(--accent-on);
                       cursor: pointer;">
          {{ ui.form.enviar }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               style="margin-left: 8px;" aria-hidden="true">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </form>
</div>
