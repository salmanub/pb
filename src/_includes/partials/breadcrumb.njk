{#
  breadcrumb.njk — BreadcrumbList con microdata
  Label encima, trail debajo
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}
{% set trail = breadcrumb | default([]) %}

{% if trail | length > 0 %}
<div class="breadcrumb-band" style="background: var(--accent-tint, #e6f2ec);">
<div style="max-width: var(--container-wide); margin: 0 auto; padding: 10px var(--gutter) 10px;">
<div class="breadcrumb-label" style="display: inline-flex; align-items: center; gap: 6px; margin-bottom: 4px;">
<span style="width: 16px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
<span style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-accent); font-weight: 500;">{{ ui.breadcrumb.label }}</span>
</div>
<nav class="breadcrumb-nav" aria-label="{{ ui.breadcrumb.aria }}" itemscope itemtype="https://schema.org/BreadcrumbList" style="display: flex; align-items: center; gap: 6px; font-family: var(--font-sans); font-size: 0.78rem; color: var(--text-muted); flex-wrap: wrap;">{% for crumb in trail %}{% if not loop.first %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;flex-shrink:0;opacity:0.45"><path d="m9 18 6-6-6-6"/></svg>{% endif %}<span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" style="flex-shrink:0">{% if crumb.url %}<a itemprop="item" href="{{ langPrefix }}{{ crumb.url }}" style="color:var(--text-muted);text-decoration:none" onmouseenter="this.style.color='var(--accent)'" onmouseleave="this.style.color='var(--text-muted)'"><span itemprop="name">{{ crumb.label }}</span></a>{% else %}<span itemprop="name" style="color:var(--text-strong);font-weight:600;white-space:normal">{{ title if title else crumb.label }}</span>{% endif %}<meta itemprop="position" content="{{ loop.index }}"></span>{% endfor %}</nav>
</div>
</div>
{% endif %}