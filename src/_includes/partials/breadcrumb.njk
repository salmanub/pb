{#
breadcrumb.njk — BreadcrumbList con microdata Schema.org
Modos:
- Por defecto: banda verde full-width (accent-tint) — páginas de servicios, legal, etc.
- breadcrumb_inline=true: inline mono uppercase (DS-style) — blog, post, casos, caso detalle
Uses: lang, ui, svc_num, breadcrumb_parent, breadcrumb_inline, breadcrumb_items[], title
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}

{# ── Auto-generate trail si no se pasan breadcrumb_items ── #}
{% if not breadcrumb_items or breadcrumb_items | length == 0 %}
{% set _svcIndexUrl = "/informes-pericials/" if lang == "ca" else ("/expert-witness-reports/" if lang == "en" else
"/informes-periciales/") %}
{% set _svcIndexLabel = ui.nav.dictamenes %}

{% if svc_num and "EXP" in svc_num %}
{# Service page: Inicio → Dictámenes → EXP·XX #}
{% set _trail = [
{ label: ui.breadcrumb.inicio, url: "/" },
{ label: _svcIndexLabel, url: _svcIndexUrl },
{ label: title }
] %}
{% elif breadcrumb_parent %}
{# Sub-page con parent: Inicio → Parent → Title #}
{% set _trail = [
{ label: ui.breadcrumb.inicio, url: "/" },
{ label: breadcrumb_parent.label, url: breadcrumb_parent.url },
{ label: title }
] %}
{% else %}
{# Página simple: Inicio → Title #}
{% set _trail = [
{ label: ui.breadcrumb.inicio, url: "/" },
{ label: title }
] %}
{% endif %}
{% else %}
{% set _trail = breadcrumb_items %}
{% endif %}

{# Legacy: soporte para variable 'breadcrumb' (array) del código anterior #}
{% if breadcrumb and breadcrumb | length > 0 %}
{% set _trail = breadcrumb %}
{% endif %}

{% if _trail | length > 0 %}

{# ══════════════════════════════════════════════
MODO INLINE (DS-style: mono uppercase sin banda)
Activar con: {% set breadcrumb_inline = true %}
══════════════════════════════════════════════ #}
{% if breadcrumb_inline %}
<nav class="ds-breadcrumb" aria-label="{{ ui.breadcrumb.aria }}" itemscope itemtype="https://schema.org/BreadcrumbList">
  <meta itemprop="name" content="{{ {{ title }} - metadata.site.title }}">
  {% for crumb in _trail %}
  <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
    {% if crumb.url %}
    <a itemprop="item" href="{{ langPrefix }}{{ crumb.url }}">
      <span itemprop="name">{{ crumb.label }}</span>
    </a>
    {% else %}
    <span itemprop="name" class="ds-breadcrumb__current">{{ crumb.label if crumb.label else title }}</span>
    {% endif %}
    <meta itemprop="position" content="{{ loop.index }}">
  </span>
  {% if not loop.last %}<span class="ds-breadcrumb__sep" aria-hidden="true">/</span>{% endif %}
  {% endfor %}
</nav>

{# ══════════════════════════════════════════════
MODO BANDA (por defecto: banda verde full-width)
══════════════════════════════════════════════ #}
{% else %}
<div class="breadcrumb-band" style="background: var(--accent-tint, #e6f2ec);">
  <div style="max-width: var(--container-wide); margin: 0 auto; padding: 10px var(--gutter) 10px;">
    <div class="breadcrumb-label"
      style="display: inline-flex; align-items: center; gap: 6px; margin-bottom: 4px; opacity: 0.45; transition: opacity 0.25s ease;">
      <span style="width: 16px; height: 1.5px; background: var(--accent); display: inline-block;"></span>
      <span
        style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-accent); font-weight: 500;">{{
        ui.breadcrumb.label }}</span>
    </div>
    <nav class="breadcrumb-nav" aria-label="{{ ui.breadcrumb.aria }}" itemscope
      itemtype="https://schema.org/BreadcrumbList"
      style="display: flex; align-items: center; gap: 6px; font-family: var(--font-sans); font-size: 0.78rem; color: var(--text-muted); flex-wrap: wrap;">
      <meta itemprop="name" content="{{ title }}">
      {% for crumb in _trail %}
      {% if not loop.first %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        style="display:inline-block;flex-shrink:0;opacity:0.45">
        <path d="m9 18 6-6-6-6" />
      </svg>{% endif %}<span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"
        style="flex-shrink:0">{% if crumb.url %}<a itemprop="item" href="{{ langPrefix }}{{ crumb.url }}"
          style="color:var(--text-muted);text-decoration:none" onmouseenter="this.style.color='var(--accent)'"
          onmouseleave="this.style.color='var(--text-muted)'"><span itemprop="name">{{ crumb.label }}</span></a>{% else
        %}<span itemprop="name" style="color:var(--text-strong);font-weight:600;white-space:normal">{{ crumb.label if
          crumb.label else title }}</span>{% endif %}
        <meta itemprop="position" content="{{ loop.index }}">
      </span>{% endfor %}
    </nav>
  </div>
</div>
{% endif %}

{% endif %}