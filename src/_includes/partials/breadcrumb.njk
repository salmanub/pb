{# Usamos una lógica más simple y directa en lugar del plugin de navegación #}
<nav aria-label="Breadcrumb" class="mb-8" itemscope itemtype="https://schema.org/BreadcrumbList">
    <meta itemprop="name" content="{{ title or page.title }}" />
    <ol class="flex flex-wrap gap-y-2 items-center text-sm md:text-base text-cyan-300/80">
        
        {# 1. Enlace a la página de Inicio (se mantiene igual) #}
        {% set homeUrl = "/" + (lang if lang != "es" else "") %}
        <li class="inline-flex items-center shrink-0" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ homeUrl }}" class="hover:text-cyan-300 transition-colors" itemprop="item">
                <span itemprop="name">
                    {% if lang == "es" %}Inicio
                    {% elif lang == "en" %}Home
                    {% else %}Inici{% endif %}
                </span>
            </a>
            <meta itemprop="position" content="1">
            <svg class="mx-2 w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </li>

        {# 2. Enlace a la Página Pilar (el "Padre") #}
        {# Comprobamos si existe el objeto `parentService` en el frontmatter #}
        {% if parentService and parentService.url and parentService.title %}
            <li class="inline-flex items-center shrink-0" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a href="{{ parentService.url }}" class="hover:text-cyan-300 transition-colors leading-tight" itemprop="item">
                    <span itemprop="name">{{ parentService.title }}</span>
                </a>
                <meta itemprop="position" content="2">
                <svg class="mx-2 w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
        {% endif %}

        {# 3. Texto de la Página Actual (no es un enlace) #}
        <li class="inline-flex items-center" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            {# Usamos 'eleventyNavigation.title' si existe, si no, el 'title' principal de la página #}
            <span class="text-white font-medium leading-tight" aria-current="page" itemprop="name">
                {{ eleventyNavigation.title or title }}
            </span>
            <meta itemprop="position" content="{% if parentService %}3{% else %}2{% endif %}">
        </li>

    </ol>
</nav>