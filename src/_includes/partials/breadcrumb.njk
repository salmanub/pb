{#
  breadcrumb.njk — BreadcrumbList con microdata
  Responsive: wrap en mobile, 1 línea en desktop
#}
{% set ui = es if not lang or lang == "es" else (ca if lang == "ca" else en) %}
{% set langPrefix = "" if not lang or lang == "es" else ("/" + lang) %}
{% set trail = breadcrumb | default([]) %}

{% if trail | length > 0 %}
<div class="breadcrumb-band" style="background: var(--accent-tint, #e6f2ec);">
<nav class="breadcrumb-nav" aria-label="{{ ui.breadcrumb.aria }}" itemscope itemtype="https://schema.org/BreadcrumbList" style="max-width: var(--container-wide); margin: 0 auto; padding: 8px var(--gutter); display: flex; align-items: center; gap: 6px; font-family: var(--font-sans); font-size: 0.78rem; color: var(--text-muted); flex-wrap: wrap;"><span style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint); font-weight: 500; flex-shrink: 0; padding-right: 4px;">{{ ui.breadcrumb.label }}</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;flex-shrink:0;opacity:0.35"><path d="m9 18 6-6-6-6"/></svg>{% for crumb in trail %}{% if not loop.first %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;flex-shrink:0;opacity:0.45"><path d="m9 18 6-6-6-6"/></svg>{% endif %}<span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" style="flex-shrink:0">{% if crumb.url %}<a itemprop="item" href="{{ langPrefix }}{{ crumb.url }}" style="color:var(--text-muted);text-decoration:none" onmouseenter="this.style.color='var(--accent)'" onmouseleave="this.style.color='var(--text-muted)'"><span itemprop="name">{{ crumb.label }}</span></a>{% else %}<span itemprop="name" style="color:var(--text-strong);font-weight:600;white-space:normal">{{ title if title else crumb.label }}</span>{% endif %}<meta itemprop="position" content="{{ loop.index }}"></span>{% endfor %}</nav>
</div>
{% endif %}