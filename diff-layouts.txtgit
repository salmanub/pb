commit e292c09daab68dd8fdde4698dabbeb6c0f057041
Author: Albert Vilardell <avilardell@outlook.com>
Date:   Thu Jul 23 23:30:48 2026 +0200

    fix(casos): el selector de idioma ya no se intercepta como paginación
    
    La interceptación SPA de la paginación comprobaba solo "¿origen y destino
    son un listado de casos?", y /casos-exito/ y /en/success-cases/ cumplen los
    dos. Al cambiar de idioma se inyectaba la rejilla del otro idioma dentro de
    la página actual y se bajaba el scroll a la rejilla, en vez de navegar.
    
    Ahora listBase() devuelve la base del listado CON el idioma y solo se
    intercepta si origen y destino coinciden. El cambio de idioma vuelve a ser
    una navegación real (idioma correcto y arriba del todo); la paginación
    dentro del mismo idioma sigue sin recarga ni salto al top.
    
    Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>

diff --git a/src/_includes/layouts/base.njk b/src/_includes/layouts/base.njk
index 5439efd2..e3352aa5 100644
--- a/src/_includes/layouts/base.njk
+++ b/src/_includes/layouts/base.njk
@@ -190,15 +190,24 @@ AGENTES §5: CSS inline (inyectado por transform), cero
         if (a && a.from && a.entry) setDir(a.from.url, a.entry.url);
       });
 
-      // Paginacion de casos en el MISMO documento: sin recarga, sin salto al top
+      // Paginacion de casos en el MISMO documento: sin recarga, sin salto al top.
+      // Devuelve la base del listado (idioma incluido) o null. Solo se intercepta
+      // si origen y destino son EL MISMO listado: asi el selector de idioma
+      // (/casos-exito/ -> /en/success-cases/) navega de verdad y no se intercepta.
       if (!window.navigation) return;
-      var LIST_RE = /^\/(?:casos-exito|ca\/casos-d-exit|en\/success-cases)\/(?:(?:pagina|page)\/\d+\/)?$/;
-      function isList(u) { try { return LIST_RE.test(new URL(u, location.origin).pathname); } catch (e) { return false; } }
+      var LIST_RE = /^\/(casos-exito|ca\/casos-d-exit|en\/success-cases)\/(?:(?:pagina|page)\/\d+\/)?$/;
+      function listBase(u) {
+        try {
+          var m = new URL(u, location.origin).pathname.match(LIST_RE);
+          return m ? m[1] : null;
+        } catch (e) { return null; }
+      }
 
       navigation.addEventListener("navigate", function (e) {
         if (!e.canIntercept || e.hashChange || e.downloadRequest || e.formData) return;
         var dest = e.destination.url;
-        if (!isList(dest) || !isList(location.href) || dest === location.href) return;
+        var toBase = listBase(dest), fromBase = listBase(location.href);
+        if (!toBase || toBase !== fromBase || dest === location.href) return;
         var fromUrl = location.href;
         e.intercept({
           scroll: "manual",

